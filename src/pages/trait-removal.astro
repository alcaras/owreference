---
import Base from '../layouts/Base.astro';
import data from '../data/trait_removal.json';

const base = import.meta.env.BASE_URL;
const { traits, counts } = data as any;
const withDirect = traits.filter((t: any) => t.direct.length > 0);
const noDirect = traits.filter((t: any) => t.direct.length === 0);
---

<Base
  title="Trait Removal"
  active="trait-removal"
  pageMark="🧹"
  description="How to get a trait off a character in Old World — every trait with the events that remove it outright and the events that displace it by granting an opposing trait. One page per trait."
  pageStats={[
    { label: 'traits', value: counts.traits },
    { label: 'remove outright', value: counts.direct },
    { label: 'by replacement', value: counts.via },
  ]}
>
  <p class="lede">
    How to get a trait <em>off</em> a character. Two routes: an event can <b>remove it outright</b>,
    or it can <b>grant an opposing trait</b>, which displaces it — the second is far more common, and
    for most traits it is the only option. Pick a trait for its removal events and its replacement
    events, listed separately.
  </p>

  <input id="tri-filter" class="tri__filter" type="search" placeholder="Filter traits…" autocomplete="off" />

  <section class="tri">
    <h2 class="tri__h">Traits with a direct cure <span class="tri__n">{withDirect.length}</span></h2>
    <p class="tri__note">
      At least one event takes the trait off outright. The rarest and most useful column on this page.
    </p>
    <div class="tri__grid">
      {withDirect.map((t: any) => (
        <a class="tri__card tri__card--direct" href={`${base}trait-removal/${t.slug}`} data-name={t.name.toLowerCase()}>
          <span class="tri__name">{t.name}</span>
          <span class="tri__counts"><b>{t.direct.length}</b> direct · {t.via.length} replacement</span>
        </a>
      ))}
    </div>
  </section>

  <section class="tri">
    <h2 class="tri__h">Replacement only <span class="tri__n">{noDirect.length}</span></h2>
    <p class="tri__note">
      No event removes these outright — the only way out is to gain the opposing trait.
    </p>
    <div class="tri__grid">
      {noDirect.map((t: any) => (
        <a class="tri__card" href={`${base}trait-removal/${t.slug}`} data-name={t.name.toLowerCase()}>
          <span class="tri__name">{t.name}</span>
          <span class="tri__counts">{t.via.length} replacement</span>
        </a>
      ))}
    </div>
  </section>
</Base>

<script>
  const input = document.getElementById('tri-filter') as HTMLInputElement | null;
  if (input) {
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      for (const sec of Array.from(document.querySelectorAll('.tri')) as HTMLElement[]) {
        let any = false;
        for (const card of Array.from(sec.querySelectorAll('.tri__card')) as HTMLElement[]) {
          const hit = !q || (card.dataset.name || '').includes(q);
          card.hidden = !hit;
          any = any || hit;
        }
        sec.hidden = !any;
      }
    });
  }
</script>

<style>
  .lede { max-width: 88ch; color: var(--text-dim); font-size: 0.86rem; line-height: 1.6; margin: 0 0 1rem; }
  .lede b { color: var(--text); }

  .tri__filter { width: 100%; max-width: 30rem; background: var(--bg); color: var(--text);
    border: 1px solid var(--border-strong); border-radius: 6px; padding: 0.45rem 0.7rem;
    font: inherit; font-size: 0.86rem; margin: 0 0 1.4rem; }
  .tri__filter:focus { outline: 0; border-color: var(--gold-deep); box-shadow: 0 0 0 2px var(--gold-glow); }

  .tri { margin: 0 0 1.8rem; }
  .tri__h { font-family: var(--font-display); font-size: 1.05rem; color: var(--accent);
    margin: 0 0 0.25rem; display: flex; align-items: baseline; gap: 0.5rem; }
  .tri__n { font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-faint); }
  .tri__note { max-width: 84ch; font-size: 0.78rem; color: var(--text-faint); line-height: 1.55; margin: 0 0 0.7rem; }

  .tri__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr)); gap: 0.4rem; }
  .tri__card { display: flex; flex-direction: column; gap: 0.15rem; padding: 0.5rem 0.65rem;
    background: var(--bg-elev); border: 1px solid var(--border); border-radius: var(--radius);
    text-decoration: none; color: var(--text); }
  .tri__card:hover { border-color: var(--gold-deep); text-decoration: none; }
  .tri__card--direct { border-left: 3px solid var(--gold-deep); }
  .tri__name { font-family: var(--font-display); font-size: 0.92rem; }
  .tri__counts { font-family: var(--font-mono); font-size: 0.62rem; color: var(--text-faint); }
  .tri__counts b { color: var(--gold-soft); }
</style>
