---
import Base from '../layouts/Base.astro';
import cognomenData from '../data/cognomens.json';

const { cognomens, tracks, calculator } = cognomenData as any;

// Glyph per track — mirrors the reference page.
const TRACK_GLYPH: Record<string, string> = {
  'Main Line': '👑', 'Killing': '⚔', 'Training / Promoting': '🎖',
  'Tribal Sites': '⛺', 'Alliances & Peace': '☮', 'Conquest': '⚐',
  'Reconquest': '⮌', 'Founding Cities': '🏛', 'Court & Specialists': '👥',
  'Tech & Wonders': '🔮', 'Building': '⛏', 'Exploration': '🧭',
  'Religion': '🙏', 'Reign': '⏳',
  'Benevolence': '🕊', 'Cults & Clergy': '🛐', 'Gathering': '🌿',
  'Raiding': '🗡', 'Lawgiving': '⚖', 'Zealotry': '🔥',
};

// Only the cognomens that participate in the score progression — strip the
// JSON down to exactly what the client-side algorithm needs.
const trackerCogs = cognomens
  .filter((c: any) => c.tracker)
  .map((c: any) => ({
    id: c.id, slug: c.slug, title: c.title, track: c.track,
    legitimacy: c.legitimacy, minValue: c.minValue,
    stats: c.stats.map((s: any) => ({ stat: s.stat, value: s.value })),
  }));

const trackOrder: string[] = tracks
  .map((t: any) => t.name)
  .filter((n: string) => trackerCogs.some((c: any) => c.track === n));

const payload = {
  cogs: trackerCogs,
  trackOrder,
  inputStats: calculator.inputStats,
  statAliases: calculator.statAliases,
  gameSpeeds: calculator.gameSpeeds,
  leaderScaling: calculator.leaderScaling,
};
---

<Base title="Cognomens Tracker" active="cognomens-tracker" pageMark="🧮" pageStats={[
  { label: 'tracked', value: trackerCogs.length },
  { label: 'tracks', value: trackOrder.length },
  { label: 'inputs', value: calculator.inputStats.length },
]}>
  <p class="cog-intro">
    Enter what your leader has done — pulled from the timeline screen
    (<kbd>F5</kbd>, hover the leader's portrait) — to see which regnal title
    they currently hold and how far the next one is. This runs the game's exact
    award routine (<code>Character.cs · updateCognomen()</code>): score
    = Σ&nbsp;stat&nbsp;×&nbsp;weight; the title is the one with the highest
    legitimacy whose scaled threshold you've cleared. Thresholds scale by
    <strong>ruler number</strong> and <strong>game speed</strong> — both modelled
    from the source. Fastest path: <strong>paste the F5 leader panel</strong>
    straight in (labels map to the game's own <code>text-stat.xml</code>
    strings, Indus DLC stats included). Inputs persist in your browser.
  </p>

  <div class="calc">
    <aside class="calc__panel">
      <details class="calc__paste" id="cf-paste-wrap" open>
        <summary class="calc__paste-sum">⇪ Paste from game</summary>
        <p class="calc__paste-help">
          In-game press <kbd>F5</kbd>, hover your leader's portrait, and copy the
          <em>Stat(s)</em> block (the <code>Cognomen:</code> line too, if you
          have it — used as a cross-check). Paste it here and hit fill.
        </p>
        <textarea id="cf-paste" rows="5" spellcheck="false"
          placeholder="Cognomen: the Gatherer (Legitimacy: +30)&#10;Tribes Contacted: 2&#10;Resources Harvested: 14&#10;Years Reigned: 17 …"></textarea>
        <div class="calc__paste-row">
          <button id="cf-paste-go" type="button" class="calc__reset calc__reset--go">Parse &amp; fill</button>
          <span id="cf-paste-msg" class="calc__paste-msg"></span>
        </div>
      </details>

      <div class="calc__settings">
        <label class="calc__field">
          <span class="calc__lbl">Ruler #</span>
          <input id="cf-ruler" type="number" min="1" step="1" value="1" />
          <span class="calc__hint">1 = founder · each +1 raises every bar 5% of base</span>
        </label>
        <label class="calc__field">
          <span class="calc__lbl">Game speed</span>
          <select id="cf-speed"></select>
        </label>
        <label class="calc__check">
          <input id="cf-bad" type="checkbox" />
          <span>Allow bad cognomens<span class="calc__hint"> (ALLOW_BAD_COGNOMENS option)</span></span>
        </label>
        <button id="cf-reset" type="button" class="calc__reset">Reset all</button>
      </div>

      <div class="calc__stats" id="cf-stats"></div>
    </aside>

    <main class="calc__out">
      <section class="calc__hero" id="cf-hero">
        <span class="calc__hero-eyebrow">Current title</span>
        <span class="calc__hero-title" id="cf-hero-title">—</span>
        <span class="calc__hero-sub" id="cf-hero-sub"></span>
      </section>

      <section class="calc__next" id="cf-next" hidden>
        <h2 class="calc__next-hdr">Closest titles <span class="calc__next-note">— click a row for how to earn it; <b class="calc__next-note-up">gold ▲</b> = higher legitimacy than your title (actually upgrades it)</span></h2>
        <ol class="calc__next-list" id="cf-next-list"></ol>
      </section>

      <div class="calc__tracks" id="cf-tracks"></div>
    </main>
  </div>

  <script type="application/json" id="cf-data" set:html={JSON.stringify(payload)}></script>
  <script is:inline>
    (function () {
      const node = document.getElementById('cf-data');
      if (!node) return;
      const DATA = JSON.parse(node.textContent || '{}');
      const KEY = 'owref:cognomen-tracker:v1';
      const GLYPH = {
        'Main Line': '👑', 'Killing': '⚔', 'Training / Promoting': '🎖',
        'Tribal Sites': '⛺', 'Alliances & Peace': '☮', 'Conquest': '⚐',
        'Reconquest': '⮌', 'Founding Cities': '🏛', 'Court & Specialists': '👥',
        'Tech & Wonders': '🔮', 'Building': '⛏', 'Exploration': '🧭',
        'Religion': '🙏', 'Reign': '⏳',
        'Benevolence': '🕊', 'Cults & Clergy': '🛐', 'Gathering': '🌿',
        'Raiding': '🗡', 'Lawgiving': '⚖', 'Zealotry': '🔥',
      };

      // ── state ────────────────────────────────────────────────
      let state = { counts: {}, ruler: 1, speed: DATA.gameSpeeds[0].id, bad: false };
      try {
        const saved = JSON.parse(localStorage.getItem(KEY) || 'null');
        if (saved && typeof saved === 'object') state = Object.assign(state, saved);
      } catch (e) {}
      const save = () => { try { localStorage.setItem(KEY, JSON.stringify(state)); } catch (e) {} };

      // ── exact game math (Character.cs / Utils.cs) ────────────
      // modify(v, m) = v * (100 + max(0, m + 100) ... ) / 100, integer.
      function modify(v, m) {
        if (v === 0 || m === 0) return v;
        const mult = Math.max(0, m + 100);
        return Math.trunc((v * mult) / 100);
      }
      function scaledMin(base, rulerIdx, speedMod) {
        // base * (20 + leaderIndex) / 20, leaderIndex 0-based, integer.
        let v = Math.trunc((base * (20 + rulerIdx)) / 20);
        return modify(v, speedMod);
      }
      function scoreOf(cog) {
        let s = 0;
        for (const st of cog.stats) s += (state.counts[st.stat] | 0) * st.value;
        return s;
      }

      function evaluate() {
        const rulerIdx = Math.max(0, (parseInt(state.ruler, 10) || 1) - 1);
        const sp = DATA.gameSpeeds.find(g => g.id === state.speed) || DATA.gameSpeeds[0];
        const speedMod = sp.modifier;

        let best = null, bestLeg = 0;
        const evald = DATA.cogs.map(c => {
          const score = scoreOf(c);
          const sMin = scaledMin(c.minValue, rulerIdx, speedMod);
          const considered = c.legitimacy > 0 || state.bad;
          const earned = considered && sMin > 0 && score >= sMin;
          const aleg = Math.abs(c.legitimacy);
          if (earned && aleg > bestLeg) { best = c; bestLeg = aleg; }
          return { c, score, sMin, earned, considered };
        });
        return { evald, best, rulerIdx, speedMod };
      }

      // ── render: stat inputs ──────────────────────────────────
      const statsBox = document.getElementById('cf-stats');
      for (const s of DATA.inputStats) {
        const row = document.createElement('label');
        row.className = 'calc__stat';
        const w = [];
        if (s.mainValue != null) w.push('main ' + s.mainValue);
        if (s.sideValue != null) w.push('side ' + s.sideValue);
        row.innerHTML =
          '<span class="calc__stat-name">' + s.label + '</span>' +
          '<span class="calc__stat-w">' + w.join(' · ') + '</span>';
        const inp = document.createElement('input');
        inp.type = 'number'; inp.min = '0'; inp.step = '1';
        inp.value = state.counts[s.stat] != null ? state.counts[s.stat] : '';
        inp.dataset.stat = s.stat;
        inp.addEventListener('input', () => {
          const v = parseInt(inp.value, 10);
          if (Number.isFinite(v) && v !== 0) state.counts[s.stat] = v;
          else delete state.counts[s.stat];
          save(); render();
        });
        row.appendChild(inp);
        statsBox.appendChild(row);
      }

      // ── render: settings ─────────────────────────────────────
      const elRuler = document.getElementById('cf-ruler');
      const elSpeed = document.getElementById('cf-speed');
      const elBad = document.getElementById('cf-bad');
      for (const g of DATA.gameSpeeds) {
        const o = document.createElement('option');
        const mult = g.modifier === 0 ? '×1.0' : '×' + ((100 + g.modifier) / 100).toFixed(1);
        o.value = g.id; o.textContent = g.label + ' (' + mult + ')';
        elSpeed.appendChild(o);
      }
      elRuler.value = state.ruler;
      elSpeed.value = state.speed;
      elBad.checked = !!state.bad;
      elRuler.addEventListener('input', () => { state.ruler = elRuler.value; save(); render(); });
      elSpeed.addEventListener('change', () => { state.speed = elSpeed.value; save(); render(); });
      elBad.addEventListener('change', () => { state.bad = elBad.checked; save(); render(); });
      document.getElementById('cf-reset').addEventListener('click', () => {
        state = { counts: {}, ruler: 1, speed: DATA.gameSpeeds[0].id, bad: false };
        save();
        for (const inp of statsBox.querySelectorAll('input')) inp.value = '';
        elRuler.value = 1; elSpeed.value = state.speed; elBad.checked = false;
        render();
      });

      // ── paste-from-game import ───────────────────────────────
      // Same normaliser as build_cognomens.py · _norm_label — keep in sync.
      const normLabel = (s) =>
        s.toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();

      function syncInputs() {
        for (const inp of statsBox.querySelectorAll('input')) {
          const v = state.counts[inp.dataset.stat];
          inp.value = v != null ? v : '';
        }
      }

      const pasteMsg = document.getElementById('cf-paste-msg');
      document.getElementById('cf-paste-go').addEventListener('click', () => {
        const raw = (document.getElementById('cf-paste').value || '');
        const lines = raw.split('\n');
        const next = {};
        let filled = 0, ignored = 0, expected = null;

        for (const line of lines) {
          const ln = line.trim();
          if (!ln) continue;
          // "Cognomen: the Gatherer (Legitimacy: +30)" → cross-check only.
          const cg = ln.match(/cognomen\s*[:=]\s*(?:the\s+)?([a-z][a-z' -]*?)\s*(?:\(|$)/i);
          if (/^[\s•\-*]*cognomen\s*[:=]/i.test(ln)) {
            if (cg) expected = cg[1].trim().toLowerCase();
            continue;
          }
          const m = ln.match(/^[\s•\-*]*(.+?)\s*[:=]\s*([\d,]+)\s*$/);
          if (!m) continue;
          const token = DATA.statAliases[normLabel(m[1])];
          const val = parseInt(m[2].replace(/,/g, ''), 10);
          if (token && Number.isFinite(val)) {
            if (val !== 0) next[token] = val;
            filled++;
          } else {
            ignored++; // parsed as "label: n" but not a cognomen-scoring stat
          }
        }

        if (!filled) {
          pasteMsg.className = 'calc__paste-msg is-warn';
          pasteMsg.textContent = ignored
            ? 'No cognomen stats recognised — is this the F5 leader Stat(s) block?'
            : 'Nothing to parse — paste the leader Stat(s) lines.';
          return;
        }

        // A paste is a full snapshot — replace counts wholesale.
        state.counts = next;
        save();
        syncInputs();
        render();

        const { best } = evaluate();
        let msg = 'Filled ' + filled + ' stat' + (filled === 1 ? '' : 's');
        if (ignored) msg += ' · ignored ' + ignored + ' non-scoring';
        pasteMsg.className = 'calc__paste-msg is-ok';
        if (expected) {
          const got = best ? best.title.replace(/^the\s+/i, '').toLowerCase() : '';
          if (got && got === expected) {
            msg += ' · ✓ matches in-game (' + best.title + ')';
          } else {
            pasteMsg.className = 'calc__paste-msg is-warn';
            msg += ' · ⚠ game shows “' + expected + '”, we get “' +
              (best ? best.title : 'none') +
              '” — adjust Ruler #/Game speed to reconcile';
          }
        }
        pasteMsg.textContent = msg;
      });

      // ── render: output ───────────────────────────────────────
      const hero = document.getElementById('cf-hero');
      const heroTitle = document.getElementById('cf-hero-title');
      const heroSub = document.getElementById('cf-hero-sub');
      const tracksBox = document.getElementById('cf-tracks');
      const nextWrap = document.getElementById('cf-next');
      const nextList = document.getElementById('cf-next-list');

      function fmt(n) { return n.toLocaleString(); }

      const labelOf = {};
      for (const s of DATA.inputStats) labelOf[s.stat] = s.label;

      // Which Closest-title rows the user has expanded — preserved across the
      // full re-render that every input change triggers.
      const openNext = new Set();

      // "How to gain it": the cognomen's scoring breakdown against the current
      // counts, plus the fewest single-stat additions that would close the gap.
      function gainHTML(cog, score, sMin) {
        const need = Math.max(0, sMin - score);
        const rows = cog.stats
          .map(st => {
            const n = state.counts[st.stat] | 0;
            return { lbl: labelOf[st.stat] || st.stat, w: st.value, n, c: n * st.value };
          })
          .sort((a, b) => b.c - a.c || Math.abs(b.w) - Math.abs(a.w));

        let h = '<table class="gain__tbl"><tbody>';
        for (const r of rows) {
          h += '<tr class="' + (r.w < 0 ? 'is-pen' : '') + '">' +
            '<td class="gain__l">' + r.lbl + '</td>' +
            '<td class="gain__n">' + fmt(r.n) + '</td>' +
            '<td class="gain__w">× ' + r.w + '</td>' +
            '<td class="gain__c">' + (r.c >= 0 ? '+' : '') + fmt(r.c) + '</td>' +
          '</tr>';
        }
        h += '</tbody></table>';

        h += '<div class="gain__sum">score <b>' + fmt(score) + '</b> / need <b>' +
          fmt(sMin) + '</b> · <b>' + fmt(need) + '</b> to go</div>';

        const routes = rows
          .filter(r => r.w > 0)
          .sort((a, b) => b.w - a.w)
          .slice(0, 3)
          .map(r => '+' + fmt(Math.ceil(need / r.w)) + ' ' + r.lbl +
            ' <span class="gain__dim">(× ' + r.w + ')</span>');
        if (need > 0 && routes.length) {
          h += '<div class="gain__routes"><span class="gain__dim">' +
            'Any one of:</span> ' + routes.join(' &nbsp;·&nbsp; ') + '</div>';
        }
        const pens = rows.filter(r => r.w < 0);
        if (pens.length) {
          h += '<div class="gain__dim gain__pen">Penalties: ' +
            pens.map(r => r.lbl + ' (× ' + r.w + ')').join(', ') +
            ' — these subtract.</div>';
        }
        return h;
      }

      function render() {
        const { evald, best } = evaluate();
        const byId = {};
        for (const e of evald) byId[e.c.id] = e;

        if (best) {
          heroTitle.textContent = best.title;
          heroSub.textContent =
            best.track + ' track · legitimacy ' +
            (best.legitimacy >= 0 ? '+' : '') + best.legitimacy;
          hero.classList.toggle('is-bad', best.legitimacy < 0);
          hero.classList.add('is-set');
        } else {
          heroTitle.textContent = 'No title yet';
          heroSub.textContent = 'No threshold cleared — keep ruling.';
          hero.classList.remove('is-set', 'is-bad');
        }

        // The game ranks by |legitimacy|; only a cognomen with HIGHER
        // legitimacy than your current title can ever replace it. Everything
        // at or below curLeg is cosmetic no matter how close in points.
        const curLeg = best ? Math.abs(best.legitimacy) : 0;
        const signed = (n) => (n >= 0 ? '+' : '') + n;

        tracksBox.innerHTML = '';
        const nextItems = [];
        for (const tname of DATA.trackOrder) {
          const tiers = DATA.cogs
            .filter(c => c.track === tname && (c.legitimacy > 0 || state.bad))
            .map(c => byId[c.id])
            .sort((a, b) => a.sMin - b.sMin);
          if (!tiers.length) continue;

          const earnedTiers = tiers.filter(t => t.earned);
          const current = earnedTiers.length ? earnedTiers[earnedTiers.length - 1] : null;
          const next = tiers.find(t => !t.earned) || null;
          const score = tiers[0].score; // identical within a track's sub-ladder
          const pct = next ? Math.max(0, Math.min(100, (score / next.sMin) * 100)) : 100;

          if (next) nextItems.push({
            cog: next.c, title: next.c.title, track: tname,
            glyph: GLYPH[tname] || '·',
            score, sMin: next.sMin,
            remaining: Math.max(0, next.sMin - score), pct,
            legit: next.c.legitimacy,
            upgrade: Math.abs(next.c.legitimacy) > curLeg,
          });

          const card = document.createElement('section');
          card.className = 'calc__card' + (current ? ' is-on' : '');
          let html =
            '<header class="calc__card-hdr">' +
              '<span class="calc__card-mark">' + (GLYPH[tname] || '·') + '</span>' +
              '<span class="calc__card-name">' + tname + '</span>' +
              '<span class="calc__card-cur">' +
                (current ? current.c.title : '—') + '</span>' +
            '</header>' +
            '<div class="calc__bar"><span style="width:' + pct.toFixed(1) + '%"></span></div>' +
            '<div class="calc__meta">' +
              'score <b>' + fmt(score) + '</b>' +
              (next
                ? ' · ' + fmt(Math.max(0, next.sMin - score)) + ' to <b>' + next.c.title + '</b>'
                : ' · <b>maxed</b>') +
            '</div>' +
            '<ol class="calc__tiers">';
          for (const t of tiers) {
            const cls = t.earned ? 'is-earned' : '';
            const isCur = current && t.c.id === current.c.id;
            const up = Math.abs(t.c.legitimacy) > curLeg;
            html +=
              '<li class="' + cls + (isCur ? ' is-cur' : '') +
                (up ? ' is-upgrade' : '') + '">' +
                '<span class="calc__tier-name">' + t.c.title + '</span>' +
                '<span class="calc__tier-leg" title="legitimacy' +
                  (up ? ' — outranks your current title' : '') + '">' +
                  signed(t.c.legitimacy) + '</span>' +
                '<span class="calc__tier-min">' + fmt(t.sMin) + '</span>' +
              '</li>';
          }
          html += '</ol>';
          card.innerHTML = html;
          tracksBox.appendChild(card);
        }

        // Closest titles — rank every track's next unearned tier by how near
        // it is (progress %, then fewest points remaining), show the top 6.
        nextItems.sort((a, b) => b.pct - a.pct || a.remaining - b.remaining);
        const top = nextItems.slice(0, 6);
        if (top.length) {
          nextList.innerHTML = top.map(n =>
            '<li class="calc__next-item' + (n.upgrade ? ' is-upgrade' : '') + '">' +
              '<details class="calc__nd" data-cid="' + n.cog.id + '"' +
                (openNext.has(n.cog.id) ? ' open' : '') + '>' +
                '<summary class="calc__next-sum">' +
                  '<span class="calc__next-caret">▸</span>' +
                  '<span class="calc__next-mark">' + n.glyph + '</span>' +
                  '<span class="calc__next-title">' + n.title + '</span>' +
                  '<span class="calc__next-leg" title="legitimacy' +
                    (n.upgrade ? ' — would become your title' : ' — ≤ current, won\'t change title') +
                    '">' + signed(n.legit) + (n.upgrade ? ' ▲' : '') + '</span>' +
                  '<span class="calc__next-track">' + n.track + '</span>' +
                  '<span class="calc__next-bar"><span style="width:' +
                    n.pct.toFixed(1) + '%"></span></span>' +
                  '<span class="calc__next-need">' +
                    (n.remaining === 0 ? 'ready' : fmt(n.remaining) + ' pts') +
                  '</span>' +
                '</summary>' +
                '<div class="calc__next-detail">' +
                  '<p class="gain__why">' +
                    (n.upgrade
                      ? 'Earning this sets your title to <b>' + n.title +
                        '</b> (legitimacy ' + signed(n.legit) + ', outranks your current).'
                      : 'Legitimacy ' + signed(n.legit) +
                        ' is ≤ your current title — earning it won\'t change the displayed title.') +
                  '</p>' +
                  gainHTML(n.cog, n.score, n.sMin) +
                '</div>' +
              '</details>' +
            '</li>'
          ).join('');
          for (const d of nextList.querySelectorAll('.calc__nd')) {
            d.addEventListener('toggle', () => {
              if (d.open) openNext.add(d.dataset.cid);
              else openNext.delete(d.dataset.cid);
            });
          }
          nextWrap.hidden = false;
        } else {
          nextWrap.hidden = true;
        }
      }

      render();
    })();
  </script>
</Base>

<!-- is:global — the track cards, tier lists and stat inputs are built at
     runtime via innerHTML, so they never receive Astro's scoped data-cid
     attribute. Scoped selectors would silently miss every generated node. -->
<style is:global>
  .cog-intro {
    max-width: 880px; color: var(--text-dim); font-size: 0.86rem;
    margin: 0 0 1.25rem; line-height: 1.6;
  }
  .cog-intro code, .cog-intro kbd {
    background: var(--bg-elev); padding: 0.05rem 0.4rem;
    border-radius: 3px; border: 1px solid var(--border);
    font-family: var(--font-mono); font-size: 0.78em;
  }
  .cog-intro strong { color: var(--text); }

  .calc {
    display: grid;
    grid-template-columns: minmax(280px, 360px) 1fr;
    gap: 1.5rem;
    align-items: start;
  }
  @media (max-width: 860px) { .calc { grid-template-columns: 1fr; } }

  /* ── input panel ── */
  .calc__panel {
    position: sticky; top: 1rem;
    background: var(--bg-elev); border: 1px solid var(--border);
    border-radius: 8px; padding: 1rem;
  }
  .calc__settings { display: flex; flex-direction: column; gap: 0.7rem; margin-bottom: 0.9rem; }
  .calc__field { display: flex; flex-direction: column; gap: 0.2rem; }
  .calc__lbl {
    font-family: var(--font-display); font-size: 0.78rem;
    color: var(--text); letter-spacing: 0.02em;
  }
  .calc__hint { color: var(--text-faint); font-size: 0.66rem; font-style: italic; }
  .calc__panel input[type=number], .calc__panel select {
    background: var(--bg); border: 1px solid var(--border);
    color: var(--text); border-radius: 4px; padding: 0.3rem 0.45rem;
    font-family: var(--font-mono); font-size: 0.8rem; width: 100%;
  }
  .calc__check {
    display: flex; align-items: baseline; gap: 0.45rem;
