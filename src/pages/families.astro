---
import Base from '../layouts/Base.astro';
import LinkedText from '../components/LinkedText.astro';
import families from '../data/families.json';
import { classifyYield } from '../lib/entities';

const base = import.meta.env.BASE_URL;

type FamilyClass = typeof families[number];

type Row =
  | { kind: 'section'; label: string }
  | {
      kind: 'effects' | 'opinions' | 'list' | 'nations' | 'archetypes';
      label: string;
      field: (f: FamilyClass) => any;
    };

// aiTraitDie weights ≥5, compacted to "Commander ×10 · Hero ×5"
function archetypeTendencies(f: FamilyClass): { name: string; slug: string; weight: number }[] {
  const w = (f.archetypeWeights || {}) as Record<string, number>;
  return Object.entries(w)
    .filter(([, v]) => v >= 5)
    .sort((a, b) => b[1] - a[1])
    .map(([id, v]) => {
      const slug = id.replace('TRAIT_', '').replace('_ARCHETYPE', '').toLowerCase();
      return { name: slug.charAt(0).toUpperCase() + slug.slice(1), slug, weight: v };
    });
}

const rows: Row[] = [
  { kind: 'section', label: 'City Bonus' },
  { kind: 'effects', label: 'City Bonus', field: f => f.cityBonus },

  { kind: 'section', label: 'Seat' },
  { kind: 'effects', label: 'Seat Bonus', field: f => f.seatBonus },
  { kind: 'effects', label: 'Seat Founding', field: f => f.seatFounding },
  { kind: 'effects', label: 'City Founding', field: f => (f as any).foundBonus },

  { kind: 'section', label: 'Opinion' },
  { kind: 'opinions', label: 'Opinion modifiers', field: f => f.opinions },

  { kind: 'section', label: 'Preferences' },
  { kind: 'list', label: 'Favored Buildings', field: f => f.favored },
  { kind: 'list', label: 'Preferred Laws',    field: f => f.preferredLaws },
  { kind: 'list', label: 'Luxuries (-/missing)', field: f => f.luxuries },

  { kind: 'section', label: 'Characters' },
  { kind: 'archetypes', label: 'Archetypes',  field: f => archetypeTendencies(f) },

  { kind: 'section', label: 'Nations' },
  { kind: 'nations', label: 'Nations',        field: f => f.nations },
];

// Pre-compute a JSON blob per family for the column-filter search.
const searchBlobs: Record<string, string> = {};
for (const f of families) {
  searchBlobs[f.slug] = JSON.stringify(f).toLowerCase();
}
---

<Base
  title="Families"
  active="families"
  pageMark="👪"
  description="The 10 family classes of Old World (Champions, Hunters, Riders, Statesmen, Sages, Patrons, Artisans, Landowners, Clerics, Traders) with city bonuses, seat bonuses, opinion modifiers, preferred laws, favored buildings, and which nations have each."
>
  <div class="page-meta">
    <h1 class="page-title">Families</h1>
    <div class="page-stats">
      <button
        type="button"
        class="stat stat--button"
        id="family-picker-toggle"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="family-picker"
      >
        <b id="family-visible-count">{families.length}</b> of <b>{families.length}</b> visible <span class="stat__chev">▾</span>
      </button>
    </div>
  </div>

  <div class="nation-picker" id="family-picker" hidden role="dialog" aria-label="Filter family classes">
    <div class="nation-picker__actions">
      <button type="button" class="nation-picker__action" data-pick="all">Select all</button>
      <button type="button" class="nation-picker__action" data-pick="none">Clear</button>
      <button type="button" class="nation-picker__action nation-picker__action--close" data-pick="close">Done</button>
    </div>
    <ul class="nation-picker__list">
      {families.map(f => (
        <li class="nation-picker__item">
          <label class="nation-picker__row">
            <input type="checkbox" class="nation-picker__cb" value={f.slug} checked />
            <img class="nation-picker__crest" src={`${base}${f.icon}`} alt="" />
            <span class="nation-picker__name">{f.name}</span>
          </label>
        </li>
      ))}
    </ul>
  </div>

  <div class="grid__searchnote" id="grid-searchnote" hidden></div>

  <div class="grid" id="families-grid">
    <div class="grid__scroll">
      {/* min-width = the mobile-crush floor (≈10rem/col); above it the 10 columns
          flex to fill the viewport, below it .grid__scroll scrolls. */}
      <table class="ntbl" style={`min-width:${families.length * 10 + 7.5}rem`}>
        <colgroup>
          <col class="ntbl__rowlabel-col" />
          {families.map(f => <col data-family={f.slug} />)}
        </colgroup>
        <thead>
          <tr>
            <th class="rowlabel rowlabel--corner">
              <span class="rowlabel__small">Class →</span>
              <span class="rowlabel__big">Attribute ↓</span>
            </th>
            {families.map(f => (
              <th class={`nhdr nhdr--family`} data-family={f.slug} title={f.id} id={f.slug}>
                <a class="nhdr__link" href={`${base}families/${f.slug}`}>
                  <img class="nhdr__crest" src={`${base}${f.icon}`} alt="" />
                  <span class="nhdr__name">{f.name}</span>
                </a>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map(row => row.kind === 'section' ? (
            <tr class="srow">
              <th class="srow__th" colspan={families.length + 1}>
                <span class="srow__chevron">▸</span>{row.label}
              </th>
            </tr>
          ) : (
            <tr>
              <th class="rowlabel" scope="row">{row.label}</th>
              {families.map(f => {
                const v = row.field(f);

                if (row.kind === 'effects') {
                  const items: string[] = v || [];
                  if (items.length === 0) {
                    return <td class="cell is-empty" data-family={f.slug}><span class="cell__dash">—</span></td>;
                  }
                  return (
                    <td class="cell cell--effects" data-family={f.slug}>
                      {items.map(text => {
                        const yieldKey = classifyYield(text)?.toLowerCase() || 'misc';
                        return (
                          <div class={`effect yield-${yieldKey}`}>
                            <LinkedText text={text} showIcons={false} iconsForYields={true} />
                          </div>
                        );
                      })}
                    </td>
                  );
                }

                if (row.kind === 'opinions') {
                  const items: { label: string; value: number }[] = v || [];
                  if (items.length === 0) {
                    return <td class="cell is-empty" data-family={f.slug}><span class="cell__dash">—</span></td>;
                  }
                  return (
                    <td class="cell cell--opinions" data-family={f.slug}>
                      {items.map(o => (
                        <div class={`opinion opinion--${o.value >= 0 ? 'pos' : 'neg'}`}>
                          <span class="opinion__label">{o.label}</span>
                          <span class="opinion__val">{o.value >= 0 ? '+' : ''}{o.value}</span>
                        </div>
                      ))}
                    </td>
                  );
                }

                if (row.kind === 'list') {
                  const items: { label: string; value: number }[] = v || [];
                  if (items.length === 0) {
                    return <td class="cell is-empty" data-family={f.slug}><span class="cell__dash">—</span></td>;
                  }
                  return (
                    <td class="cell cell--list yield-misc" data-family={f.slug}>
                      {items.map(it => (
                        <div class="listitem">
                          <span><LinkedText text={it.label} showIcons={false} /></span>
                          <span class={`opinion__val opinion--${it.value >= 0 ? 'pos' : 'neg'}`}>{it.value >= 0 ? '+' : ''}{it.value}</span>
                        </div>
                      ))}
                    </td>
                  );
                }

                if (row.kind === 'archetypes') {
                  const items: { name: string; slug: string; weight: number }[] = v || [];
                  if (items.length === 0) {
                    return <td class="cell is-empty" data-family={f.slug}><span class="cell__dash">—</span></td>;
                  }
                  return (
                    <td class="cell cell--archetypes yield-misc" data-family={f.slug}>
                      <span class="arc-tendencies">
                        {items.map((it, i) => (
                          <>
                            {i > 0 && <span class="arc-tendency__sep"> · </span>}
                            <a class="arc-tendency" href={`${base}archetypes#${it.slug}`}>
                              {it.name} <b class={it.weight >= 10 ? 'arc-tendency__w10' : ''}>×{it.weight}</b>
                            </a>
                          </>
                        ))}
                      </span>
                    </td>
                  );
                }

                if (row.kind === 'nations') {
                  const nations: { slug: string; name: string }[] = v || [];
                  if (nations.length === 0) {
                    return <td class="cell is-empty" data-family={f.slug}><span class="cell__dash">—</span></td>;
                  }
                  return (
                    <td class="cell cell--nations yield-misc" data-family={f.slug}>
                      <div class="nation-tags">
                        {nations.map(n => (
                          <a class={`nation-tag n-${n.slug}`} href={`${base}nations#${n.slug}`} title={n.name}>
                            <img src={`${base}img/crests/${n.slug}.png`} alt="" class="nation-tag__crest" />
                            <span class="nation-tag__name">{n.name}</span>
                          </a>
                        ))}
                      </div>
                    </td>
                  );
                }

                return <td class="cell is-empty" data-family={f.slug}>—</td>;
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <p class="xref">
    → <a href={`${base}family-heads`}>How the family head is chosen</a> — the
    succession priority, the weighted random roll and its trait modifiers,
    transcribed from the game source.
  </p>

  <script type="application/json" id="family-search-blobs" set:html={JSON.stringify(searchBlobs)}></script>
  <script is:inline>
    // Combined column-picker + search, mirroring the Nations page
    // (state of the art), keyed by data-family.
    (function () {
      const input = document.getElementById('site-search');
      const blobNode = document.getElementById('family-search-blobs');
      const grid = document.getElementById('families-grid');
      const note = document.getElementById('grid-searchnote');
      const toggle = document.getElementById('family-picker-toggle');
      const picker = document.getElementById('family-picker');
      const visibleCount = document.getElementById('family-visible-count');
      if (!blobNode || !grid) return;
      let blobs;
      try { blobs = JSON.parse(blobNode.textContent || '{}'); } catch { return; }
      const slugs = Object.keys(blobs);
      const picked = new Set(slugs);

      function applyFilters() {
        const q = ((input && input.value) || '').trim().toLowerCase();
        let visibleN = 0, hiddenBySearch = 0;
        for (const slug of slugs) {
          const matchesSearch = !q || blobs[slug].includes(q);
          const isPicked = picked.has(slug);
          const visible = matchesSearch && isPicked;
          if (visible) visibleN++;
          if (!matchesSearch) hiddenBySearch++;
          for (const el of grid.querySelectorAll('[data-family="' + slug + '"]')) {
            el.classList.toggle('is-hidden', !visible);
          }
        }
        if (visibleCount) visibleCount.textContent = String(visibleN);
        // Shrink the table's min-width floor to the visible-column count so hiding
        // columns can't leave a phantom scroll on narrow screens.
        const tbl = grid.querySelector('table.ntbl');
        if (tbl) tbl.style.minWidth = (visibleN * 10 + 7.5) + 'rem';
        if (note) {
          if (q && hiddenBySearch > 0) {
            note.hidden = false;
            note.textContent =
              'Showing ' + (slugs.length - hiddenBySearch) + ' of ' + slugs.length +
              ' family classes matching "' + (input ? input.value : '') + '"';
          } else {
            note.hidden = true;
            note.textContent = '';
          }
        }
      }

      if (input) input.addEventListener('input', applyFilters);

      if (toggle && picker) {
        toggle.addEventListener('click', () => {
          const open = !picker.hidden;
          picker.hidden = open;
          toggle.setAttribute('aria-expanded', String(!open));
        });
        document.addEventListener('click', (e) => {
          if (picker.hidden) return;
          if (picker.contains(e.target) || toggle.contains(e.target)) return;
          picker.hidden = true;
          toggle.setAttribute('aria-expanded', 'false');
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !picker.hidden) {
            picker.hidden = true;
            toggle.setAttribute('aria-expanded', 'false');
            toggle.focus();
          }
        });
      }

      const cbs = picker ? picker.querySelectorAll('.nation-picker__cb') : [];
      cbs.forEach((cb) => {
        cb.addEventListener('change', () => {
          if (cb.checked) picked.add(cb.value);
          else picked.delete(cb.value);
          applyFilters();
        });
      });

      if (picker) {
        picker.addEventListener('click', (e) => {
          const btn = e.target.closest('[data-pick]');
          if (!btn) return;
          const action = btn.getAttribute('data-pick');
          if (action === 'all') {
            slugs.forEach((s) => picked.add(s));
            cbs.forEach((cb) => (cb.checked = true));
            applyFilters();
          } else if (action === 'none') {
            picked.clear();
            cbs.forEach((cb) => (cb.checked = false));
            applyFilters();
          } else if (action === 'close') {
            picker.hidden = true;
            if (toggle) toggle.setAttribute('aria-expanded', 'false');
          }
        });
      }

      applyFilters();
    })();
  </script>
</Base>

<style>
  /* Cross-link to the family-heads mechanics page */
  .xref { font-size: 0.86rem; line-height: 1.55; color: var(--text-dim); max-width: 72ch; margin: 1.6rem 0 0; }
  .xref a { color: var(--gold-soft); }

  /* Family class column headers — neutral, since classes don't have a single in-game color */
  .nhdr--family {
    background: var(--bg-elev-2);
    color: var(--text);
    border-bottom: 2px solid var(--border-strong);
    background-image: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(0,0,0,0.18));
  }

  /* Opinion list: label + signed value */
  .cell--opinions {
    padding: 0.3rem 0.45rem;
    background: var(--bg-elev);
    background-image: none;
    color: var(--text);
  }
  .opinion {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.1rem 0;
    border-bottom: 1px dashed var(--border);
    font-size: 0.72rem;
  }
  .opinion:last-child { border-bottom: 0; }
  .opinion__label { color: var(--text-dim); }
  .opinion__val {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  .opinion--pos .opinion__val, .opinion--pos { color: #4caf7d; }
  .opinion--neg .opinion__val, .opinion--neg { color: #d46e6e; }

  /* List row (favored buildings, preferred laws, luxuries) */
  .cell--list {
    padding: 0.3rem 0.45rem;
  }
  .listitem {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.1rem 0;
    font-size: 0.72rem;
  }

  /* Archetype tendencies row — compact inline "Commander ×10 · Hero ×5" */
  .cell--archetypes {
    padding: 0.3rem 0.45rem;
    font-size: 0.72rem;
  }
  .arc-tendencies {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
  }
  .arc-tendency {
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }
  .arc-tendency__sep { display: none; }
  .arc-tendency:hover { color: var(--gold); text-decoration: none; }
  .arc-tendency b {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    color: var(--text-dim);
  }
  .arc-tendency .arc-tendency__w10 { color: var(--gold); }
  .arc-tendency__sep { color: var(--text-faint); }

  /* Nation tags inside the "Nations" row.
     Keep the <td> a real table-cell so it stays bound to its column;
     do the flex wrapping on an inner container. */
  .cell--nations {
    padding: 0.3rem 0.45rem;
    vertical-align: top;
  }
  .nation-tags {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.2rem;
  }
  .nation-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.15rem 0.5rem 0.15rem 0.3rem;
    background: var(--nation-bg, var(--bg-elev));
    color: var(--nation-fg, var(--text));
    border: 1px solid color-mix(in srgb, var(--nation-bg) 60%, #000 40%);
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.7rem;
    font-weight: 500;
    background-image: linear-gradient(rgba(0,0,0,0.2), rgba(0,0,0,0.2));
  }
  .nation-tag:hover { text-decoration: none; filter: brightness(1.12); }
  .nation-tag__crest { width: 14px; height: 14px; object-fit: contain; }
</style>
