---
import Base from '../layouts/Base.astro';
import LinkedText from '../components/LinkedText.astro';
import nations from '../data/nations.json';
import { classifyYield } from '../lib/entities';

const base = import.meta.env.BASE_URL;

type Row =
  | { kind: 'section'; label: string }
  | {
      kind: 'data' | 'shrine' | 'family' | 'bonus';
      label: string;
      field: (n: typeof nations[number]) => any;
      skipClassify?: boolean;
    };

const rows: Row[] = [
  { kind: 'section', label: 'Bonuses' },
  // Bonus 1/2/3 pull from the XML-canonical effects list (humanizer output).
  // Fallback to legacy yaml bonuses for nations whose XML coverage is partial.
  { kind: 'bonus', label: 'Bonus 1', field: n => (n.effectsXml?.[0] ?? n.bonuses?.[0]) },
  { kind: 'bonus', label: 'Bonus 2', field: n => (n.effectsXml?.[1] ?? n.bonuses?.[1]) },
  { kind: 'bonus', label: 'Bonus 3', field: n => (n.effectsXml?.[2] ?? n.bonuses?.[2]) },

  { kind: 'section', label: 'Shrines' },
  { kind: 'shrine', label: 'Shrine 1', field: n => n.shrines?.[0] },
  { kind: 'shrine', label: 'Shrine 2', field: n => n.shrines?.[1] },
  { kind: 'shrine', label: 'Shrine 3', field: n => n.shrines?.[2] },
  { kind: 'shrine', label: 'Shrine 4', field: n => n.shrines?.[3] },

  { kind: 'section', label: 'Unique Unit' },
  { kind: 'data', label: 'Names',      field: n => n.uniqueUnit?.names,     skipClassify: true },
  { kind: 'data', label: 'Traits',     field: n => n.uniqueUnit?.traits,    skipClassify: true },
  { kind: 'data', label: 'Cost',       field: n => n.uniqueUnit?.cost },
  { kind: 'data', label: 'Upkeep',     field: n => n.uniqueUnit?.upkeep },
  { kind: 'data', label: 'Move/Sight', field: n => n.uniqueUnit?.moveSight, skipClassify: true },
  { kind: 'data', label: 'U6 Card',    field: n => n.uniqueUnit?.u6Card,    skipClassify: true },
  { kind: 'data', label: 'U8 Card',    field: n => n.uniqueUnit?.u8Card,    skipClassify: true },

  { kind: 'section', label: 'Starting Techs' },
  { kind: 'data', label: 'Tech 1', field: n => n.startingTech?.[0] },
  { kind: 'data', label: 'Tech 2', field: n => n.startingTech?.[1] },
  { kind: 'data', label: 'Tech 3', field: n => n.startingTech?.[2] },

  { kind: 'section', label: 'Families' },
  { kind: 'family', label: 'Family 1', field: n => n.families?.[0] },
  { kind: 'family', label: 'Family 2', field: n => n.families?.[1] },
  { kind: 'family', label: 'Family 3', field: n => n.families?.[2] },
  { kind: 'family', label: 'Family 4', field: n => n.families?.[3] },
  { kind: 'family', label: 'Family 5', field: n => n.families?.[4] },
  { kind: 'family', label: 'Family 6', field: n => n.families?.[5] },

  { kind: 'section', label: 'Royal Family' },
  { kind: 'data', label: 'Leader', field: n => n.leader?.name },
  { kind: 'data', label: 'Spouse', field: n => n.leader?.spouse },
  { kind: 'data', label: 'Heir 1', field: n => n.leader?.heir1 },
  { kind: 'data', label: 'Heir 2', field: n => n.leader?.heir2 },
];

const ordered = [...nations].sort((a, b) => a.name.localeCompare(b.name));

// Shrine type → yield key. Used for the 3px left-bar color when the
// effect text alone doesn't classify (FIRE/HEALING/HUNTING boost tiles
// but produce no direct yield, so we anchor on a thematic fit).
const SHRINE_TYPE_YIELD: Record<string, string> = {
  WAR:        'training',
  KINGSHIP:   'civics',
  WISDOM:     'science',
  SUN:        'orders',
  WATER:      'money',
  LOVE:       'growth',
  UNDERWORLD: 'culture',
  HEARTH:     'culture',
  FIRE:       'iron',
  HEALING:    'growth',
  HUNTING:    'food',
};

// Pre-compute a search blob per nation for the column-filter search.
const searchBlobs: Record<string, string> = {};
for (const n of nations) {
  searchBlobs[n.slug] = JSON.stringify(n).toLowerCase();
}
---

<Base
  title="Nations"
  active="nations"
  eyebrow="All 13 · side by side"
  description="All 13 Old World nations side-by-side: starting bonuses, shrines, unique units, families, starting techs, and leader/royal lineup. Pulled XML-canonical from the game's own files."
>
  <div class="page-meta">
    <div>
      <div class="page-eyebrow">All 13 · side by side</div>
      <h1 class="page-title">Nations</h1>
    </div>
    <div class="page-stats">
      <button
        type="button"
        class="stat stat--button"
        id="nation-picker-toggle"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="nation-picker"
      >
        <b id="nation-visible-count">{nations.length}</b> of <b>{nations.length}</b> visible <span class="stat__chev">▾</span>
      </button>
    </div>
  </div>

  <div class="nation-picker" id="nation-picker" hidden role="dialog" aria-label="Filter nations">
    <div class="nation-picker__actions">
      <button type="button" class="nation-picker__action" data-pick="all">Select all</button>
      <button type="button" class="nation-picker__action" data-pick="none">Clear</button>
      <button type="button" class="nation-picker__action nation-picker__action--close" data-pick="close">Done</button>
    </div>
    <ul class="nation-picker__list">
      {ordered.map(n => (
        <li class="nation-picker__item">
          <label class={`nation-picker__row n-${n.slug}`}>
            <input type="checkbox" class="nation-picker__cb" value={n.slug} checked />
            <img class="nation-picker__crest" src={`${base}img/crests/${n.slug}.png`} alt="" />
            <span class="nation-picker__name">{n.name}</span>
          </label>
        </li>
      ))}
    </ul>
  </div>

  <div class="grid" id="nations-grid">
    <div class="grid__scroll">
      <table class="ntbl">
        <colgroup>
          <col class="ntbl__rowlabel-col" />
          {ordered.map(n => <col data-nation={n.slug} />)}
        </colgroup>
        <thead>
          <tr>
            <th class="rowlabel rowlabel--corner">
              <span class="rowlabel__small">Nation →</span>
              <span class="rowlabel__big">Attribute ↓</span>
            </th>
            {ordered.map(n => (
              <th class={`nhdr n-${n.slug}`} data-nation={n.slug} title={n.id} id={n.slug}>
                <div class="nhdr__inner">
                  <a class="nhdr__link" href={`${base}nations#${n.slug}`}>
                    <img class="nhdr__crest" src={`${base}img/crests/${n.slug}.png`} alt="" />
                    <span class="nhdr__name">{n.name}</span>
                  </a>
                </div>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map(row => row.kind === 'section' ? (
            <tr class="srow">
              <th class="srow__th" colspan={ordered.length + 1}>{row.label}</th>
            </tr>
          ) : (
            <tr>
              <th class="rowlabel" scope="row">{row.label}</th>
              {ordered.map(n => {
                const v = row.field(n);
                const empty = v == null || v === '' || (row.kind === 'family' && !v);
                if (empty) {
                  return (
                    <td class={`cell n-${n.slug} is-empty`} data-nation={n.slug}>
                      <span class="cell__dash">—</span>
                    </td>
                  );
                }

                if (row.kind === 'shrine') {
                  const sh = v;
                  const effect = sh.effect || '';
                  const type = sh.shrine?.type || '';
                  const typeLabel = sh.shrine?.typeLabel || '';
                  const deity = sh.shrine?.name || '';
                  const iconUrl = type ? `${base}img/icons/shrines/${type.toLowerCase()}.png` : '';
                  const yieldKey = SHRINE_TYPE_YIELD[type] || classifyYield(effect)?.toLowerCase() || 'misc';
                  return (
                    <td class={`cell n-${n.slug} yield-${yieldKey}`} data-nation={n.slug}>
                      <div class="shrine">
                        <div class="shrine__head">
                          {iconUrl && <img class="shrine__art" src={iconUrl} alt="" />}
                          <span class="shrine__type">{typeLabel}</span>
                        </div>
                        <span class="shrine__deity">{deity}</span>
                        <div class="shrine__effect"><LinkedText text={effect} showIcons={false} iconsForYields={true} /></div>
                      </div>
                    </td>
                  );
                }

                if (row.kind === 'family') {
                  const iconUrl = v.classKey ? `${base}img/archetypes/${v.classKey}.png` : null;
                  // Yield-bar color for family cells: leave it off (no signal).
                  return (
                    <td class={`cell cell--noref n-${n.slug}`} data-nation={n.slug}>
                      <div class="fam">
                        <div class="fam__head">
                          {iconUrl && <img class="fam__icon" src={iconUrl} alt="" />}
                          <span class="fam__class">{v.class}</span>
                        </div>
                        <span class="fam__name">{v.name}</span>
                      </div>
                    </td>
                  );
                }

                // 'bonus' and 'data' rows share the same rendering — just
                // text inside a yield-classed cell with the 3px left bar.
                const text = String(v);
                const classified = row.skipClassify ? null : classifyYield(text)?.toLowerCase();
                const yieldKey = classified || (row.kind === 'bonus' ? 'misc' : '');
                const yieldClass = yieldKey ? `yield-${yieldKey}` : '';
                return (
                  <td class={`cell n-${n.slug} ${yieldClass}`} data-nation={n.slug}>
                    <LinkedText text={text} showIcons={false} iconsForYields={true} />
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="grid__searchnote" id="grid-searchnote" hidden></div>
  </div>

  <div class="legends">
    <div class="legend">
      <span class="legend__label">Yields</span>
      {['orders','science','civics','culture','money','training','food','growth','wood','stone','iron'].map(y => (
        <span class={`chip yield-${y}`}>
          <img class="chip__icon" src={`${base}img/icons/yields/${y}.png`} alt="" onerror="this.style.display='none'" />
          {y[0].toUpperCase() + y.slice(1)}
        </span>
      ))}
    </div>
    <p class="caption">Left edge = yield given · Right edge = nation tint</p>
  </div>

  <script type="application/json" id="nation-search-blobs" set:html={JSON.stringify(searchBlobs)}></script>
  <script is:inline>
    (function () {
      const input = document.getElementById('site-search');
      const blobNode = document.getElementById('nation-search-blobs');
      const grid = document.getElementById('nations-grid');
      const note = document.getElementById('grid-searchnote');
      const toggle = document.getElementById('nation-picker-toggle');
      const picker = document.getElementById('nation-picker');
      const visibleCount = document.getElementById('nation-visible-count');
      if (!blobNode || !grid) return;
      let blobs;
      try { blobs = JSON.parse(blobNode.textContent || '{}'); } catch { return; }
      const slugs = Object.keys(blobs);
      const picked = new Set(slugs);

      function applyFilters() {
        const q = ((input && input.value) || '').trim().toLowerCase();
        let visibleN = 0, hiddenBySearch = 0;
        for (const slug of slugs) {
          const matchesSearch = !q || blobs[slug].includes(q);
          const isPicked = picked.has(slug);
          const visible = matchesSearch && isPicked;
          if (visible) visibleN++;
          if (!matchesSearch) hiddenBySearch++;
          for (const el of grid.querySelectorAll('[data-nation="' + slug + '"]')) {
            el.classList.toggle('is-hidden', !visible);
          }
        }
        if (visibleCount) visibleCount.textContent = String(visibleN);
        if (note) {
          if (q && hiddenBySearch > 0) {
            note.hidden = false;
            note.textContent =
              'Showing ' + (slugs.length - hiddenBySearch) + ' of ' + slugs.length +
              ' nations matching "' + (input ? input.value : '') + '"';
          } else {
            note.hidden = true;
            note.textContent = '';
          }
        }
      }

      if (input) input.addEventListener('input', applyFilters);

      if (toggle && picker) {
        toggle.addEventListener('click', () => {
          const open = !picker.hidden;
          picker.hidden = open;
          toggle.setAttribute('aria-expanded', String(!open));
        });
        document.addEventListener('click', (e) => {
          if (picker.hidden) return;
          if (picker.contains(e.target) || toggle.contains(e.target)) return;
          picker.hidden = true;
          toggle.setAttribute('aria-expanded', 'false');
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !picker.hidden) {
            picker.hidden = true;
            toggle.setAttribute('aria-expanded', 'false');
            toggle.focus();
          }
        });
      }

      const cbs = picker ? picker.querySelectorAll('.nation-picker__cb') : [];
      cbs.forEach((cb) => {
        cb.addEventListener('change', () => {
          if (cb.checked) picked.add(cb.value);
          else picked.delete(cb.value);
          applyFilters();
        });
      });

      if (picker) {
        picker.addEventListener('click', (e) => {
          const btn = e.target.closest('[data-pick]');
          if (!btn) return;
          const action = btn.getAttribute('data-pick');
          if (action === 'all') {
            slugs.forEach((s) => picked.add(s));
            cbs.forEach((cb) => (cb.checked = true));
            applyFilters();
          } else if (action === 'none') {
            picked.clear();
            cbs.forEach((cb) => (cb.checked = false));
            applyFilters();
          } else if (action === 'close') {
            picker.hidden = true;
            if (toggle) toggle.setAttribute('aria-expanded', 'false');
          }
        });
      }

      applyFilters();
    })();
  </script>
</Base>
