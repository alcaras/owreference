---
import EventGroupPage from '../components/EventGroupPage.astro';
const base = import.meta.env.BASE_URL;
---
<EventGroupPage sectionKey="ruins" title="Ruin Events" active="ruin-events" pageMark="🏚️">
  What can happen when one of your units explores <strong>Ruins</strong>. One event is drawn by
  weight from those whose conditions you meet. See also <a href={`${base}expedition-events`}>Expedition Events</a>
  and the mission events on <a href={`${base}rally`}>Rally Troops</a> / <a href={`${base}hold-court`}>Hold Court</a> /
  <a href={`${base}steal-research`}>Steal Research</a>.
</EventGroupPage>
