---
import EventGroupPage from '../components/EventGroupPage.astro';
const base = import.meta.env.BASE_URL;
---
<EventGroupPage sectionKey="ruins" title="Ruin Events" active="ruin-events" pageMark="🏚️">
  The pop-ups that fire when one of your units explores a <strong>Ruins</strong> tile. One story is
  drawn by weight from those whose conditions are met — the percentage is each story's share of the
  eligible-by-weight pool. Each card shows what fires it, who's eligible, the guaranteed reward, and
  every response you can pick. See also <a href={`${base}expedition-events`}>Expedition Events</a> and the
  mission events on <a href={`${base}rally`}>Rally Troops</a> / <a href={`${base}hold-court`}>Hold Court</a> /
  <a href={`${base}steal-research`}>Steal Research</a>.
</EventGroupPage>
