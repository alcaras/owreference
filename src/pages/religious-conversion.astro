---
import Base from '../layouts/Base.astro';
import LinkedText from '../components/LinkedText.astro';
import Term from '../components/Term.astro';
import conversion from '../data/conversion.json';

const base = import.meta.env.BASE_URL;
const sr = conversion.stateReligion;
const cityYield = sr.cityYields.map(y => `+${y.value} ${y.yield.replace('YIELD_', '').toLowerCase().replace(/^./, c => c.toUpperCase())}`).join(', ');
---

<Base
  title="Religious Conversion"
  active="religious-conversion"
  pageMark="🙏"
  eyebrow="Religion"
  description="How Old World families and characters choose a religion, with the exact scoring from the game's source code, and what adopting a State Religion costs and gives."
  pageStats={[
    { label: 'family cycle', value: `${conversion.family.rotation} turns` },
    { label: 'character roll', value: `${conversion.globals.characterReligionProb}%` },
    { label: 'state religion', value: `${sr.costBase}+ Civics` },
  ]}
>
  <p class="lede">
    This page is about <b>people</b>: how your nation picks a State Religion, and how
    families and characters decide which faith to follow. How a religion gets into a
    <b>city</b> in the first place (the spread roll, distance to the Holy City,
    Disciples, shrines, founding) is on <a href={`${base}religious-spread`}>Religious Spread</a>.
  </p>

  <section class="rc-section">
    <h2 class="rc-h2">State Religion</h2>
    <p>
      You start with no State Religion. You can adopt any religion that at least one of
      your cities follows. A pagan religion needs the <Term id="LAW_DIVINE_RULE" showIcon={false} />
      law first, and it stops being your State Religion if that law ends.
    </p>
    <ul class="rc-bullets">
      <li>
        <b>Cost.</b> {sr.costBase} <LinkedText text="Civics" showIcons={false} />, plus
        {sr.costPerChange} for every time you have adopted a State Religion before (one count for
        all religions), rounded down to 10 and never more than {sr.maxCivics.toLocaleString('en-US')}.
      </li>
      <li>
        <b>Cities.</b> {cityYield} in each of your cities that follows it. A world religion
        (and Hinduism) also carries a Civics upkeep while it is your State Religion; pagan ones do not.
      </li>
      <li>
        <b>Characters.</b> +{sr.opinion} opinion from characters who follow it, −{sr.opinion} from
        characters of any other religion (−{sr.opinion / 2} if theirs is pagan), doubled for a
        religion's head. Other nations also judge you by your State Religion.
      </li>
      <li>
        <b>Disciples and theologies.</b> Your cities that follow it can train its Disciples, and only a
        Disciple of your State Religion can establish a <a href={`${base}theologies`}>Theology</a>
        (paying its Civics cost and using up the Disciple). What Disciples do is on
        <a href={`${base}religious-spread#other`}>Religious Spread</a>.
      </li>
    </ul>
  </section>

  <section class="rc-section">
    <h2 class="rc-h2">Family conversion</h2>
    <p>
      Source: <code>Player.cs::doFamilyReligion</code>. Starting turn
      <b>{conversion.family.startTurn}</b>, the game evaluates one family slot each
      turn, because family <code>i</code> is checked when
      <code>turn % {conversion.family.rotation} == i % {conversion.family.rotation}</code>,
      so every family is reconsidered once every {conversion.family.rotation} turns.
      Each religion is scored, and a religion must score more than
      <b>{conversion.family.threshold}</b> to be eligible. The highest score wins, with
      no random element, and the +50 bonus for the religion a family already follows is
      what stops families from changing god every cycle.
    </p>

    <table class="rc-table rc-table--narrow rc-table--score">
      <thead>
        <tr>
          <th class="rc-num">Points</th>
          <th>Source</th>
        </tr>
      </thead>
      <tbody>
        {conversion.family.scoring.map(s => (
          <tr>
            <td class="rc-num"><b>+{s.points}</b></td>
            <td><LinkedText text={s.label} /></td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="rc-section">
    <h2 class="rc-h2">Character conversion</h2>
    <p>
      Source: <code>Character.cs::doReligion</code> (the trigger gate at line 7950)
      and <code>::chooseReligion</code> (the scoring at line 8509). Global constants
      live in <code>globalsInt.xml</code>.
    </p>

    <h3 class="rc-h3">Who rolls</h3>
    <ul class="rc-bullets">
      {conversion.character.whoRolls.map(line => <li><LinkedText text={line} /></li>)}
    </ul>

    <h3 class="rc-h3">Eligibility threshold</h3>
    <p><LinkedText text={conversion.character.threshold.description} /></p>

    <div class="rc-twocol">
      <div class="rc-card">
        <h3 class="rc-h3" style="margin-top:0">City points with a family</h3>
        <p class="rc-fineprint" style="font-style:normal">{conversion.character.cityScoringWithFamily.note}</p>
        <table class="rc-table rc-table--narrow rc-table--score">
          <tbody>
            {conversion.character.cityScoringWithFamily.rules.map(r => (
              <tr>
                <td class="rc-num"><b>+{r.points}</b></td>
                <td><LinkedText text={r.label} /></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="rc-card">
        <h3 class="rc-h3" style="margin-top:0">City points with no family</h3>
        <p class="rc-fineprint" style="font-style:normal">{conversion.character.cityScoringNoFamily.note}</p>
        <table class="rc-table rc-table--narrow rc-table--score">
          <tbody>
            {conversion.character.cityScoringNoFamily.rules.map(r => (
              <tr>
                <td class="rc-num"><b>+{r.points}</b></td>
                <td><LinkedText text={r.label} /></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="rc-card">
        <h3 class="rc-h3" style="margin-top:0">City points for a tribe character</h3>
        <p class="rc-fineprint" style="font-style:normal">{conversion.character.cityScoringTribe.note}</p>
        <table class="rc-table rc-table--narrow rc-table--score">
          <tbody>
            {conversion.character.cityScoringTribe.rules.map(r => (
              <tr>
                <td class="rc-num"><b>+{r.points}</b></td>
                <td><LinkedText text={r.label} /></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <h3 class="rc-h3">Role points</h3>
    <p class="rc-fineprint" style="font-style:normal">{conversion.character.roleScoring.note}</p>
    <table class="rc-table rc-table--narrow rc-table--score">
      <tbody>
        {conversion.character.roleScoring.rules.map(r => (
          <tr>
            <td class="rc-num"><b>+{r.points}</b></td>
            <td><LinkedText text={r.label} /></td>
          </tr>
        ))}
      </tbody>
    </table>

    <h3 class="rc-h3">Post-threshold modifiers</h3>
    <p class="rc-fineprint" style="font-style:normal">{conversion.character.postThreshold.note}</p>
    <table class="rc-table rc-table--narrow rc-table--score">
      <tbody>
        {conversion.character.postThreshold.rules.map(r => (
          <tr>
            <td class="rc-num"><b>+{r.points}</b></td>
            <td><LinkedText text={r.label} /></td>
          </tr>
        ))}
      </tbody>
    </table>

    <h3 class="rc-h3">Final tiebreaker</h3>
    <p>{conversion.character.randomization}</p>

    <p class="rc-fineprint">
      Globals (<code>globalsInt.xml</code>): roll probability
      <b>{conversion.globals.characterReligionProb}%</b>; conversion starts turn
      <b>{conversion.globals.characterReligionDelayTurns}</b>; minimum age
      <b>{conversion.globals.tutorsAge}</b>; adulthood at <b>{conversion.globals.adultAge}</b>.
    </p>
  </section>
</Base>

<style>
  .lede {
    color: var(--text-dim);
    font-size: 0.9rem;
    line-height: 1.55;
    max-width: 72ch;
    margin: 0.4rem 0 1.5rem;
  }
  .lede b { color: var(--text); }

  .rc-section { margin-top: 2rem; }
  .rc-h2 {
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    margin: 0 0 0.5rem;
    color: var(--text);
  }
  .rc-h3 {
    font-family: var(--font-display);
    font-size: 0.92rem;
    letter-spacing: 0.03em;
    margin: 0 0 0.4rem;
    color: var(--text);
  }
  .rc-section p {
    color: var(--text-dim);
    font-size: 0.85rem;
    line-height: 1.55;
    max-width: 72ch;
    margin: 0.3rem 0;
  }
  .rc-section p b { color: var(--text); }

  .rc-table {
    width: 100%;
    max-width: 80ch;
    border-collapse: collapse;
    margin: 0.6rem 0;
    font-size: 0.78rem;
  }
  .rc-table--narrow { max-width: 50ch; }
  .rc-table thead th {
    text-align: left;
    color: var(--text-dim);
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    padding: 0.4rem 0.5rem;
    border-bottom: 1px solid var(--border-strong);
  }
  .rc-table tbody td {
    padding: 0.4rem 0.5rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  .rc-table tbody tr:hover { background: var(--bg-elev); }

  .rc-num { text-align: right; font-variant-numeric: tabular-nums; }
  .rc-num.rc-num { font-family: var(--font-mono); }
  .rc-num b { color: var(--text); font-weight: 600; }



  .rc-fineprint {
    color: var(--text-faint) !important;
    font-size: 0.78rem !important;
    line-height: 1.5;
    font-style: italic;
  }

  .rc-twocol {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 0.7rem;
    margin-top: 0.6rem;
  }
  .rc-card {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.7rem 0.9rem;
  }
  .rc-card p { font-size: 0.8rem; margin: 0.3rem 0; }



  code {
    font-family: var(--font-mono);
    font-size: 0.78em;
    background: var(--bg-elev);
    padding: 0 0.25rem;
    border-radius: 3px;
    border: 1px solid var(--border);
  }

  .rc-h3 {
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--text);
    margin: 1rem 0 0.4rem;
    letter-spacing: 0.02em;
  }
  .rc-bullets {
    color: var(--text-dim);
    font-size: 0.82rem;
    line-height: 1.55;
    margin: 0.4rem 0 0.8rem;
    padding-left: 1.2rem;
    max-width: 80ch;
  }
  .rc-bullets li { padding: 0.18rem 0; }

  /* Tighter score tables (Family/Character conversion) */
  .rc-table--score { max-width: 70ch; }
  .rc-table--score tbody td:first-child { width: 5rem; }
  .rc-table--score b { color: var(--accent); font-weight: 700; }
</style>
