---
// Scope is currently Nations-only. The site index redirects there so
// alcaras.github.io/owreference/ doesn't dead-end on an empty landing.
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta http-equiv="refresh" content={`0; url=${base}nations`} />
  <link rel="canonical" href={`${base}nations`} />
  <title>Old World Reference</title>
</head>
<body>
  <p>Redirecting to <a href={`${base}nations`}>Nations</a>…</p>
</body>
</html>
