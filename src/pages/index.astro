---
import Base from '../layouts/Base.astro';
import { TABS, SECTIONS } from '../data/tabs';

const base = import.meta.env.BASE_URL;

const bySection = SECTIONS.map(sec => ({
  name: sec,
  tabs: TABS.filter(t => t.section === sec),
}));

const totals = {
  built: TABS.filter(t => t.status === 'built').length,
  placeholder: TABS.filter(t => t.status === 'placeholder').length,
};
---

<Base
  title="Index"
  active="index"
  pageMark=""
  description="The alcaras spreadsheet, in your browser. Every Old World nation, family, shrine, wonder, tech, law, unit, promotion, and game mechanic — pulled directly from the game's XML and source code, updated each patch."
  pageStats={[
    { label: 'built', value: totals.built },
    { label: 'pending', value: totals.placeholder },
  ]}
>
  {bySection.map(s => (
    <section class="section">
      <h2 class="section__title">{s.name}</h2>
      <ul class="card-grid">
        {s.tabs.map(t => (
          <li class={`card card--${t.status}`}>
            <a href={`${base}${t.slug}`} class="card__link">
              <div class="card__head">
                <span class="card__icon">{t.icon}</span>
                <span class="card__name">{t.label}</span>
              </div>
              <p class="card__desc">{t.summary}</p>
              <span class={`card__status card__status--${t.status}`}>{t.status}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>

<style>
  .section { margin-top: 1.75rem; }
  .section__title {
    margin-bottom: 0.75rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.75rem;
  }
  .card-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0.6rem;
  }
  .card {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 8px;
    transition: border-color 0.15s, transform 0.15s;
    position: relative;
  }
  .card:hover { border-color: var(--border-strong); transform: translateY(-1px); }
  .card--placeholder { border-style: dashed; }
  .card__link {
    display: block;
    padding: 0.85rem 1rem;
    color: var(--text);
    text-decoration: none;
  }
  .card__head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }
  .card__icon { font-size: 1.2rem; line-height: 1; }
  .card__name {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .card__desc {
    margin: 0.15rem 0 0.5rem;
    font-size: 0.82rem;
    color: var(--text-dim);
    line-height: 1.3;
  }
  .card__status {
    position: absolute;
    top: 0.55rem;
    right: 0.7rem;
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    border: 1px solid var(--border);
  }
  .card__status--built {
    color: #4caf7d;
    border-color: rgba(76, 175, 125, 0.4);
    background: rgba(76, 175, 125, 0.08);
  }
  .card__status--placeholder {
    color: var(--text-faint);
    background: var(--bg-elev-2);
  }
</style>
