---
import Base from '../layouts/Base.astro';
import { TABS } from '../data/tabs';

const base = import.meta.env.BASE_URL;

// Group tabs by section, preserving the order sections first appear in
// the catalog. 'skipped' tabs are omitted; 'placeholder' tabs render as
// dimmed, non-clickable cards so the index honestly reflects coverage.
const sectionOrder: string[] = [];
const bySection: Record<string, typeof TABS> = {};
for (const t of TABS) {
  if (t.status === 'skipped') continue;
  if (!bySection[t.section]) { bySection[t.section] = []; sectionOrder.push(t.section); }
  bySection[t.section].push(t);
}
---

<Base
  title="Home"
  active="home"
  description="The Old World Reference — an XML-canonical companion to Mohawk Games' Old World, auto-updated each patch. Nations, families, wonders, laws, technologies, units, promotions, shrines and more, every fact derived straight from the game's own data files."
>
  <section class="hero">
    <p class="hero__eyebrow">Old World</p>
    <h1 class="hero__title">Reference</h1>
    <p class="hero__lede">
      An XML-canonical companion to <a href="https://mohawkgames.com/oldworld/">Mohawk Games' Old World</a>,
      successor to the legacy reference spreadsheet. Every page is a deterministic
      projection of the game's own data files, resynced each patch — so it never
      drifts from what you see in-game.
    </p>
    <div class="hero__cta">
      <a class="hero__btn hero__btn--primary" href={`${base}nations`}>Browse Nations →</a>
      <a class="hero__btn" href="https://github.com/alcaras/owreference">Source on GitHub</a>
    </div>
  </section>

  {sectionOrder.map(section => (
    <section class="catalog">
      <h2 class="catalog__head">{section}</h2>
      <div class="catalog__grid">
        {bySection[section].map(t => (
          t.status === 'built' ? (
            <a class="tcard" href={`${base}${t.slug}`}>
              <span class="tcard__icon" aria-hidden="true">{t.icon}</span>
              <span class="tcard__body">
                <span class="tcard__label">{t.label}</span>
                <span class="tcard__summary">{t.summary}</span>
              </span>
            </a>
          ) : (
            <span class="tcard tcard--soon" title="Not yet built">
              <span class="tcard__icon" aria-hidden="true">{t.icon}</span>
              <span class="tcard__body">
                <span class="tcard__label">{t.label} <span class="tcard__badge">soon</span></span>
                <span class="tcard__summary">{t.summary}</span>
              </span>
            </span>
          )
        ))}
      </div>
    </section>
  ))}
</Base>

<style>
  .hero {
    padding: 2.5rem 0 2rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1.75rem;
  }
  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    color: var(--text-faint);
    margin: 0 0 0.2rem;
  }
  .hero__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--accent);
    margin: 0 0 0.6rem;
    letter-spacing: 0.01em;
  }
  .hero__lede {
    max-width: 60ch;
    color: var(--text-dim);
    line-height: 1.55;
    margin: 0 0 1.25rem;
  }
  .hero__lede a { color: var(--accent); }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .hero__btn {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.95rem;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    color: var(--text);
    text-decoration: none;
    font-size: 0.85rem;
    background: var(--bg-elev);
  }
  .hero__btn:hover { background: var(--bg-elev-2); text-decoration: none; }
  .hero__btn--primary {
    background: color-mix(in srgb, var(--accent) 22%, var(--bg-elev) 78%);
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
    color: var(--text);
  }

  .catalog { margin: 1.75rem 0; }
  .catalog__head {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--text);
    margin: 0 0 0.75rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--border);
  }
  .catalog__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 0.6rem;
  }
  .tcard {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
    padding: 0.7rem 0.8rem;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 7px;
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.12s, background 0.12s;
  }
  a.tcard:hover {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--border));
    background: var(--bg-elev-2);
    text-decoration: none;
  }
  .tcard--soon { opacity: 0.5; cursor: default; }
  .tcard__icon { font-size: 1.15rem; line-height: 1.3; flex-shrink: 0; }
  .tcard__body { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
  .tcard__label {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.92rem;
  }
  .tcard__badge {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    color: var(--text-faint);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 0 0.25rem;
    vertical-align: middle;
  }
  .tcard__summary {
    font-size: 0.76rem;
    color: var(--text-dim);
    line-height: 1.4;
  }
</style>
