---
import Base from '../layouts/Base.astro';
import LinkedText from '../components/LinkedText.astro';
import traitData from '../data/traits.json';
import { classifyYield } from '../lib/entities';
const base = import.meta.env.BASE_URL;

type Trait = typeof traitData.strength[number];

const CATEGORIES: { key: keyof typeof traitData; label: string; blurb: string }[] = [
  { key: 'strength',   label: 'Strengths',   blurb: 'Personality strengths — rolled in childhood or granted by events.' },
  { key: 'weakness',   label: 'Weaknesses',  blurb: 'Personality weaknesses — each replaces its opposing strengths when gained.' },
  { key: 'archetype',  label: 'Archetypes',  blurb: 'The ten leader archetypes (full detail on the Archetypes page).' },
  { key: 'affliction', label: 'Afflictions', blurb: 'Wounds and illnesses — with recovery odds and death risk per mortality setting.' },
  { key: 'item',       label: 'Items',       blurb: 'Heirlooms and artifacts carried as traits, granted by events.' },
  { key: 'status',     label: 'Statuses',    blurb: 'Roles, clergy, story traits and other statuses the game tracks as traits.' },
];

// Trait names referenced by Replaces/Blocks/Leads-to are scan-excluded from the
// global linker (too many common words), so resolve them to their own row anchor
// on this page directly.
const traitSlugByName = new Map<string, string>();
for (const cat of CATEGORIES) for (const t of (traitData[cat.key] as Trait[])) traitSlugByName.set(t.name, t.slug);
const traitAnchor = (name: string) => traitSlugByName.has(name) ? `#${traitSlugByName.get(name)}` : null;

const RATINGS = ['Wisdom', 'Charisma', 'Courage', 'Discipline'] as const;
const RATING_TONE: Record<string, string> = {
  Wisdom:     'yield-science',
  Charisma:   'yield-civics',
  Courage:    'yield-training',
  Discipline: 'yield-orders',
};

function ratingsFor(t: Trait, r: string) {
  return t.ratings.filter(x => x.rating === r);
}

const allTraits: Trait[] = CATEGORIES.flatMap(c => traitData[c.key] as Trait[]);
const dynastyCount = allTraits.filter(t => (t as any).dynastyOf).length;

// Source facet: base game + each DLC/pack present, ordered biggest-first
// (base always leads). Each trait carries `source` from build_traits.py.
const SOURCE_ORDER = [
  'Base game', 'Empires of the Indus', 'Wonders & Dynasties',
  'The Sacred and the Profane', 'Religion event pack', 'Behind the Throne', 'Wrath of Gods',
];
const sourceCounts = new Map<string, number>();
for (const t of allTraits) {
  const s = (t as any).source || 'Base game';
  sourceCounts.set(s, (sourceCounts.get(s) || 0) + 1);
}
const SOURCES = [...sourceCounts.keys()].sort(
  (a, b) => (SOURCE_ORDER.indexOf(a) + 1 || 99) - (SOURCE_ORDER.indexOf(b) + 1 || 99));
const sourceSlug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const searchBlobs: Record<string, string> = {};
for (const t of allTraits) searchBlobs[t.slug] = JSON.stringify(t).toLowerCase();

const EFFECT_GROUPS: { key: 'leaderEffects' | 'governorEffects' | 'generalEffects'; label: string }[] = [
  { key: 'leaderEffects',   label: 'Leader' },
  { key: 'governorEffects', label: 'Governor' },
  { key: 'generalEffects',  label: 'General' },
];
---

<Base title="Traits" active="traits" pageMark="🎭" pageStats={[
  { label: 'traits',     value: allTraits.length },
  { label: 'strengths',  value: traitData.strength.length },
  { label: 'weaknesses', value: traitData.weakness.length },
  { label: 'items',      value: traitData.item.length },
]}>
  <p class="traits-intro">
    Every character trait in <code>trait.xml</code>, grouped the way the game flags
    them. Rating columns show the trait's Wisdom / Charisma / Courage / Discipline
    contribution (° marks a fallback value, used when the rating isn't already set).
    Most traits are granted by events; the Acquired column lists only what the XML
    states directly — minimum age, the childhood adjective and injury rolls, recovery
    odds. Which child traits a parent can pass on lives on
    <a href={`${base}trait-inheritance`}>Trait Inheritance</a>; the ten archetypes are
    detailed on <a href={`${base}archetypes`}>Archetypes</a>.
  </p>

  <div class="tfilter" id="tfilter">
    <div class="tfilter__row">
      <span class="tfilter__label">Category</span>
      <div class="tfilter__chips">
        {CATEGORIES.map(cat => (
          <button type="button" class="fchip is-on" data-facet="cat" data-val={cat.key} aria-pressed="true">
            {cat.label}<span class="fchip__n">{(traitData[cat.key] as Trait[]).length}</span>
          </button>
        ))}
      </div>
    </div>
    <div class="tfilter__row">
      <span class="tfilter__label">Source</span>
      <div class="tfilter__chips">
        {SOURCES.map(s => (
          <button type="button" class="fchip is-on" data-facet="src" data-val={sourceSlug(s)} aria-pressed="true">
            {s === 'Base game' ? 'Base game' : s}<span class="fchip__n">{sourceCounts.get(s)}</span>
          </button>
        ))}
      </div>
    </div>
    <div class="tfilter__row">
      <span class="tfilter__label">Options</span>
      <div class="tfilter__chips">
        <button type="button" class="dyn-toggle" id="dyn-toggle" aria-pressed="false"
          title="Character-kit traits tied to one historical leader (Wonders & Dynasties dynasty kits and scenario leaders) — marked with a 👑 name tag below">
          <span class="dyn-toggle__box" aria-hidden="true"></span>
          Hide dynasty traits <span class="dyn-toggle__count">({dynastyCount})</span>
        </button>
        <button type="button" class="tfilter__reset" id="tfilter-reset">Reset</button>
        <span class="tfilter__count" id="tfilter-count" aria-live="polite"></span>
      </div>
    </div>
  </div>

  <div id="traits-grid">
    {CATEGORIES.map(cat => {
      const list = traitData[cat.key] as Trait[];
      return (
        <section class="tcat" data-cat={cat.key} id={cat.key}>
          <h2 class="tcat__title">
            <span class="tcat__name">{cat.label}</span>
            <span class="tcat__count">{list.length} traits</span>
          </h2>
          <p class="tcat__blurb">{cat.blurb}</p>
          <div class="grid__scroll">
            <table class="ntbl">
              <thead>
                <tr>
                  <th class="rowlabel rowlabel--corner">Trait</th>
                  {RATINGS.map(r => (
                    <th class="nhdr nhdr--family nhdr--rating" title={r}>
                      <img class="rating-hdr-ico" src={`${base}img/icons/ratings/${r.toLowerCase()}.png`} alt={r} />
                    </th>
                  ))}
                  <th class="nhdr nhdr--family">Effects</th>
                  <th class="nhdr nhdr--family">Opinions</th>
                  <th class="nhdr nhdr--family">Replaces / Blocks</th>
                  <th class="nhdr nhdr--family">Modifiers &amp; Flags</th>
                  <th class="nhdr nhdr--family">Acquired</th>
                </tr>
              </thead>
              <tbody>
                {list.map(t => {
                  const hasEffects = t.leaderEffects.length || t.governorEffects.length || t.generalEffects.length;
                  const hasRel = t.replaces.length || t.blocks.length || t.leadsTo.length;
                  const hasMods = t.modifiers.length || t.flags.length;
                  return (
                    <tr data-trait={t.slug} id={t.slug} data-cat={cat.key}
                        data-source={sourceSlug((t as any).source || 'Base game')}
                        data-dynasty={(t as any).dynastyOf ? '1' : undefined}>
                      <th class="rowlabel" scope="row">
                        <span class="trait__name" title={t.description || undefined}>{t.name}</span>
                        {t.religion && <span class="trait__sub">{t.religion}</span>}
                        {t.dlc && <span class="trait__dlc">{t.dlc}</span>}
                        {(t as any).dynastyOf && (
                          <span class="trait__dlc trait__dyn" title={`Character-kit trait of ${(t as any).dynastyOf}`}>👑 {(t as any).dynastyOf}</span>
                        )}
                      </th>
                      {RATINGS.map(r => {
                        const vals = ratingsFor(t, r);
                        return vals.length ? (
                          <td class={`cell cell--rating ${RATING_TONE[r]}`}>
                            {vals.map(v => (
                              <span
                                class={`rt ${v.value >= 0 ? 'rt--pos' : 'rt--neg'}`}
                                title={v.fallback ? 'Fallback rating — applies when the rating is not set another way' : undefined}
                              >{v.value > 0 ? `+${v.value}` : `−${-v.value}`}{v.fallback ? '°' : ''}</span>
                            ))}
                          </td>
                        ) : (
                          <td class="cell cell--rating is-empty"><span class="cell__dash">—</span></td>
                        );
                      })}
                      <td class={`cell cell--effects ${hasEffects ? '' : 'is-empty'}`}>
                        {hasEffects ? (
                          <div class="fxstack">
                            {EFFECT_GROUPS.map(g =>
                              (t[g.key] as string[]).map(line => {
                                const yieldKey = classifyYield(line)?.toLowerCase() || 'misc';
                                return (
                                  <div class={`effect yield-${yieldKey}`}>
                                    <span class="effect__role">{g.label}</span>
                                    <LinkedText text={line} showIcons={false} iconsForYields={true} />
                                  </div>
                                );
                              })
                            )}
                          </div>
                        ) : <span class="cell__dash">—</span>}
                      </td>
                      <td class={`cell ${t.opinions.length ? 'yield-legitimacy' : 'is-empty'}`}>
                        {t.opinions.length ? (
                          <ul class="modlist">
                            {t.opinions.map(o => (
                              <li>
                                <span class="modlist__label">{o.label}</span>
                                <span class={`num ${o.value >= 0 ? 'num--pos' : 'num--neg'}`}>
                                  {o.value >= 0 ? '+' : ''}{o.value}
                                </span>
                              </li>
                            ))}
                          </ul>
                        ) : <span class="cell__dash">—</span>}
                      </td>
                      <td class={`cell ${hasRel ? 'yield-maintenance' : 'is-empty'}`}>
                        {hasRel ? (
                          <div class="chiplist">
                            {t.replaces.map(o => <span class="chip chip--neutral" title="Replaces (overwrites) this trait">⇄ {traitAnchor(o) ? <a href={traitAnchor(o)}>{o}</a> : o}</span>)}
                            {t.blocks.map(o => <span class="chip chip--neutral chip--blocked" title="Cannot coexist with this trait">⊘ {traitAnchor(o) ? <a href={traitAnchor(o)}>{o}</a> : o}</span>)}
                            {t.leadsTo.map(o => <span class="chip chip--neutral chip--leads" title="May progress to this trait">→ {traitAnchor(o.name) ? <a href={traitAnchor(o.name)}>{o.name}</a> : o.name} {o.prob}%</span>)}
                          </div>
                        ) : <span class="cell__dash">—</span>}
                      </td>
                      <td class={`cell ${hasMods ? 'yield-misc' : 'is-empty'}`}>
                        {hasMods ? (
                          <div class="modwrap">
                            {t.modifiers.length > 0 && (
                              <ul class="modlist">
                                {t.modifiers.map(m => (
                                  <li>
                                    <span class="modlist__label">{m.label}</span>
                                    <span class={`num ${m.value >= 0 ? 'num--pos' : 'num--neg'}`}>
                                      {m.value >= 0 ? '+' : ''}{m.value}%
                                    </span>
                                  </li>
                                ))}
                              </ul>
                            )}
                            {t.flags.length > 0 && (
                              <div class="chiplist">
                                {t.flags.map(f => <span class="chip chip--neutral chip--flag">{f}</span>)}
                              </div>
                            )}
                          </div>
                        ) : <span class="cell__dash">—</span>}
                      </td>
                      <td class={`cell ${t.acquisition.length ? 'yield-misc' : 'is-empty'}`}>
                        {t.acquisition.length ? (
                          <ul class="acqlist">
                            {t.acquisition.map(a => <li>{a}</li>)}
                          </ul>
                        ) : <span class="cell__dash">—</span>}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>
      );
    })}
  </div>

  <script type="application/json" id="traits-search-blobs" set:html={JSON.stringify(searchBlobs)}></script>
  <script is:inline>
    (function () {
      const input = document.getElementById('site-search');
      const grid = document.getElementById('traits-grid');
      const blobNode = document.getElementById('traits-search-blobs');
      const dynBtn = document.getElementById('dyn-toggle');
      const resetBtn = document.getElementById('tfilter-reset');
      const countEl = document.getElementById('tfilter-count');
      const facetBtns = Array.from(document.querySelectorAll('.fchip'));
      if (!input || !grid || !blobNode) return;
      let blobs;
      try { blobs = JSON.parse(blobNode.textContent || '{}'); } catch { return; }
      let hideDyn = false;

      // Active facet sets: a row must match one of the ON values in EACH facet
      // that has any chips. An empty set (all off) hides everything in that facet.
      function activeSet(facet) {
        const on = new Set();
        for (const b of facetBtns)
          if (b.getAttribute('data-facet') === facet && b.classList.contains('is-on'))
            on.add(b.getAttribute('data-val'));
        return on;
      }

      const rows = Array.from(grid.querySelectorAll('tbody tr[data-trait]'));
      function apply() {
        const q = (input.value || '').trim().toLowerCase();
        const cats = activeSet('cat');
        const srcs = activeSet('src');
        let shown = 0;
        for (const el of rows) {
          const slug = el.getAttribute('data-trait');
          const okSearch = !q || (blobs[slug] || '').includes(q);
          const okCat = cats.has(el.getAttribute('data-cat'));
          const okSrc = srcs.has(el.getAttribute('data-source'));
          const okDyn = !(hideDyn && el.hasAttribute('data-dynasty'));
          const show = okSearch && okCat && okSrc && okDyn;
          el.classList.toggle('is-hidden', !show);
          if (show) shown++;
        }
        for (const sec of grid.querySelectorAll('.tcat')) {
          const visible = sec.querySelectorAll('tbody tr:not(.is-hidden)').length;
          sec.classList.toggle('is-hidden', visible === 0);
        }
        if (countEl) countEl.textContent = shown + ' of ' + rows.length + ' traits';
      }

      // ── Shareable URL state ──────────────────────────────────────────────
      // Only OFF facets and active options are encoded, so the default view
      // stays a clean paramless URL. cat=/src= list the HIDDEN values.
      function offList(facet) {
        return facetBtns.filter(b => b.getAttribute('data-facet') === facet && !b.classList.contains('is-on'))
          .map(b => b.getAttribute('data-val'));
      }
      function writeURL() {
        const p = new URLSearchParams();
        const offCat = offList('cat'), offSrc = offList('src');
        if (offCat.length) p.set('hidecat', offCat.join(','));
        if (offSrc.length) p.set('hidesrc', offSrc.join(','));
        if (hideDyn) p.set('hidedyn', '1');
        const q = p.toString();
        history.replaceState(null, '', q ? '?' + q + location.hash : location.pathname + location.hash);
      }
      function readURL() {
        const p = new URLSearchParams(location.search);
        const setOff = (facet, csv) => {
          const off = new Set((csv || '').split(',').filter(Boolean));
          for (const b of facetBtns) if (b.getAttribute('data-facet') === facet) {
            const on = !off.has(b.getAttribute('data-val'));
            b.classList.toggle('is-on', on);
            b.setAttribute('aria-pressed', String(on));
          }
        };
        setOff('cat', p.get('hidecat'));
        setOff('src', p.get('hidesrc'));
        hideDyn = p.get('hidedyn') === '1';
        if (dynBtn) { dynBtn.classList.toggle('is-on', hideDyn); dynBtn.setAttribute('aria-pressed', String(hideDyn)); }
      }

      for (const b of facetBtns) b.addEventListener('click', () => {
        const on = b.classList.toggle('is-on');
        b.setAttribute('aria-pressed', String(on));
        writeURL(); apply();
      });
      if (dynBtn) dynBtn.addEventListener('click', () => {
        hideDyn = !hideDyn;
        dynBtn.setAttribute('aria-pressed', String(hideDyn));
        dynBtn.classList.toggle('is-on', hideDyn);
        writeURL(); apply();
      });
      if (resetBtn) resetBtn.addEventListener('click', () => {
        for (const b of facetBtns) { b.classList.add('is-on'); b.setAttribute('aria-pressed', 'true'); }
        hideDyn = false;
        if (dynBtn) { dynBtn.classList.remove('is-on'); dynBtn.setAttribute('aria-pressed', 'false'); }
        input.value = '';
        writeURL(); apply();
      });
      input.addEventListener('input', apply);
      readURL();
      apply();
    })();
  </script>
</Base>

<style>
  .traits-intro {
    max-width: 860px;
    color: var(--text-dim);
    font-size: 0.86rem;
    margin: 0 0 1rem;
    line-height: 1.55;
  }
  .traits-intro code {
    background: var(--bg-elev);
    padding: 0.05rem 0.4rem;
    border-radius: 3px;
    border: 1px solid var(--border);
  }

  .tcat { margin: 1.6rem 0; }
  .tcat__title {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0 0 0.2rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 25%, var(--border));
    padding-bottom: 0.35rem;
    color: var(--text);
  }
  .tcat__count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-faint);
    font-weight: 400;
  }
  .tcat__blurb {
    margin: 0.25rem 0 0.6rem;
    color: var(--text-dim);
    font-size: 0.78rem;
  }

  .ntbl .rowlabel { min-width: 8rem; }
  .nhdr--rating { min-width: 2.4rem; }
  .rating-hdr-ico { width: 18px; height: 18px; object-fit: contain; vertical-align: middle; }

  .trait__name {
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: 0.02em;
    display: block;
  }
  .trait__sub {
    display: block;
    font-style: italic;
    font-size: 0.68rem;
    color: var(--text-dim);
  }
  .trait__dlc {
    display: inline-block;
    margin-top: 0.18rem;
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.05em;
    color: var(--text-faint);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.02rem 0.3rem;
  }
  .trait__dyn {
    color: var(--text-dim);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
  }

  /* Faceted filter bar */
  .tfilter {
    display: flex; flex-direction: column; gap: 0.5rem;
    border: 1px solid var(--border-strong); border-radius: 10px;
    background: var(--bg-elev); padding: 0.7rem 0.85rem; margin: 0 0 1.25rem;
  }
  .tfilter__row { display: flex; align-items: flex-start; gap: 0.7rem; flex-wrap: wrap; }
  .tfilter__label {
    font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--text-faint);
    min-width: 4.2rem; padding-top: 0.32rem; flex: none;
  }
  .tfilter__chips { display: flex; flex-wrap: wrap; gap: 0.35rem; align-items: center; }
  .fchip {
    display: inline-flex; align-items: center; gap: 0.35rem;
    font-family: var(--font-display); font-size: 0.76rem; letter-spacing: 0.02em;
    color: var(--text-faint); background: var(--bg);
    border: 1px solid var(--border); border-radius: 999px;
    padding: 0.25rem 0.65rem; cursor: pointer; transition: all 0.12s;
  }
  .fchip:hover { color: var(--text-dim); border-color: var(--border-strong); }
  .fchip.is-on {
    color: var(--text); background: color-mix(in srgb, var(--accent) 22%, var(--bg-elev) 78%);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .fchip:not(.is-on) { opacity: 0.55; text-decoration: line-through; text-decoration-color: color-mix(in srgb, currentColor 50%, transparent); }
  .fchip__n { font-family: var(--font-mono); font-size: 0.62rem; color: var(--text-faint); }
  .fchip.is-on .fchip__n { color: color-mix(in srgb, var(--accent) 80%, var(--text)); }
  .tfilter__reset {
    font-family: var(--font-display); font-size: 0.74rem; color: var(--text-dim);
    background: none; border: 1px solid var(--border); border-radius: 999px;
    padding: 0.25rem 0.7rem; cursor: pointer; transition: color 0.12s, border-color 0.12s;
  }
  .tfilter__reset:hover { color: var(--text); border-color: var(--border-strong); }
  .tfilter__count { font-family: var(--font-mono); font-size: 0.68rem; color: var(--text-faint); margin-left: 0.2rem; }

  /* Dynasty-trait toggle */
  .dyn-toggle {
    display: inline-flex; align-items: center; gap: 0.45rem;
    font-family: var(--font-display); font-size: 0.76rem; letter-spacing: 0.02em;
    color: var(--text-dim); background: var(--bg);
    border: 1px solid var(--border-strong); border-radius: 999px;
    padding: 0.25rem 0.7rem; cursor: pointer;
    transition: background 0.12s, color 0.12s;
  }
  .dyn-toggle:hover { color: var(--text); }
  .dyn-toggle.is-on { background: color-mix(in srgb, var(--accent) 28%, var(--bg-elev) 72%); color: var(--text); }
  .dyn-toggle__box {
    width: 0.85rem; height: 0.85rem; border: 1px solid var(--border-strong);
    border-radius: 4px; background: var(--bg); position: relative; flex: none;
  }
  .dyn-toggle.is-on .dyn-toggle__box { background: var(--accent); border-color: var(--accent); }
  .dyn-toggle.is-on .dyn-toggle__box::after {
    content: '✓'; position: absolute; inset: 0; display: grid; place-items: center;
    font-size: 0.62rem; color: var(--bg); font-weight: 700;
  }
  .dyn-toggle__count { font-family: var(--font-mono); font-size: 0.68rem; color: var(--text-faint); }

  .cell--rating {
    text-align: center;
    white-space: nowrap;
  }
  .rt {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    font-size: 0.82rem;
  }
  .rt + .rt { margin-left: 0.3rem; }
  .rt--neg { opacity: 0.85; }

  .cell--effects { min-width: 16rem; }
  .fxstack {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .fxstack .effect {
    background: var(--yield-bg, var(--bg-elev-2));
    color: var(--yield-fg, var(--text));
    background-image: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(0,0,0,0.20) 60%, rgba(0,0,0,0.32));
    padding: 0.2rem 0.45rem;
    border-radius: 4px;
    font-size: 0.7rem;
    line-height: 1.25;
    border: 1px solid color-mix(in srgb, var(--yield-bg, var(--border)) 50%, #000 50%);
  }
  .effect__role {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.75;
    margin-right: 0.35rem;
