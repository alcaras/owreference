---
import Base from '../layouts/Base.astro';
import UnitsTable from '../components/UnitsTable.astro';
import allUnits from '../data/units.json';

// Fighting units from the standard roster — Infantry, Polearm, Mounted, Ranged,
// Siege and Ship. The split is `isMilitary` (the game's UNITCYCLE_MILITARY_*
// classification); support units (Scouts, Disciples, Workers…) live on
// /civilian-units. Both draw from the same units.json `normal` category.
const units = (allUnits as any[]).filter(u => u.category === 'normal' && u.isMilitary && u.production > 0);
---

<Base
  title="Military Units"
  active="military-units"
  pageMark="⚔️"
  description={`The ${units.length} fighting units of Old World any nation can build — Infantry, Polearm, Mounted, Ranged, Siege and Ship classes. Each row shows Strength, Movement, Range, training cost, material cost, upkeep, tech prerequisite and combat counters, all derived from the game's unit.xml. Civilian and support units (Scouts, Disciples, Workers) are listed separately.`}
>
  <UnitsTable units={units} heading="Military Units" noun="military units" />
</Base>
