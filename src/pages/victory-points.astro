---
import Base from '../layouts/Base.astro';
import D from '../data/victory_points.json';

const base = import.meta.env.BASE_URL;

const wonders = D.improvements.filter((i: any) => i.wonder);
const holySites = D.improvements.filter((i: any) => i.holyCity);
const otherImps = D.improvements.filter((i: any) => !i.wonder && !i.holyCity);
const contents = Object.entries(D.contents) as [string, any][];
const contentCounts = (c: string) => ({
  wonders: wonders.filter((i: any) => i.content === c).length,
  holy: holySites.filter((i: any) => i.content === c).length,
  projects: D.projects.filter((p: any) => p.content === c).length,
});
// Multiplayer tournament setup: duel, High (+25%), all content. The game's own
// single-player default is Normal.
const TOURNAMENT = { players: 2, teams: 2, option: 'VICTORYPOINT_MEDIUM_HIGH', sites: 16 };
const culturesTotalVP = D.cultures.reduce((s: number, c: any) => s + c.vp, 0);

// Grounding (kept off the page): Game.cs getVPToWin / getVPToWinByVictory; the
// wonder cap is finishMapPlacement disabling all but AVAILABLE_WONDERS, which
// getVPToWin then skips. Wonder VP is EffectPlayer.iVP; holy sites are held at
// one by the religion prereq (iMaxCities 1) and iMaxPlayerCount 1. Victory Point
// option is utils().modify(vp, iModifier) from victoryPoint.xml, applied last.
// All divisions are C# integer divisions. Tech VPs score via meSourceTech; the
// pool skips NationPrereq / DynastyPrereq entries. VICTORY_POINTS 100%;
// VICTORY_DOUBLE iPercentVP 50, iOpponentMaxPointPercent 200. Constants from
// globalsInt.xml, culture.xml, victoryPoint.xml, victory.xml; VP carriers from
// improvement.xml and project.xml.
---

<Base
  title="Victory Point Target"
  active="victory-points"
  pageMark="🏆"
  pageStats={[
    { label: 'holy sites', value: holySites.length },
    { label: 'VP options', value: D.victoryPointOptions.length },
  ]}
>
  <p class="lede">
    How many <strong>Victory Points</strong> you need to win a game. The target depends on the
    <b>number of city sites on the map</b>, the number of players and teams, and the
    <b>Victory Point</b> setup option.
  </p>
  <p class="lede">
    Set up your game below (the defaults are the tournament duel at High) and read the row for
    your map. The breakdown shows where each point comes from.
  </p>

  <section class="asm">
    <div class="asm__row">
      <span class="asm__tag">Game</span>
      <div class="asm__fields">
        <label class="f"><span>Players <i>humans and AI</i></span>
          <input type="number" id="v-players" value={TOURNAMENT.players} min="1" max="12" step="1" /></label>
        <label class="f"><span>Teams</span>
          <input type="number" id="v-teams" value={TOURNAMENT.teams} min="1" max="12" step="1" /></label>
        <label class="f f--sel"><span>Victory Points <i>game setup</i></span>
          <select id="v-option">
            {D.victoryPointOptions.map((o: any) => (
              <option value={o.id} selected={o.id === TOURNAMENT.option}>
                {o.name} ({o.modifier >= 0 ? '+' : ''}{o.modifier}%)
              </option>
            ))}
          </select>
        </label>
        <label class="f--chk"><input type="checkbox" id="v-characters" checked />
          <span>Characters on <i>untick for the No Characters mode</i></span></label>
      </div>
    </div>
    <div class="asm__row">
      <span class="asm__tag">Content</span>
      <div class="asm__fields">
        {contents.map(([c, info]) => {
          const n = contentCounts(c);
          const bits = [
            n.wonders ? `${n.wonders} wonders` : '',
            n.holy ? `${n.holy} holy site${n.holy > 1 ? 's' : ''}` : '',
            n.projects ? `${n.projects} project${n.projects > 1 ? 's' : ''}` : '',
          ].filter(Boolean).join(' · ');
          return (
            <label class="f--chk"><input type="checkbox" class="v-content" data-content={c} checked />
              <span>{info.dlcName} <i>{bits}</i></span></label>
          );
        })}
      </div>
    </div>
    <div class="asm__row">
      <span class="asm__tag">Your map</span>
      <div class="asm__fields">
        <label class="f"><span>City sites <i>whole map, all nations</i></span>
          <input type="number" id="v-sites" value={TOURNAMENT.sites} min="1" max="80" step="1" /></label>
        <button type="button" class="asm__reset" id="v-reset">Tournament defaults</button>
      </div>
    </div>
  </section>

  <div id="v-sum" class="sum"></div>

  <section class="brk" id="v-brk"></section>

  <div class="grid">
    <div class="grid__scroll">
      <table class="ntbl vp">
        <thead>
          <tr>
            <th class="rowlabel rowlabel--corner">City sites</th>
            <th class="nhdr nhdr--num">Pool<span class="vp__hdnote">before scaling</span></th>
            <th class="nhdr nhdr--num">Base<span class="vp__hdnote">teams and players</span></th>
            {D.victoryPointOptions.map((o: any) => (
              <th class="nhdr nhdr--num vp__opt" data-option={o.id}>
                {o.name}<span class="vp__hdnote">{o.modifier >= 0 ? '+' : ''}{o.modifier}%</span>
              </th>
            ))}
            <th class="nhdr nhdr--num vp__dcol">Double<span class="vp__hdnote">½ of target</span></th>
          </tr>
        </thead>
        <tbody id="v-body"></tbody>
      </table>
    </div>
  </div>

  <section class="rates">
    <h2 class="rates__h">How the target is worked out</h2>
    <div class="rates__cols">
      <div>
        <h3>The pool <span class="tag">per map</span></h3>
        <ul>
          <li><b>Culture</b> adds sites × VP ÷ {D.cultures.length} for each of the
            {D.cultures.length} culture levels
            ({D.cultures.map((c: any) => `${c.name} ${c.vp}`).join(', ')}), each rounded down on its
            own. That is roughly {culturesTotalVP}/{D.cultures.length} VP per site; because of the
            rounding, 13 sites give 31 rather than 30. With <b>No Characters</b> it divides by
            {D.cultures.length + 1} instead.</li>
          <li><b>Wonders</b> count {wonders[0].vp} VP each. Only
            <b>{D.globals.AVAILABLE_WONDERS}</b> of the {wonders.length} wonders your content enables
            stay available after the map is made, so the wonder share is
            {D.globals.AVAILABLE_WONDERS} × {wonders[0].vp} whatever DLC you own, unless you have too
            few wonders enabled to reach that cap.</li>
          <li><b>Holy sites</b>, one per religion
            ({holySites.map((h: any) => h.name).join(', ')}), count once each.</li>
          <li><b>Projects</b> that carry VP count once per four sites, or at most once per player
            when the project is unique. Today that is only
            <b>{D.projects.map((p: any) => p.name).join(', ')}</b>
            ({D.projects.map((p: any) => `${p.vp} VP, ${D.contents[p.content]?.dlcName}`).join(', ')}),
            the extra point per four sites you see when Behind the Throne is on.</li>
          {otherImps.length ? <li><b>Other improvements</b> that carry VP ({otherImps.map((i: any) => i.name).join(', ')})
            count up to their limits per city, family and player.</li> : null}
        </ul>
      </div>
      <div>
        <h3>The scaling</h3>
        <ul>
          <li><b>Teams:</b> pool × 6 ÷ (3 + teams). Two teams keep 6/5 of the pool, three keep
            the pool, and six keep two thirds.</li>
          <li><b>Players:</b> a game with <b>exactly two players</b> needs 40% of that (× 2 ÷ 5);
            every other game needs 50%.</li>
          <li><b>The Victory Point option</b> applies last:
            {D.victoryPointOptions.map((o: any, i: number) => (
              <span>{o.name} {o.modifier >= 0 ? '+' : ''}{o.modifier}%{i < D.victoryPointOptions.length - 1 ? ', ' : ''}</span>
            ))}.</li>
          <li>Every step rounds down, so the order matters. The table follows it from Pool to Base
            to the option.</li>
        </ul>
      </div>
      <div>
        <h3>What the target does not count</h3>
        <ul>
          <li><b>Tech VPs.</b> The VP techs at the end of the tree add to your score but not to
            the target.</li>
          <li><b>Legendary steps.</b> Each culture step past Legendary is +1 VP for the city, but
            the pool counts only one Legendary per site, so more VP is available than the pool
            assumes.</li>
          <li><b>Nation and dynasty wonders</b> are skipped. No current wonder is one.</li>
          {D.skippedImprovements.map((i: any) => (
            <li><b>{i.name}</b> carries {i.vp} VP but is {i.reason}, so the pool leaves it
              out.</li>
          ))}
        </ul>
      </div>
      <div>
        <h3>How to read the result</h3>
        <ul>
          <li><b>Points victory</b> goes to the first team to reach the target.</li>
          <li><b>Double victory</b> needs half the target, rounded half up, <i>and</i> twice every
            opponent's VP. The last column shows the first condition; the second changes every
            turn.</li>
          <li>City sites means every site on the map, occupied or free, not just yours.</li>
          <li>The score panel tooltip shows the real target. If it differs from this page, your
            site count or a setting is different.</li>
        </ul>
      </div>
    </div>
    <p class="fine">
      See <a href={`${base}ambitions`}>Ambitions</a> for the victory conditions themselves.
    </p>
  </section>
</Base>

<script is:inline define:vars={{ D, TOURNAMENT }}>
  (() => {
    const $ = (id) => document.getElementById(id);
    const G = D.globals;
    const idiv = (a, b) => Math.trunc(a / b);

    // Utils.cs modify — integer, floors toward zero like C#.
    const modify = (v, m) => {
      if (v === 0 || m === 0) return v;
      const mult = Math.max(0, m + 100);
      return idiv(v * mult, 100);
    };

    function setup() {
      const players = Math.max(1, +$('v-players').value || 1);
      const teams = Math.max(1, Math.min(players, +$('v-teams').value || 1));
      if (+$('v-teams').value !== teams) $('v-teams').value = teams;
      const enabled = new Set([...document.querySelectorAll('.v-content')]
        .filter((c) => c.checked).map((c) => c.dataset.content));
      const opt = D.victoryPointOptions.find((o) => o.id === $('v-option').value) || D.victoryPointOptions[0];
      return { players, teams, characters: $('v-characters').checked, enabled, opt };
    }
    const hasContent = (s, c) => !c || s.enabled.has(c);

    // Game.cs getVPToWin, up to (not including) the victoryPoint modifier.
    // Returns the pool and the scaled base plus a per-source breakdown.
    function pool(sites, s) {
      const parts = [];
      let culture = 0;
      const div = D.cultures.length + (s.characters ? 0 : 1);
      for (const c of D.cultures) {
        const v = idiv(sites * c.vp, div);
        culture += v;
        parts.push({ kind: 'culture', name: c.name, n: v, vp: 1, total: v, note: `${sites} × ${c.vp} ÷ ${div}` });
      }

      // finishMapPlacement: only AVAILABLE_WONDERS of the content-enabled
      // wonders stay buildable; getVPToWin skips the disabled ones.
      const wondersOn = D.improvements.filter((i) => i.wonder && hasContent(s, i.content));
      const wonderSlots = G.NO_WONDERS === 1 ? 0 : Math.min(wondersOn.length, G.AVAILABLE_WONDERS);
      let imps = 0;
      const wonderVP = wondersOn.length ? wondersOn[0].vp : 0;
      // Every wonder is worth the same today; if a patch differentiates them
      // the cap picks by random draw, so sum a representative value.
      const perWonder = wondersOn.length ? Math.round(wondersOn.reduce((a, i) => a + i.vp, 0) / wondersOn.length) : 0;
      const wonderTotal = wonderSlots * perWonder;
      imps += wonderTotal;
      parts.push({ kind: 'wonders', name: 'Wonders', n: wonderSlots, vp: perWonder, total: wonderTotal,
        note: `${wondersOn.length} enabled, cap ${G.AVAILABLE_WONDERS}` });

      for (const i of D.improvements) {
        if (i.wonder || !hasContent(s, i.content)) continue;
        let maxNumber = sites * 12;
        let maxCities = sites;
        let maxPlayers = s.players;
        let maxFamilies = s.players * G.MAX_FAMILIES;
        if (i.holyCity) {
          maxCities = i.religionPrereq ? 1 : D.religionsNum;
          maxPlayers = Math.min(maxCities, maxPlayers);
          maxFamilies = Math.min(maxCities, maxFamilies);
        }
        if (i.maxPlayerCount > 0) maxNumber = Math.min(maxNumber, i.maxPlayerCount * maxPlayers);
        if (i.maxFamilyCount > 0) maxNumber = Math.min(maxNumber, i.maxFamilyCount * maxFamilies);
        if (i.maxCityCount > 0) maxNumber = Math.min(maxNumber, i.maxCityCount * maxCities);
        if (i.classMaxCityCount > 0) maxNumber = Math.min(maxNumber, i.classMaxCityCount * maxCities);
        if (i.classMaxCultureCount > 0) maxNumber = Math.min(maxNumber, idiv(i.classMaxCultureCount * maxCities * D.cultures.length, 2));
        imps += maxNumber * i.vp;
        parts.push({ kind: i.holyCity ? 'holy' : 'imp', name: i.name, n: maxNumber, vp: i.vp, total: maxNumber * i.vp });
      }

      let projects = 0;
      for (const p of D.projects) {
        if (!hasContent(s, p.content)) continue;
        let maxProjects = idiv(sites, 4);
        if (p.unique) maxProjects = Math.min(maxProjects, s.players);
        projects += maxProjects * p.vp;
        parts.push({ kind: 'project', name: p.name, n: maxProjects, vp: p.vp, total: maxProjects * p.vp,
          note: p.unique ? `${sites} ÷ 4, at most one per player` : `${sites} ÷ 4` });
      }

      const total = culture + imps + projects;
      let vp = idiv(total * (3 + 3), 3 + s.teams);
      const teamScaled = vp;
      if (s.players === 2) vp = idiv(vp * 2, 5); else vp = idiv(vp, 2);
      return { parts, culture, imps, projects, total, teamScaled, base: vp };
    }

    const target = (basev, opt) => modify(basev, opt.modifier);
    // getVPToWinByVictory: (vp × percent + 50) ÷ 100
    const byVictory = (vp, v) => idiv(vp * v.percentVP + 50, 100);
    const doubleV = D.victories.find((v) => v.id === 'VICTORY_DOUBLE');

    function render() {
      const s = setup();
      const sites = Math.max(1, +$('v-sites').value || 1);
      const r = pool(sites, s);
      const vp = target(r.base, s.opt);

      document.querySelectorAll('.vp__opt').forEach((th) => th.classList.toggle('is-on', th.dataset.option === s.opt.id));

      $('v-sum').innerHTML = [
        `<span><b>${vp}</b> VP to win<i>${sites} city sites · ${s.players} players · ${s.teams} team${s.teams > 1 ? 's' : ''} · ${s.opt.name}</i></span>`,
        `<span><b>${r.total}</b> in the pool<i>${r.culture} culture · ${r.imps} improvements · ${r.projects} projects</i></span>`,
        `<span><b>${r.base}</b> after scaling<i>× 6 ÷ ${3 + s.teams} teams = ${r.teamScaled}, then ${s.players === 2 ? '× 2 ÷ 5 (duel)' : '÷ 2'}</i></span>`,
        doubleV ? `<span><b>${byVictory(vp, doubleV)}</b> for a Double victory<i>and ${doubleV.opponentMaxPointPercent}% of any opponent</i></span>` : '',
      ].join('');

      const groups = [
        ['culture', 'Culture', 'one of each level per site'],
        ['wonders', 'Wonders', ''],
        ['holy', 'Holy sites', 'one each'],
        ['imp', 'Improvements', ''],
        ['project', 'Projects', ''],
      ];
      $('v-brk').innerHTML = groups.map(([k, label, hint]) => {
        const ps = r.parts.filter((p) => p.kind === k);
        if (!ps.length) return '';
        const sum = ps.reduce((a, p) => a + p.total, 0);
        return `<div class="brk__g"><div class="brk__h"><span>${label}</span><b>${sum}</b></div>` +
          `<ul>${ps.map((p) => `<li><span class="brk__n">${p.name}</span>` +
            `<span class="brk__m">${p.kind === 'culture' ? p.note : `${p.n} × ${p.vp}${p.note ? ` <i>· ${p.note}</i>` : ''}`}</span>` +
            `<b>${p.total}</b></li>`).join('')}</ul>` +
          (hint ? `<div class="brk__hint">${hint}</div>` : '') + `</div>`;
      }).join('');

      // Maps scale with the player count (about 4 to 16 sites each), so the table does too.
      const lo = s.players * 4, hi = s.players * 16;
      const rows = [];
      for (let n = lo; n <= hi; n++) {
        const rr = pool(n, s);
        const opts = D.victoryPointOptions.map((o) =>
          `<td class="cell cell--num vp__opt${o.id === s.opt.id ? ' is-on' : ''}">${target(rr.base, o)}</td>`).join('');
        const t = target(rr.base, s.opt);
        rows.push(`<tr${n === sites ? ' class="vp--here"' : ''}>` +
          `<td class="rowlabel vp__n">${n}</td>` +
          `<td class="cell cell--num vp__dim">${rr.total}</td>` +
          `<td class="cell cell--num vp__dim">${rr.base}</td>` + opts +
          `<td class="cell cell--num vp__dcol">${doubleV ? byVictory(t, doubleV) : '—'}</td></tr>`);
      }
      $('v-body').innerHTML = rows.join('');
    }

    for (const id of ['v-players', 'v-teams', 'v-sites']) $(id).addEventListener('input', render);
    $('v-option').addEventListener('change', render);
    $('v-characters').addEventListener('change', render);
    document.querySelectorAll('.v-content').forEach((c) => c.addEventListener('change', render));
    $('v-reset').addEventListener('click', () => {
      $('v-players').value = TOURNAMENT.players;
      $('v-teams').value = TOURNAMENT.teams;
      $('v-option').value = TOURNAMENT.option;
      $('v-characters').checked = true;
      document.querySelectorAll('.v-content').forEach((c) => { c.checked = true; });
      render();
    });
    render();
  })();
</script>

<style>
  .lede { max-width: 88ch; color: var(--text-dim); font-size: 0.86rem; line-height: 1.6; margin: 0 0 1rem; }
  .lede a { color: var(--accent); }
  .lede b, .lede strong { color: var(--text); }

  .asm { border: 1px solid var(--border-strong); border-radius: var(--radius-lg); background: var(--bg-elev);
    padding: 0.2rem 0.9rem 0.6rem; margin: 0 0 1.1rem; }
  .asm__row { display: flex; align-items: flex-start; gap: 0.9rem; padding: 0.55rem 0; }
  .asm__row + .asm__row { border-top: 1px solid var(--border); }
  .asm__tag { flex: none; width: 7rem; padding-top: 0.95rem; font-family: var(--font-mono);
    font-size: 0.62rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-faint); }
  .asm__fields { display: flex; flex-wrap: wrap; gap: 0.5rem 1.3rem; align-items: flex-end; flex: 1; }
  .asm__reset { align-self: flex-end; background: transparent; color: var(--accent); border: 1px solid
    color-mix(in srgb, var(--accent) 40%, transparent); border-radius: 6px; padding: 0.3rem 0.6rem;
    font-family: var(--font-body); font-size: 0.72rem; cursor: pointer; margin-bottom: 0.05rem; }
  .asm__reset:hover { border-color: var(--accent); }
  .f { display: flex; flex-direction: column; gap: 0.2rem; font-size: 0.74rem; color: var(--text-dim); }
  .f i { color: var(--text-faint); font-size: 0.9em; font-style: italic; }
  .f input, .f select { width: 7rem; background: var(--bg); color: var(--text); border: 1px solid var(--border-strong);
    border-radius: 6px; padding: 0.25rem 0.4rem; font-family: var(--font-mono); font-size: 0.78rem; }
  .f--sel select { width: 11rem; font-family: var(--font-body); }
  .f--chk { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.74rem;
    color: var(--text-dim); cursor: pointer; padding-bottom: 0.32rem; }
  .f--chk input { accent-color: var(--accent); }
  .f--chk i { color: var(--text-faint); font-style: italic; }

  .sum { display: flex; flex-wrap: wrap; gap: 0.4rem 2rem; margin: 0 0 0.9rem; padding: 0 0.2rem; }
  .sum :global(span) { display: flex; flex-direction: column; font-size: 0.74rem; color: var(--text-dim); }
  .sum :global(b) { font-family: var(--font-mono); font-size: 1rem; color: var(--accent); }
  .sum :global(span:first-child b) { font-size: 1.5rem; }
  .sum :global(i) { font-style: italic; font-size: 0.66rem; color: var(--text-faint); }

  /* The pool breakdown: one column per source, rows are name · maths · points. */
  .brk { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 0.6rem;
    margin: 0 0 1.1rem; }
  .brk :global(.brk__g) { border: 1px solid var(--border); border-radius: var(--radius-lg);
    background: var(--bg-elev); padding: 0.45rem 0.7rem 0.5rem; }
  .brk :global(.brk__h) { display: flex; justify-content: space-between; align-items: baseline;
    font-family: var(--font-display); font-size: 0.82rem; color: var(--text); margin: 0 0 0.3rem; }
  .brk :global(.brk__h b) { font-family: var(--font-mono); color: var(--accent); font-size: 0.95rem; }
  .brk :global(ul) { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.12rem; }
  .brk :global(li) { display: grid; grid-template-columns: minmax(0, 1fr) auto 2.2rem; gap: 0.5rem;
    font-size: 0.72rem; color: var(--text-dim); align-items: baseline; }
  .brk :global(.brk__n) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .brk :global(.brk__m) { font-family: var(--font-mono); font-size: 0.66rem; color: var(--text-faint);
    white-space: nowrap; }
  .brk :global(.brk__m i) { font-family: var(--font-body); font-style: italic; }
  .brk :global(li b) { font-family: var(--font-mono); color: var(--text); text-align: right;
    font-variant-numeric: tabular-nums; }
  .brk :global(.brk__hint) { font-size: 0.62rem; color: var(--text-faint); font-style: italic; margin-top: 0.3rem; }

  .vp__hdnote { display: block; font-family: var(--font-body); font-weight: 400; text-transform: none;
    letter-spacing: 0; font-size: 0.58rem; color: var(--text-faint); margin-top: 0.15rem; }
  .vp { width: auto; min-width: 36rem; max-width: 52rem; }
  .nhdr--num, .vp :global(.cell--num) { text-align: right; }
  .vp :global(.cell--num) { font-family: var(--font-mono); font-variant-numeric: tabular-nums;
    font-size: 0.86rem; vertical-align: top; }
  .vp :global(.rowlabel) { text-align: left; width: 6rem; }
  .vp :global(.vp__n) { font-family: var(--font-mono); font-size: 0.82rem; color: var(--text-dim); }
  .vp :global(.vp__dim) { color: var(--text-faint); font-size: 0.76rem; }
  .vp :global(.vp__dcol) { border-left: 1px solid var(--border-strong); color: var(--text-dim); width: 5.5rem; }
  .vp :global(.vp__opt.is-on) { color: var(--accent); }
