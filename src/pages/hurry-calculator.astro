---
import Base from '../layouts/Base.astro';
import D from '../data/hurry.json';

const base = import.meta.env.BASE_URL;

// Anything the engine refuses to hurry is dead weight in the picker.
const hurryable = (x: any) => !x.noHurry;

const stdUnits = D.units.filter((u: any) => hurryable(u) && !u.nation && u.productionType === 'YIELD_TRAINING');
// Ships stand apart (they cost the same as land units of the same strength but
// are never an alternative to one), then land units group by strength. Cost is
// NOT uniform within a strength band — str 5 spans 80-100 and str 8 spans
// 100-120 — so these are groupings, not collapses.
const ships = stdUnits.filter((u: any) => u.ship);
const landByStrength = [...new Set(stdUnits.filter((u: any) => !u.ship).map((u: any) => u.strength))]
  .sort((a: any, b: any) => a - b)
  .map((strength: any) => ({
    strength,
    units: stdUnits.filter((u: any) => !u.ship && u.strength === strength)
      .sort((a: any, b: any) => a.production - b.production || a.name.localeCompare(b.name)),
  }));
// Steppe Rider is Yuezhi-unique but Growth-produced and priced on its own, so
// it belongs here by name rather than in a collapsed bucket.
const allGrowth = D.units.filter((u: any) => hurryable(u) && u.productionType === 'YIELD_GROWTH');
// One Disciple per religion (the Hindu one is a Brahmin), all priced the same —
// collapse to a single row unless a patch makes them diverge.
const disciples = allGrowth.filter((u: any) => u.buildReligion);
const discipleCosts = [...new Set(disciples.map((u: any) => `${u.production}/${u.productionCity}`))];
const discipleRow = disciples.length > 1 && discipleCosts.length === 1 ? disciples[0] : null;
const growthRows = [
  ...allGrowth
    .filter((u: any) => !discipleRow || !u.buildReligion)
    .map((u: any) => ({
      value: u.id, production: u.production, productionCity: u.productionCity,
      label: `${u.name} — ${u.production}`
        + (u.productionCity ? ` · +${u.productionCity}/copy` : '')
        + (u.nation ? ` · ${u.nation.replace('NATION_', '').toLowerCase()}` : ''),
    })),
  ...(discipleRow ? [{
    value: 'DISCIPLE_ANY', production: discipleRow.production, productionCity: discipleRow.productionCity,
    label: `Disciple / Brahmin — ${discipleRow.production} · +${discipleRow.productionCity}/copy · any religion`,
  }] : []),
].sort((a, b) => a.production - b.production || a.label.localeCompare(b.label));

// Most tiered projects share one ladder (I/II/III/IV = 40/60/80/100), so they
// collapse to a generic row per tier. Inquiry runs its own ladder and stays
// listed by name — derived per patch, not hardcoded.
const tierOf = (n: string) => (n.match(/^(.*?)\s+(IV|I{1,3})$/) || []).slice(1);
const hurryableProjects = D.projects.filter(hurryable);
const ladders = new Map<string, { tier: string; production: number; p: any }[]>();
const untiered: any[] = [];
for (const p of hurryableProjects as any[]) {
  const [family, tier] = tierOf(p.name);
  if (!family) { untiered.push(p); continue; }
  if (!ladders.has(family)) ladders.set(family, []);
  ladders.get(family)!.push({ tier, production: p.production, p });
}
const ladderKey = (rows: any[]) =>
  rows.slice().sort((a, b) => a.tier.length - b.tier.length).map(r => `${r.tier}:${r.production}`).join(',');
const ladderCounts = new Map<string, number>();
for (const rows of ladders.values()) ladderCounts.set(ladderKey(rows), (ladderCounts.get(ladderKey(rows)) || 0) + 1);
const sharedLadder = [...ladderCounts.entries()].filter(([, n]) => n > 1).sort((a, b) => b[1] - a[1])[0]?.[0];
const genericTiers = sharedLadder
  ? [...ladders.values()].find(rows => ladderKey(rows) === sharedLadder)!
      .slice().sort((a, b) => a.production - b.production)
  : [];
const ownLadderProjects = [...ladders.entries()]
  .filter(([, rows]) => ladderKey(rows) !== sharedLadder)
  .flatMap(([, rows]) => rows.map(r => r.p));

// Every str-6 unique costs 120 and every str-8 unique 160, so one row each
// beats thirteen identical ones. Verify per patch instead of hardcoding it:
// a strength band that stops being uniform falls back to listing its members.
const uniqueTraining = D.units.filter((u: any) => hurryable(u) && u.nation && u.productionType === 'YIELD_TRAINING');
const uniqueBands = [...new Set(uniqueTraining.map((u: any) => u.strength))]
  .sort((a: any, b: any) => a - b)
  .map((strength: any) => {
    const members = uniqueTraining.filter((u: any) => u.strength === strength);
    const costs = [...new Set(members.map((u: any) => u.production))];
    return { strength, members, uniform: costs.length === 1 ? costs[0] : null };
  });

// What unlocks each channel, and it is NOT the same for every build target —
// Money on a unit wants the Holy War law, but on a project or specialist it is
// a Judge governor instead. Same split for Training. Source chains are
// documented on /hurrying; these follow it, and the column notes track whatever
// is selected in the picker.
const channels = [
  { key: 'civics', label: 'Civics', unit: 'always', project: 'always' },
  { key: 'training', label: 'Training', unit: 'Zealot leader', project: 'Cathedral + Redemption' },
  { key: 'money', label: 'Money', unit: 'Holy War law', project: 'Judge governor' },
  { key: 'orders', label: 'Orders', unit: 'Orthodoxy law', project: 'Orthodoxy law' },
  { key: 'growth', label: 'Citizens', unit: 'Volunteers law', project: 'Volunteers law' },
];
const availability = Object.fromEntries(channels.map(c => [c.key, { unit: c.unit, project: c.project }]));

// Everything the client needs to replay City.cs integer arithmetic exactly.
const payload = {
  globals: D.globals,
  ym: D.yieldsMultiplier,
  hurryMod: D.yieldHurryModifier,
  avail: availability,
};
---

<Base
  title="Hurry Production Calculator"
  active="hurry-calculator"
  pageMark="⏩"
  pageStats={[
    { label: 'channels', value: channels.length },
    { label: 'builds', value: stdUnits.length + allGrowth.length + uniqueTraining.length + hurryableProjects.length },
  ]}
>
  <p class="lede">
    What <strong>Hurry Production</strong> costs, replaying the engine's own integer maths. Only four things
    move the number: the <b>production still missing</b>, how many times you have already hurried
    <b>that same channel in that city</b> (+10% each, and it never resets), whether the build is
    <b>under 50% done</b> (up to +50%), and whether it is produced with
    <b>Growth</b> rather than Training or Civics (+50%). The unit's identity never enters the
    formula — only its production cost and production type — so the picker is a convenience over a
    plain cost number. See <a href={`${base}hurrying`}>Hurrying Production</a> for which channels
    you can actually unlock.
  </p>

  <section class="asm">
    <div class="asm__row">
      <span class="asm__tag">Building</span>
      <div class="asm__fields">
        <label class="f f--wide"><span>What you're hurrying</span>
          <select id="h-pick">
            {landByStrength.map((g: any) => (
              <optgroup label={`Strength ${g.strength}`}>
                {g.units.map((u: any) => (
                  <option value={u.id} data-cost={u.production} data-pt={u.productionType} data-pc={u.productionCity} data-kind="unit">
                    {u.name} — {u.production}
                  </option>
                ))}
              </optgroup>
            ))}
            <optgroup label="Ships">
              {ships.map((u: any) => (
                <option value={u.id} data-cost={u.production} data-pt={u.productionType} data-pc={u.productionCity} data-kind="unit">
                  {u.name} — {u.production} · str {u.strength}
                </option>
              ))}
            </optgroup>
            <optgroup label="Growth units — +50% hurry cost">
              {growthRows.map((r: any) => (
                <option value={r.value} data-cost={r.production} data-pt="YIELD_GROWTH"
                        data-pc={r.productionCity} data-kind="unit">{r.label}</option>
              ))}
            </optgroup>
            <optgroup label="Unique units">
              {uniqueBands.map((b: any) => (b.uniform
                ? <option value={`UU_STR_${b.strength}`} data-cost={b.uniform} data-pt="YIELD_TRAINING" data-pc="0" data-kind="unit">
                    Unique unit · str {b.strength} — {b.uniform} <span set:html="&nbsp;" />(all {b.members.length})
                  </option>
                : b.members.map((u: any) => (
                    <option value={u.id} data-cost={u.production} data-pt={u.productionType} data-pc={u.productionCity} data-kind="unit">
                      {u.name} — {u.production} · {u.nation.replace('NATION_', '').toLowerCase()}
                    </option>
                  ))
              ))}
            </optgroup>
            {/* Specialists build with Civics (getBuildYieldType falls through
                for SPECIALIST_BUILD) and cost by tier: _1 40 / _2 60 / _3 80,
                rural flat 40 — uniform across all 38 specialists in the XML.
                Unlock-wise they share the Projects column of the matrix. */}
            <optgroup label="Specialists">
              <option value="SPEC_TIER_1" data-cost="40" data-pt="YIELD_CIVICS" data-pc="0" data-pcpct="5" data-kind="project">
                Apprentice (urban I) / any rural — 40
              </option>
              <option value="SPEC_TIER_2" data-cost="60" data-pt="YIELD_CIVICS" data-pc="0" data-pcpct="5" data-kind="project">
                Master (urban II) — 60
              </option>
              <option value="SPEC_TIER_3" data-cost="80" data-pt="YIELD_CIVICS" data-pc="0" data-pcpct="5" data-kind="project">
                Elder (urban III) — 80
              </option>
            </optgroup>
            <optgroup label="Projects">
              {genericTiers.map((r: any) => (
                <option value={`PROJECT_TIER_${r.tier}`} data-cost={r.production}
                        data-pt={r.p.productionType} data-pc="0" data-kind="project">
                  Project {r.tier} — {r.production}
                </option>
              ))}
              {[...ownLadderProjects, ...untiered].map((p: any) => (
                <option value={p.id} data-cost={p.production} data-pt={p.productionType} data-pc="0" data-kind="project">
                  {p.name} — {p.production}
                </option>
              ))}
            </optgroup>
          </select>
        </label>
        <label class="f"><span>Production cost <i>edit for custom</i></span>
          <input type="number" id="h-cost" value="80" min="1" max="2000" step="1" /></label>
        <label class="f"><span>Already built here <i>Workers/Settlers/Disciples +10 · Specialists +5%</i></span>
          <input type="number" id="h-copies" value="0" min="0" max="20" step="1" /></label>
        <label class="f--chk"><input type="checkbox" id="h-growth" />
          <span>Growth production <i>+50% hurry</i></span></label>
      </div>
    </div>

    <div class="asm__row">
      <span class="asm__tag">Progress</span>
      <div class="asm__fields">
        <label class="f"><span>Production done</span>
          <input type="number" id="h-done" value="0" min="0" max="2000" step="1" /></label>
        <label class="f f--slide"><span>&nbsp;</span>
          <input type="range" id="h-slide" value="0" min="0" max="100" step="1" /></label>
      </div>
    </div>
  </section>

  <div id="h-sum" class="sum"></div>

  <div class="grid">
    <div class="grid__scroll">
      <table class="ntbl hc">
        <thead>
          <tr>
            <th class="rowlabel rowlabel--corner">Previously done<br /><span class="hc__hdnote">this channel, this city</span></th>
            <th class="nhdr nhdr--num">Multiplier</th>
            {channels.map(c => (
              <th class="nhdr nhdr--num">
                <span class="hc__hd">
                  <img src={`${base}img/icons/yields/${c.key}.png`} alt="" width="14" height="14" />
                  {c.label}
                </span>
                <span class="hc__hdnote" id={`hn-${c.key}`}>{c.unit}</span>
              </th>
            ))}
            <th class="nhdr nhdr--num hc__dcol">
              <span class="hc__hd">
                <img src={`${base}img/icons/yields/discontent.png`} alt="" width="14" height="14" />
                Discontent
              </span>
              <span class="hc__hdnote">never escalates</span>
            </th>
          </tr>
        </thead>
        <tbody id="h-body"></tbody>
      </table>
    </div>
  </div>

  <section class="rates">
    <h2 class="rates__h">What the code says</h2>
    <div class="rates__cols">
      <div>
        <h3>The escalation <span class="tag">per city, per channel</span></h3>
        <ul>
          <li>Every hurry does <code>iCost *= (10 + count); iCost /= 10</code> — so the
            <b>n</b>th repeat costs <b>(10+n)/10</b> of base. Ten prior Civics hurries in a city
            means the eleventh costs double.</li>
          <li>The counters are per <b>city</b> and per <b>channel</b>
            (<code>miHurryCivicsCount</code>, <code>miHurryTrainingCount</code>, …). Hurrying with
            Money never raises your Civics price.</li>
          <li>Nothing in the code resets them — they are set to 0 when the city is created and only
            ever incremented (<code>City.cs:283</code>, <code>incrementHurry*Count</code>).</li>
        </ul>
      </div>
      <div>
        <h3>Base cost per channel</h3>
        <ul>
          <li><b>Civics / Training</b> — <code>1.5 × missing + 100</code>, rounded up to a
            multiple of 10.</li>
          <li><b>Money</b> — <code>5 × missing + 10</code>, rounded up to 10.</li>
          <li><b>Orders</b> — <code>missing/10 + 2</code>, not rounded.</li>
          <li><b>Citizens</b> — the escalation hits the <i>missing production first</i>, then
            <code>missing/80 + 1</code>. That base citizen is the one thing the repeat penalty
            never touches — and because the division is integer, the escalation is usually
            swallowed whole: Citizens is often the same price at nine prior hurries as at none.</li>
        </ul>
      </div>
      <div>
        <h3>The two multipliers on top</h3>
        <ul>
          <li><b>Under 50% done</b> — <code>getModifiedHurryCost</code> adds
            <code>(50 − percent)%</code>. At 0% progress that is +50%; at 25% it is +25%; from 50%
            up it is nothing. Hurrying something barely started is the expensive case.</li>
          <li><b>Growth builds</b> — <code>YIELD_GROWTH</code> is the only yield carrying
            <code>iHurryModifier</code> (+50). Workers, Settlers, Scouts and Disciples all hurry
            half again dearer than a soldier of identical cost.</li>
          <li>Both are applied <i>after</i> the repeat escalation, in that order.</li>
        </ul>
      </div>
      <div>
        <h3>Discontent, and the gates</h3>
        <ul>
          <li>Every hurry adds <code>missing/100 + 10</code> Discontent regardless of channel, and
            it does <b>not</b> escalate with the hurry count — but it does take both multipliers
            above. <b>Monetary Reform</b> zeroes it (<code>iHurryDiscontentModifier −100</code>).
            In practice that is a near-flat 10–18, not something that scales with the build.</li>
          <li>Because it does not escalate, a city that has already hurried nine times pays the
            <b>same</b> Discontent as one that never has — only the yield price climbs.</li>
          <li class="muted">The community <i>Rush Buy Rules Summary Table</i> in the official
            manual (p.220) gives this one as <code>10 + mp/10</code>. That converts the base to
            displayed Discontent but not the <code>mp</code> term: the engine holds Discontent in
            tenths and the UI divides by 10 (<code>HelpText.cs:1316</code>), so the missing-production
            term is <code>mp/100</code>. The same table's note that “Discontent … increases by 10%
            base too” is also wrong — <code>getHurryDiscontent</code> has no count term, and all five
            <code>hurry*Build</code> functions call it identically. Every other row matches the code.</li>
          <li><code>canHurry</code> refuses outright when the city is <b>Damaged</b>, when the
            build would finish next turn anyway (<code>getBuildTurnsLeft == 1</code>), or below
            <b>Developing</b> culture (<code>HURRY_CULTURE</code>).</li>
          <li>Three city effects switch hurrying off entirely: a <b>Furious family</b>
            (<code>EFFECTCITY_OPINIONFAMILY_FURIOUS</code>), <b>Autonomous Rule</b> and
            <b>Shared Power</b>. Anger your family and the whole lever disappears.</li>
          <li>Workers, Settlers and Disciples also cost <b>+10 production per copy already built
            in that city</b> (<code>iProductionCity</code>) — a second, separate escalation that
            feeds the missing-production figure above.</li>
        </ul>
      </div>
    </div>
    <p class="fine">
      Formulas from <b>City.cs</b> <code>getHurryCivicsCost</code>, <code>getHurryTrainingCost</code>,
      <code>getHurryMoneyCost</code>, <code>getHurryOrdersCost</code>,
      <code>getHurryPopulationCost</code> and <code>getModifiedHurryCost</code>; constants from
      <code>globalsInt.xml</code>. Costs are charged with
      <code>changeYieldStockpileWhole</code>, so every figure here is in whole displayed yield.
      Integer truncation is reproduced exactly — the numbers should match the in-game tooltip.
    </p>
  </section>
</Base>

<script is:inline define:vars={{ D: payload }}>
  (() => {
    const G = D.globals, YM = D.ym;
    const $ = (id) => document.getElementById(id);

    // ── Utils.cs ────────────────────────────────────────────────────────────
    const modify = (v, m) => {
      if (v === 0 || m === 0) return v;
      const mult = Math.max(0, m + 100);
      return Math.trunc((v * mult) / 100);
    };
    const roundUp = (v, mod) => { const r = v % mod; return r === 0 ? v : v + (mod - r); };
    // City.cs: iCost *= (10 + count); iCost /= 10
    const escalate = (v, n) => Math.trunc((v * (10 + n)) / 10);

    // City.cs getModifiedHurryCost — under-50% penalty, then the build's yield
    // hurry modifier, then an optional round up to a whole multiple of 10.
    function modified(cost, total, done, growth, round) {
      if (total > 0) {
        const pct = Math.trunc((done * 100) / total);
        if (pct < 50) cost = modify(cost, 50 - pct);
      }
      cost = modify(cost, growth ? (D.hurryMod.YIELD_GROWTH || 0) : 0);
      if (round) cost = roundUp(cost, YM);
      return Math.max(0, cost);
    }

    const CH = {
      civics: (mp, n, t, d, g) =>
        modified(escalate(modify(mp, G.HURRY_CIVICS_COST_MODIFIER) + G.HURRY_CIVICS_COST_BASE, n), t, d, g, true),
      training: (mp, n, t, d, g) =>
        modified(escalate(modify(mp, G.HURRY_TRAINING_COST_MODIFIER) + G.HURRY_TRAINING_COST_BASE, n), t, d, g, true),
      money: (mp, n, t, d, g) =>
        modified(escalate(mp * G.HURRY_MONEY_COST_PER + G.HURRY_MONEY_COST_BASE, n), t, d, g, true),
      orders: (mp, n, t, d, g) =>
        modified(escalate(modify(mp, G.HURRY_ORDERS_COST_MODIFIER) + G.HURRY_ORDERS_COST_BASE, n), t, d, g, false),
      // Population escalates the missing production BEFORE dividing, so the
      // base citizen is never multiplied.
      growth: (mp, n, t, d, g) =>
        modified(Math.trunc(escalate(mp, n) / G.HURRY_POPULATION_COST_PER) + G.HURRY_POPULATION_COST_BASE, t, d, g, false),
    };
    const ORDER = ['civics', 'training', 'money', 'orders', 'growth'];

    function discontent(mp, t, d, g) {
      const c = Math.trunc(mp / G.HURRY_DISCONTENT_COST_PER) + G.HURRY_DISCONTENT_COST_BASE;
      return modified(c, t, d, g, true) / YM;   // stored in tenths
    }

    // ── state ───────────────────────────────────────────────────────────────
    let custom = false;

    function readPick() {
      const opt = $('h-pick').selectedOptions[0];
      return opt ? {
        cost: +opt.dataset.cost, growth: opt.dataset.pt === 'YIELD_GROWTH',
        perCopy: +(opt.dataset.pc || 0), perCopyPct: +(opt.dataset.pcpct || 0),
        kind: opt.dataset.kind || 'unit',
      } : null;
    }

    // Which unlock each channel needs depends on the build target: Money on a
    // unit is the Holy War law, on a project/specialist it's a Judge governor.
    function setNotes(kind) {
      for (const k of ORDER) {
        const el = $('hn-' + k);
        if (el && D.avail[k]) el.textContent = D.avail[k][kind] || D.avail[k].unit;
      }
    }

    function applyPick() {
      const p = readPick();
      if (!p) return;
      custom = false;
      $('h-copies').value = 0;
      $('h-cost').value = p.cost;
      $('h-growth').checked = p.growth;
      render();
    }

    function render() {
      const p = readPick();
      const perCopy = custom ? 0 : (p ? p.perCopy : 0);
      const perCopyPct = custom ? 0 : (p ? p.perCopyPct : 0);
      const copies = Math.max(0, +$('h-copies').value || 0);
      // Units escalate flat (iProductionCity); specialists escalate +5%/copy
      // (SPECIALIST_COST_PRODUCED_MODIFIER, applied via utils().modify)
      let total = (+$('h-cost').value || 0) + perCopy * copies;
      if (perCopyPct && copies) total = modify(total, perCopyPct * copies);
      total = Math.max(1, total);
      let done = Math.max(0, Math.min(total, +$('h-done').value || 0));
      $('h-done').max = total;
      $('h-slide').value = Math.round((done / total) * 100);
      const growth = $('h-growth').checked;
      const mp = Math.max(0, total - done);
      const pct = Math.trunc((done * 100) / total);
      const penalty = pct < 50 ? 50 - pct : 0;

      setNotes(p ? p.kind : 'unit');

      $('h-sum').innerHTML = [
        `<span><b>${mp}</b> production missing<i>of ${total}${(perCopy || perCopyPct) && copies ? ` — incl. ${perCopyPct ? `+${perCopyPct * copies}%` : `+${perCopy * copies}`} for ${copies} built here` : ''}</i></span>`,
        `<span><b>${pct}%</b> done<i>${penalty ? `under half — +${penalty}% cost` : 'at or past half — no penalty'}</i></span>`,
        `<span><b>${growth ? '+50%' : 'none'}</b> production-type surcharge<i>${growth ? 'Growth build' : 'Training / Civics build'}</i></span>`,
      ].join('');

      const disc = discontent(mp, total, done, growth);
      const rows = [];
      for (let n = 0; n <= 9; n++) {
        const cells = ORDER.map((k) => {
          const v = CH[k](mp, n, total, done, growth);
          const base = CH[k](mp, 0, total, done, growth);
          const up = n && base ? Math.round(((v - base) / base) * 100) : 0;
          return `<td class="cell cell--num">${v}${up ? `<span class="natnote">+${up}%</span>` : ''}</td>`;
        }).join('');
        rows.push(
          `<tr${n === 0 ? ' class="hc--first"' : ''}>` +
          `<td class="rowlabel hc__n">${n === 0 ? 'none yet' : n + (n === 1 ? ' time' : ' times')}</td>` +
          `<td class="cell cell--num hc__mul">×${((10 + n) / 10).toFixed(1)}</td>` +
          cells +
          `<td class="cell cell--num hc__dcol hc__disc">${disc}</td>` + '</tr>');
      }
      $('h-body').innerHTML = rows.join('');
    }

    $('h-pick').addEventListener('change', applyPick);
    $('h-cost').addEventListener('input', () => { custom = true; render(); });
    $('h-copies').addEventListener('input', render);
    $('h-growth').addEventListener('change', render);
    $('h-done').addEventListener('input', render);
    $('h-slide').addEventListener('input', () => {
      const p = readPick();
      const perCopy = custom ? 0 : (p ? p.perCopy : 0);
      const perCopyPct = custom ? 0 : (p ? p.perCopyPct : 0);
      const copies = Math.max(0, +$('h-copies').value || 0);
      let total = (+$('h-cost').value || 0) + perCopy * copies;
      if (perCopyPct && copies) total = modify(total, perCopyPct * copies);
      total = Math.max(1, total);
      $('h-done').value = Math.round((total * +$('h-slide').value) / 100);
      render();
    });

    // Default to a Spearman-ish mid unit rather than the first option.
    // Open on a mid-tier line unit rather than whatever sorts first.
    const pref = [...$('h-pick').options].find((o) => o.value === 'UNIT_SPEARMAN');
    if (pref) pref.selected = true;
    applyPick();
  })();
</script>

