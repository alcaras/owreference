---
import Base from '../layouts/Base.astro';
import LinkedText from '../components/LinkedText.astro';
import Term from '../components/Term.astro';
import AutobuildCompare from '../components/AutobuildCompare.astro';
import autobuild from '../data/autobuild.json';

// Everything here is transcribed from the game source — PlayerAI.cs
// (doAutomatedCityBuilds → doCityBuildPlanning → getBestBuild and its
// validity/value helpers), City.cs (isAutoBuild, updateDefaultGovernor,
// canBuildProject/canBuildUnit) and Game.cs (the BUILD_* action gates) —
// with tunables from globalsAI.xml via scripts/build_autobuild.py.
const base = import.meta.env.BASE_URL;
const { constants: C, vizier, unitBuildModifierTraits, defensiveProjects,
        governorRequiredProjects, governorTraitCount } = autobuild;
const shared = autobuild.carriers.find(c => c.id === vizier.noGovernorEffectCity)!;

// getBuildValue(base, rate, cost, min, half):
//   turns = ceil(cost·10 / rate); turns ≤ min → base;
//   else base × (half − min) / (turns + half − 2·min)
function discount(turns: number, min: number, half: number): number {
  if (turns <= min) return 1;
  return (half - min) / (turns + half - 2 * min);
}
const pct = (x: number) => `${Math.round(x * 100)}%`;
const buildTypes = [
  { kind: 'Project',    min: C.AI_MIN_PROJECT_BUILD_TURNS,    half: C.AI_HALF_VALUE_PROJECT_BUILD_TURNS },
  { kind: 'Specialist', min: C.AI_MIN_SPECIALIST_BUILD_TURNS, half: C.AI_HALF_VALUE_SPECIALIST_BUILD_TURNS },
  { kind: 'Unit',       min: C.AI_MIN_UNIT_BUILD_TURNS,       half: C.AI_HALF_VALUE_UNIT_BUILD_TURNS },
];
const sampleTurns = [1, 2, 4, 6, 8, 12, 20, 40];

// Worked example: a 60-Civics project in a city making 6 Civics/turn.
const exCost = 60, exRate = 6;
const exTurns = Math.ceil(exCost / exRate);
const exFactor = discount(exTurns, C.AI_MIN_PROJECT_BUILD_TURNS, C.AI_HALF_VALUE_PROJECT_BUILD_TURNS);

---

<Base
  title="Grand Vizier Rulership"
  active="grand-vizier"
  pageMark="📜"
  description={`How Old World's Grand Vizier (${vizier.dlc}) runs every city that has no Governor: which cities he takes, what his traits do there, how to take a city back, and how he picks each build.`}
  pageStats={[
    { label: 'seat', value: vizier.name },
    { label: 'needs trait', value: vizier.traitPrereqs.map(t => t.name).join(' or ') },
    { label: 'opinion', value: `+${vizier.assignOpinion}` },
    { label: 'XP/turn', value: vizier.xpPerTurn },
  ]}
>
  <p class="lede">
    Appoint a <b>{vizier.name}</b> ({vizier.dlc}) and every city without a
    <LinkedText text="Governor" /> builds whatever the AI picks for it. This page shows which
    cities he runs, how to take one back, and how he chooses.
  </p>

  <section class="cc-section">
    <h2 class="cc-h2">The seat</h2>
    <ul class="cc-bullets">
      <li>
        <b>Requires</b> {vizier.dlc} and a character with
        {vizier.traitPrereqs.map((t, i) => (<>{i > 0 && ' or '}<Term id={t.id} /></>))}.
      </li>
      <li>
        <b>Appointing</b> gives the character <b>+{vizier.assignOpinion}</b> opinion of you and
        <b>{vizier.xpPerTurn} XP</b> per turn, like other council seats. The seat pays
        <b>no rating yields</b> (see <a href={`${base}council`}>Council</a>) and sends no seat
        notifications.
      </li>
      <li>
        <b>Its one effect</b>, <i>{vizier.effectPlayerName}</i>, gives <b>{shared.name}</b> to each
        of your cities that has no Governor. A city loses it the moment you assign one. In game it
        reads "{vizier.help.citiesWithoutGovernor.replace('{0_cityEffectText}', shared.name)}".
      </li>
      <li>
        <b>{shared.name}</b> hands the queue to the AI, stops you hurrying, and makes the Vizier the
        city's acting Governor ("{vizier.help.actsAsGovernor.replace('{0_character}', 'The Vizier')}").
      </li>
    </ul>
  </section>

  <section class="cc-section">
    <h2 class="cc-h2">Taking a city back</h2>
    <p>Any city with <b>no Governor</b> is run by the Vizier. There is no per-city toggle.</p>
    <table class="cc-table">
      <thead><tr><th>You want</th><th>Do this</th><th>Why it works</th></tr></thead>
      <tbody>
        <tr>
          <td>Manual control of <b>one</b> city</td>
          <td>Assign any <LinkedText text="Governor" /> to it</td>
          <td>Shared Power only goes to cities with no Governor, so the queue is yours again at once.</td>
        </tr>
        <tr>
          <td>Manual control of <b>all</b> cities</td>
          <td>Dismiss the Vizier (or leave the seat empty)</td>
          <td>The effect goes away with the seat.</td>
        </tr>
        <tr>
          <td>All cities back, <b>without</b> the dismissal</td>
          <td>Give the Vizier another job, such as Governor of one city or General</td>
          <td>A character holds one job at a time, so the new post vacates the seat and you keep the character working for you.</td>
        </tr>
        <tr>
          <td>Keep it that way</td>
          <td>Watch Governor deaths and reassignments</td>
          <td>A city whose Governor leaves for any reason goes back to the Vizier on your next turn.</td>
        </tr>
      </tbody>
    </table>
    <p class="cc-fineprint">
      New cities start without a Governor, so the Vizier picks their first build the moment they
      are founded. A damaged city you capture gets a repair project queued the same way.
    </p>
  </section>

  <section class="cc-section">
    <h2 class="cc-h2">What his character does to those cities</h2>
    <p>Wherever no real Governor sits, rules that look for a Governor find the Vizier.</p>
    <ul class="cc-bullets">
      <li>
        <b>His traits' Governor effects apply</b> in <i>every</i> city he runs.
        {governorTraitCount} traits have one, and the <a href={`${base}traits`}>Traits</a> page
        lists them. A Builder Vizier speeds improvements everywhere he rules; a Warlike one adds
        Training.
      </li>
      <li>
        <b>His opinion of you</b> gives the usual Governor-opinion yield bonus or penalty in each of
        those cities. A furious Vizier hurts every ungoverned city.
      </li>
      <li>
        <b>The city counts as governed</b>, so projects that need a Governor become legal. Today
        that means the {governorRequiredProjects.length} <b>Suppress Dissent</b> projects. The Vizier
        queues one whenever the city has the matching Dissent effect and the Training is in stock.
      </li>
      <li>
        <b>Not applied:</b> leader-as-Governor bonuses, and rating yields, since the seat has none.
      </li>
    </ul>

    <h3 class="cc-h3">Projects that need a Governor</h3>
    <table class="cc-table">
      <thead><tr><th>Project</th><th>Needs in the city</th><th>Cost</th><th>Content</th></tr></thead>
      <tbody>
        {governorRequiredProjects.map(p => (
          <tr>
            <td><Term id={p.id} /></td>
            <td><LinkedText text={p.needsEffect} /></td>
            <td class="cc-num">{p.cost}</td>
            <td class="cc-dim">{p.dlc}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="cc-section">
    <h2 class="cc-h2">When he decides</h2>
    <ul class="cc-bullets">
      <li>
        <b>At the start of your turn</b>, before you can act. Whatever is in the queue when the turn
        opens is already his choice.
      </li>
      <li>
        <b>Your old queue is frozen, not deleted.</b> He puts his pick in front of it every turn,
        and your entries wait until a Governor arrives.
      </li>
      <li>
        <b>You cannot</b> add a project, specialist or unit, move or remove a queue entry, or hurry.
        The tooltip reads "{vizier.help.cannotChange.replace('{LIST}', shared.name)}". A project's
        repeat flag is ignored.
      </li>
      <li>
        <b>You still can</b> buy tiles, pass laws, run missions, manage religion, order workers and
        assign a Governor.
      </li>
    </ul>
  </section>

  <section class="cc-section">
    <h2 class="cc-h2">How he picks</h2>
    <p>He uses the same city planner as the AI nations, with buying switched off. In order:</p>
    <ol class="cc-steps">
      <li>
        <b>Repairs first.</b> When the city takes more damage than it heals on its own, he queues
        the best project that restores city HP.
      </li>
      <li>
        <b>Gather candidates</b> for each city with nothing planned: every legal project, the next
        specialist on every worked tile, and every unit that passes the need test below. The
        highest value wins. Since 1.0.84658 some candidates are <b>low priority</b> and lose to
        <em>every</em> ordinary candidate whatever the values say: emergency units such as Militia
        and Conscripts always, and any land military unit once its count is already over the plain
        military target.
      </li>
      <li>
        <b>Pay in value order</b> across the empire, and only from yields <b>already in stock</b>.
        A winner you cannot afford is skipped and that yield is marked short, which can also shelve
        cheaper items.
      </li>
      <li>
        <b>No city is left idle.</b> Any city still empty gets the same search again, and it always
        queues <i>something</i>.
      </li>
    </ol>
    <p class="cc-fineprint">
      He never buys unless the AI is playing your whole nation. Wonders and improvements never
      appear, because workers build them, not the queue.
    </p>
  </section>

  <section class="cc-section">
    <h2 class="cc-h2">Candidates and their filters</h2>
    <p>
      A city is <b>in danger</b> when the threat near it is over {C.AI_CITY_MIN_DANGER} and over
      the protection of its own tile. If filtering for danger leaves nothing, he searches again
      with danger ignored.
    </p>
    <div class="cc-scroll">
      <table class="cc-table cc-table--wide">
        <thead><tr><th>Pool</th><th>A candidate when…</th><th>Left out when…</th></tr></thead>
        <tbody>
          <tr>
            <td><b>Projects</b></td>
            <td>
              You could build it from the menu: content, tech, culture, prerequisites, max count
              (queued copies included), family seat, Governor requirement, and the goods in stock.
              Its value is at least 1.
            </td>
            <td>
              The city is in danger and the project is not <b>defensive</b>, or the city is on the
              border with a defensive project available and this one is not. Defensive projects add
              city HP or strength:
              {defensiveProjects.map((p, i) => (<>{i > 0 && ', '}<Term id={p.id} />{p.eventOnly && <span class="cc-dim"> (event)</span>}</>))}.
            </td>
          </tr>
          <tr>
            <td><b>Specialists</b></td>
            <td>
              For each tile with an active improvement: the tile's next specialist tier, the first of
              that class the city may build.
            </td>
            <td>The city is in danger.</td>
          </tr>
          <tr>
            <td><b>Units</b></td>
            <td>
              The city can build it and has a tile to spawn it on. Autonomous Rule's
              "{vizier.help.noUnits}" removes every unit here. Then a need test:
              <b>regular military</b> always passes. <b>Workers</b> pass while below 1.5 times a
              per-family target of max(1, min({C.AI_MAX_NUM_WORKERS_PER_HUNDRED_CITIES / 100} ×
              family cities, {C.AI_MAX_NUM_WORKERS_PER_HUNDRED_ORDERS / 100} × Orders × family
              cities ÷ cities)). <b>Disciples</b> work the same way at
              {C.AI_MAX_NUM_DISCIPLES_PER_HUNDRED_CITIES}/100 cities and
              {C.AI_MAX_NUM_DISCIPLES_PER_HUNDRED_ORDERS}/100 Orders, and only while there is
              somewhere left to spread. <b>Settlers</b> pass while reachable free or allied city
              sites exist, <b>missionaries</b> when the religion is unspread and you have none, and
              <b>scouts</b> while you have fewer than half as many as cities. <b>Emergency units</b>
              such as Militia pass only in danger, or when you are under target and have no current
              unit to build.
            </td>
            <td>
              The city is in danger and the unit cannot fight. Otherwise the land military cap
              applies, and since 1.0.84658 it is uneven. A <b>current regular</b> unit is blocked
              once your current military passes <b>1.5 times</b> the target. An <b>obsolete</b> unit
              is counted against <em>all</em> your land military. An <b>emergency</b> unit (Militia,
              Conscripts) is counted against all land military versus the <b>plain</b> target, with
              no headroom. A warship is blocked when its water area already has 1.5 times its
              target, or its target is 0.
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <h3 class="cc-h3">The military target, and the one trait that changes it</h3>
    <p>
      The target is max(10, 2.5 × cities), plus your forts and revealed tribal camps. It moves up
      to 50% either way with how likely war looks with the players you have met, and gets a flat
      +50% when you are not peaceful. Last comes a <b>character modifier</b>: the military-build
      trait modifiers of your council members, but <b>only the {vizier.name} seat counts</b>. The
      result stays between −50% and +100%.
    </p>
    <table class="cc-table cc-table--narrow">
      <thead><tr><th>Vizier trait</th><th class="cc-num">Military target</th></tr></thead>
      <tbody>
        {unitBuildModifierTraits.map(t => (
          <tr>
            <td><Term id={t.id} />{t.archetype && <span class="cc-dim"> archetype</span>}</td>
            <td class="cc-num"><b>{t.modifier > 0 ? '+' : ''}{t.modifier}%</b></td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="cc-fineprint">
      This is the only way the Vizier's traits change what he picks. His traits still apply as
      Governor effects, as above.
    </p>
  </section>

  <section class="cc-section">
    <h2 class="cc-h2">How each candidate is valued</h2>
    <p>
      Each candidate gets a raw value from the AI's economy model, then loses value the longer the
      city needs to finish it.
    </p>
    <ul class="cc-bullets">
      <li>
        <b>Project:</b> the value of its effects, finish bonus and yield modifier, plus a bonus when
        an active <LinkedText text="Ambition" /> counts it and half the value of what it unlocks;
        minus the projects it replaces (times the copies you own) and its cost at the AI's yield
        prices. An effect limited to one per city is skipped if the city already has one. The value
        is at least 1, and a project paid in Growth is halved in a city with no citizens.
      </li>
      <li>
        <b>Unit:</b> the base unit value times a need factor, which weighs the city's production
        against the empire average for that unit, this family's share of cities, how far you are
        under target, city danger and the family's attitude to army size. Ambition bonuses are
        added; upkeep and cost are subtracted. The value is halved when the city's production for
        the unit is under {C.AI_NO_UNIT_BUILD_PERCENT}% of the average.
      </li>
      <li>
        <b>Specialist:</b> its yields, border expansion and unlocks, minus cost, at the city's
        Civics rate.
      </li>
    </ul>

    <div class="cc-formula">
      <div class="cc-line"><span class="cc-eq">turns = ceil(cost ÷ rate)</span></div>
      <div class="cc-line"><span class="cc-eq cc-add">turns ≤ min → full value</span></div>
      <div class="cc-line"><span class="cc-eq cc-add">else value × (half − min) ÷ (turns + half − 2·min)</span></div>
    </div>
    <div class="cc-scroll">
      <table class="cc-table">
        <thead>
          <tr>
            <th>Build type</th>
            <th class="cc-num">min</th>
            <th class="cc-num">half</th>
            {sampleTurns.map(t => <th class="cc-num">{t}t</th>)}
          </tr>
        </thead>
        <tbody>
          {buildTypes.map(b => (
            <tr>
              <td>{b.kind}</td>
              <td class="cc-num">{b.min}</td>
              <td class="cc-num">{b.half}</td>
              {sampleTurns.map(t => <td class="cc-num"><b>{pct(discount(t, b.min, b.half))}</b></td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="cc-fineprint">
      A project costing {exCost} Civics in a city making {exRate} Civics per turn takes {exTurns}
      turns, so it keeps {pct(exFactor)} of its value. In a city making 30 Civics it takes 2 turns
      and keeps 100%. That is why the Vizier puts civic projects where Civics is high and grows
      specialists in weaker cities.
    </p>
  </section>

  <section class="cc-section">
    <h2 class="cc-h2">Compared with manual control and Autonomous Rule</h2>
    <AutobuildCompare current="vizier" />
  </section>
</Base>

<style>
  .lede { color: var(--text-dim); font-size: 0.9rem; line-height: 1.55; max-width: 76ch; margin: 0.4rem 0 1.5rem; }
  .lede b { color: var(--text); }
  .lede a { color: var(--accent); }

  .cc-section { margin-top: 2rem; }
  .cc-h2 { font-family: var(--font-display); font-size: 1.05rem; letter-spacing: 0.04em; margin: 0 0 0.5rem; color: var(--text); }
  .cc-h3 { font-family: var(--font-display); font-size: 0.9rem; letter-spacing: 0.03em; margin: 1.2rem 0 0.4rem; color: var(--text); }
  .cc-section p { color: var(--text-dim); font-size: 0.85rem; line-height: 1.55; max-width: 76ch; margin: 0.3rem 0; }
  .cc-section p b { color: var(--text); }
  .cc-section a { color: var(--accent); }

  .cc-bullets { color: var(--text-dim); font-size: 0.85rem; line-height: 1.55; margin: 0.4rem 0 0.8rem; padding-left: 1.2rem; max-width: 84ch; }
  .cc-bullets li { padding: 0.2rem 0; }
  .cc-bullets b { color: var(--text); }

  .cc-steps { list-style: decimal inside; color: var(--text-dim); font-size: 0.85rem; line-height: 1.55; max-width: 80ch; padding: 0; margin: 0.5rem 0; }
  .cc-steps li { padding: 0.25rem 0; }
  .cc-steps b { color: var(--text); }

  .cc-formula { background: var(--bg-elev); border: 1px solid var(--border); border-radius: 6px; padding: 0.8rem 1rem; margin: 0.6rem 0 0.9rem; max-width: 64ch; }
  .cc-line { padding: 0.12rem 0; }
  .cc-eq { font-family: var(--font-mono); font-size: 0.82rem; color: var(--text); }
  .cc-add { color: var(--text-dim); }

  .cc-scroll { overflow-x: auto; max-width: 100%; }
  .cc-table { width: 100%; max-width: 72ch; border-collapse: collapse; margin: 0.6rem 0; font-size: 0.8rem; }
  .cc-table--narrow { max-width: 36ch; }
  .cc-table--wide { max-width: none; min-width: 48rem; }
  .cc-table thead th { text-align: left; color: var(--text-dim); font-family: var(--font-ui); font-weight: 500; font-size: 0.7rem; letter-spacing: 0.05em; padding: 0.4rem 0.5rem; border-bottom: 1px solid var(--border-strong); }
  .cc-table tbody td { padding: 0.4rem 0.5rem; border-bottom: 1px solid var(--border); vertical-align: top; color: var(--text-dim); line-height: 1.5; }
  .cc-table tbody td b { color: var(--text); }
  .cc-table tbody tr:hover { background: var(--bg-elev); }
  .cc-num { text-align: right; font-variant-numeric: tabular-nums; font-family: var(--font-mono); white-space: nowrap; }
  .cc-num b { color: var(--text); font-weight: 600; }
  .cc-dim { color: var(--text-faint); font-size: 0.85em; }

  .cc-fineprint { color: var(--text-faint) !important; font-size: 0.78rem !important; line-height: 1.5; font-style: italic; max-width: 76ch; }
  .cc-fineprint b { color: var(--text-dim); }

</style>
