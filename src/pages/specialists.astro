---
// Split into two focused tabs: Urban Specialists + Rural Specialists.
// Keep this slug alive so old links don't dead-end; send to the urban view.
const base = import.meta.env.BASE_URL;
const dest = `${base}urban-specialists`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta http-equiv="refresh" content={`0; url=${dest}`} />
  <link rel="canonical" href={dest} />
  <title>Specialists — Old World Reference</title>
</head>
<body>
  <p>Moved — see <a href={dest}>Urban Specialists</a> and <a href={`${base}rural-specialists`}>Rural Specialists</a>.</p>
</body>
</html>
