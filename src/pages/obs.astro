---
// The OBS browser-source overlay: a transparent page showing the card that
// /streamer last pushed. Not in the nav — its URL is pasted into OBS.
//
// How the two pages talk (in priority order):
//   1. ?id=UNIT_HOPLITE      — pin one card forever (testing, or a static badge)
//   2. ?session=CODE          — subscribe to the free ntfy.sh pub/sub relay.
//      This is what makes the natural setup work: control panel in a normal
//      desktop browser, /obs as an OBS Browser Source (a SEPARATE browser —
//      localStorage never crosses that gap). Each panel generates its own
//      random code, so any number of streamers coexist without a backend of
//      ours. Native EventSource, no library.
//   3. BroadcastChannel + localStorage — when /streamer runs as an OBS
//      Custom Browser Dock (dock and browser source share one CEF profile)
//   4. ?server               — also poll the optional local state server
//      (scripts/overlay_state_server.cjs) for offline/LAN use. Not polled
//      unless asked: silent failed fetches every 400ms would be noise.
import '../styles/theme.css';
import '../styles/overlay-card.css';
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <title>OBS Overlay — Old World Reference</title>
</head>
<body class="obs">
  <div id="card" class="ocard obs__card" hidden></div>

  <script>
    import { cardHTML, matchupHTML, MATCHUP_PREFIX } from '../lib/overlay-card';

    const base = import.meta.env.BASE_URL;
    const el = document.getElementById('card')!;
    const params = new URLSearchParams(location.search);
    const pinned = params.get('id');
    const session = params.get('session');
    const useServer = params.has('server');

    let cards: Record<string, any> | null = null;
    let lastTs = 0;    // newest state timestamp seen, from ANY source
    let hideTimer: ReturnType<typeof setTimeout> | undefined;

    // The state is a card id, or "MATCHUP|A|B" for the head-to-head view.
    function renderState(id: string): string | null {
      if (!cards) return null;
      if (id.startsWith(MATCHUP_PREFIX)) {
        const [, a, b] = id.split('|');
        return cards[a] && cards[b] ? matchupHTML(cards[a], cards[b], base) : null;
      }
      return cards[id] ? cardHTML(cards[id], base, { noSpoilers: spoilerFree }) : null;
    }
    let spoilerFree = false;

    let visible = false;
    function hide() {
      visible = false;
      el.classList.remove('is-in');
      setTimeout(() => { if (!visible) el.hidden = true; }, 350);
    }

    // State = {id, ts, ttl}. `ts` distinguishes every push, so re-showing the
    // same card restarts the auto-hide countdown; ttl (seconds, 0 = stay)
    // rides along from the panel — the overlay itself has no settings.
    //
    // Multiple sources feed this (localStorage poll, BroadcastChannel, session
    // relay, local relay), so precedence is strictly by ts: older or absent
    // state is a NO-OP — an empty localStorage in OBS's fresh profile must not
    // clear a card the session relay just delivered. Explicit clears carry
    // their own newer ts.
    function apply(state: { id?: string; ts?: number; ttl?: number; sp?: number } | null) {
      if (!state || !state.ts || state.ts <= lastTs) return;
      lastTs = state.ts;
      if (!state.id) { hide(); return; }
      spoilerFree = !!state.sp;
      const html = renderState(state.id);
      if (!html) { hide(); return; }
      visible = true;
      el.innerHTML = html;
      el.hidden = false;
      requestAnimationFrame(() => el.classList.add('is-in'));
      clearTimeout(hideTimer);
      if (state.ttl && state.ttl > 0) hideTimer = setTimeout(hide, state.ttl * 1000);
    }

    function readLocal(): any {
      try { return JSON.parse(localStorage.getItem('ow-overlay-state') || 'null'); }
      catch { return null; }
    }

    const channel = new BroadcastChannel('ow-overlay');
    channel.onmessage = (e) => { if (!pinned) apply(e.data); };

    window.addEventListener('storage', (e) => {
      if (!pinned && e.key === 'ow-overlay-state') apply(readLocal());
    });

    async function pollServer() {
      try {
        const r = await fetch('http://127.0.0.1:43210/get');
        apply(await r.json());
      } catch { /* server not running — stay on last state */ }
    }

    // Free public pub/sub (ntfy.sh): the panel POSTs state to a random
    // per-user topic; we listen here. EventSource reconnects on its own.
    function subscribeSession(code: string) {
      // since=5m replays the recent state on (re)connect, so refreshing the
      // browser source in OBS re-shows whatever is currently live
      const es = new EventSource(`https://ntfy.sh/owref-${encodeURIComponent(code)}/sse?since=5m`);
      es.addEventListener('message', (e) => {
        try { apply(JSON.parse(JSON.parse(e.data).message)); } catch { /* not ours */ }
      });
    }

    fetch(`${base}data/overlay-cards.json`)
      .then((r) => r.json())
      .then((d) => {
        cards = d;
        if (pinned) {
          const html = renderState(pinned);
          if (html) { visible = true; el.innerHTML = html; el.hidden = false;
                      requestAnimationFrame(() => el.classList.add('is-in')); }
          return;
        }
        apply(readLocal());
        setInterval(() => apply(readLocal()), 500);
        if (session) subscribeSession(session);
        if (useServer) setInterval(pollServer, 400);
      });
  </script>

  <style is:global>
    /* theme.css paints the body with gradients AND a body::before grid
       texture — kill every layer for a transparent OBS capture. It also sets
       color-scheme: dark, which makes Chromium composite a transparent page
       onto DARK GRAY instead of showing through (the classic OBS-overlay
       gotcha) — force light so the canvas stays genuinely transparent. */
    :root { color-scheme: light; }
    html, body.obs {
      background: none !important;
      background-color: transparent !important;
      margin: 0; padding: 0;
      overflow: hidden;
    }
    body.obs::before, body.obs::after { display: none !important; }
    .obs__card {
      position: fixed; left: 20px; top: 20px;
      opacity: 0; transform: translateY(24px);
      transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                  transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .obs__card.is-in { opacity: 1; transform: translateY(0); }
  </style>
</body>
</html>
