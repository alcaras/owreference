---
import Base from '../layouts/Base.astro';
import LinkedText from '../components/LinkedText.astro';
import units from '../data/units.json';
import { counterBonus, attackDamage } from '../lib/combat';

const base = import.meta.env.BASE_URL;

type Unit = typeof units[number];

// Rock-paper-scissors matrix. Each row is "Attacker class" → which trait it
// counters and by how much (averaged across that class's signature units).
// Built from the XML counter modifiers attached to each unit's effect tree.

const ATTACKER_CLASSES = ['Infantry', 'Polearm', 'Mounted', 'Ranged', 'Siege'];
const DEFENDER_TARGETS = ['Infantry', 'Polearm', 'Mounted', 'Ranged', 'Melee', 'Siege'];

// Pick a small set of "iconic" units per class for the row legend.
function pickIconic(cls: string): Unit[] {
  return (units as Unit[])
    .filter(u => u.isCombat && u.primaryLabel === cls && !u.nationPrereq)
    .sort((a, b) => a.strength - b.strength)
    .slice(0, 3);
}

interface Cell {
  best: number;       // largest positive modifier any unit of this class has vs this target
  worst: number;      // largest negative
  sources: string[];  // representative unit names
}

function cellFor(attackerClass: string, defender: string): Cell {
  const matchers: Unit[] = (units as Unit[])
    .filter(u => u.isCombat && u.primaryLabel === attackerClass);
  let best = 0;
  let worst = 0;
  const sources: string[] = [];
  for (const u of matchers) {
    for (const c of u.counters) {
      if (c.target !== defender) continue;
      if (c.kind !== 'vs' && c.kind !== 'melee vs') continue;
      if (c.value > best) { best = c.value; }
      if (c.value < worst) { worst = c.value; }
      if (c.value !== 0 && !sources.includes(u.name)) sources.push(u.name);
    }
  }
  return { best, worst, sources: sources.slice(0, 3) };
}

const matrix = ATTACKER_CLASSES.map(cls => ({
  cls,
  iconic: pickIconic(cls),
  cells: DEFENDER_TARGETS.map(d => ({ defender: d, ...cellFor(cls, d) })),
}));

// ── Per-unit counter list (the spreadsheet's "If you're facing…" view) ──
// Damage math lives in src/lib/combat.ts — the game's own
// InfoHelpers.getAttackDamage with both sides' anti-trait modifiers.
const landCombat = (units as Unit[]).filter(u => u.isCombat && !u.isWater && u.primaryLabel !== 'Disciple');

interface CounterPick { name: string; slug: string; iconSlug: string; dmg: number; nation: string | null }

function countersFor(def: Unit): CounterPick[] {
  const picks: CounterPick[] = [];
  for (const att of landCombat) {
    if (att.id === def.id) continue;
    const bonus = counterBonus(att, def.traits, true, att.isMelee);
    if (bonus <= 0) continue;            // only true counters, like the sheet
    const dmg = attackDamage(att, def);
    if (dmg < 7) continue;               // the sheet's "significant" bar
    picks.push({ name: att.name, slug: att.slug, iconSlug: att.iconSlug, dmg, nation: att.nationLabel || null });
  }
  picks.sort((a, b) => b.dmg - a.dmg || a.name.localeCompare(b.name));
  // One entry per name (upgrade dupes), capped for scan-ability.
  const seen = new Set<string>();
  return picks.filter(p => !seen.has(p.name) && seen.add(p.name) !== undefined).slice(0, 8);
}

const defenders = [...landCombat]
  .sort((a, b) => b.strength - a.strength || a.name.localeCompare(b.name))
  .map(def => ({ def, picks: countersFor(def) }));

const tiers = new Map<number, typeof defenders>();
for (const d of defenders) {
  const t = Math.round(d.def.strength / 10);
  if (!tiers.has(t)) tiers.set(t, []);
  tiers.get(t)!.push(d);
}
const tierList = [...tiers.entries()].sort((a, b) => b[0] - a[0]);
---

<Base
  title="Unit Counters at-a-glance"
  active="unit-counters"
  pageMark="⚔️"
  pageStats={[
    { label: 'units covered', value: defenders.length },
    { label: 'attacker classes', value: ATTACKER_CLASSES.length },
  ]}
>
  <p class="lede">
    <b>If you're facing a unit, build these.</b> Each number is the damage that
    counter deals per attack — the game's own formula
    (<code>6 × StrAtt / StrDef</code>, both sides' anti-trait modifiers applied,
    full HP, open terrain, no promotions). Only true counters — attackers with
    an anti-trait bonus against the target — make the list.
  </p>

  {tierList.map(([tier, list]) => (
    <section class="ctier">
      <h2 class="ctier__h">Strength {tier} defenders</h2>
      <div class="grid">
        <div class="grid__scroll">
          <table class="ntbl ntbl--counters">
            <tbody>
              {list.map(({ def, picks }) => (
                <tr id={def.slug}>
                  <th class="rowlabel" scope="row">
                    <div class="rl">
                      <span class="rl__name">
                        <img class="rl__icon" src={`${base}img/icons/units/${def.iconSlug}.png`} alt="" loading="lazy" />
                        {def.name}
                      </span>
                      <span class="rl__sources">{def.primaryLabel}{def.nationLabel ? ` · ${def.nationLabel}` : ''}{def.isTribal ? ' · tribal' : ''}</span>
                    </div>
                  </th>
                  <td class="cell cell--picks">
                    {picks.length === 0 ? (
                      <span class="cell__dash">no significant counters</span>
                    ) : (
                      picks.map(p => (
                        <a class="pick yield-training" href={`${base}units#${p.slug}`} title={`${p.name}${p.nation ? ` (${p.nation})` : ''} deals ${p.dmg} damage per attack`}>
                          <img class="pick__icon" src={`${base}img/icons/units/${p.iconSlug}.png`} alt="" loading="lazy" />
                          <span class="pick__name">{p.name}</span>
                          <span class="pick__dmg">{p.dmg}</span>
                        </a>
                      ))
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  ))}

  <h2 class="ctier__h ctier__h--matrix">Class overview</h2>
  <div class="grid">
    <div class="grid__scroll">
      <table class="ntbl">
        <colgroup>
          <col class="ntbl__rowlabel-col" />
          {DEFENDER_TARGETS.map(d => <col data-target={d} />)}
        </colgroup>
        <thead>
          <tr>
            <th class="rowlabel rowlabel--corner">
              <span class="rowlabel__small">Target →</span>
              <span class="rowlabel__big">Attacker ↓</span>
            </th>
            {DEFENDER_TARGETS.map(d => (
              <th class="nhdr nhdr--family" data-target={d}>
                <div class="nhdr__inner">
                  <span class="nhdr__name">{d}</span>
                </div>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {matrix.map(row => (
            <tr>
              <th class="rowlabel" scope="row">
                <div class="rl">
                  <span class="rl__name">{row.cls}</span>
                  <span class="rl__sources">
                    {row.iconic.map(u => u.name).join(', ')}
                  </span>
                </div>
              </th>
              {row.cells.map(cell => {
                const v = cell.best || cell.worst;
                if (v === 0) {
                  return (
                    <td class="cell is-empty" data-target={cell.defender}>
                      <span class="cell__dash">—</span>
                    </td>
                  );
                }
                const cls = v > 0 ? 'yield-training' : 'yield-misc';
                return (
                  <td class={`cell ${cls}`} data-target={cell.defender}>
                    <div class="counter">
                      <span class="counter__val">{v > 0 ? '+' : ''}{v}%</span>
                      {cell.sources.length > 0 && (
                        <span class="counter__sources"><LinkedText text={cell.sources.join(' · ')} showIcons={false} /></span>
                      )}
                    </div>
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <div class="legends">
    <div class="legend">
      <span class="legend__label">Read it</span>
      <span>Row = which class is attacking. Column = the defender's trait. A "+50% vs Mounted" cell means Polearm units (Spearman etc.) get +50% strength when fighting any Mounted-trait unit.</span>
    </div>
    <div class="legend">
      <span class="legend__label">Classic rules of thumb</span>
      <span class="chip yield-training">Polearm beats Mounted</span>
      <span class="chip yield-training">Mounted beats Ranged</span>
      <span class="chip yield-training">Infantry beats Polearm</span>
      <span class="chip yield-misc">Ranged softens before melee</span>
    </div>
  </div>

  <style>
    .lede {
      color: var(--text-dim);
      max-width: 64ch;
      margin: 0 0 1rem;
      font-size: 0.84rem;
      line-height: 1.5;
    }
    .lede code {
      background: var(--bg-elev);
      padding: 0.05rem 0.35rem;
      border-radius: 3px;
      border: 1px solid var(--border);
    }
    .ctier { margin: 0 0 1.1rem; }
    .ctier__h {
      font-family: var(--font-display);
      font-size: 0.95rem;
      font-weight: 600;
      letter-spacing: 0.03em;
      color: var(--text-dim);
      margin: 0 0 0.4rem;
    }
    .ctier__h--matrix { margin-top: 1.6rem; }
    .ntbl--counters .rowlabel { min-width: 13rem; }
    .rl__icon { width: 1.15em; height: 1.15em; object-fit: contain; vertical-align: -0.2em; margin-right: 0.3em; }
    .cell--picks { padding: 0.3rem 0.45rem; }
    .pick {
      display: inline-flex; align-items: center; gap: 0.3rem;
      margin: 0.12rem 0.18rem 0.12rem 0;
      padding: 0.14rem 0.4rem;
      border: 1px solid color-mix(in srgb, var(--yield-bg) 55%, var(--border));
      border-left: 3px solid var(--yield-bg);
      border-radius: 5px;
      background: color-mix(in srgb, var(--yield-bg) 12%, var(--bg-elev));
      color: var(--text);
      font-size: 0.74rem;
      text-decoration: none;
      white-space: nowrap;
    }
    .pick:hover { background: color-mix(in srgb, var(--yield-bg) 22%, var(--bg-elev)); text-decoration: none; }
    .pick__icon { width: 1.1em; height: 1.1em; object-fit: contain; }
    .pick__dmg {
      font-family: var(--font-mono);
      font-weight: 600;
      font-size: 0.72rem;
      color: var(--gold);
    }
    .rl { display: flex; flex-direction: column; gap: 0.1rem; }
    .rl__name {
      font-family: var(--font-display);
      font-size: 0.84rem;
      color: var(--text);
      font-weight: 600;
      letter-spacing: 0.02em;
    }
    .rl__sources {
      font-family: var(--font-mono);
      font-size: 0.55rem;
      color: var(--text-faint);
      letter-spacing: 0.04em;
      text-transform: none;
    }
    .counter { display: flex; flex-direction: column; align-items: flex-start; gap: 0.1rem; }
    .counter__val {
      font-family: var(--font-mono);
      font-size: 0.95rem;
      font-weight: 600;
      letter-spacing: 0.02em;
    }
    .counter__sources {
      font-size: 0.6rem;
      opacity: 0.85;
      letter-spacing: 0.02em;
    }
    .nhdr--family {
      background: var(--bg-elev-2);
      color: var(--text);
      border-bottom: 2px solid var(--border-strong);
      background-image: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(0,0,0,0.18));
    }
  </style>
</Base>
