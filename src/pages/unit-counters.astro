---
import Base from '../layouts/Base.astro';
import LinkedText from '../components/LinkedText.astro';
import units from '../data/units.json';
import { counterBonus, attackDamage } from '../lib/combat';

const base = import.meta.env.BASE_URL;

type Unit = typeof units[number];

// Rock-paper-scissors matrix. Each row is "Attacker class" → which trait it
// counters and by how much. Built entirely from the XML counter modifiers on
// each unit's effect tree (own effects + trait effects): rows are the
// primary classes present in the data, columns the union of traits any
// vs-modifier actually targets — so a patch adding a new modifier target
// (e.g. Camel's "+50% vs Horse" → the Horse column) appears automatically.

const CLASS_ORDER = ['Infantry', 'Polearm', 'Mounted', 'Ranged', 'Siege', 'Melee', 'Horse'];
const orderKey = (s: string) => { const i = CLASS_ORDER.indexOf(s); return i < 0 ? 99 : i; };
const matrixPool = (units as Unit[]).filter(u => u.isCombat && u.isMilitary && !u.isWater);
const ATTACKER_CLASSES = [...new Set(matrixPool.map(u => u.primaryLabel).filter(Boolean))]
  .sort((a, b) => orderKey(a) - orderKey(b) || a.localeCompare(b));
const DEFENDER_TARGETS = [...new Set(matrixPool.flatMap(u => u.counters
  .filter(c => c.kind === 'vs' || c.kind === 'melee vs' || c.kind === 'attack vs')
  .map(c => c.target)))]
  .sort((a, b) => orderKey(a) - orderKey(b) || a.localeCompare(b));

// Pick a small set of "iconic" units per class for the row legend.
function pickIconic(cls: string): Unit[] {
  return (units as Unit[])
    .filter(u => u.isCombat && u.isMilitary && u.primaryLabel === cls && !u.nationPrereq)
    .sort((a, b) => a.strength - b.strength)
    .slice(0, 3);
}

interface CellGroup { value: number; names: string[] }

// One group per distinct modifier value, so units are never listed under a
// number they don't have (Spearman is +50% vs Mounted, only Pikeman is +100%).
function cellFor(attackerClass: string, defender: string): CellGroup[] {
  const matchers: Unit[] = (units as Unit[])
    .filter(u => u.isCombat && u.isMilitary && u.primaryLabel === attackerClass);
  const perUnit = new Map<string, number>();
  for (const u of matchers) {
    let v = 0;
    for (const c of u.counters) {
      if (c.target !== defender) continue;
      // Attacker's perspective (row = attacking class), mirroring
      // Unit.cs attackUnitStrength: 'vs' and 'attack vs' always apply;
      // the melee bucket only applies if the attacker itself is melee —
      // a Horse Archer carries Mounted's "+50% melee vs Siege" line but
      // never benefits when attacking.
      if (c.kind === 'vs' || c.kind === 'attack vs') v += c.value;
      else if (c.kind === 'melee vs' && u.isMelee) v += c.value;
    }
    if (v !== 0 && !perUnit.has(u.name)) perUnit.set(u.name, v);
  }
  const byValue = new Map<number, string[]>();
  for (const [name, v] of perUnit) {
    if (!byValue.has(v)) byValue.set(v, []);
    byValue.get(v)!.push(name);
  }
  return [...byValue.entries()]
    .sort((a, b) => b[0] - a[0])
    .map(([value, names]) => ({ value, names }));
}

const matrix = ATTACKER_CLASSES.map(cls => ({
  cls,
  iconic: pickIconic(cls),
  cells: DEFENDER_TARGETS.map(d => ({ defender: d, groups: cellFor(cls, d) })),
}));

// ── Per-unit counter list (the spreadsheet's "If you're facing…" view) ──
// Damage math lives in src/lib/combat.ts — the game's own
// InfoHelpers.getAttackDamage with both sides' anti-trait modifiers.
// isMilitary excludes Scouts, Explorers, and religion Disciples — they can
// technically fight but aren't army units (their primaryLabel is Infantry,
// so trait filters won't catch them).
const landCombat = (units as Unit[]).filter(u => u.isCombat && u.isMilitary && !u.isWater);

interface CounterPick {
  name: string; slug: string; iconSlug: string; cls: string;
  nation: string | null; str: number; techCost: number;
  deal: number; take: number; net: number;
}

// A counter is who wins the TRADE, not who hits hardest: a Spearman deals 8 to
// a Horse Archer but takes 8 back (net 0), while a Camel Archer deals the same
// 8 and takes only 4 (net +4). The XML shows why — the Spearman's anti-Mounted
// line is `melee vs`, which Unit.cs applies only when the melee side is
// involved (nothing on defense against a ranged attacker), whereas the Camel's
// anti-Horse is a plain `vs` that applies attacking AND defending.
//   deal = we attack them · take = they attack us.
// No counterattack is modelled: Unit.getCounterAttackDamage returns 0 unless
// the ATTACKER is melee, so a ranged attacker takes no return fire.
function countersFor(def: Unit): CounterPick[] {
  const picks: CounterPick[] = [];
  for (const att of landCombat) {
    const deal = attackDamage(att, def);
    if (deal < 7) continue;              // the sheet's "significant" bar
    const take = attackDamage(def, att);
    picks.push({
      name: att.name, slug: att.slug, iconSlug: att.iconSlug,
      cls: att.primaryLabel || '', nation: att.nationLabel || null,
      str: att.strength, techCost: att.techCost,
      deal, take, net: deal - take,
    });
  }
  picks.sort((a, b) => b.net - a.net || b.deal - a.deal || a.name.localeCompare(b.name));
  // One entry per name (upgrade dupes). Every pick is rendered — the filters
  // below decide what shows, and nothing is silently truncated.
  const seen = new Set<string>();
  return picks.filter(p => !seen.has(p.name) && seen.add(p.name) !== undefined);
}

// Nation filter options (e.g. you + your opponent). Generic units always show.
const nationOptions = [...new Set((units as Unit[]).map(u => u.nationLabel).filter(Boolean))].sort();

const defenders = [...landCombat]
  .sort((a, b) => b.strength - a.strength || a.name.localeCompare(b.name))
  .map(def => ({ def, picks: countersFor(def) }));

// Group by strength tier, and within each tier split unique units out from the
// standard ones — a UU only matters in some matchups, so mixing them into one
// list makes the generic tier harder to read.
const groups = new Map<string, { tier: number; uu: boolean; list: typeof defenders }>();
for (const d of defenders) {
  const tier = Math.round(d.def.strength / 10);
  const uu = !!d.def.nationLabel;
  const key = `${tier}-${uu ? 'u' : 'g'}`;
  if (!groups.has(key)) groups.set(key, { tier, uu, list: [] });
  groups.get(key)!.list.push(d);
}
// Tier descending; unique units before standard within a tier.
const tierList = [...groups.values()].sort(
  (a, b) => b.tier - a.tier || Number(b.uu) - Number(a.uu));

// Wider ramp so a +9 reads instantly hotter than a +3.
const netClass = (n: number) =>
  n >= 8 ? 'n8' : n >= 6 ? 'n6' : n >= 4 ? 'n4' : n >= 2 ? 'n2' : n >= 1 ? 'n1' : n === 0 ? 'n0' : 'nn';
const fmtNet = (n: number) => (n > 0 ? `+${n}` : `${n}`);
---

<Base pageFilter
  title="Unit Counters at-a-glance"
  active="unit-counters"
  pageMark="⚔️"
  pageStats={[
    { label: 'units covered', value: defenders.length },
    { label: 'attacker classes', value: ATTACKER_CLASSES.length },
  ]}
>
  <p class="lede">
    <b>If you're facing a unit, build these</b> — ranked by the trade, not raw damage.
    Each pick reads <span class="key"><b class="k-str">STR</b> · unit · <b class="k-deal">dealt</b>/<b class="k-take">taken</b> · <b class="k-net">net</b></span>,
    where <i>dealt</i> is your damage attacking it and <i>taken</i> is its damage attacking you
    (<code>6 × StrAtt / StrDef</code>, both sides' anti-trait modifiers, full HP, open terrain,
    no promotions — the same numbers as <a href={`${base}unit-damage`}>Unit Damage</a>).
    Research costs live on <a href={`${base}science-to-unlock`}>Total Science to Unlock</a>.
  </p>

  <div class="natbar">
    <span class="natbar__label">Nations</span>
    <select id="nation-a" class="natbar__sel" aria-label="Your nation">
      <option value="">All nations</option>
      {nationOptions.map(n => <option value={n}>{n}</option>)}
    </select>
    <span class="natbar__vs">vs</span>
    <select id="nation-b" class="natbar__sel" aria-label="Opponent nation">
      <option value="">All nations</option>
      {nationOptions.map(n => <option value={n}>{n}</option>)}
    </select>
    <span class="natbar__hint">Pick your nation and your opponent's to hide everyone else's unique units. Generic units always show.</span>
  </div>

  <div class="ctrl">
    <label class="ctrl__tog" title="Hide attackers with a higher strength stat than the defender">
      <input type="checkbox" id="hide-stronger" /> hide stronger attackers
    </label>
    <label class="ctrl__tog" title="Hide attackers whose cumulative tech cost (no starting techs; laws for unique units) exceeds the defender's">
      <input type="checkbox" id="hide-costlier" checked /> hide attackers needing more tech
    </label>
    <label class="ctrl__tog" title="Drop attackers that lose the exchange; even trades (net 0) still show">
      <input type="checkbox" id="hide-losing" /> hide losing trades
    </label>
    <span class="scale" aria-hidden="true">
      <span class="netbig nn">−2</span>
      <span class="netbig n0">0</span>
      <span class="netbig n1">+1</span>
      <span class="netbig n2">+2</span>
      <span class="netbig n4">+4</span>
      <span class="netbig n6">+6</span>
      <span class="netbig n8">+8</span>
    </span>
  </div>

  {tierList.map(({ tier, uu, list }) => (
    <section class="ctier">
      <h2 class="ctier__h">
        Strength {tier}
        <span class={`ctier__kind ${uu ? 'is-uu' : ''}`}>{uu ? 'unique units' : 'standard units'}</span>
      </h2>
      <div class="grid">
        <div class="grid__scroll">
          <table class="ntbl ntbl--counters">
            <tbody>
              {list.map(({ def, picks }) => (
                <tr id={def.slug} data-nation={def.nationLabel || ''} data-str={def.strength} data-tech={def.techCost}>
                  <th class="rowlabel" scope="row">
                    <div class="rl">
                      <span class="rl__name">
                        <img class="rl__icon" src={`${base}img/icons/units/${def.iconSlug}.png`} alt="" loading="lazy" />
                        {def.name}
                      </span>
                      <span class="rl__sources">{def.primaryLabel}{def.nationLabel ? ` · ${def.nationLabel}` : ''}{def.isTribal ? ' · tribal' : ''}</span>
                    </div>
                  </th>
                  <td class="cell cell--picks">
                    {picks.length === 0 ? (
                      <span class="cell__dash">no significant counters</span>
                    ) : (
                      <>
                      <span class="cell__none cell__dash">none under current filters</span>
                      {picks.map(p => (
                        <a class="pick" data-nation={p.nation || ''} data-str={p.str} data-tech={p.techCost} data-net={p.net} href={`${base}units#${p.slug}`} title={`${p.name}${p.nation ? ` (${p.nation})` : ''} — ${p.cls}, STR ${p.str / 10}, ${p.techCost} science to unlock. Deals ${p.deal} attacking it; takes ${p.take} when it attacks. Net ${fmtNet(p.net)}.`}>
                          <span class="pick__str">{p.str / 10}</span>
                          <img class="pick__icon" src={`${base}img/icons/units/${p.iconSlug}.png`} alt="" loading="lazy" />
                          <span class="pick__name">{p.name}</span>
                          <span class="pick__xch"><b>{p.deal}</b>/{p.take}</span>
                          <span class={`netbig ${netClass(p.net)}`}>{fmtNet(p.net)}</span>
                        </a>
                      ))}
                      </>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  ))}

  <h2 class="ctier__h ctier__h--matrix">Class overview</h2>
  <div class="grid">
    <div class="grid__scroll">
      <table class="ntbl">
        <colgroup>
          <col class="ntbl__rowlabel-col" />
          {DEFENDER_TARGETS.map(d => <col data-target={d} />)}
        </colgroup>
        <thead>
          <tr>
            <th class="rowlabel rowlabel--corner">
              <span class="rowlabel__small">Target →</span>
              <span class="rowlabel__big">Attacker ↓</span>
            </th>
            {DEFENDER_TARGETS.map(d => (
              <th class="nhdr nhdr--family" data-target={d}>
                <div class="nhdr__inner">
                  <span class="nhdr__name">{d}</span>
                </div>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {matrix.map(row => (
            <tr>
              <th class="rowlabel" scope="row">
                <div class="rl">
                  <span class="rl__name">{row.cls}</span>
                  <span class="rl__sources">
                    {row.iconic.map(u => u.name).join(', ')}
                  </span>
                </div>
              </th>
              {row.cells.map(cell => {
                if (cell.groups.length === 0) {
                  return (
                    <td class="cell is-empty" data-target={cell.defender}>
                      <span class="cell__dash">—</span>
                    </td>
                  );
                }
                return (
                  <td class="cell" data-target={cell.defender}>
                    {cell.groups.map(g => (
                      <div class="counter">
                        <span class={`counter__val ${g.value > 0 ? 'is-pos' : 'is-neg'}`}>{g.value > 0 ? '+' : ''}{g.value}%</span>
                        <span class="counter__sources"><LinkedText text={g.names.join(' · ')} showIcons={false} /></span>
                      </div>
                    ))}
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <div class="legends">
    <div class="legend">
      <span class="legend__label">Read it</span>
      <span>Row = which class is attacking. Column = the defender's trait. A "+50% vs Mounted" cell means Polearm units (Spearman etc.) get +50% strength when fighting any Mounted-trait unit. Green = advantage, red = penalty.</span>
    </div>
  </div>

  <script is:inline>
    (function () {
      const selA = document.getElementById('nation-a');
      const selB = document.getElementById('nation-b');
      const chkStr = document.getElementById('hide-stronger');
      const chkTech = document.getElementById('hide-costlier');
      if (!selA || !selB) return;
      const chkLose = document.getElementById('hide-losing');
      const KEY = 'ow-nation-filter';
      const STR_KEY = 'ow-str-filter';
      const TECH_KEY = 'ow-tech-filter';
      const LOSE_KEY = 'ow-lose-filter';
      try {
        const saved = JSON.parse(localStorage.getItem(KEY) || '[]');
        if (saved[0]) selA.value = saved[0];
        if (saved[1]) selB.value = saved[1];
        // Strength + losing-trade filters default OFF (explicit '1' opts in);
        // the tech filter defaults ON (explicit '0' opts out).
        if (chkStr) chkStr.checked = localStorage.getItem(STR_KEY) === '1';
        if (chkTech) chkTech.checked = localStorage.getItem(TECH_KEY) !== '0';
        if (chkLose) chkLose.checked = localStorage.getItem(LOSE_KEY) === '1';
      } catch {}
      function apply() {
        const chosen = [selA.value, selB.value].filter(Boolean);
        const ok = (n) => !n || chosen.length === 0 || chosen.includes(n);
        const hideStronger = chkStr && chkStr.checked;
        const hideCostlier = chkTech && chkTech.checked;
        const hideLosing = chkLose && chkLose.checked;
        for (const tr of document.querySelectorAll('.ctier tbody tr')) {
          const rowOk = ok(tr.dataset.nation || '');
          tr.classList.toggle('nat-hidden', !rowOk);
          if (!rowOk) continue;
          const defStr = +(tr.dataset.str || 0);
          const defTech = +(tr.dataset.tech || 0);
          let shown = 0;
          // No cap — every pick that clears the filters is shown.
          for (const p of tr.querySelectorAll('.pick')) {
            const show = ok(p.dataset.nation || '')
              && (!hideStronger || +(p.dataset.str || 0) <= defStr)
              && (!hideCostlier || +(p.dataset.tech || 0) <= defTech)
              && (!hideLosing || +(p.dataset.net || 0) >= 0);
            if (show) shown++;
            p.classList.toggle('nat-hidden', !show);
          }
        }
        for (const sec of document.querySelectorAll('.ctier')) {
          sec.classList.toggle('nat-hidden', !sec.querySelector('tbody tr:not(.nat-hidden):not(.is-hidden)'));
        }
      }
      function onChange() {
        try {
          localStorage.setItem(KEY, JSON.stringify([selA.value, selB.value]));
          if (chkStr) localStorage.setItem(STR_KEY, chkStr.checked ? '1' : '0');
          if (chkTech) localStorage.setItem(TECH_KEY, chkTech.checked ? '1' : '0');
          if (chkLose) localStorage.setItem(LOSE_KEY, chkLose.checked ? '1' : '0');
        } catch {}
        apply();
      }
      selA.addEventListener('change', onChange);
      selB.addEventListener('change', onChange);
      if (chkStr) chkStr.addEventListener('change', onChange);
      if (chkTech) chkTech.addEventListener('change', onChange);
      if (chkLose) chkLose.addEventListener('change', onChange);
      apply();
    })();
  </script>

  <script is:inline>
    // Header search filters the defender rows by unit name.
    (function () {
      const input = document.getElementById('page-filter');
      if (!input) return;
      function apply() {
        const q = (input.value || '').trim().toLowerCase();
        for (const tr of document.querySelectorAll('.ctier tbody tr')) {
          const label = tr.querySelector('.rl');
          const text = label ? label.textContent.toLowerCase() : '';
          tr.classList.toggle('is-hidden', !!q && !text.includes(q));
        }
        for (const sec of document.querySelectorAll('.ctier')) {
          sec.classList.toggle('is-hidden', !sec.querySelector('tbody tr:not(.nat-hidden):not(.is-hidden)'));
        }
      }
      input.addEventListener('input', apply);
    })();
  </script>

  <style>
    .lede {
      color: var(--text-dim);
      max-width: 64ch;
      margin: 0 0 1rem;
      font-size: 0.84rem;
      line-height: 1.5;
    }
    .lede code {
      background: var(--bg-elev);
      padding: 0.05rem 0.35rem;
      border-radius: 3px;
      border: 1px solid var(--border);
    }
    .ctier { margin: 0 0 1.1rem; }
    .ctier__h {
      font-family: var(--font-display);
      font-size: 0.95rem;
      font-weight: 600;
      letter-spacing: 0.03em;
      color: var(--text-dim);
      margin: 0 0 0.4rem;
    }
    .ctier__h--matrix { margin-top: 1.6rem; }
    .ntbl--counters .rowlabel { width: 13rem; text-align: left; vertical-align: top; }
    .ntbl--counters .rl { align-items: flex-start; }
    .rl__icon { width: 1.15em; height: 1.15em; object-fit: contain; vertical-align: -0.2em; margin-right: 0.3em; }
    .cell--picks { padding: 0.3rem 0.6rem; }
    /* Shown only when every pick in the cell is filtered out. */
    .cell--picks .cell__none { display: none; }
    .cell--picks:not(:has(.pick:not(.nat-hidden))) .cell__none { display: inline; }
    .cell--picks { display: flex; flex-wrap: wrap; gap: 0.35rem; }
    .pick {
      display: inline-flex; align-items: center; gap: 0.32rem;
      background: var(--bg); border: 1px solid var(--border); border-radius: 999px;
      padding: 0.18rem 0.4rem 0.18rem 0.28rem;
      color: var(--text-dim); text-decoration: none; white-space: nowrap;
      transition: border-color 0.12s, background 0.12s;
    }
    .pick:hover { text-decoration: none; border-color: var(--accent); background: color-mix(in srgb, var(--accent) 8%, var(--bg)); }
    .pick__icon { width: 18px; height: 18px; object-fit: contain; }
    .pick__name { font-size: 0.78rem; color: var(--text); }
    .pick__str {
      font-family: var(--font-mono); font-size: 0.66rem; font-weight: 700; color: var(--text-faint);
      background: var(--bg-elev-2); border-radius: 4px; padding: 0.02rem 0.28rem;
      min-width: 1.1rem; text-align: center;
    }
    .pick__xch { font-family: var(--font-mono); font-size: 0.68rem; color: #7fa8d0; }
    .pick__xch b { color: #e08a5f; font-weight: 700; }

    /* Net badge — saturated ramp so big trades read at a glance. */
    .netbig {
      font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-weight: 700;
      font-size: 0.78rem; text-align: center; border-radius: 5px; padding: 0.05rem 0.34rem;
      min-width: 2rem; display: inline-block; color: #1a1206;
    }
    .nn { background: #3f6187; color: #cddcea; }
    .n0 { background: #4a4740; color: #b9b2a4; }
    .n1 { background: #b99447; }
    .n2 { background: #d99a3c; }
    .n4 { background: #e07a33; }
    .n6 { background: #e2542c; color: #fff2ec; }
    .n8 { background: #d3231f; color: #fff; box-shadow: 0 0 0 1px #ff6a5e55, 0 0 10px #d3231f55; }

    /* Filter row + net scale legend */
    .ctrl { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem 1.1rem; margin: 0 0 1.1rem; }
    .ctrl__tog { font-size: 0.78rem; color: var(--text-dim); display: inline-flex; align-items: center; gap: 0.3rem; cursor: pointer; }
    .ctrl__tog input { accent-color: var(--accent); }
    .scale { display: inline-flex; gap: 2px; margin-left: auto; }

    .key { font-family: var(--font-mono); font-size: 0.8em; background: var(--bg-elev-2); border-radius: 5px; padding: 0.05rem 0.35rem; white-space: nowrap; }
    .k-str { color: var(--text-faint); } .k-deal { color: #e08a5f; } .k-take { color: #7fa8d0; } .k-net { color: var(--accent); }

    .ctier__kind {
      font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.08em;
      text-transform: uppercase; color: var(--text-faint); margin-left: 0.45rem;
      border: 1px solid var(--border); border-radius: 4px; padding: 0.02rem 0.32rem;
    }
    .ctier__kind.is-uu {
      color: color-mix(in srgb, var(--accent) 85%, var(--text));
      border-color: color-mix(in srgb, var(--accent) 45%, transparent);
      background: color-mix(in srgb, var(--accent) 12%, transparent);
    }
    .rl { display: flex; flex-direction: column; gap: 0.1rem; }
    .rl__name {
      font-family: var(--font-display);
      font-size: 0.84rem;
      color: var(--text);
      font-weight: 600;
      letter-spacing: 0.02em;
    }
    .rl__sources {
      font-family: var(--font-mono);
      font-size: 0.55rem;
      color: var(--text-faint);
      letter-spacing: 0.04em;
      text-transform: none;
    }
    .counter { display: flex; flex-direction: column; align-items: flex-start; gap: 0.05rem; padding: 0.12rem 0; }
    .counter__val {
      font-family: var(--font-mono);
      font-size: 0.95rem;
      font-weight: 600;
      letter-spacing: 0.02em;
    }
    .counter__val.is-pos { color: #4caf7d; }
    .counter__val.is-neg { color: #c25555; }
    .counter__sources {
      font-size: 0.6rem;
      opacity: 0.85;
      letter-spacing: 0.02em;
    }
    .nhdr--family {
      background: var(--bg-elev-2);
      color: var(--text);
      border-bottom: 2px solid var(--border-strong);
      background-image: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(0,0,0,0.18));
    }
  </style>
</Base>
