---
import Base from '../layouts/Base.astro';
import LinkedText from '../components/LinkedText.astro';
import Term from '../components/Term.astro';
import projects from '../data/projects.json';
import { classifyYield } from '../lib/entities';

const base = import.meta.env.BASE_URL;

const yieldIcon = (key: string) => `${base}img/icons/yields/${key}.png`;

const buildable = projects.filter(p => !p.eventOnly);
const eventOnly = projects.filter(p => p.eventOnly);

// Pre-classify a JSON blob per project for the header-search filter.
const searchBlobs: Record<string, string> = {};
for (const p of projects) {
  searchBlobs[p.slug] = JSON.stringify(p).toLowerCase();
}

// Prereq kind → tooltip explaining where the requirement lives.
const PREREQ_KIND_TITLE: Record<string, string> = {
  tech: 'Technology required',
  project: 'Requires this project first',
  culture: 'Minimum city culture level',
  city: 'City must have this',
  player: 'Player must have this',
  capital: 'Capital must have this',
  option: 'Game option',
  flag: 'Situational requirement',
};
---

<Base
  title="Projects"
  active="projects"
  pageMark="🏗️"
  pageStats={[
    { label: 'projects', value: projects.length },
    { label: 'buildable', value: buildable.length },
    { label: 'event-only', value: eventOnly.length },
  ]}
  description={`All ${projects.length} city projects of Old World — ${buildable.length} buildable from the city production menu (Walls, Treasury, Forum, Festival, Decree…) plus ${eventOnly.length} event-granted projects, with cost per yield, tech/culture/family prerequisites, and humanized effects pulled straight from the game's project.xml.`}
>
  <div class="legends">
    <div class="legend" id="avail-filter" role="group" aria-label="Filter by availability">
      <span class="legend__label">Show</span>
      <button type="button" class="chip chip--filter is-on" data-avail="all">All</button>
      <button type="button" class="chip chip--filter" data-avail="build">Buildable</button>
      <button type="button" class="chip chip--filter" data-avail="event">Event-only</button>
    </div>
  </div>

  <div class="grid__searchnote" id="grid-searchnote" hidden></div>

  <div class="grid" id="projects-grid">
    <div class="grid__scroll">
      <table class="ntbl ptbl">
        <colgroup>
          <col class="ptbl__name-col" />
          <col class="ptbl__cost-col" />
          <col class="ptbl__req-col" />
          <col class="ptbl__fx-col" />
        </colgroup>
        <thead>
          <tr>
            <th class="rowlabel rowlabel--corner"><span class="nhdr__name">Project</span></th>
            <th class="nhdr nhdr--col" title="Production cost (first chip = yield the city produces it with; the rest are paid up front)"><span class="nhdr__name">Cost</span></th>
            <th class="nhdr nhdr--col"><span class="nhdr__name">Requirements</span></th>
            <th class="nhdr nhdr--col"><span class="nhdr__name">Effects</span></th>
          </tr>
        </thead>
        <tbody>
          {projects.map(p => (
            <tr
              data-project={p.slug}
              data-avail={p.eventOnly ? 'event' : 'build'}
              id={p.slug}
            >
              <th class="rowlabel rowlabel--proj" scope="row" data-sortval={p.sortName}>
                <div class="pname">
                  {p.icon ? (
                    <img class="pname__art" src={`${base}${p.icon}`} alt="" loading="lazy" onerror="this.style.display='none'" />
                  ) : (
                    <span class="pname__art pname__art--ph" aria-hidden="true">🏗️</span>
                  )}
                  <div class="pname__text">
                    <span class="pname__name">{p.name}</span>
                    <div class="pname__meta">
                      {p.eventOnly && <span class="chip chip--event" title="Granted by events or missions — not in the normal build menu">Event</span>}
                      {p.dlc && <span class="chip chip--dlc" title={p.source}>DLC</span>}
                      {p.repeat && <span class="chip chip--trait" title="Can be built repeatedly">Repeatable</span>}
                      {p.unique && <span class="chip chip--trait" title="Once per player">Unique</span>}
                      {p.maxCount === 1 && <span class="chip chip--trait" title="At most one per city">1 per city</span>}
                      {p.maxCount > 1 && <span class="chip chip--trait" title={`At most ${p.maxCount} per city`}>{p.maxCount} per city</span>}
                      {p.noHurry && <span class="chip chip--trait" title="Cannot be hurried">No hurry</span>}
                      {p.captureDestroy && <span class="chip chip--trait" title="Destroyed when the city is captured">Lost on capture</span>}
                    </div>
                  </div>
                </div>
              </th>

              {/* Cost — first chip is the production yield, the rest up-front */}
              {p.cost.length === 0 ? (
                <td class="cell cell--cost is-empty"><span class="cell__dash">—</span></td>
              ) : (
                <td class="cell cell--cost" data-sortval={p.cost[0].value}>
                  {p.cost.map(c => (
                    <span class={`costchip yield-${c.yield}`}>
                      <img class="costchip__ico" src={yieldIcon(c.yield)} alt={c.yield} onerror="this.style.display='none'" />
                      {c.value}
                    </span>
                  ))}
                </td>
              )}

              {/* Requirements */}
              {p.prereqs.length === 0 ? (
                <td class="cell cell--req is-empty"><span class="cell__dash">—</span></td>
              ) : (
                <td class="cell cell--req">
                  {p.prereqs.map((pr: any) => (
                    pr.kind === 'tech' && pr.id ? (
                      <span class="req-tag req-tag--tech" title={PREREQ_KIND_TITLE.tech}>
                        <Term id={pr.id} />
                      </span>
                    ) : (
                      <span class={`req-tag req-tag--${pr.kind}`} title={PREREQ_KIND_TITLE[pr.kind] || ''}>
                        <LinkedText text={pr.label} showIcons={false} />
                      </span>
                    )
                  ))}
                </td>
              )}

              {/* Effects */}
              {p.effects.length === 0 ? (
                <td class="cell is-empty"><span class="cell__dash">—</span></td>
              ) : (
                <td class="cell cell--effects">
                  {p.effects.map((text: string) => {
                    const yk = classifyYield(text)?.toLowerCase() || 'misc';
                    return (
                      <div class={`effect yield-${yk}`}>
                        <LinkedText text={text} showIcons={false} iconsForYields={true} />
                      </div>
                    );
                  })}
                </td>
              )}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <script type="application/json" id="project-search-blobs" set:html={JSON.stringify(searchBlobs)}></script>
  <script is:inline>
    // Availability filter chips + header search, composed. Mirrors the
    // wonders page's filter wiring, with one single-choice facet.
    (function () {
      const input = document.getElementById('site-search');
      const blobNode = document.getElementById('project-search-blobs');
      const grid = document.getElementById('projects-grid');
      const note = document.getElementById('grid-searchnote');
      const filter = document.getElementById('avail-filter');
      if (!blobNode || !grid || !filter) return;
      let blobs;
      try { blobs = JSON.parse(blobNode.textContent || '{}'); } catch { return; }

      const rows = Array.from(grid.querySelectorAll('tr[data-project]'));
      const chips = Array.from(filter.querySelectorAll('[data-avail]'));
      let avail = 'all';

      function apply() {
        const q = ((input && input.value) || '').trim().toLowerCase();
        let hiddenBySearch = 0;
        for (const row of rows) {
          const slug = row.getAttribute('data-project');
          const matchesSearch = !q || (blobs[slug] || '').includes(q);
          const matchesAvail = avail === 'all' || row.getAttribute('data-avail') === avail;
          if (!matchesSearch) hiddenBySearch++;
          row.classList.toggle('is-hidden', !(matchesSearch && matchesAvail));
        }
        if (note) {
          if (q && hiddenBySearch > 0) {
            note.hidden = false;
            note.textContent =
              'Showing ' + (rows.length - hiddenBySearch) + ' of ' + rows.length +
              ' projects matching "' + (input ? input.value : '') + '"';
          } else {
            note.hidden = true;
            note.textContent = '';
          }
        }
      }

      chips.forEach((chip) => chip.addEventListener('click', () => {
        avail = chip.getAttribute('data-avail');
        chips.forEach((c) => c.classList.toggle('is-on', c === chip));
        apply();
      }));
      if (input) input.addEventListener('input', apply);
      apply();
    })();
  </script>
  <script is:inline>
    // Click-to-sort columns (same approach as wonders.astro; honors
    // data-sortval so the name column sorts alphabetically and the cost
    // column by its production cost).
    (function () {
      const table = document.querySelector('#projects-grid table.ntbl');
      if (!table || !table.tHead) return;
      const ths = Array.from(table.tHead.rows[0].cells);
      ths.forEach((th, ci) => {
        if (ci > 1) return; // only Project + Cost sort usefully
        th.classList.add('is-sortable');
        th.addEventListener('click', () => {
          const tb = table.tBodies[0];
          const rows = Array.from(tb.rows);
          const asc = th.getAttribute('aria-sort') !== 'ascending';
          ths.forEach(h => h.removeAttribute('aria-sort'));
          th.setAttribute('aria-sort', asc ? 'ascending' : 'descending');
          const val = r => {
            const c = r.cells[ci];
            const sv = c && c.getAttribute && c.getAttribute('data-sortval');
            const t = (sv != null ? sv : (c ? c.textContent : '')).trim();
            const n = parseFloat(t.replace(/[^0-9.\-]/g, ''));
            return { t, n: (t && !isNaN(n)) ? n : null };
          };
          rows.sort((a, b) => {
            const ka = val(a), kb = val(b);
            let r;
            if (ka.n !== null && kb.n !== null) r = ka.n - kb.n;
            else if (ka.n !== null) r = -1;
            else if (kb.n !== null) r = 1;
            else r = ka.t.localeCompare(kb.t);
            return asc ? r : -r;
          });
          rows.forEach(r => tb.appendChild(r));
        });
      });
    })();
  </script>
</Base>

<style>
  /* Column widths */
  .ptbl__name-col { width: 17rem; }
  .ptbl__cost-col { width: 8rem; }
  .ptbl__req-col  { width: 15rem; }
  .ptbl__fx-col   { width: auto; }

  /* Column headers (same affordance as wonders / urban improvements) */
  .nhdr--col {
    background: var(--bg-elev-2);
    color: var(--text);
    background-image: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(0,0,0,0.18));
    border-bottom: 2px solid var(--border-strong);
    text-align: left;
    padding: 0.45rem 0.55rem;
  }
  .nhdr__name { font-family: var(--font-display); font-size: 0.78rem; letter-spacing: 0.03em; display: inline-flex; align-items: center; gap: 0.3rem; }
  .nhdr.is-sortable, .rowlabel--corner.is-sortable { cursor: pointer; user-select: none; }
  .nhdr.is-sortable:hover, .rowlabel--corner.is-sortable:hover { filter: brightness(1.12); }
  .nhdr.is-sortable .nhdr__name::after,
  .rowlabel--corner.is-sortable .nhdr__name::after {
    content: '↕'; opacity: 0.35; margin-left: 0.25rem; font-size: 0.85em;
  }
  .nhdr[aria-sort='ascending'] .nhdr__name::after,
  .rowlabel--corner[aria-sort='ascending'] .nhdr__name::after { content: '↑'; opacity: 0.9; }
  .nhdr[aria-sort='descending'] .nhdr__name::after,
  .rowlabel--corner[aria-sort='descending'] .nhdr__name::after { content: '↓'; opacity: 0.9; }

  /* Project name cell: art + Cinzel name + badges */
  .rowlabel--proj { padding: 0.4rem 0.6rem; text-align: left; background: var(--bg-elev); }
  .pname { display: flex; gap: 0.5rem; align-items: flex-start; }
  .pname__art {
    width: 34px; height: 34px; object-fit: contain; flex-shrink: 0;
    border-radius: 5px; background: rgba(0,0,0,0.25);
  }
  .pname__art--ph { display: inline-flex; align-items: center; justify-content: center; font-size: 1.1rem; opacity: 0.5; }
  .pname__text { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }
  .pname__name { font-family: var(--font-display); font-weight: 600; font-size: 0.92rem; color: var(--text); letter-spacing: 0.02em; }
  .pname__meta { display: flex; gap: 0.25rem; flex-wrap: wrap; align-items: center; }

  /* Badge chips */
  .chip--event { background: color-mix(in srgb, #6b5ea6 30%, var(--bg-elev) 70%); color: var(--text); border: 1px solid color-mix(in srgb, #6b5ea6 50%, transparent); padding: 0.05rem 0.4rem; font-size: 0.64rem; }
  .chip--dlc { background: var(--bg-elev-2); color: var(--text-dim); border: 1px solid var(--border); padding: 0.05rem 0.4rem; font-size: 0.62rem; letter-spacing: 0.06em; font-family: var(--font-mono); text-transform: uppercase; }
  .chip--trait { background: var(--bg); color: var(--text-dim); border: 1px solid var(--border); padding: 0.05rem 0.4rem; font-size: 0.62rem; }

  /* Cost chips: yield-tinted pills with icon + mono number */
  .cell--cost { padding: 0.3rem 0.55rem; }
  .costchip {
    display: inline-flex; align-items: center; gap: 0.25rem;
    margin: 0.08rem 0.2rem 0.08rem 0;
    padding: 0.08rem 0.45rem;
    border-radius: 999px;
    font-family: var(--font-mono); font-variant-numeric: tabular-nums;
    font-weight: 600; font-size: 0.76rem;
    color: var(--text);
    background: color-mix(in srgb, var(--yield-bg, var(--bg-elev-2)) 30%, var(--bg-elev) 70%);
    border: 1px solid color-mix(in srgb, var(--yield-bg, var(--border)) 45%, transparent);
  }
  .costchip__ico { width: 13px; height: 13px; object-fit: contain; flex-shrink: 0; }

  /* Requirement tags */
  .cell--req { padding: 0.3rem 0.5rem; font-size: 0.74rem; }
  .req-tag {
    display: inline-block;
    padding: 0.05rem 0.4rem;
    margin: 0.08rem 0.2rem 0.08rem 0;
    border: 1px solid var(--border);
    border-radius: 4px;
    font-size: 0.7rem;
    color: var(--text-dim);
    background: var(--bg);
  }
  .req-tag--tech { border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); color: var(--text); }
  .req-tag--capital, .req-tag--player { border-style: dashed; }

  /* Effect mini-tiles — same look as the laws / wonders effect stacks */
  .cell--effects { padding: 0.3rem 0.5rem; }
  .cell--effects .effect {
    padding: 0.22rem 0.45rem;
    margin: 0.12rem 0;
    border-radius: var(--radius-sm);
    font-size: 0.74rem;
    line-height: 1.3;
    background: var(--yield-bg, var(--bg-elev));
    color: var(--yield-fg, var(--text));
    background-image: linear-gradient(180deg, rgba(255,255,255,0.05), rgba(0,0,0,0.2) 60%, rgba(0,0,0,0.32));
    border: 1px solid color-mix(in srgb, var(--yield-bg, var(--border)) 50%, #000 50%);
  }

  /* Availability filter chips */
  .chip--filter {
    cursor: pointer;
    padding: 0.1rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-elev);
  }
  .chip--filter.is-on {
    color: var(--text);
    border-color: color-mix(in srgb, var(--accent) 55%, var(--border));
    background: color-mix(in srgb, var(--accent) 18%, var(--bg-elev) 82%);
  }

  tr.is-hidden { display: none; }
</style>
