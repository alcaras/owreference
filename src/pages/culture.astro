---
import Base from '../layouts/Base.astro';
import LinkedText from '../components/LinkedText.astro';
import culture from '../data/culture.json';
import { classifyYield } from '../lib/entities';

const base = import.meta.env.BASE_URL;

const levels = culture.cultureLevels;
const devLevels = culture.developmentLevels;
const G = culture.globals;

const totalWonders = levels.reduce((n, l) => n + l.gates.wonders.length, 0);
const totalBuildings = levels.reduce((n, l) => n + l.gates.buildings.length, 0);
const totalUnits = levels.reduce((n, l) => n + l.gates.units.length, 0);

// Grounding (kept off the page): culture.xml (iThreshold, VP, miXP,
// capture/assimilate modifiers, EffectCity, Council projects), effectCity.xml
// (per-Pop consumption), improvement.xml / unit.xml / project.xml
// (CulturePrereq, CultureObsolete, RequiresCulture, MinimumCulture),
// development.xml, globalsInt.xml. Semantics: City.cs growCulture, canDoProject,
// doPlayerTurn (assimilation countdown); culture steps past Legendary scored in
// countCultureStepVPs; Player.cs countVP; Character.cs governor XP.
---

<Base
  title="Culture & Development"
  active="culture"
  pageMark="🎭"
  description="Old World's four city culture levels, Weak, Developing, Strong and Legendary: what each costs, what it gives and unlocks, and how it slows capture and assimilation. Also the Development game setup option."
  pageStats={[
    { label: 'culture levels', value: levels.length },
    { label: 'gated wonders', value: totalWonders },
    { label: 'gated buildings', value: totalBuildings },
    { label: 'gated units', value: totalUnits },
  ]}
>
  <p class="lede">
    What each city <b>culture level</b>, from Weak to Legendary, costs, gives
    and unlocks.
  </p>
  <p class="lede">
    A city gains culture from buildings, specialists, projects and events. When
    it reaches the level's threshold it advances and a culture event fires.
    Higher culture is worth more <LinkedText text="Victory Points" /> and unlocks
    better wonders, buildings, units and projects, but each
    <LinkedText text="Citizen" /> consumes more.
  </p>

  <section class="cl-section">
    <h2 class="cl-h2">The four culture levels</h2>
    <table class="cl-table">
      <thead>
        <tr>
          <th>Level</th>
          <th class="cl-num">Culture to advance</th>
          <th class="cl-num">VP per city</th>
          <th class="cl-num">Governor XP/turn</th>
          <th>Citizen consumption</th>
          <th>Level-up project</th>
        </tr>
      </thead>
      <tbody>
        {levels.map(l => (
          <tr>
            <td class="cl-level">
              <img class="cl-level__icon" src={`${base}img/icons/culture/${l.slug}.png`} alt="" onerror="this.style.display='none'" />
              <b>{l.name}</b>
            </td>
            <td class="cl-num"><b>{l.threshold.toLocaleString('en-US')}</b></td>
            <td class="cl-num">{l.vp}</td>
            <td class="cl-num">{l.governorXp}</td>
            <td>
              <div class="cl-effects">
                {l.consumption.map(text => {
                  const yieldKey = classifyYield(text)?.toLowerCase() || 'misc';
                  return (
                    <span class={`cl-effect yield-${yieldKey}`}>
                      <LinkedText text={text} showIcons={false} iconsForYields={true} />
                    </span>
                  );
                })}
              </div>
            </td>
            <td class="cl-proj">{l.defaultProject ? <LinkedText text={l.defaultProject.name} showIcons={false} /> : '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="cl-fineprint">
      <b>Culture to advance</b> is the culture a city needs to leave that level,
      from 100 (Weak to Developing) up to 5,000 (past Legendary). Past Legendary
      each further <i>culture step</i> costs 5,000 × (steps + 1) and is worth
      <b>+1 VP</b>. <b>Governor XP per turn</b> is what a governor earns each turn
      from the city's culture level. The <b>level-up project</b>, Council I to IV,
      is the city's default project at that level.
    </p>
  </section>

  <section class="cl-section">
    <h2 class="cl-h2">What each level unlocks</h2>
    <p>
      Tiered city projects such as Council, Festival, Decree, Inquiry, Hunt,
      Olympiad and Convoy need the city at <b>exactly</b> that level. The
      Treasury, Forum and Archive tiers need <b>at least</b> that level.
    </p>
    <div class="cl-cards">
      {levels.map(l => (
        <article class="cl-card">
          <h3 class="cl-card__name">
            <img class="cl-level__icon" src={`${base}img/icons/culture/${l.slug}.png`} alt="" onerror="this.style.display='none'" />
            {l.name}
          </h3>

          {l.gates.wonders.length > 0 && (
            <div class="cl-gate">
              <div class="cl-gate__label">Wonders</div>
              <ul class="cl-gate__list">
                {l.gates.wonders.map(w => (
                  <li><LinkedText text={w.name} /></li>
                ))}
              </ul>
            </div>
          )}

          {l.gates.buildings.length > 0 && (
            <div class="cl-gate">
              <div class="cl-gate__label">Urban buildings</div>
              <ul class="cl-gate__list">
                {l.gates.buildings.map(b => (
                  <li>
                    <LinkedText text={b.name} />
                    {b.class && b.class !== b.name && <span class="cl-dim"> · {b.class}</span>}
                  </li>
                ))}
              </ul>
            </div>
          )}

          {l.gates.units.length > 0 && (
            <div class="cl-gate">
              <div class="cl-gate__label">Units</div>
              <ul class="cl-gate__list">
                {l.gates.units.map(u => (
                  <li>
                    <LinkedText text={u.name} />
                    {u.obsoleteAt && <span class="cl-dim"> · until {u.obsoleteAt}</span>}
                  </li>
                ))}
              </ul>
            </div>
          )}

          {l.gates.projectsExact.length > 0 && (
            <div class="cl-gate">
              <div class="cl-gate__label">Projects (exactly this level)</div>
              <div class="cl-gate__chips">
                {l.gates.projectsExact.map(p => (
                  <span class="cl-chip">{p.name}</span>
                ))}
              </div>
            </div>
          )}

          {l.gates.projectsMin.length > 0 && (
            <div class="cl-gate">
              <div class="cl-gate__label">Projects (this level or higher)</div>
              <div class="cl-gate__chips">
                {l.gates.projectsMin.map(p => (
                  <span class="cl-chip">{p.name}</span>
                ))}
              </div>
            </div>
          )}
        </article>
      ))}
    </div>
    <p class="cl-fineprint">
      Culture-gated units come in pairs. The Developing unit, such as the
      Battering Ram, Hoplite or Hastatus, goes <b>obsolete at Strong</b> and is
      replaced by its upgrade, such as the Siege Tower, Phalangite or Legionary.
      Buildings and wonders also need their techs and other requirements; only
      the culture requirement is shown here.
    </p>
  </section>

  <section class="cl-section">
    <h2 class="cl-h2">Capture and assimilation</h2>
    <table class="cl-table cl-table--narrow">
      <thead>
        <tr>
          <th>Level</th>
          <th class="cl-num">Extra capture turns</th>
          <th class="cl-num">Extra assimilate turns</th>
          <th class="cl-num">Assimilation per turn</th>
        </tr>
      </thead>
      <tbody>
        {levels.map(l => (
          <tr>
            <td class="cl-level">
              <img class="cl-level__icon" src={`${base}img/icons/culture/${l.slug}.png`} alt="" onerror="this.style.display='none'" />
              <b>{l.name}</b>
            </td>
            <td class="cl-num">+{l.extraCaptureTurns}</td>
            <td class="cl-num">+{l.extraAssimilateTurns}</td>
            <td class="cl-num">−{Math.abs(l.assimilationRate)}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="cl-fineprint">
      A captured foreign city needs <b>{G.baseAssimilateTurns} assimilate
      turns</b> plus the <i>founder's</i> culture bonus, and its yields are
      modified by <b>{G.assimilateYieldModifier}%</b> until it assimilates. The
      countdown moves by the city's <i>current</i> culture level each turn, so
      higher culture assimilates faster. Extra capture turns add to the base of
      {G.baseCaptureTurns}; see
      <a href={`${base}city-capture-mechanics`}>City Capture Mechanics</a>.
    </p>
  </section>

  <section class="cl-section">
    <h2 class="cl-h2">The Development setup option</h2>
    <p>
      The <b>Development</b> option in advanced setup has nothing to do with city
      culture. It sets how developed the AI nations are when the game begins
      (average cities, capital population and free techs), and how many turns
      the AI waits before building wonders and founding religions.
    </p>
    <table class="cl-table">
      <thead>
        <tr>
          <th>Setting</th>
          <th class="cl-num">Avg cities</th>
          <th class="cl-num">Capital pop</th>
          <th class="cl-num">Free techs</th>
          <th class="cl-num">AI no-Wonder turns</th>
          <th class="cl-num">AI no-Religion turns</th>
          <th>Notes</th>
        </tr>
      </thead>
      <tbody>
        {devLevels.map(d => (
          <tr>
            <td class="cl-level"><b>{d.name}</b></td>
            <td class="cl-num">{d.avgCities || '—'}</td>
            <td class="cl-num">{d.capitalPopulation || '—'}</td>
            <td class="cl-num">{d.techs || '—'}</td>
            <td class="cl-num">{d.noWonderTurns || '—'}</td>
            <td class="cl-num">{d.noReligionTurns || '—'}</td>
            <td class="cl-help">{d.help}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

</Base>

<style>
  .lede {
    color: var(--text-dim);
    font-size: 0.9rem;
    line-height: 1.55;
    max-width: 72ch;
    margin: 0.4rem 0 1.5rem;
  }
  .lede b { color: var(--text); }

  .cl-section { margin-top: 2rem; }
  .cl-h2 {
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    margin: 0 0 0.5rem;
    color: var(--text);
  }
  .cl-section p {
    color: var(--text-dim);
    font-size: 0.85rem;
    line-height: 1.55;
    max-width: 78ch;
    margin: 0.3rem 0;
  }
  .cl-section p b { color: var(--text); }

  .cl-table {
    width: 100%;
    max-width: 100ch;
    border-collapse: collapse;
    margin: 0.6rem 0;
    font-size: 0.8rem;
  }
  .cl-table--narrow { max-width: 64ch; }
  .cl-table thead th {
    text-align: left;
    color: var(--text-dim);
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    padding: 0.4rem 0.5rem;
    border-bottom: 1px solid var(--border-strong);
  }
  .cl-table tbody td {
    padding: 0.45rem 0.5rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
    color: var(--text-dim);
  }
  .cl-table tbody tr:hover { background: var(--bg-elev); }
  .cl-num { text-align: right; font-variant-numeric: tabular-nums; font-family: var(--font-mono); }
  .cl-num b { color: var(--text); font-weight: 600; }
  .cl-level { white-space: nowrap; }
  .cl-level b { color: var(--text); font-family: var(--font-display); letter-spacing: 0.03em; }
  .cl-level__icon { width: 1.1em; height: 1.1em; object-fit: contain; vertical-align: -0.18em; margin-right: 0.35rem; }
  .cl-proj { white-space: nowrap; }
  .cl-help { font-size: 0.75rem; color: var(--text-faint); }

  /* Consumption mini-tiles — colored by the yield they touch */
  .cl-effects { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .cl-effect {
    display: inline-block;
    padding: 0.1rem 0.45rem 0.1rem 0.4rem;
    font-size: 0.74rem;
    border-left: 3px solid var(--yield-bg, var(--border-strong));
    background: color-mix(in srgb, var(--yield-bg, var(--border-strong)) 14%, transparent);
    border-radius: 0 3px 3px 0;
    color: var(--text-soft);
    white-space: nowrap;
  }

  /* Per-level unlock cards */
  .cl-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 0.8rem;
    margin: 0.8rem 0;
    max-width: 1500px;
  }
  .cl-card {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.8rem 0.9rem;
  }
  .cl-card__name {
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.04em;
    color: var(--accent);
    margin: 0 0 0.6rem;
  }
  .cl-gate { margin-top: 0.6rem; }
  .cl-gate__label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    color: var(--text-faint);
    margin-bottom: 0.25rem;
  }
  .cl-gate__list {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--text-soft);
  }
  .cl-gate__list li { padding: 0.06rem 0; }
  .cl-dim { color: var(--text-faint); font-size: 0.85em; }
  .cl-gate__chips { display: flex; flex-wrap: wrap; gap: 0.25rem; }
  .cl-chip {
    display: inline-block;
    padding: 0.08rem 0.45rem;
    font-size: 0.7rem;
    color: var(--text-soft);
    background: color-mix(in srgb, var(--border-strong) 35%, transparent);
    border: 1px solid var(--border);
    border-radius: 999px;
    white-space: nowrap;
  }

  .cl-fineprint {
    color: var(--text-faint) !important;
    font-size: 0.78rem !important;
    line-height: 1.5;
    font-style: italic;
    max-width: 80ch;
  }
  .cl-fineprint b { color: var(--text-dim); }
  .cl-fineprint a { color: var(--accent); }
</style>
