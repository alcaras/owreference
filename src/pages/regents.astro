---
import Base from '../layouts/Base.astro';
import LinkedText from '../components/LinkedText.astro';
import regents from '../data/regents.json';

// Mechanic transcribed from Character.makeRegent / isSuccessionSkipRegent,
// Player.setLeader (the handover) and PlayerBonus.cs (miRegentOfSubject, the
// bonus that actually crowns one; iRegentOfSubject in event bonuses). Reign
// years are tracked by STAT_YEARS_REGENT. The candidate ladder is data: eventStory.xml
// iPriority + SubjectExtras, resolved in build_regents.py.
const base = import.meta.env.BASE_URL;

// death and abdication run the same ladder with different flavour events —
// collapse to one rung per (priority, candidate) for the table
const rungs: any[] = [];
for (const e of regents.events as any[]) {
  const prev = rungs.find(r => r.priority === e.priority && r.candidate === e.candidate);
  if (prev) { prev.abdication = prev.abdication || e.abdication; continue; }
  rungs.push({ ...e });
}
---

<Base
  title="Regents"
  active="regents"
  pageMark="👶"
  description="How regency works in Old World and who is picked. Covers the candidate ladder, which runs from parent to grandparent, aunt or uncle, any elder courtier and finally a family head, the age gates that trigger it, what the Regent trait does, and how the rightful heir takes the throne back."
  pageStats={[
    { label: 'candidate rungs', value: rungs.length },
    { label: 'family opinion', value: `+${regents.regentTrait.familyOpinion}` },
  ]}
>
  <p class="lede">
    When the crown falls to a child, someone rules in their name. You do not pick the regent;
    the game does. This page shows who it picks and how the throne goes back to the heir.
  </p>

  <section class="rg">
    <h2 class="rg__h">When a regency happens</h2>
    <p class="rg__intro">
      On succession, by death <em>or</em> abdication, when the new leader is a minor. A leader
      under 7 always gets a regent. A leader aged 6 to 17 gets one only when a suitable relative
      exists. From <b>18</b> the new leader rules alone.
    </p>

    <h2 class="rg__h">Who is picked</h2>
    <p class="rg__intro">
      The game goes down this list and takes the first candidate someone in your court fits. You
      may decline the first three; the last two are forced.
    </p>

    <ol class="rg__ladder">
      {rungs.map((r: any) => (
        <li class="rg__rung">
          <div class="rg__rungtop">
            <span class="rg__prio">priority {r.priority}</span>
            <span class="rg__who">{r.candidate}</span>
            {r.optional
              ? <span class="rg__tag rg__tag--opt">you may decline</span>
              : <span class="rg__tag rg__tag--forced">forced</span>}
          </div>
          <div class="rg__meta">
            <span class="rg__ev">"{r.name}"</span>
            {r.candidateFilters.length > 0 && (
              <span class="rg__req">must be {r.candidateFilters.join(', ')}</span>
            )}
            {r.leaderFilters.length > 0 && (
              <span class="rg__req">new leader {r.leaderFilters.join(', ')}</span>
            )}
          </div>
        </li>
      ))}
    </ol>
    <p class="rg__note">
      When no relative qualifies, a <b>family head</b> takes the regency: an outsider with their
      own family's interests, hence "Power Play".
    </p>

    <h2 class="rg__h">What being regent does</h2>
    <div class="rg__cols">
      <div>
        <h3 class="rg__sub">While regent</h3>
        <ul class="rg__list">
          <li>They are your <b>leader</b>: their ratings, traits and archetype drive your empire,
            and they take the <b>{regents.title}</b> title.</li>
          <li>They carry the <b>{regents.regentTrait.name}</b> trait, worth
            <b>{regents.regentTrait.familyOpinion > 0 ? `+${regents.regentTrait.familyOpinion}` : regents.regentTrait.familyOpinion} opinion</b>
            with their own family.</li>
          <li>Their time on the throne counts as a reign, so cognomen stats accrue to them.</li>
        </ul>
      </div>
      <div>
        <h3 class="rg__sub">Giving the throne back</h3>
        <ul class="rg__list">
          <li>The heir keeps the <b>Rightful Heir</b> trait, and the succession list <b>skips
            regents</b> and their descendants. A regency does not move your line to the regent's
            branch.</li>
          <li>When the throne passes on, a regent who still holds the trait converts to
            <b>{regents.formerRegentTrait.name}</b>
            {regents.formerRegentTrait.ratings.length > 0 && (
              <>, worth <b>{regents.formerRegentTrait.ratings.map((r: string) => `+${r}`).join(', ')}</b></>
            )} for the rest of their life.</li>
          <li>If the regent dies while still holding power, a dedicated event returns the
            rightful heir to the throne.</li>
        </ul>
      </div>
    </div>

    <p class="rg__note">
      Some story events also install a regent outside succession, sometimes a foreign character.
    </p>

    <p class="rg__see">
      See also <a href={`${base}family-heads`}>Family Head Selection</a>, which follows a different
      rule.
    </p>
  </section>
</Base>

<style>
  .lede { max-width: 88ch; color: var(--text-dim); font-size: 0.86rem; line-height: 1.6; margin: 0 0 1.4rem; }
  .lede b { color: var(--text); }

  .rg__h { font-family: var(--font-display); font-size: 1.1rem; color: var(--accent);
    margin: 1.6rem 0 0.5rem; }
  .rg__h:first-of-type { margin-top: 0; }
  .rg__intro { max-width: 88ch; font-size: 0.84rem; color: var(--text-dim); line-height: 1.6; margin: 0 0 0.9rem; }
  .rg__intro b, .rg__note b { color: var(--text); }

  .rg__ladder { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.5rem;
    counter-reset: rung; max-width: 80ch; }
  .rg__rung { border: 1px solid var(--border); border-left: 3px solid var(--gold-deep);
    border-radius: var(--radius); background: var(--bg-elev); padding: 0.6rem 0.8rem; }
  .rg__rungtop { display: flex; align-items: baseline; gap: 0.6rem; flex-wrap: wrap; }
  .rg__prio { font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--text-faint); }
  .rg__who { font-family: var(--font-display); font-size: 1rem; color: var(--text); }
  .rg__tag { font-family: var(--font-mono); font-size: 0.58rem; letter-spacing: 0.05em;
    text-transform: uppercase; border-radius: 3px; padding: 0.05rem 0.35rem; border: 1px solid var(--border); }
  .rg__tag--opt { color: var(--gold-soft); border-color: color-mix(in srgb, var(--gold) 40%, transparent); }
  .rg__tag--forced { color: #d9603c; border-color: color-mix(in srgb, #d9603c 40%, transparent); }
  .rg__meta { display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; margin-top: 0.3rem; }
  .rg__ev { font-size: 0.76rem; color: var(--text-dim); font-style: italic; }
  .rg__req { font-family: var(--font-mono); font-size: 0.66rem; color: var(--text-faint); }

  .rg__cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(22rem, 1fr)); gap: 0.8rem 2rem; }
  .rg__sub { font-family: var(--font-display); font-size: 0.9rem; color: var(--text); margin: 0 0 0.35rem; }
  .rg__list { margin: 0; padding-left: 1.1rem; display: grid; gap: 0.4rem;
    font-size: 0.82rem; color: var(--text-dim); line-height: 1.55; }
  .rg__list b { color: var(--text); }

  .rg__note { max-width: 88ch; font-size: 0.78rem; color: var(--text-faint); line-height: 1.6; margin: 0.9rem 0 0; }
  .rg__see { margin-top: 1.4rem; font-size: 0.82rem; color: var(--text-dim); }
  .rg__see a { color: var(--accent); }
</style>
