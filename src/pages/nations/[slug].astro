---
import Base from '../../layouts/Base.astro';
import LinkedText from '../../components/LinkedText.astro';
import nations from '../../data/nations.json';
import familyClasses from '../../data/families.json';
import allUnits from '../../data/units.json';
import allProjects from '../../data/projects.json';
import { classifyYield } from '../../lib/entities';
import { existsSync } from 'node:fs';

const base = import.meta.env.BASE_URL;

// classKey (slug) → "Commander ×10 · Hero ×5" from the class's archetype die
const tendenciesByClass: Record<string, string> = {};
for (const fc of familyClasses as any[]) {
  const w = fc.archetypeWeights || {};
  const parts = Object.entries(w)
    .filter(([, v]) => (v as number) > 1)
    .sort((a, b) => (b[1] as number) - (a[1] as number))
    .map(([k, v]) => `${k.replace('TRAIT_', '').replace('_ARCHETYPE', '').toLowerCase().replace(/^./, c => c.toUpperCase())} ×${v}`);
  if (parts.length) tendenciesByClass[fc.slug] = parts.join(' · ');
}

export function getStaticPaths() {
  return nations.map(n => ({ params: { slug: n.slug }, props: { n } }));
}

const { n } = Astro.props;

// Colour key per shrine type. War/Fire/Hunting are the "military" shrines and
// all read red (training), matching the Shrines page tier — even though Fire's
// and Hunting's literal signature yields are iron/food.
const SHRINE_TYPE_YIELD: Record<string, string> = {
  WAR: 'training', KINGSHIP: 'civics', WISDOM: 'science', SUN: 'orders',
  WATER: 'money', LOVE: 'growth', UNDERWORLD: 'culture', HEARTH: 'culture',
  FIRE: 'training', HEALING: 'growth', HUNTING: 'training',
};

function bonusSource(): string[] {
  const xml = ((n as any).effectsXml as string[] | undefined) || [];
  const yaml = ((n as any).bonuses as string[] | undefined) || [];
  return xml.length >= yaml.length ? xml : yaml;
}
const bonuses = bonusSource();
const shrines = (n as any).shrines || [];
const families = (n as any).families || [];
const dynasties = (n as any).dynastyDetails || [];
const startingTech: string[] = (n as any).startingTech || [];
const startingLaw: string[] = (n as any).startingLaw || [];
const cityNames: string[] = (n as any).cityNames || [];
const startUnits = (n as any).startUnits || [];
const cityUnits = (n as any).cityUnits || [];
const titles = (n as any).titles || {};
const uniqueImprovements = (n as any).uniqueImprovements || [];

// ── Unique units: full stat cards (joined from units.json by NationPrereq) ──
const traitIcon = (key: string) => `${base}img/icons/unit_traits/${key}.png`;
const yieldIcon = (key: string) => `${base}img/icons/yields/${key}.png`;
const eraIcon = (era: string) => `${base}img/icons/culture/${era.toLowerCase()}.png`;
// Some unique units ship no portrait art (Hittite chariots, Kush archers …) —
// gate on the file so check_links stays clean and the card just drops the image.
const unitArt = (slug: string): string | null =>
  existsSync(`public/img/icons/units/${slug}.png`) ? `${base}img/icons/units/${slug}.png` : null;

// Same hidden-trait set as unique-units.astro: combat classes (shown elsewhere)
// + mount sub-types (internal counter math, not player-facing labels).
const HIDE_TRAITS = new Set([
  'UNITTRAIT_PROMOTABLE', 'UNITTRAIT_MELEE', 'UNITTRAIT_INFANTRY', 'UNITTRAIT_POLEARM',
  'UNITTRAIT_MOUNTED', 'UNITTRAIT_RANGED', 'UNITTRAIT_SIEGE', 'UNITTRAIT_SHIP',
  'UNITTRAIT_TRIBAL', 'UNITTRAIT_DISCIPLE', 'UNITTRAIT_WORKER',
  'UNITTRAIT_HORSE', 'UNITTRAIT_CAMEL', 'UNITTRAIT_ELEPHANT', 'UNITTRAIT_CHARIOT',
]);
const secondaryTraits = (u: any): string[] =>
  (u.traitIds as string[])
    .filter(t => t !== u.primaryTrait && !HIDE_TRAITS.has(t))
    .map(t => t.replace('UNITTRAIT_', '').replace(/_/g, ' ').toLowerCase()
      .replace(/\b\w/g, c => c.toUpperCase()));

const CULTURE_TIERS = new Set(['Weak', 'Developing', 'Strong', 'Legendary']);
const tierLabel = (t: string) => t === 'Initial' ? 'From start' : CULTURE_TIERS.has(t) ? `${t} Culture` : t;
const tierIcon = (t: string): string | undefined => CULTURE_TIERS.has(t) ? eraIcon(t) : undefined;
// Unlock for a unit: Culture tier, or a building gate (Aksum's D'mt Warrior
// has no culture prereq but needs a Stronghold).
function unitUnlock(u: any): { label: string; icon?: string } {
  const c = (u.culturePrereq || '').replace('CULTURE_', '');
  const tier = c ? c[0] + c.slice(1).toLowerCase() : '';
  if (tier && CULTURE_TIERS.has(tier)) return { label: tierLabel(tier), icon: tierIcon(tier) };
  if (u.improvementPrereqLabel) return { label: u.improvementPrereqLabel };
  return { label: 'From start' };
}

// Build base→upgrade lines for this nation's unique units (e.g. D'mt Warrior →
// Shotelai), folding differing values with a slash, same as unique-units.astro.
const myUnits = (allUnits as any[]).filter(u => u.nationPrereq === (n as any).id);
const byId = new Map(myUnits.map(u => [u.id, u]));
const upgradeTargets = new Set<string>();
for (const u of myUnits) for (const t of (u.upgradeTo as string[])) if (byId.has(t)) upgradeTargets.add(t);
type ULine = { chain: any[]; base: any };
const unitLines: ULine[] = [];
for (const u of myUnits) {
  if (upgradeTargets.has(u.id)) continue;
  const chain = [u]; let cur = u;
  for (let g = 0; g < 4; g++) {
    const nxt = (cur.upgradeTo as string[]).map(t => byId.get(t)).find(Boolean);
    if (!nxt) break;
    chain.push(nxt); cur = nxt;
  }
  unitLines.push({ chain, base: u });
}
unitLines.sort((a, b) => a.base.eraOrder - b.base.eraOrder || a.base.name.localeCompare(b.base.name));

const collapse = (vals: any[]) => {
  const out: any[] = [];
  for (const v of vals) if (!out.length || out[out.length - 1] !== v) out.push(v);
  return out;
};
const foldNums = (vals: (number | string)[], sep = ' / ') => collapse(vals).join(sep);
function foldYields(chain: any[], field: 'costs' | 'consumption') {
  const keys: string[] = [];
  for (const u of chain) for (const c of u[field]) if (!keys.includes(c.yield)) keys.push(c.yield);
  return keys.map(k => ({
    yield: k,
    text: foldNums(chain.map(u => { const c = u[field].find((x: any) => x.yield === k); return c ? c.value : 0; }), '/'),
  }));
}
const lineTraits = (chain: any[]) => [...new Set(chain.flatMap(u => secondaryTraits(u)))];
function lineAbilities(chain: any[]) {
  const seen = new Set<string>(); const out: any[] = [];
  for (const u of chain) for (const a of u.abilities) if (!seen.has(a.label)) { seen.add(a.label); out.push(a); }
  return out;
}

// ── Unique projects: leveling chains gated to this nation (Aksum's Mint Coin) ──
const ROMAN: Record<string, number> = { I: 1, II: 2, III: 3, IV: 4, V: 5, VI: 6 };
function projNation(src: string): string | null {
  const m = /\(([^)]+)\)/.exec(src || '');
  return m ? m[1] : null;
}
const projGroups = new Map<string, { name: string; icon: string; levels: any[] }>();
for (const p of allProjects as any[]) {
  if (p.eventOnly) continue;
  if (projNation(p.source) !== (n as any).name) continue;
  const m = /^(.*?)\s+([IVX]+)$/.exec(p.name);
  const baseName = m ? m[1] : p.name;
  const lvl = m ? (ROMAN[m[2]] || 0) : 0;
  const culture = (p.prereqs || []).map((x: any) => x.label).find((l: string) => /Culture$/.test(l)) || '';
  const g = projGroups.get(baseName) || { name: baseName, icon: p.icon, levels: [] };
  g.levels.push({
    label: p.name, level: lvl, culture,
    effects: p.effects || [],
    cost: (p.cost || []).map((c: any) => ({ yield: c.yield, value: c.value })),
  });
  projGroups.set(baseName, g);
}
const uniqueProjects = [...projGroups.values()].map(g => ({
  ...g, levels: g.levels.sort((a, b) => a.level - b.level),
}));

const hasKit = uniqueImprovements.length > 0 || uniqueProjects.length > 0;

// For the Stele's per-family yield boost: this nation's family classes, in
// their own order, so we show only the variants Aksum actually fields.
const yieldLabel = (k: string) => k.replace(/^./, c => c.toUpperCase());
const familyBoostRows = (g: any) =>
  !g.familyBoost ? [] : families
    .map((f: any) => {
      const c = g.familyBoost.classes.find((x: any) => x.classKey === f.classKey);
      return c ? { classKey: f.classKey, class: c.class, yields: c.yields } : null;
    })
    .filter(Boolean);
const boostScale = (g: any) =>
  g.familyBoost ? g.familyBoost.pcts.map((p: number) => `+${p}%`).join(' / ') : '';
---

<Base
  title={n.name}
  active="nations"
  description={`Old World reference: ${n.name} — its kit at a glance: bonuses, unique units (full stats), unique improvements & projects, shrines, families and starting techs, plus dynasties and royal lineup — all XML-canonical from the game's files.`}
>
  <a class="back-link" href={`${base}nations`}>← All nations</a>

  <header class="nat-head" style={`--nation-bg: ${n.color.bg}; --nation-fg: ${n.color.fg};`}>
    <img class="nat-head__crest" src={`${base}img/crests/${n.slug}.png`} alt="" />
    <div class="nat-head__title">
      <div class="nat-head__sub">
        Old World · Nation
        {n.gameContent && <span class="nat-head__dlc"> · DLC: {n.gameContent}</span>}
      </div>
      <h1 class="nat-head__name">{n.name}</h1>
      {titles.leader && <div class="nat-head__title-label">Leader title: <em>{titles.leader}</em></div>}
    </div>
    <div class="nat-head__rule"></div>
  </header>

  <div class="np-grid">
    <section class="np-sec np-sec--bonuses">
      <h2 class="np-sec__title">Bonuses</h2>
      <ul class="np-list">
        {bonuses.map(b => {
          const yk = classifyYield(b)?.toLowerCase() || 'misc';
          return (
            <li class={`np-item yield-${yk}`}>
              <LinkedText text={b} showIcons={false} iconsForYields={true} />
            </li>
          );
        })}
      </ul>
    </section>

    {hasKit && (
      <section class="np-sec np-sec--kit">
        <h2 class="np-sec__title">Unique Improvements &amp; Projects</h2>
        <div class="kit-grid">
          {uniqueProjects.map((g: any) => (
            <article class="kit yield-money">
              <header class="kit__head">
                <img class="kit__icon" src={`${base}${g.icon}`} alt="" onerror="this.style.display='none'" />
                <span class="kit__name">{g.name}</span>
                <span class="kit__kind">Project</span>
              </header>
              <div class="kit__levels">
                {g.levels.map((lv: any) => (
                  <div class="kit-lv">
                    <span class="kit-lv__gate">{(lv.culture || 'Start').replace(/ Culture$/, '')}</span>
                    <span class="kit-lv__fx">
                      {lv.effects.map((e: string) => (
                        <span class="kit-lv__line"><LinkedText text={e} showIcons={false} iconsForYields={true} /></span>
                      ))}
                    </span>
                    <span class="kit-lv__cost">
                      {lv.cost.map((c: any) => (
                        <span class="kit-cost"><img src={yieldIcon(c.yield)} alt="" onerror="this.style.display='none'" />{c.value}</span>
                      ))}
                    </span>
                  </div>
                ))}
              </div>
            </article>
          ))}
          {uniqueImprovements.map((g: any) => (
            <article class="kit yield-civics">
              <header class="kit__head">
                <img class="kit__icon" src={`${base}${g.icon}`} alt="" onerror="this.style.display='none'" />
                <span class="kit__name">{g.name}</span>
                <span class="kit__kind">Improvement</span>
              </header>
              <div class="kit__levels">
                {g.levels.map((lv: any) => (
                  <div class="kit-lv">
                    <span class="kit-lv__gate">{(lv.culture || 'Start')}</span>
                    <span class="kit-lv__fx">
                      {[...lv.outputs, ...lv.effects].map((e: string) => (
                        <span class="kit-lv__line"><LinkedText text={e} showIcons={false} iconsForYields={true} /></span>
                      ))}
                    </span>
                    <span class="kit-lv__cost">
                      <span class="kit-cost"><LinkedText text={lv.cost} showIcons={false} iconsForYields={true} /></span>
                      <span class="kit-lv__turns">{lv.buildTurns}t</span>
                    </span>
                  </div>
                ))}
              </div>
              {g.familyBoost && familyBoostRows(g).length > 0 && (
                <div class="kit-fam">
                  <div class="kit-fam__hd">
                    Seated family boosts its yield
                    <span class="kit-fam__scale">{boostScale(g)} <em>by tier</em></span>
                  </div>
                  <ul class="kit-fam__list">
                    {familyBoostRows(g).map((r: any) => (
                      <li class="kit-fam__row">
                        <img class="kit-fam__icon" src={`${base}img/archetypes/${r.classKey}.png`} alt="" onerror="this.style.display='none'" />
                        <span class="kit-fam__cls">{r.class}</span>
                        <span class="kit-fam__arrow">→</span>
                        <span class="kit-fam__yields">
                          {r.yields.map((y: string) => (
                            <span class="kit-fam__y"><img src={yieldIcon(y)} alt="" onerror="this.style.display='none'" />{yieldLabel(y)}</span>
                          ))}
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="np-sec np-sec--uu">
      <h2 class="np-sec__title">Unique Units <span class="np-count">{unitLines.length}</span></h2>
      <div class="uu-grid">
        {unitLines.map(({ chain, base: bu }) => {
          const unlock = unitUnlock(bu);
          const traits = lineTraits(chain);
          const abilities = lineAbilities(chain);
          const costs = foldYields(chain, 'costs');
          const upkeep = foldYields(chain, 'consumption');
          const prod = foldNums(chain.map(u => u.production), '/');
          const str = foldNums(chain.map(u => u.strength / 10), '/');
          const hp = foldNums(chain.map(u => u.hp), '/');
          const move = foldNums(chain.map(u => u.movement), '/');
          const vis = foldNums(chain.map(u => u.vision), '/');
          const range = bu.rangeMax > 0 ? foldNums(chain.map(u => `${u.rangeMin}-${u.rangeMax}`), '/') : '';
          return (
            <article class="uu">
              <div class="uu__top">
                {unitArt(bu.slug)
                  ? <img class="uu__art" src={unitArt(bu.slug)} alt="" loading="lazy" />
                  : <div class="uu__art uu__art--none" aria-hidden="true">{bu.primaryLabel?.[0] || '⚔'}</div>}
                <div class="uu__id">
                  <div class="uu__names">
                    {chain.map((u, i) => (
                      <>
                        {i > 0 && <span class="uu__arrow">→</span>}
                        <a class="uu__name" href={`${base}unique-units`}>{u.name}</a>
                      </>
                    ))}
                  </div>
                  <div class="uu__class">
                    <img src={traitIcon((bu.primaryTrait || '').replace('UNITTRAIT_', '').toLowerCase())} alt="" onerror="this.style.display='none'" />
                    {bu.primaryLabel}
                    {traits.map(t => <span class="uu__trait">{t}</span>)}
                  </div>
                  <div class="uu__unlock">
                    {unlock.icon && <img src={unlock.icon} alt="" onerror="this.style.display='none'" />}
                    {unlock.label}
                  </div>
                </div>
              </div>

              <div class="uu__stats">
                <span class="uu-stat" title="Strength"><b>STR</b>{str}</span>
                <span class="uu-stat" title="Hit points"><b>HP</b>{hp}</span>
                <span class="uu-stat" title="Movement"><b>MOVE</b>{move}</span>
                <span class="uu-stat" title="Vision (tiles)"><b>SIGHT</b>{vis}</span>
                {range && <span class="uu-stat" title="Attack range"><b>RANGE</b>{range}</span>}
              </div>

              <dl class="uu__econ">
                <dt>Cost</dt>
                <dd>
                  <span class="uu-y"><img src={yieldIcon('training')} alt="" />{prod}</span>
                  {costs.map((c: any) => (
                    <span class="uu-y"><img src={yieldIcon(c.yield)} alt="" onerror="this.style.display='none'" />{c.text}</span>
                  ))}
                </dd>
                {upkeep.length > 0 && (
                  <>
                    <dt>Upkeep</dt>
                    <dd>
                      {upkeep.map((c: any) => (
                        <span class="uu-y uu-y--neg"><img src={yieldIcon(c.yield)} alt="" onerror="this.style.display='none'" />−{c.text}</span>
                      ))}
                    </dd>
                  </>
                )}
              </dl>

              {abilities.length > 0 && (
                <ul class="uu__abils">
                  {abilities.map((a: any) => (
                    <li class="uu-abil">
                      <span class="uu-abil__name">
                        {a.icon && <img src={`${base}img/icons/${a.icon}.png`} alt="" onerror="this.style.display='none'" />}
                        {a.label}
                      </span>
                      {a.lines && a.lines.length > 0 && (
                        <span class="uu-abil__fx">{a.lines.join(' · ')}</span>
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </article>
          );
        })}
      </div>
    </section>

    <section class="np-sec np-sec--shrines">
      <h2 class="np-sec__title">Shrines</h2>
      <div class="np-shrines">
        {shrines.filter((s: any) => s.shrine).map((sh: any) => {
          const type = sh.shrine?.type || '';
          const yk = SHRINE_TYPE_YIELD[type] || 'misc';
          const iconUrl = type ? `${base}img/icons/shrines/${type.toLowerCase()}.png` : '';
          return (
            <article class={`np-shrine yield-${yk}`}>
              {iconUrl && <img class="np-shrine__art" src={iconUrl} alt="" />}
              <div class="np-shrine__body">
                <header>
                  <span class="np-shrine__type">{sh.shrine?.typeLabel}</span>
                  <span class="np-shrine__deity">{sh.shrine?.name}</span>
                </header>
                <p class="np-shrine__effect">
                  <LinkedText text={sh.effect || ''} showIcons={false} iconsForYields={true} />
                </p>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <section class="np-sec np-sec--families">
      <h2 class="np-sec__title">Families <span class="np-count">choose up to 3</span></h2>
      <ul class="np-families">
        {families.map((f: any) => (
          <li class="np-fam" style={f.ingameColor ? `--fam-stripe: ${f.ingameColor}` : undefined}>
            {f.classKey && <img class="np-fam__icon" src={`${base}img/archetypes/${f.classKey}.png`} alt="" />}
            <span class="np-fam__class">{f.class}</span>
            <span class="np-fam__name">{f.name}</span>
            {tendenciesByClass[f.classKey] && (
              <a class="np-fam__arch" href={`${base}archetype-tendencies`} title="Archetype die weights for this family class">
                {tendenciesByClass[f.classKey]}
              </a>
            )}
            {f.supremacy && (
              <span class="np-fam__sup">
                <span class="np-fam__sup-name">{f.supremacy.name}</span>
                {f.supremacy.effects.map((e: string) => {
                  const yk = classifyYield(e)?.toLowerCase() || 'misc';
                  return (
                    <span class={`np-item np-item--sup yield-${yk}`}>
                      <LinkedText text={e} showIcons={false} iconsForYields={true} />
                    </span>
                  );
                })}
              </span>
            )}
          </li>
        ))}
      </ul>
    </section>

    <section class="np-sec np-sec--start">
      <h2 class="np-sec__title">Start</h2>
      <dl class="np-dl np-dl--start">
        {(startUnits.length > 0 || cityUnits.length > 0) && (
          <>
            <dt>Starting Units</dt>
            <dd class="np-units">
              {[...startUnits, ...cityUnits].map((u: any) => (
                <span class="np-unit">
                  {u.trait && (
                    <img class="np-unit__glyph" src={`${base}img/icons/unit_traits/${u.trait}.png`} alt="" onerror="this.style.display='none'" />
                  )}
                  {u.count > 1 && <span class="np-unit__n">{u.count}×</span>}
                  {u.name}
                </span>
              ))}
            </dd>
          </>
        )}
        {startingTech.length > 0 && (
          <>
            <dt>Tech</dt>
            <dd>
              <ul class="np-chips">
                {startingTech.map(t => <li class="np-chip">{t}</li>)}
              </ul>
            </dd>
          </>
        )}
        {startingLaw.length > 0 && (
          <>
            <dt>Laws</dt>
            <dd>
              <ul class="np-chips">
                {startingLaw.map(l => <li class="np-chip">{l}</li>)}
              </ul>
            </dd>
          </>
        )}
      </dl>
    </section>

    <hr class="np-divider" />

    <section class="np-sec np-sec--dynasties">
      <h2 class="np-sec__title">Dynasties &amp; Leaders</h2>
      {dynasties.length === 0 ? (
        <p class="np-empty">No dynasty data for this nation.</p>
      ) : (
        <ul class="np-dynasties">
          {dynasties.map((d: any) => (
            <li class="np-dyn">
              {d.portrait ? (
                <img class="np-dyn__portrait" src={`${base}${d.portrait}`} alt={d.firstRuler || d.name} />
              ) : (
                <div class="np-dyn__portrait np-dyn__portrait--placeholder">{(d.firstRuler || d.name)?.[0] || '?'}</div>
              )}
              <div class="np-dyn__body">
                {(() => {
                  const ts = d.leaderTraits || [];
                  const arch = ts.find((t: any) => t.archetype);
                  const rest = ts.filter((t: any) => !t.archetype);
                  return (
                    <>
                      <header class="np-dyn__head">
                        {arch && arch.icon && (
                          <img class="np-dyn__arch" src={`${base}${arch.icon}`}
                               alt={arch.label} title={arch.label} />
                        )}
                        <span class="np-dyn__name">{d.name}</span>
                        {arch && <span class="np-dyn__arch-name">{arch.label}</span>}
                        {d.leaderAge != null && d.leaderAge > 0 && (
                          <span class="np-dyn__age">age {d.leaderAge}</span>
                        )}
                        {d.gameContent && <span class="np-dyn__dlc">{d.gameContent}</span>}
                      </header>
                      {d.firstRuler && (
                        <div class="np-dyn__role">
                          First ruler: <em>{d.firstRuler}</em>
                          {d.founder && d.founder !== d.firstRuler && <> · founded by <em>{d.founder}</em></>}
                        </div>
                      )}
                      {rest.length > 0 && (
                        <ul class="np-dyn__traits">
                          {rest.map((t: any) => (
                            <li class="np-trait">
                              <span class="np-trait__name">{t.label}</span>
                              {t.effects && t.effects.length > 0 ? (
                                <span class="np-trait__fx">{t.effects.join(' · ')}</span>
                              ) : (
                                <span class="np-trait__fx np-trait__fx--none">no mechanical effect</span>
                              )}
                            </li>
                          ))}
                        </ul>
                      )}
                    </>
                  );
                })()}
                {d.description && (
                  <p class="np-dyn__desc"><LinkedText text={d.description} showIcons={false} iconsForYields={true} /></p>
                )}
                {d.leaderUrl && <a class="np-dyn__url" href={d.leaderUrl} target="_blank" rel="noopener">Wikipedia ↗</a>}
              </div>
            </li>
          ))}
        </ul>
      )}
    </section>

    {cityNames.length > 0 && (
      <section class="np-sec np-sec--cities">
        <h2 class="np-sec__title">City names <span class="np-count">{cityNames.length}</span></h2>
        <ul class="np-citylist">
          {cityNames.map(c => <li>{c}</li>)}
        </ul>
      </section>
    )}
  </div>
</Base>

