---
import Base from '../../layouts/Base.astro';
import LinkedText from '../../components/LinkedText.astro';
import nations from '../../data/nations.json';
import { classifyYield } from '../../lib/entities';

const base = import.meta.env.BASE_URL;

export function getStaticPaths() {
  return nations.map(n => ({ params: { slug: n.slug }, props: { n } }));
}

const { n } = Astro.props;

const SHRINE_TYPE_YIELD: Record<string, string> = {
  WAR: 'training', KINGSHIP: 'civics', WISDOM: 'science', SUN: 'orders',
  WATER: 'money', LOVE: 'growth', UNDERWORLD: 'culture', HEARTH: 'culture',
  FIRE: 'iron', HEALING: 'growth', HUNTING: 'food',
};

// Pick bonus source: prefer XML when at least as complete; else yaml.
function bonusSource(): string[] {
  const xml = ((n as any).effectsXml as string[] | undefined) || [];
  const yaml = ((n as any).bonuses as string[] | undefined) || [];
  return xml.length >= yaml.length ? xml : yaml;
}
const bonuses = bonusSource();
const shrines = (n as any).shrines || [];
const uniqueUnit = (n as any).uniqueUnit || {};
const families = (n as any).families || [];
const dynasties = (n as any).dynastyDetails || [];
const startingTech: string[] = (n as any).startingTech || [];
const startingLaw: string[] = (n as any).startingLaw || [];
const leader = (n as any).leader || {};
---

<Base
  title={n.name}
  active="nations"
  description={`Old World reference: ${n.name} — bonuses, shrines, unique units, families, dynasties, starting techs, and royal lineup, pulled XML-canonical from the game's files.`}
>
  <a class="back-link" href={`${base}nations`}>← All nations</a>

  <header class="nat-head" style={`--nation-bg: ${n.color.bg}; --nation-fg: ${n.color.fg};`}>
    <img class="nat-head__crest" src={`${base}img/crests/${n.slug}.png`} alt="" />
    <div class="nat-head__title">
      <div class="nat-head__sub">Old World · Nation</div>
      <h1 class="nat-head__name">{n.name}</h1>
      {n.gameContent && <div class="nat-head__dlc">DLC: {n.gameContent}</div>}
    </div>
    <div class="nat-head__rule"></div>
  </header>

  <section class="np-sec">
    <h2 class="np-sec__title">Bonuses</h2>
    <ul class="np-list">
      {bonuses.map(b => {
        const yk = classifyYield(b)?.toLowerCase() || 'misc';
        return (
          <li class={`np-item yield-${yk}`}>
            <LinkedText text={b} showIcons={false} iconsForYields={true} />
          </li>
        );
      })}
    </ul>
  </section>

  <section class="np-sec">
    <h2 class="np-sec__title">Shrines</h2>
    <div class="np-shrines">
      {shrines.filter((s: any) => s.shrine).map((sh: any) => {
        const type = sh.shrine?.type || '';
        const yk = SHRINE_TYPE_YIELD[type] || 'misc';
        const iconUrl = type ? `${base}img/icons/shrines/${type.toLowerCase()}.png` : '';
        return (
          <article class={`np-shrine yield-${yk}`}>
            {iconUrl && <img class="np-shrine__art" src={iconUrl} alt="" />}
            <div class="np-shrine__body">
              <header>
                <span class="np-shrine__type">{sh.shrine?.typeLabel}</span>
                <span class="np-shrine__deity">{sh.shrine?.name}</span>
              </header>
              <p class="np-shrine__effect">
                <LinkedText text={sh.effect || ''} showIcons={false} iconsForYields={true} />
              </p>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section class="np-sec">
    <h2 class="np-sec__title">Unique Unit</h2>
    <dl class="np-dl">
      {uniqueUnit.names && <><dt>Names</dt><dd><LinkedText text={uniqueUnit.names} showIcons={false} iconsForYields={true} /></dd></>}
      {uniqueUnit.traits && <><dt>Traits</dt><dd>{uniqueUnit.traits}</dd></>}
      {uniqueUnit.cost && <><dt>Cost</dt><dd><LinkedText text={uniqueUnit.cost} showIcons={false} iconsForYields={true} /></dd></>}
      {uniqueUnit.upkeep && <><dt>Upkeep</dt><dd><LinkedText text={uniqueUnit.upkeep} showIcons={false} iconsForYields={true} /></dd></>}
      {uniqueUnit.moveSight && <><dt>Move/Sight</dt><dd>{uniqueUnit.moveSight}</dd></>}
    </dl>
  </section>

  <section class="np-sec">
    <h2 class="np-sec__title">Starting Techs</h2>
    <ul class="np-chips">
      {startingTech.map(t => <li class="np-chip">{t}</li>)}
      {startingTech.length === 0 && <li class="np-chip np-chip--dim">—</li>}
    </ul>
    {startingLaw.length > 0 && (
      <>
        <h3 class="np-sub">Starting Laws</h3>
        <ul class="np-chips">{startingLaw.map(l => <li class="np-chip">{l}</li>)}</ul>
      </>
    )}
  </section>

  <section class="np-sec">
    <h2 class="np-sec__title">Families</h2>
    <ul class="np-families">
      {families.map((f: any) => (
        <li class="np-fam" style={f.ingameColor ? `--fam-stripe: ${f.ingameColor}` : undefined}>
          {f.classKey && <img class="np-fam__icon" src={`${base}img/archetypes/${f.classKey}.png`} alt="" />}
          <span class="np-fam__class">{f.class}</span>
          <span class="np-fam__name">{f.name}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="np-sec">
    <h2 class="np-sec__title">Dynasties</h2>
    {dynasties.length === 0 ? (
      <p class="np-empty">No dynasty data for this nation.</p>
    ) : (
      <ul class="np-dynasties">
        {dynasties.map((d: any) => (
          <li class="np-dyn">
            <header class="np-dyn__head">
              <span class="np-dyn__name">{d.name}</span>
              {d.founder && d.founder !== d.firstRuler && (
                <span class="np-dyn__role">founder · <em>{d.founder}</em></span>
              )}
              {d.firstRuler && (
                <span class="np-dyn__role">first ruler · <em>{d.firstRuler}</em></span>
              )}
              {d.gameContent && <span class="np-dyn__dlc">{d.gameContent}</span>}
            </header>
            {d.description && (
              <p class="np-dyn__desc"><LinkedText text={d.description} showIcons={false} iconsForYields={true} /></p>
            )}
          </li>
        ))}
      </ul>
    )}
  </section>

  {(leader.name || leader.spouse || leader.heir1 || leader.heir2) && (
    <section class="np-sec">
      <h2 class="np-sec__title">Royal Family</h2>
      <dl class="np-dl">
        {leader.name && <><dt>Leader</dt><dd>{leader.name}</dd></>}
        {leader.spouse && <><dt>Spouse</dt><dd>{leader.spouse}</dd></>}
        {leader.heir1 && <><dt>Heir 1</dt><dd>{leader.heir1}</dd></>}
        {leader.heir2 && <><dt>Heir 2</dt><dd>{leader.heir2}</dd></>}
      </dl>
    </section>
  )}
</Base>

<style>
  .back-link {
    display: inline-block;
    font-family: var(--font-ui);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--gold-soft);
    margin: 0 0 1rem;
    text-decoration: none;
  }
  .back-link:hover { color: var(--gold); text-decoration: none; }

  .nat-head {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 1rem;
    padding-bottom: 0.8rem;
    margin-bottom: 1.4rem;
    position: relative;
  }
  .nat-head__crest {
    width: 64px; height: 64px;
    object-fit: contain;
    filter: drop-shadow(0 2px 3px rgba(0,0,0,0.6));
  }
  .nat-head__title { display: flex; flex-direction: column; gap: 0.1rem; }
  .nat-head__sub {
    font-family: var(--font-ui);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--gold-soft);
    font-weight: 500;
  }
  .nat-head__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 2.4rem;
    line-height: 1.1;
    color: var(--text);
    letter-spacing: 0.005em;
  }
  .nat-head__dlc {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-dim);
    margin-top: 0.25rem;
  }
  .nat-head__rule {
    grid-column: 1 / -1;
    height: 3px;
    background: var(--nation-bg, var(--gold-deep));
    opacity: 0.85;
  }

  .np-sec { margin: 1.6rem 0; }
  .np-sec__title {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.66rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold-soft);
    border-bottom: 1px solid var(--gold-deep);
    padding-bottom: 0.3rem;
    margin: 0 0 0.7rem;
  }
  .np-sub {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    margin: 0.9rem 0 0.4rem;
    color: var(--text-soft);
  }
  .np-empty { color: var(--text-faint); font-style: italic; }

  .np-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.35rem; }
  .np-item {
    padding: 0.4rem 0.7rem 0.4rem 0.9rem;
    background: var(--bg-elev);
    border-left: 3px solid var(--yield-bg, var(--border-strong));
    border-radius: 0 4px 4px 0;
    font-size: 0.92rem;
  }

  .np-shrines {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 0.5rem;
  }
  .np-shrine {
    display: flex;
    gap: 0.6rem;
    padding: 0.5rem 0.7rem 0.5rem 0.9rem;
    background: var(--bg-elev);
    border-left: 3px solid var(--yield-bg, var(--border-strong));
    border-radius: 0 4px 4px 0;
  }
  .np-shrine__art {
    width: 38px; height: 38px;
    object-fit: cover;
    border-radius: 3px;
    flex-shrink: 0;
    align-self: flex-start;
  }
  .np-shrine__body { flex: 1; }
  .np-shrine__body header { display: flex; align-items: baseline; gap: 0.4rem; }
  .np-shrine__type {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    color: var(--text);
  }
  .np-shrine__deity {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.82rem;
    color: var(--text-faint);
  }
  .np-shrine__effect { margin: 0.15rem 0 0; font-size: 0.86rem; color: var(--text-soft); }

  .np-dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.25rem 1rem;
    margin: 0;
    font-size: 0.92rem;
  }
  .np-dl dt {
    font-family: var(--font-ui);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--text-dim);
    padding-top: 0.2rem;
  }
  .np-dl dd { margin: 0; color: var(--text); }

  .np-chips { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .np-chip {
    padding: 0.25rem 0.65rem;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.88rem;
    color: var(--text);
  }
  .np-chip--dim { color: var(--text-faint); font-style: italic; }

  .np-families { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 0.35rem; }
  .np-fam {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.35rem 0.7rem 0.35rem 0.85rem;
    background: var(--bg-elev);
    box-shadow: inset 3px 0 0 var(--fam-stripe, var(--border));
    border-radius: 0 4px 4px 0;
  }
  .np-fam__icon { width: 1.1em; height: 1.1em; object-fit: contain; align-self: center; opacity: 0.85; }
  .np-fam__class { font-family: var(--font-display); font-weight: 600; font-size: 0.96rem; color: var(--text); }
  .np-fam__name { font-family: var(--font-display); font-style: italic; font-size: 0.78rem; color: var(--text-faint); }

  .np-dynasties { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.7rem; }
  .np-dyn {
    padding: 0.55rem 0.85rem;
    background: var(--bg-elev);
    border-left: 3px solid var(--gold-deep);
    border-radius: 0 4px 4px 0;
  }
  .np-dyn__head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.6rem; }
  .np-dyn__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--text);
    letter-spacing: 0.01em;
  }
  .np-dyn__role {
    font-family: var(--font-ui);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--text-dim);
  }
  .np-dyn__role em { font-style: italic; color: var(--text-soft); letter-spacing: 0.02em; text-transform: none; font-size: 0.9rem; }
  .np-dyn__dlc {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--gold-soft);
    margin-left: auto;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .np-dyn__desc {
    margin: 0.35rem 0 0;
    color: var(--text-soft);
    font-size: 0.92rem;
    line-height: 1.5;
    max-width: 80ch;
  }
</style>
