---
import Base from '../layouts/Base.astro';
import LinkedText from '../components/LinkedText.astro';
import jobs from '../data/jobs.json';
import scaling from '../data/stat-scaling.json';
import archetypesData from '../data/archetypes.json';
import studyCourses from '../data/study_courses.json';
import { classifyYield } from '../lib/entities';

const base = import.meta.env.BASE_URL;

type Job = typeof jobs[number];

const SLOT_GLYPH: Record<string, string> = {
  Council: '⚜', General: '⚔', Governor: '🏛', Agent: '⌬', Explorer: '⌖', Misc: '·',
};

// Group by slot type for the table sections
const grouped: Record<string, Job[]> = {};
for (const j of jobs) {
  (grouped[j.slotType] ||= []).push(j);
}
const sections = ['Council', 'General', 'Governor', 'Agent', 'Explorer', 'Misc'].filter(s => grouped[s]?.length);

const searchBlobs: Record<string, string> = {};
for (const j of jobs) searchBlobs[j.slug] = JSON.stringify(j).toLowerCase();

// ─── Jobs at-a-glance matrix ───────────────────────────────────────────────
// Replicates the legacy spreadsheet's opening matrix: roles × (the four
// ratings + the ten archetypes). Every cell is data-driven:
//  · rating→role payouts: stat-scaling.json (rating.xml triangle formula) for
//    Leader/Courtier, Governor, Agent, General; jobs.json tri-effects
//    (council.xml) for Ambassador / Chancellor / Spymaster.
//  · role↔archetype fit: archetypes.json `slots` (bGeneralPrereq /
//    bGovernorPrereq / agent flags in trait.xml) and jobs.json traitPrereqs
//    for the council seats.
//  · heir education: study_courses.json (bonus-event.xml enrolment rating
//    bump + eventOption.xml EVENTOPTION_STUDY_*_ARCHETYPES graduation pools).
//  · archetype rating modifiers: archetypes.json `ratings` (trait.xml aiRating).
const RATING_ORDER = ['wisdom', 'charisma', 'courage', 'discipline'] as const;

const statBySlug = Object.fromEntries((scaling as any).stats.map((s: any) => [s.slug, s]));
const ratingCols = RATING_ORDER.map((slug) => {
  const s = statBySlug[slug];
  return { slug, name: s.name as string, color: s.color as string, yield: s.yield as string };
});

type MxCell = { text: string; tone: string; tri?: boolean } | null;

// Rows whose payout comes straight from the rating formula (stat-scaling.json).
// General's combat bonuses get the training tone (same call as stats.json's
// general columns), the rest tint by the stat's signature yield.
function scalingRow(roleKey: string): MxCell[] {
  return RATING_ORDER.map((slug) => {
    const s = statBySlug[slug];
    const role = (s.roles as any[]).find((r) => r.key === roleKey);
    if (!role) return null;
    const text = `+${role.effect}${roleKey === 'general' && !String(role.effect).endsWith('%') && role.kind === 'pct' ? ' %' : ''}`;
    const tone = roleKey === 'general' ? 'yield-training' : `yield-${s.yield}`;
    return { text, tone };
  });
}

// Council rows: jobs.json effects are "+X Thing × tri(Rating)" strings
// humanized from council.xml — split them back out per rating.
function councilRow(jobName: string): MxCell[] {
  const job = jobs.find((j) => j.name === jobName);
  const byRating: Record<string, string> = {};
  for (const e of job?.effects ?? []) {
    const m = e.match(/^(.+) × tri\((\w+)\)$/);
    if (m) byRating[m[2].toLowerCase()] = m[1];
  }
  return RATING_ORDER.map((slug) => {
    const text = byRating[slug];
    if (!text) return null;
    return { text, tone: `yield-${classifyYield(text)?.toLowerCase() || 'misc'}`, tri: true };
  });
}

const slotFits = (slot: string) =>
  new Set(archetypesData.filter((a) => (a.slots as string[]).includes(slot)).map((a) => a.name));
const jobFits = (jobName: string) =>
  new Set(jobs.find((j) => j.name === jobName)?.traitPrereqs ?? []);

type MxRole = { name: string; note: string; cells: MxCell[]; fits: Set<string> | null; fitNote?: string };
const matrixRoles: MxRole[] = [
  { name: 'Leader & Courtiers', note: 'flat yield/turn', cells: scalingRow('leader'), fits: null },
  { name: 'Governor', note: 'yield % in city', cells: scalingRow('governor'), fits: slotFits('Governor'), fitNote: 'can govern' },
  { name: 'General', note: 'unit bonus', cells: scalingRow('general'), fits: slotFits('General'), fitNote: 'can lead units' },
  { name: 'Ambassador', note: 'council seat', cells: councilRow('Ambassador'), fits: jobFits('Ambassador'), fitNote: 'eligible archetype' },
  { name: 'Chancellor', note: 'council seat', cells: councilRow('Chancellor'), fits: jobFits('Chancellor'), fitNote: 'eligible archetype' },
  { name: 'Spymaster', note: 'council seat', cells: councilRow('Spymaster'), fits: jobFits('Spymaster'), fitNote: 'eligible archetype' },
  { name: 'Agent', note: 'yield % abroad', cells: scalingRow('agent'), fits: slotFits('Agent'), fitNote: 'can be agent' },
];

const courseRows = (studyCourses as any[]).map((c) => ({
  name: c.course as string,
  rating: (c.rating as string).toLowerCase(),
  text: `+${c.ratingBonus} ${c.rating}`,
  pool: new Set(c.archetypes as string[]),
}));

const archRows = archetypesData.map((a) => ({
  name: a.name,
  slug: a.slug,
  icon: a.icon,
  mods: Object.fromEntries(a.ratings.map((r) => [r.label.toLowerCase(), r.value])) as Record<string, number>,
}));

const mxCols = 1 + ratingCols.length + archRows.length;
const toneBySlug = Object.fromEntries(RATING_ORDER.map((slug) => [slug, `yield-${statBySlug[slug].yield}`]));
---

<Base title="Jobs" active="jobs" pageMark="💼" pageStats={[
  { label: 'jobs', value: jobs.length },
  { label: 'council seats', value: grouped['Council']?.length ?? 0 },
  { label: 'archetypes', value: archRows.length },
]}>
  <h2 class="mx-h">Jobs at-a-glance</h2>
  <p class="mx-sub">
    What each rating pays in each role, which archetypes can hold it, and how heir education
    funnels into archetypes. Council payouts scale by the triangle of the rating (×△);
    Governor / Agent / General payouts follow the
    <a href={`${base}stat-scaling`}>rating formula</a>.
  </p>

  <div class="grid">
    <div class="grid__scroll">
      <table class="ntbl mx">
        <colgroup>
          <col class="ntbl__rowlabel-col mx-col-label" />
          {ratingCols.map(() => <col class="mx-col-rating" />)}
          {archRows.map(() => <col class="mx-col-arch" />)}
        </colgroup>
        <thead>
          <tr>
            <th class="rowlabel rowlabel--corner">
              <span class="rowlabel__small">Rating · Archetype →</span>
              <span class="rowlabel__big">Role ↓</span>
            </th>
            {ratingCols.map((s) => (
              <th class="nhdr" style={`--nation-bg:${s.color}`} title={`${s.name} — in-game color`}>
                <div class="nhdr__inner">
                  <a class="nhdr__link" href={`${base}${s.slug}`}>
                    <img class="nhdr__crest" src={`${base}img/icons/yields/${s.yield}.png`} alt="" loading="lazy" onerror="this.style.display='none'" />
                    <span class="nhdr__name">{s.name}</span>
                  </a>
                </div>
              </th>
            ))}
            {archRows.map((a, i) => (
              <th class={`nhdr mx-archhdr${i === 0 ? ' mx-archstart' : ''}`}>
                <div class="nhdr__inner">
                  <a class="nhdr__link" href={`${base}archetypes#${a.slug}`}>
                    {a.icon && <img class="nhdr__crest mx-archcrest" src={`${base}${a.icon}`} alt="" loading="lazy" onerror="this.style.display='none'" />}
                    <span class="nhdr__name mx-archname">{a.name}</span>
                  </a>
                </div>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          <tr class="srow">
            <th class="srow__th" colspan={mxCols}>
              <span class="srow__chevron">▸</span> Roles — rating payout · archetype fit
            </th>
          </tr>
          {matrixRoles.map((r) => (
            <tr>
              <th class="rowlabel" scope="row">
                {r.name}
                <span class="mx-rownote">{r.note}</span>
              </th>
              {r.cells.map((c) => c ? (
                <td class="cell mx-cell">
                  <div class={`effect ${c.tone}`}>
                    <LinkedText text={c.text} showIcons={false} />
                    {c.tri && <span class="tri-mark" title="Scales with the triangle of the rating: ×R·(R+1)/2">×△</span>}
                  </div>
                </td>
              ) : (
                <td class="cell mx-cell is-empty"><span class="cell__dash">—</span></td>
              ))}
              {archRows.map((a, i) => (
                <td class={`cell mx-cell mx-fitcell${i === 0 ? ' mx-archstart' : ''} ${r.fits?.has(a.name) ? '' : 'is-empty'}`}>
                  {r.fits?.has(a.name)
                    ? <span class="mx-dot" title={`${a.name} — ${r.fitNote ?? 'fits'} (${r.name})`}>●</span>
                    : <span class="cell__dash">—</span>}
                </td>
              ))}
            </tr>
          ))}

          <tr class="srow">
            <th class="srow__th" colspan={mxCols}>
              <span class="srow__chevron">▸</span> Heir education — course rating bump · graduation archetype pool
            </th>
          </tr>
          {courseRows.map((c) => (
            <tr>
              <th class="rowlabel" scope="row">{c.name}</th>
              {RATING_ORDER.map((slug) => slug === c.rating ? (
                <td class="cell mx-cell">
                  <div class={`effect ${toneBySlug[slug]}`}>
                    <LinkedText text={c.text} showIcons={false} />
                  </div>
                </td>
              ) : (
                <td class="cell mx-cell is-empty"><span class="cell__dash">—</span></td>
              ))}
              {archRows.map((a, i) => (
                <td class={`cell mx-cell mx-fitcell${i === 0 ? ' mx-archstart' : ''} ${c.pool.has(a.name) ? '' : 'is-empty'}`}>
                  {c.pool.has(a.name)
                    ? <span class="mx-dot" title={`Studying ${c.name} can lead to ${a.name}`}>●</span>
                    : <span class="cell__dash">—</span>}
                </td>
              ))}
            </tr>
          ))}

          <tr class="srow">
            <th class="srow__th" colspan={mxCols}>
              <span class="srow__chevron">▸</span> Archetypes — rating modifiers
            </th>
          </tr>
          {archRows.map((a) => (
            <tr>
              <th class="rowlabel" scope="row">
                <span class="mx-archlabel">
                  {a.icon && <img class="mx-archlabel__icon" src={`${base}${a.icon}`} alt="" loading="lazy" onerror="this.style.display='none'" />}
                  <a class="mx-archlabel__link" href={`${base}archetypes#${a.slug}`}>{a.name}</a>
                </span>
              </th>
              {RATING_ORDER.map((slug) => {
                const v = a.mods[slug];
                if (!v) return <td class="cell mx-cell is-empty"><span class="cell__dash">—</span></td>;
                const s = statBySlug[slug];
                return (
                  <td class="cell mx-cell">
                    <div class={`effect ${toneBySlug[slug]}${v < 0 ? ' mx-neg' : ''}`} title={`${a.name}: ${v > 0 ? '+' : ''}${v} ${s.name}`}>
                      {v > 0 ? `+${v}` : `−${Math.abs(v)}`} {s.name}
                    </div>
                  </td>
                );
              })}
              {archRows.map((other, i) => (
                <td class={`cell mx-cell mx-fitcell${i === 0 ? ' mx-archstart' : ''} ${other.slug === a.slug ? '' : 'is-empty'}`}>
                  {other.slug === a.slug
                    ? <span class="mx-self" title={`${a.name} — this column`}>◆</span>
                    : <span class="cell__dash">—</span>}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <div class="legends mx-legends">
    <div class="legend">
      <span class="legend__label">● Fit</span>
      Archetype can hold the role (trait prereqs in <code>trait.xml</code> / council seat prereqs) —
      or, on education rows, the course's graduation archetype pool.
    </div>
    <div class="legend">
      <span class="legend__label">×△ Triangular scaling</span>
      Council payouts multiply their base by tri(R) = R·(R+1)/2 of the seat-holder's rating.
    </div>
  </div>

  <h2 class="mx-h">Job details</h2>
  <div class="grid" id="jobs-grid">
    <div class="grid__scroll">
      <table class="ntbl">
        <colgroup>
          <col class="ntbl__rowlabel-col" />
          <col />
          <col />
          <col />
          <col />
          <col />
          <col />
        </colgroup>
        <thead>
          <tr>
            <th class="rowlabel rowlabel--corner">
              <span class="rowlabel__small">Job →</span>
              <span class="rowlabel__big">Field ↓</span>
            </th>
            <th class="nhdr nhdr--family">Name</th>
            <th class="nhdr nhdr--family">Slot</th>
            <th class="nhdr nhdr--family">Tech Prereq</th>
            <th class="nhdr nhdr--family">Trait Prereqs</th>
            <th class="nhdr nhdr--family">Assignment Opinion</th>
            <th class="nhdr nhdr--family">Effects</th>
          </tr>
        </thead>
        <tbody>
          {sections.map(section => (
            <>
              <tr class="srow">
                <th class="srow__th" colspan={7}>
                  <span class="srow__chevron">▸</span>
                  <span class="srow__icon">{SLOT_GLYPH[section]}</span> {section} Jobs
                </th>
              </tr>
              {grouped[section].map(j => (
                <tr data-job={j.slug}>
                  <th class="rowlabel" scope="row" id={j.slug}>{j.name}</th>
                  <td class="cell yield-misc">
                    <span class="job__title">{j.name}</span>
                    {j.dlc && <span class="job__dlc">{j.dlc.replace('EVENTPACK_', '').replace('_', ' ').toLowerCase()}</span>}
                  </td>
                  <td class="cell yield-misc">
                    <span class="slot-tag" data-slot={j.slotType.toLowerCase()}>
                      <span class="slot-tag__glyph">{SLOT_GLYPH[j.slotType]}</span>
                      {j.slotType}
                    </span>
                  </td>
                  <td class={`cell ${j.techPrereq ? 'yield-science' : 'is-empty'}`}>
                    {j.techPrereq ? <LinkedText text={j.techPrereq} /> : <span class="cell__dash">—</span>}
                  </td>
                  <td class={`cell ${j.traitPrereqs.length ? 'yield-misc' : 'is-empty'}`}>
                    {j.traitPrereqs.length ? (
                      <div class="chiplist">
                        {j.traitPrereqs.map(t => <span class="chip chip--neutral">{t}</span>)}
                      </div>
                    ) : <span class="cell__dash">—</span>}
                  </td>
                  <td class={`cell ${j.iOpinion ? 'yield-legitimacy' : 'is-empty'}`}>
                    {j.iOpinion ? <span class="opinion__val opinion--pos">+{j.iOpinion}</span> : <span class="cell__dash">—</span>}
                  </td>
                  <td class={`cell ${j.effects.length ? 'cell--effects' : 'is-empty'}`}>
                    {j.effects.length ? j.effects.map(text => {
                      const yieldKey = classifyYield(text)?.toLowerCase() || 'misc';
                      // "+1 Civics × tri(Charisma)" → base + ×△ marker, same as the Council page
                      const tri = text.match(/^(.+) × tri\((\w+)\)$/);
                      return (
                        <div class={`effect yield-${yieldKey}${tri ? ' effect--tri' : ''}`}>
                          {tri ? (
                            <>
                              <span class="rating-label">{tri[2]}</span>
                              <span class="effect__out">
                                <LinkedText text={tri[1]} showIcons={false} />
                                <span class="tri-mark" title="Scales with the triangle of the rating: ×R·(R+1)/2">×△</span>
                              </span>
                            </>
                          ) : (
                            <LinkedText text={text} showIcons={false} />
                          )}
                        </div>
                      );
                    }) : <span class="cell__dash">—</span>}
                  </td>
                </tr>
              ))}
            </>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <div class="legends">
    <div class="legend">
      <span class="legend__label">×△ Triangular scaling</span>
      Council yields and opinions multiply their base by tri(R) = R·(R+1)/2 of the assigned character's rating —
      rating 1/2/3/4/5 → ×1/×3/×6/×10/×15. Opinions are also rounded out to the nearest 5.
      See <a href={`${base}council`}>Council</a> for the full breakdown.
    </div>
  </div>

  <script type="application/json" id="job-search-blobs" set:html={JSON.stringify(searchBlobs)}></script>
  <script is:inline>
    (function () {
      const input = document.getElementById('site-search');
      const blobNode = document.getElementById('job-search-blobs');
      const grid = document.getElementById('jobs-grid');
      if (!input || !blobNode || !grid) return;
      let blobs;
      try { blobs = JSON.parse(blobNode.textContent || '{}'); } catch { return; }
      function apply() {
        const q = (input.value || '').trim().toLowerCase();
        for (const slug of Object.keys(blobs)) {
          const match = !q || blobs[slug].includes(q);
          for (const el of grid.querySelectorAll('[data-job="' + slug + '"]')) {
            el.classList.toggle('is-hidden', !match);
          }
        }
      }
      input.addEventListener('input', apply);
      apply();
    })();
  </script>
</Base>

<style>
  /* ─── At-a-glance matrix ─── */
  .mx-h {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    margin: 1.2rem 0 0.2rem;
  }
  .mx-h:first-of-type { margin-top: 0; }
  .mx-sub {
    margin: 0.2rem 0 0.8rem;
    max-width: 64rem;
    font-size: 0.84rem;
    color: var(--text-dim);
    line-height: 1.45;
  }
  .mx col.mx-col-rating { width: 9.5rem; }
  .mx col.mx-col-arch { width: 4.6rem; }

  /* Colored mini-tile — same recipe as the Projects effects tiles */
  .mx .effect {
    display: inline-block;
    padding: 0.18rem 0.45rem;
    border-radius: var(--radius-sm);
    font-size: 0.74rem;
    line-height: 1.3;
    background: var(--yield-bg, var(--bg-elev));
    color: var(--yield-fg, var(--text));
    background-image: linear-gradient(180deg, #ffffff0d, #0003 60%, #00000052);
    border: 1px solid color-mix(in srgb, var(--yield-bg, var(--border)) 50%, #000 50%);
  }
  .mx .effect.mx-neg {
    background: transparent;
    background-image: none;
    color: var(--text-dim);
    border: 1px dashed color-mix(in srgb, var(--yield-bg, var(--border)) 55%, transparent);
  }
  .mx .effect .tri-mark { margin-left: 0.3rem; }

  .mx .mx-cell { padding: 0.26rem 0.5rem; }
  .mx .mx-fitcell { text-align: center; }
  .mx-dot { color: var(--gold); font-size: 0.7rem; }
  .mx-self { color: var(--gold-soft); font-size: 0.68rem; opacity: 0.85; }

  /* Divider where the archetype block starts */
  .mx .mx-archstart { border-left: 1px solid var(--border-strong); }

  /* Compact archetype column headers */
  .mx .mx-archhdr { padding: 0.5rem 0.35rem 0.4rem; }
  .mx .mx-archhdr .nhdr__inner::after { background: var(--border-strong); }
  .mx .mx-archcrest { width: 20px; height: 20px; }
  .mx .mx-archname { font-size: 0.7rem; line-height: 1.1; }

  .mx-rownote {
    display: block;
    font-family: var(--font-ui);
    font-weight: 400;
    font-size: 0.62rem;
    color: var(--text-faint);
  }
  .mx-archlabel { display: inline-flex; align-items: center; gap: 0.3rem; }
  .mx-archlabel__icon { width: 14px; height: 14px; object-fit: contain; opacity: 0.9; }
  .mx-archlabel__link { color: inherit; text-decoration: none; }
  .mx-archlabel__link:hover { color: var(--gold); }
  .mx-legends { margin-bottom: 1rem; }

  .job__title {
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: 0.02em;
  }
  .job__dlc {
    display: block;
    margin-top: 0.1rem;
    font-size: 0.6rem;
    color: var(--text-faint);
    font-style: italic;
    text-transform: lowercase;
  }
  .slot-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.15rem 0.5rem;
    background: var(--bg-elev-2);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.7rem;
    color: var(--text);
  }
  .slot-tag__glyph { color: var(--accent); opacity: 0.85; }
  .slot-tag[data-slot="council"]  { border-color: color-mix(in srgb, var(--accent) 50%, var(--border)); }
  .slot-tag[data-slot="general"]  { border-color: color-mix(in srgb, #c25555 50%, var(--border)); }
  .slot-tag[data-slot="governor"] { border-color: color-mix(in srgb, #4e84b8 50%, var(--border)); }
  .slot-tag[data-slot="agent"]    { border-color: color-mix(in srgb, #735483 50%, var(--border)); }

  .chiplist {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem;
  }
  .chiplist .chip {
    padding: 0.1rem 0.45rem;
    font-size: 0.7rem;
  }

  .srow__icon { color: var(--accent); margin-right: 0.3rem; }

  /* Triangular-scaled effects — same presentation as the Council page */
  .effect--tri {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.4rem;
  }
  .effect--tri .rating-label {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.02em;
  }
  .effect--tri .effect__out { text-align: right; }
  .tri-mark {
    margin-left: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--gold-soft, var(--text-faint));
    cursor: help;
  }

  /* Wider job-name column for legibility */
  .ntbl .nhdr:nth-child(2) { min-width: 8rem; }
  /* Pull the effects column wider so multi-line bonuses don't get cramped */
  .ntbl .nhdr:last-child { min-width: 18rem; }
</style>
