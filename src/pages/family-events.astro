---
import EventGroupPage from '../components/EventGroupPage.astro';
const base = import.meta.env.BASE_URL;
---
<EventGroupPage sectionKey="family" title="Family Events" active="family-events" pageMark="👪">
  Events tied to one <a href={`${base}families`}>family class</a>: Champions, Clerics, Hunters, Landowners,
  Patrons, Riders, Sages, Statesmen, Traders and Artisans. They fire only for a family of that class, or
  are about one. The trigger chip names the class. These events also appear in their own category on
  <a href={`${base}events`}>Story Events</a>.
</EventGroupPage>
