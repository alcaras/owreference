---
import Base from '../layouts/Base.astro';
import LinkedText from '../components/LinkedText.astro';

// Constants from reference/XML/Infos/globalsInt.xml and culture.xml; mechanic
// transcribed from City.cs (getCaptureThreshold / setCaptureTurns / doTribeTurn).
// Counter: +1 per turn while isUnitCapturingCity (changeCaptureTurns(1)), -1 per
// turn otherwise, reset by setCaptureTurns(0) on ownership change. Founder test is
// getCaptureTeam() != getFirstTeam(). Razing on capture (setCaptureTurns): a tribe
// with GAMEOPTION_ALLOW_CITY_RAZING, or a player at isCityMaxReached().
//
//   CITY_BASE_CAPTURE_TURNS      = 2
//   CITY_CAPTURE_DAMAGE_PERCENT  = 50   (HP the city is left at after it flips)
//   culture.iExtraCaptureTurns:  Weak 0 · Developing 1 · Strong 2 · Legendary 3
//   +1 to the threshold when the capturer is NOT the city's original founder.

const BASE_TURNS = 2;

const cultures = [
  { name: 'Weak',       extra: 0 },
  { name: 'Developing', extra: 1 },
  { name: 'Strong',     extra: 2 },
  { name: 'Legendary',  extra: 3 },
];

// threshold = max(1, base + cultureExtra + (notFounder ? 1 : 0))
const rows = cultures.map(c => ({
  culture: c.name,
  extra: c.extra,
  foreign: Math.max(1, BASE_TURNS + c.extra + 1), // taking a city you didn't found
  own:     Math.max(1, BASE_TURNS + c.extra),     // retaking a city your team founded
}));
---

<Base
  title="City Capture Mechanics"
  active="city-capture-mechanics"
  pageMark="🏰"
  description="How long a city takes to change hands after you occupy it in Old World: the capture counter, how culture level and founding change the turns needed, and how progress is lost."
  pageStats={[
    { label: 'base turns', value: BASE_TURNS },
    { label: 'capture HP left', value: '50%' },
  ]}
>
  <p class="lede">
    How many turns you must hold an enemy city before it becomes yours, and what
    happens if you are pushed off early.
  </p>

  <section class="cc-section">
    <h2 class="cc-h2">How the counter works</h2>
    <ul class="cc-bullets">
      <li>
        Each turn your unit occupies the city, a hidden capture counter goes up
        by <b>1</b>.
      </li>
      <li>
        When the counter reaches the number of turns needed, the city is yours,
        left at <b>50% HP</b>.
      </li>
      <li>
        While no one occupies it, the counter falls by <b>1</b> per turn back to
        0. You must hold the city for the full count without a break.
      </li>
      <li>
        The counter resets to 0 whenever the city changes owner, including a
        recapture or a liberation.
      </li>
    </ul>
  </section>

  <section class="cc-section">
    <h2 class="cc-h2">Turns needed</h2>
    <div class="cc-formula">
      <div class="cc-line">
        <span class="cc-eq">turns = {BASE_TURNS}</span>
      </div>
      <div class="cc-line">
        <span class="cc-eq cc-add">+ extra turns for the city's culture</span>
      </div>
      <div class="cc-line">
        <span class="cc-eq cc-add">+ 1&nbsp;&nbsp;if your team did not found the city</span>
      </div>
      <div class="cc-line cc-min">
        <span class="cc-eq">→ minimum 1</span>
      </div>
    </div>

    <p>
      The culture that counts is the highest culture level any other team has in
      the city.
    </p>

    <table class="cc-table cc-table--narrow">
      <thead>
        <tr><th>City culture</th><th class="cc-num">Extra turns</th></tr>
      </thead>
      <tbody>
        {cultures.map(c => (
          <tr>
            <td><LinkedText text={c.name} /></td>
            <td class="cc-num"><b>+{c.extra}</b></td>
          </tr>
        ))}
      </tbody>
    </table>

    <p class="cc-fineprint">
      <b>Retaking a city your team founded is one turn faster</b>, even if an
      enemy has held and grown it since.
    </p>
  </section>

  <section class="cc-section">
    <h2 class="cc-h2">Turns to flip</h2>
    <table class="cc-table">
      <thead>
        <tr>
          <th>City culture</th>
          <th class="cc-num">Taking a foreign city</th>
          <th class="cc-num">Retaking your own</th>
        </tr>
      </thead>
      <tbody>
        {rows.map(r => (
          <tr>
            <td><LinkedText text={r.culture} /> <span class="cc-dim">(+{r.extra})</span></td>
            <td class="cc-num"><b>{r.foreign}</b></td>
            <td class="cc-num"><b>{r.own}</b></td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="cc-fineprint">
      A new enemy city changes hands after <b>3</b> turns, and an old
      <LinkedText text="Legendary" /> enemy capital takes <b>6</b>. Liberating
      one of your own cities takes a turn off each.
    </p>
  </section>

  <section class="cc-section">
    <h2 class="cc-h2">When a captured city is razed instead</h2>
    <p>A captured city is <b>razed</b> instead of changing hands when:</p>
    <ul class="cc-bullets">
      <li>
        a <LinkedText text="Tribe" /> captures it and the city razing game option
        is on, or
      </li>
      <li>
        a player captures it while already at their <b>city cap</b>.
      </li>
    </ul>
  </section>

  <section class="cc-section">
    <h2 class="cc-h2">Example</h2>
    <ol class="cc-steps">
      <li>
        You attack a rival's <LinkedText text="Strong" />-culture city that you
        did not found. You need 2 + 2 (Strong) + 1 (not your city) = <b>5</b>
        turns.
      </li>
      <li>
        Your unit occupies the city, and the counter rises by 1 at the end of
        each turn it holds.
      </li>
      <li>
        If a relief force pushes you out with the counter at 3, it falls by 1 per
        turn back toward 0 and you start over.
      </li>
      <li>
        Hold all 5 turns and the city is yours at <b>50% HP</b>. If your team
        had founded it, it would take <b>4</b>.
      </li>
    </ol>
  </section>

</Base>

<style>
  .lede {
    color: var(--text-dim);
    font-size: 0.9rem;
    line-height: 1.55;
    max-width: 72ch;
    margin: 0.4rem 0 1.5rem;
  }

  .cc-section { margin-top: 2rem; }
  .cc-h2 {
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    margin: 0 0 0.5rem;
    color: var(--text);
  }
  .cc-section p {
    color: var(--text-dim);
    font-size: 0.85rem;
    line-height: 1.55;
    max-width: 72ch;
    margin: 0.3rem 0;
  }
  .cc-section p b { color: var(--text); }

  .cc-bullets {
    color: var(--text-dim);
    font-size: 0.85rem;
    line-height: 1.55;
    margin: 0.4rem 0 0.8rem;
    padding-left: 1.2rem;
    max-width: 80ch;
  }
  .cc-bullets li { padding: 0.2rem 0; }
  .cc-bullets b { color: var(--text); }

  .cc-formula {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.8rem 1rem;
    margin: 0.6rem 0 0.9rem;
    max-width: 60ch;
  }
  .cc-line { padding: 0.12rem 0; }
  .cc-eq {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text);
  }
  .cc-add { color: var(--text-dim); }
  .cc-min .cc-eq { color: var(--accent); }

  .cc-table {
    width: 100%;
    max-width: 64ch;
    border-collapse: collapse;
    margin: 0.6rem 0;
    font-size: 0.8rem;
  }
  .cc-table--narrow { max-width: 36ch; }
  .cc-table thead th {
    text-align: left;
    color: var(--text-dim);
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    padding: 0.4rem 0.5rem;
    border-bottom: 1px solid var(--border-strong);
  }
  .cc-table tbody td {
    padding: 0.4rem 0.5rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  .cc-table tbody tr:hover { background: var(--bg-elev); }
  .cc-num { text-align: right; font-variant-numeric: tabular-nums; font-family: var(--font-mono); }
  .cc-num b { color: var(--text); font-weight: 600; }
  .cc-dim { color: var(--text-faint); font-size: 0.8em; }

  .cc-steps {
    list-style: decimal inside;
    color: var(--text-dim);
    font-size: 0.85rem;
    line-height: 1.55;
    max-width: 72ch;
    padding: 0;
    margin: 0.5rem 0;
  }
  .cc-steps li { padding: 0.25rem 0; }
  .cc-steps b { color: var(--text); }

  .cc-fineprint {
    color: var(--text-faint) !important;
    font-size: 0.78rem !important;
    line-height: 1.5;
    font-style: italic;
    max-width: 72ch;
  }
  .cc-fineprint b { color: var(--text-dim); }
</style>
