---
import Base from '../layouts/Base.astro';
import D from '../data/family_city_opinion.json';
import OPINION from '../data/opinion.json';

const base = import.meta.env.BASE_URL;

const G = D.globals;
const famBrackets = (OPINION as any[]).find((t) => t.kind === 'Family')?.brackets ?? [];
const landowners = D.classes.find((c: any) => c.mostCities !== 0 || c.fewestCities !== 0);
const champions = D.classes.find((c: any) => c.largestMilitary !== 0);

// Default the picker to Rome — it has a Landowners family (Claudius), so the
// class extra is visible the moment the page loads.
const DEFAULT_NATION = D.nations.find((n: any) => n.id === 'NATION_ROME')?.id ?? D.nations[0].id;
const DEFAULT_TOTAL = 8;

// Envy ladder, precomputed: triangle(gap - 1) x ENVY_OPINION for each number
// of cities a family trails the largest family by.
const envyLadder = [0, 1, 2, 3, 4, 5, 6, 7].map((gap) => {
  const tri = gap < 2 ? 0 : ((gap - 1) * gap) / 2;
  const value = tri * G.ENVY_OPINION;
  return {
    gap,
    label: gap === 0 ? 'level or ahead' : String(gap),
    tri,
    value,
    cls: value === 0 ? 'mini__zero' : 'mini__bad',
    shown: value === 0 ? '—' : String(value),
  };
});

// Most/Fewest split by the number of families tied at that end. All three tied
// pays nothing at all.
const tieRows = [1, 2, 3].map((tied) => {
  const all = tied === 3;
  const half = (pool: number) => Math.trunc(pool / tied);
  return {
    tied,
    label: all ? '3 — all of them' : String(tied),
    all,
    most: all ? '—' : `+${half(G.MOST_CITIES_OPINION)}`,
    fewest: all ? '—' : String(half(G.FEWEST_CITIES_OPINION)),
    land: all ? '—' :
      `+${half(G.MOST_CITIES_OPINION + (landowners?.mostCities ?? 0))} / ` +
      `${half(G.FEWEST_CITIES_OPINION + (landowners?.fewestCities ?? 0))}`,
  };
});
---

<Base
  title="Envy & the City Split"
  active="family-envy"
  pageMark="😠"
  eyebrow="Family opinion"
  description="How Most Cities, Fewest Cities and Envy move family opinion — with a calculator for any split of cities between your three families."
  pageStats={[
    { label: 'most cities', value: `+${G.MOST_CITIES_OPINION}` },
    { label: 'fewest cities', value: G.FEWEST_CITIES_OPINION },
    { label: 'envy step', value: G.ENVY_OPINION },
  ]}
>
  <p class="lede">
    Three of the terms in <a href={`${base}opinion`}>family opinion</a> care about nothing but
    <strong>how many cities each family holds</strong>: <b>{D.help.mostCities}</b>
    (+{G.MOST_CITIES_OPINION}, split between families tied at the top), <b>{D.help.fewestCities}</b>
    ({G.FEWEST_CITIES_OPINION}, split at the bottom) and <b>{D.help.envyName}</b>, a curve that only
    starts once a family is <em>two</em> cities behind the leader and then bites hard. Only
    <b>{landowners?.name}</b> bend them, by {landowners?.mostCities} more at each end. Pick your nation,
    the three families you started with and how many cities you will have, and every way of
    dividing them is ranked below, kindest split first.
  </p>

  <section class="asm">
    <div class="asm__bar">
      <label class="f f--sel"><span>Nation</span>
        <select id="e-nation">
          {D.nations.map((n: any) => (
            <option value={n.id} selected={n.id === DEFAULT_NATION}>{n.name}</option>
          ))}
        </select>
      </label>
      <div class="asm__picks" id="e-picks"></div>
      <label class="f"><span>Total cities</span>
        <span class="f__step">
          <button type="button" class="stp" id="e-total-dn" aria-label="One fewer city">−</button>
          <input type="number" id="e-total" value={DEFAULT_TOTAL} min="0" max="40" />
          <button type="button" class="stp" id="e-total-up" aria-label="One more city">+</button>
        </span>
      </label>
      <button type="button" class="asm__reset" id="e-reset">Reset</button>
    </div>
  </section>

  <div class="duo">
  <div class="duo__left">
    <h2 class="fams__h">Breakdown of <b id="e-sel-lbl"></b></h2>
    <div class="fams" id="e-fams"></div>
  </div>
  <section class="rung duo__right">
    <h2 class="rung__h">Every way to split <b id="e-total-lbl">8</b> cities</h2>
    <p class="rung__note">
      Kindest split first: the one whose <em>unhappiest</em> family is least unhappy, then by the
      sum. Each cell is a family's city count and what that split does to its opinion. Click a row
      for the breakdown.
    </p>
    <div class="grid">
      <div class="grid__scroll">
        <table class="ntbl rung__t">
          <colgroup id="e-rung-cols"></colgroup>
          <thead>
            <tr id="e-rung-head"></tr>
          </thead>
          <tbody id="e-rung-body"></tbody>
        </table>
      </div>
    </div>
    <p class="rung__more" id="e-rung-more"></p>
  </section>
  </div>

  <section class="ladder">
    <div class="ladder__col">
      <h3>The {D.help.envyName} curve <span class="tag">triangular</span></h3>
      <p class="ladder__p">
        <code>triangle(lead − yours − 1) × {G.ENVY_OPINION}</code>, where <em>lead</em> is the most
        cities any one family holds. One city behind is free; after that each further city costs
        more than the last.
      </p>
      <table class="ntbl mini">
        <colgroup><col style="width:9rem" /><col /><col /></colgroup>
        <thead><tr>
          <th class="rowlabel rowlabel--corner">Cities behind</th>
          <th class="nhdr nhdr--num">triangle(n−1)</th>
          <th class="nhdr nhdr--num">{D.help.envyName}</th>
        </tr></thead>
        <tbody>
          {envyLadder.map((r) => (
            <tr>
              <td class="rowlabel mini__n">{r.label}</td>
              <td class="cell cell--num mini__dim">{r.tri}</td>
              <td class={`cell cell--num ${r.cls}`}>{r.shown}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="ladder__col">
      <h3>Ties split the award <span class="tag">integer division</span></h3>
      <p class="ladder__p">
        {D.help.mostCities} and {D.help.fewestCities} are divided by the number of families tied at
        that end, truncating toward zero — and if <em>every</em> family is tied, neither term
        applies at all. That is why a perfectly even split is worth exactly nothing rather than
        being worth something to everyone.
      </p>
      <table class="ntbl mini">
        <colgroup><col style="width:8rem" /><col /><col /><col style="width:8rem" /></colgroup>
        <thead><tr>
          <th class="rowlabel rowlabel--corner">Families tied</th>
          <th class="nhdr nhdr--num">{D.help.mostCities}</th>
          <th class="nhdr nhdr--num">{D.help.fewestCities}</th>
          <th class="nhdr nhdr--num">…as {landowners?.name}</th>
        </tr></thead>
        <tbody>
          {tieRows.map((r) => (
            <tr>
              <td class="rowlabel mini__n">{r.label}</td>
              <td class={`cell cell--num ${r.all ? 'mini__zero' : 'mini__good'}`}>{r.most}</td>
              <td class={`cell cell--num ${r.all ? 'mini__zero' : 'mini__bad'}`}>{r.fewest}</td>
              <td class={`cell cell--num ${r.all ? 'mini__zero' : 'mini__dim'}`}>{r.land}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="rates">
    <h2 class="rates__h">What the code says</h2>
    <div class="rates__cols">
      <div>
        <h3>{D.help.mostCities} <span class="tag">+{G.MOST_CITIES_OPINION}</span></h3>
        <ul>
          <li>Goes to the family holding <b>at least as many</b> cities as every other — a family
            that merely ties for the lead still qualifies.</li>
          <li>The award is <code>({G.MOST_CITIES_OPINION} + the class's own bonus) ÷ families tied
            at the top</code>, C# integer division.</li>
          <li>Nothing is paid when <b>all</b> families are tied — a young empire where every family
            holds one city collects at neither end — and nothing in a 1-family game.</li>
        </ul>
      </div>
      <div>
        <h3>{D.help.fewestCities} <span class="tag">{G.FEWEST_CITIES_OPINION}</span></h3>
        <ul>
          <li>The mirror image: charged to whoever holds <b>no more</b> cities than anyone else,
            split across everyone tied at the bottom.</li>
          <li>Both ends can land on the same family only if the split is even — and an even split
            cancels both, so in practice no family ever takes both.</li>
          <li>A family with <b>zero</b> cities is still counted; losing your last city to a rival
            leaves the family at the bottom of the table, not out of it.</li>
        </ul>
      </div>
      <div>
        <h3>{D.help.envyName} <span class="tag">{G.ENVY_OPINION} × triangle</span></h3>
        <ul>
          <li>Compares every family against the <b>largest</b> family, not against the average, so
            one runaway family makes the other two miserable at once.</li>
          <li><code>(yours + 1) ≥ lead</code> pays nothing — the one-city grace is what makes a
            4/3/3 split so much cheaper than 4/4/1.</li>
          <li>Triangular, not linear: two behind is {1 * G.ENVY_OPINION}, three is
            {3 * G.ENVY_OPINION}, four is {6 * G.ENVY_OPINION}, five is {10 * G.ENVY_OPINION}. The
            fifth city of a gap costs as much as the first four together.</li>
          <li>Unlike the other two it has no tie logic and no class modifier — every family reads
            the same ladder.</li>
        </ul>
      </div>
      <div>
        <h3>Class extras</h3>
        <ul>
          <li><b><a href={`${base}families/${landowners?.slug}`}>{landowners?.name}</a></b> are the
            only class that bends these terms: <code>iMostCitiesOpinion</code>
            +{landowners?.mostCities} and <code>iFewestCitiesOpinion</code> {landowners?.fewestCities},
            which <b>doubles</b> both — {G.MOST_CITIES_OPINION + (landowners?.mostCities ?? 0)} at the
            top, {G.FEWEST_CITIES_OPINION + (landowners?.fewestCities ?? 0)} at the bottom. Envy is
            unchanged.</li>
          <li><b><a href={`${base}families/${champions?.slug}`}>{champions?.name}</a></b> run the same
            mechanic on <em>units</em> instead ({champions?.largestMilitary} / {champions?.smallestMilitary}
            for the largest and smallest military), and there the award is not divided on a tie —
            ties simply pay nothing.</li>
          <li>Every other class contributes 0 to both, so their families read the flat globals.</li>
        </ul>
      </div>
      <div>
        <h3>What lands where</h3>
        <ul>
          {famBrackets.map((b: any) => (
            <li><b>{b.label}</b> <span class="tag">{b.range}</span>
              {' — '}{[...b.cityEffects, ...b.unitEffects].join(', ') || 'no effect'}</li>
          ))}
        </ul>
      </div>
      <div>
        <h3>Reading the result</h3>
        <ul>
          <li>The city terms are only part of the sum. Leader traits, council seats, laws,
            luxuries, wonders, religion and memories all add into the same number before it is
            bracketed, so the bracket shown here is what the cities alone would earn.</li>
          <li>Because it is recomputed rather than accumulated, <b>giving a city away fixes the
            number immediately</b>. There is no decay to wait out.</li>
          <li>Founding a city is also previewed this way in-game: the found-city tooltip shows each
            family's Envy and Most/Fewest terms <em>before and after</em>, which is the same routine
            run with the new city already assigned.</li>
          <li>The count is not the only way cities move opinion — <code>calculateFamilyOpinionCityDist</code>
            also rewards a family whose own cities sit <b>close together</b>, off the average distance
            between them and the map's minimum city-site spacing. Traders are the one class that wants
            the opposite (<code>bPrefersDistant</code>), and either way it is a bonus only, never a
            penalty. It is not modelled here.</li>
        </ul>
      </div>
    </div>
    <p class="fine">
      Formulas from <b>PlayerOpinion.cs</b> —
      <code>calculateFamilyOpinionMostCities</code>, <code>calculateFamilyOpinionFewestCities</code>,
      <code>calculateFamilyOpinionEnvy</code>, summed by <code>calculateFamilyOpinionRate</code> and
      bracketed by <code>InfoHelpers.getOpinionFamilyFromRate</code>; <code>triangle</code> from
      <b>Utils.cs</b>. Constants from <code>globalsInt.xml</code> and <code>familyClass.xml</code>,
      brackets from <code>opinionFamily.xml</code>, family colors from <code>color.xml</code>.
      Integer truncation is reproduced exactly. See <a href={`${base}families`}>Families</a> for the
      rest of each class's opinion modifiers and <a href={`${base}opinion`}>Opinion</a> for the
      bracket effects in full.
    </p>
  </section>
</Base>

<script is:inline define:vars={{ D, base, DEFAULT_NATION, DEFAULT_TOTAL }}>
  (() => {
    const $ = (id) => document.getElementById(id);
    const G = D.globals;
    const idiv = (a, b) => Math.trunc(a / b);
    // Utils.cs triangle
    const triangle = (n) => {
      const a = Math.abs(n);
      return Math.sign(n) * a * (a + 1) / 2;
    };

    // InfoHelpers.getOpinionFromRate — the smallest threshold at or above the
    // value wins; Friendly's missing threshold is int.MaxValue.
    const bracketFor = (v) => {
      let best = null;
      let min = Infinity;
      for (const b of D.brackets) {
        const t = b.threshold === null ? Infinity : b.threshold;
        if (t >= v && t <= min) { min = t; best = b; }
      }
      return best;
    };

    // The three city-count terms, replayed per family
    // (PlayerOpinion.cs calculateFamilyOpinionMostCities / FewestCities / Envy).
    // `fams` is [{cities, mostCities, fewestCities}] — class extras, not globals.
    function cityTerms(fams) {
      const n = fams.length;
      const counts = fams.map((f) => f.cities);
      const lead = counts.length ? Math.max(...counts) : 0;

      return fams.map((f, i) => {
        const c = counts[i];
        let most = null;
        let fewest = null;
        let envy = null;

        if (n > 1) {
          const opMost = f.mostCities + G.MOST_CITIES_OPINION;
          if (opMost !== 0) {
            let tied = 1;
            let beaten = false;
            for (let j = 0; j < n; j++) {
              if (j === i) continue;
              if (counts[j] > c) { beaten = true; break; }
              if (counts[j] === c) tied++;
            }
            if (!beaten && tied !== n) most = { value: idiv(opMost, tied), tied, pool: opMost };
          }

          const opFew = f.fewestCities + G.FEWEST_CITIES_OPINION;
          if (opFew !== 0) {
            let tied = 1;
            let beaten = false;
            for (let j = 0; j < n; j++) {
              if (j === i) continue;
              if (counts[j] < c) { beaten = true; break; }
              if (counts[j] === c) tied++;
            }
            if (!beaten && tied !== n) fewest = { value: idiv(opFew, tied), tied, pool: opFew };
          }
        }

        if (n > 0 && (c + 1) < lead) {
          const gap = lead - (c + 1);
          const v = triangle(gap) * G.ENVY_OPINION;
          if (v !== 0) envy = { value: v, gap: lead - c, tri: triangle(gap) };
        }

        const total = (most?.value ?? 0) + (fewest?.value ?? 0) + (envy?.value ?? 0);
        return { most, fewest, envy, total, cities: c, lead };
      });
    }

    // ── state ────────────────────────────────────────────────────────
    let nationId = DEFAULT_NATION;
    const count = 3;     // MAX_FAMILIES: three of the nation's four are ever in play
    let picks = [];      // family ids, one per slot
    let total = DEFAULT_TOTAL;
    let selected = null; // split key "a/b/c" the breakdown shows; null = the top row
    let showAll = false;

    const nation = () => D.nations.find((n) => n.id === nationId) || D.nations[0];
    const familyById = (id) => nation().families.find((f) => f.id === id);

    function resetPicks() {
      picks = nation().families.slice(0, 3).map((f) => f.id);
      selected = null;
      showAll = false;
    }

    function slots() {
      return picks.slice(0, count).map((id, i) => ({ ...(familyById(id) || nation().families[i]), other: 0 }));
    }

    const sign = (v) => (v > 0 ? `+${v}` : `${v}`);
    const esc = (s) => String(s).replace(/[&<>"]/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

    // ── family pickers ───────────────────────────────────────────────
    function renderPicks() {
      const s = slots();
      const nationFams = nation().families;
      $('e-picks').innerHTML = s.map((f, i) => {
        const options = nationFams.map((nf) =>
          `<option value="${nf.id}"${nf.id === f.id ? ' selected' : ''}>${esc(nf.name)} · ${esc(nf.className)}</option>`).join('');
        const extra = f.mostCities || f.fewestCities
          ? ` <i class="pick__extra" title="${esc(f.className)}: ${sign(f.mostCities)} most cities, ${sign(f.fewestCities)} fewest cities">${sign(f.mostCities)}/${sign(f.fewestCities)}</i>` : '';
        return `<label class="f f--sel pick" style="--fam:${f.color}"><span>Family ${i + 1}${extra}</span>
          <select class="pick__sel" data-slot="${i}" aria-label="Family in slot ${i + 1}">${options}</select></label>`;
      }).join('');
    }

    // ── every split of `total` across the slots ──────────────────────
    // Compositions, not partitions: who holds which pile matters once a
    // Landowners family is in play, and the reader wants to see their own
    // family names in the columns anyway.
    function allSplits(s) {
      const n = s.length;
      const rows = [];
      // Every family holds at least one city: a family with none is not a
      // plan anyone makes, and it drowns the list in 0/x/y rows.
      const walk = (i, left, acc) => {
        if (i === n - 1) { if (left >= 1) rows.push(acc.concat(left)); return; }
        for (let k = left - (n - 1 - i); k >= 1; k--) walk(i + 1, left - k, acc.concat(k));
      };
      if (n > 0 && total >= n) walk(0, total, []);
      const scored = rows.map((split) => {
        const terms = cityTerms(s.map((f, i) => ({ ...f, cities: split[i] })));
        const totals = terms.map((t) => t.total);
        const withOther = totals.map((v, i) => v + s[i].other);
        return {
          split, key: split.join('/'), terms, totals,
          sum: totals.reduce((a, v) => a + v, 0),
          worst: Math.min(...totals),
          worstAll: Math.min(...withOther),
          even: Math.max(...split) - Math.min(...split) <= 1,
        };
      });
      // Worst family first, then the sum, then the flattest split: the
      // ordering a player actually cares about is "which split leaves nobody
      // furious".
      scored.sort((a, b) => (b.worst - a.worst) || (b.sum - a.sum) ||
        ((Math.max(...a.split) - Math.min(...a.split)) - (Math.max(...b.split) - Math.min(...b.split))));
      return scored;
    }

    function renderRungs(s, scored) {
      const head = ['<th class="rowlabel rowlabel--corner">Split</th>']
        .concat(s.map((f) => `<th class="nhdr rung__fh"><span style="--fam:${f.color}"></span>${esc(f.name)}</th>`))
        .concat(['<th class="nhdr nhdr--num">Sum</th>', '<th class="nhdr nhdr--num">Worst</th>']);
      $('e-rung-head').innerHTML = head.join('');
      $('e-rung-cols').innerHTML = ['<col style="width:5.5rem" />']
        .concat(s.map(() => '<col style="width:9.5rem" />'))
        .concat(['<col style="width:5rem" />', '<col style="width:5rem" />']).join('');

      const cap = showAll ? Infinity : 20;
      const shown = scored.slice(0, cap);
      if (selected && !shown.some((r) => r.key === selected)) {
        const here = scored.find((r) => r.key === selected);
        if (here) shown.push(here);
      }
      $('e-rung-more').innerHTML = scored.length === 0
        ? `Fewer cities than families: every family needs at least one.`
        : scored.length > shown.length
          ? `Best ${shown.length} of ${scored.length} splits · <a href="#" id="e-show-all">show all</a>`
          : `${scored.length} splits${showAll && scored.length > 20 ? ' · <a href="#" id="e-show-all">show fewer</a>' : ''}`;

      const selKey = selected || (scored[0] && scored[0].key);
      $('e-rung-body').innerHTML = shown.map((r, idx) => {
        const cells = r.totals.map((v, i) => {
          const b = bracketFor(v + s[i].other);
          const cls = v > 0 ? 'is-good' : v < 0 ? 'is-bad' : 'is-zero';
          return `<td class="cell rung__c ${cls}" style="--brk:${b ? b.color : '#7d8590'}" title="${b ? esc(b.label) : ''}">` +
            `<b>${r.split[i]}</b><i>${sign(v)}</i></td>`;
        }).join('');
        const flags = (idx === 0 && !scored.slice(1).some(x => x.worst === r.worst && x.sum === r.sum) ? '<em class="rung__flag">best</em>' : '') +
          (r.even ? '<em class="rung__flag rung__flag--even">even</em>' : '');
        return `<tr class="rung__r${r.key === selKey ? ' is-here' : ''}" data-split="${r.key}">` +
          `<td class="rowlabel rung__k">${r.key}${flags}</td>${cells}` +
          `<td class="cell cell--num rung__s">${sign(r.sum)}</td>` +
          `<td class="cell cell--num ${r.worst < 0 ? 'is-bad' : 'is-zero'}">${sign(r.worst)}</td></tr>`;
      }).join('');
      return selKey;
    }

    // "40 ÷ 1 tied" is nonsense; say what the split actually was.
    function tieNote(term, off, n) {
      if (!term) return n > 1 ? off : 'no rivals';
      if (term.tied === 1) return `${term.pool}, alone at that end`;
      return `${term.pool} ÷ ${term.tied} tied`;
    }
    function termRow(label, note, term) {
      if (!term) return `<li class="fam__term is-off"><span>${label}</span><i>${note}</i><b>—</b></li>`;
      const cls = term.value > 0 ? 'is-good' : term.value < 0 ? 'is-bad' : '';
      return `<li class="fam__term ${cls}"><span>${label}</span><i>${note}</i><b>${sign(term.value)}</b></li>`;
    }

    function renderBreakdown(s, row) {
      $('e-sel-lbl').textContent = row ? row.key : '—';
      if (!row) { $('e-fams').innerHTML = ''; return; }
      $('e-fams').innerHTML = s.map((f, i) => {
        const t = row.terms[i];
        const sum = t.total + f.other;
        const b = bracketFor(sum);
        const extra = f.mostCities || f.fewestCities
          ? `<span class="fam__extra">${esc(f.className)} ${sign(f.mostCities)} / ${sign(f.fewestCities)}</span>` : '';
        return `<article class="fam" style="--fam:${f.color}">
          <div class="fam__strip"></div>
          <div class="fam__head">
            <span class="fam__name">${esc(f.name)}</span>
            <a class="fam__class" href="${base}families/${f.classSlug}">
              <img src="${base}${f.icon}" alt="" width="16" height="16" />${esc(f.className)}</a>
            ${extra}
          </div>
          <div class="fam__cities"><b class="fam__n">${row.split[i]}</b><span class="fam__cl">${row.split[i] === 1 ? 'city' : 'cities'}</span></div>
          <ul class="fam__terms">
            ${termRow(D.help.mostCities, tieNote(t.most, 'not the largest', s.length), t.most)}
            ${termRow(D.help.fewestCities, tieNote(t.fewest, 'not the smallest', s.length), t.fewest)}
            ${termRow(D.help.envyName, t.envy ? `${t.envy.gap} behind → triangle(${t.envy.gap - 1}) = ${t.envy.tri}` : (s.length > 1 ? 'within one of the lead' : 'no rivals'), t.envy)}
          </ul>
          <div class="fam__sum">
            <span class="fam__sumn ${t.total > 0 ? 'is-good' : t.total < 0 ? 'is-bad' : ''}">${sign(t.total)}</span>
            <span class="fam__suml">from cities</span>
          </div>
          <div class="fam__brk" style="--brk:${b ? b.color : '#7d8590'}">
            <b>${b ? esc(b.label) : '—'}</b><i>from cities alone</i>
          </div>
        </article>`;
      }).join('');
    }

    function render() {
      const s = slots();
      $('e-total-lbl').textContent = String(total);
      $('e-total').value = String(total);
      const scored = allSplits(s);
      const selKey = renderRungs(s, scored);
      renderBreakdown(s, scored.find((r) => r.key === selKey) || null);
    }

    // ── events ───────────────────────────────────────────────────────
    $('e-nation').addEventListener('change', () => {
      nationId = $('e-nation').value;
      resetPicks();
      renderPicks();
      render();
    });
    $('e-rung-more').addEventListener('click', (ev) => {
      const a = ev.target.closest('#e-show-all');
      if (!a) return;
      ev.preventDefault();
      showAll = !showAll;
      render();
    });
    const setTotal = (v) => { total = Math.max(0, Math.min(40, v | 0)); selected = null; render(); };
    $('e-total').addEventListener('input', () => setTotal(+$('e-total').value || 0));
    $('e-total-dn').addEventListener('click', () => setTotal(total - 1));
    $('e-total-up').addEventListener('click', () => setTotal(total + 1));
    $('e-reset').addEventListener('click', () => {
      $('e-nation').value = DEFAULT_NATION;
      nationId = DEFAULT_NATION;
      total = DEFAULT_TOTAL;
      resetPicks();
      renderPicks();
      render();
    });

    $('e-picks').addEventListener('change', (ev) => {
      const sel = ev.target.closest('.pick__sel');
      if (!sel) return;
      const i = +sel.dataset.slot;
      const was = picks[i];
      const dup = picks.indexOf(sel.value);
      if (dup !== -1 && dup !== i) picks[dup] = was;  // swap, never duplicate
      picks[i] = sel.value;
      renderPicks();
      render();
    });

    $('e-rung-body').addEventListener('click', (ev) => {
      const row = ev.target.closest('.rung__r');
      if (!row) return;
      selected = row.dataset.split;
      render();
    });

    resetPicks();
    renderPicks();
    render();
  })();
</script>

