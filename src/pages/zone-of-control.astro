---
// Zone of Control — how the movement code decides which step is refused.
// Data: src/data/zoc.json (scripts/build_zoc.py: unit/effect XML + a port
// of Tile.isHostileZOC / Unit.isValidMovementDirection that computes every
// board below). Nothing on a board is hand-marked.
// Prose: src/data/zoc-prose.md — every heading, caption, note and paragraph
// is read from there at build time so the text can be edited without
// touching this template. `{placeholders}` are filled from the data (VARS).
import Base from '../layouts/Base.astro';
import Term from '../components/Term.astro';
import HexBoard from '../components/HexBoard.astro';
import data from '../data/zoc.json';
import proseRaw from '../data/zoc-prose.md?raw';
import editorJs from '../lib/prose-editor.js?raw';
import { createProse, type ProseVar } from '../lib/prose';

const PROSE_FILE = 'src/data/zoc-prose.md';
const DEV = import.meta.env.DEV;

const base = import.meta.env.BASE_URL;
const { units, grants, constants, texts, quadrants } = data;
const sc = Object.fromEntries(data.scenarios.map(s => [s.id, s])) as Record<string, (typeof data.scenarios)[number]>;
const boards = data.scenarios.filter(s => s.render);
const zocColor = constants.colors.hostile;
const hk = constants.hotkeys;

// Representatives for the four cards. Membership comes from the data: each
// pick lands in whatever quadrant build_zoc.py computed for it.
const PICKS = [
  'UNIT_WARRIOR', 'UNIT_SPEARMAN', 'UNIT_AXEMAN', 'UNIT_ARCHER', 'UNIT_LEGIONARY', 'UNIT_TRIREME',
  'UNIT_HORSEMAN', 'UNIT_CHARIOT', 'UNIT_CAMEL_ARCHER', 'UNIT_CATAPHRACT', 'UNIT_HORSE_ARCHER',
  'UNIT_WAR_ELEPHANT', 'UNIT_ONAGER', 'UNIT_BATTERING_RAM', 'UNIT_SETTLER', 'UNIT_WORKER', 'UNIT_CARAVAN',
  'UNIT_SCOUT', 'UNIT_SCOUT_HANNO_NAVIGATOR',
];
const byId = new Map(units.map(u => [u.id, u]));
const QUADRANT_ORDER = ['exerts', 'ignores-mounted', 'neither', 'ignores-all'] as const;
const cards = QUADRANT_ORDER.map(q => {
  const all = units.filter(u => u.quadrant === q);
  const picks = PICKS.map(id => byId.get(id)!).filter(u => u && u.quadrant === q);
  return { q, label: quadrants[q], all, picks, more: all.length - picks.length };
});

const polearm = grants.find(g => g.id === 'EFFECTUNIT_POLEARM')!;
const maneuvers = grants.find(g => g.id === 'EFFECTUNIT_MANEUVERS')!;
const mahout = grants.find(g => g.id === 'EFFECTUNIT_TRAIT_MAHOUT')!;

// ---- prose file: "## key" sections, minimal inline markdown, {placeholders} (src/lib/prose.ts) ----
const VARS: Record<string, ProseVar> = {
  conceptLong: texts.conceptLong,
  spearmanQuote: texts.spearman.split('. ').filter(s => s.includes('Only Polearm'))[0] ?? '',
  polearmCarriers: polearm.carriers.join(', '),
  mahoutName: mahout.name,
  mahoutDlc: mahout.dlc,
  maneuversName: maneuvers.name,
  routUnits: constants.routUnits.join(', '),
  routImmune: constants.routImmune.join(', '),
  pushUnits: constants.pushUnits.join(', '),
  nonBlocking: constants.nonBlocking.map(u => u.name).filter((n, i, a) => a.indexOf(n) === i).join(', '),
  waterUnits: constants.waterUnits.map(u => `${u.name} (${u.sources.map(s => s.name).join(', ')})`).join(' and '),
  hiding: constants.hiding.map(h => `*${h.name}* (${h.targets.join(', ')}) from ${h.sources.map(s => s.name).join(', ')}`).join('; '),
  showKey: hk.show.key,
  lockKey: hk.lock.key,
};
const { inline, blocks, has } = createProse({ raw: proseRaw, vars: VARS, listClass: 'zc-list', name: 'zoc-prose' });

const SOURCES = [
  ['Unit.isValidMovementDirection', 'Unit.cs:7670-7695', 'the one rule: refused iff both tiles are in hostile ZOC; current tile tested with bIgnoreRiver = the step crosses a river (7689). Called from PathFinder.cs:914.'],
  ['Unit.canBeSwapped / canSwapUnits', 'Unit.cs:8252, 8287', 'swap refused when both tiles are in hostile ZOC. No other caller of isHostileZOC exists.'],
  ['Unit.canAdvanceAfterAttack / canHaveRoutCooldown / canTargetFrom', 'Unit.cs:8342, 8389, 8508', 'Rout advance after a kill needs a bRout effect the defender is not immune to (getDefenderRoutEffectUnit 8420, where EFFECTUNIT_POLEARM is immune), another target reachable from the new tile, and canOccupyTile, with no zone test. The move itself is setTileID at Unit.cs:9711.'],
  ['Unit.getPushTile', 'Unit.cs:10031', 'Panic / Fireship push: the three tiles away from the attacker, tested with canUnitOccupy only.'],
  ['Unit.hasZOC / hasIgnoreZOC', 'Unit.cs:6983, 7008', 'unit type flag or any held effect.'],
  ['Unit.isUnitZoc', 'Unit.cs:4550', 'aeUnitTraitZOC: Polearm effects list Mounted.'],
  ['Tile.isDirectionHostileZOC', 'Tile.cs:9991-10058', 'same medium only; hostile cities on land; hidden exerters and hidden movers; embarked units cannot ignore ship ZOC; ignore test, then the trait test.'],
  ['Tile.isHostileZOC', 'Tile.cs:10061-10096', 'impassable and city tiles never in ZOC; improvement bIgnoreZOC (unset everywhere); river edges skipped unless bIgnoreRiver.'],
  ['Tile.isInUnitZOC', 'Tile.cs:9974', 'the selected-unit overlay test: no river check.'],
  ['Game.isHostile', 'Game.cs:14753', 'diplomacy.xml bHostile: only DIPLOMACY_WAR.'],
  ['Tile.canUnitPass', 'Tile.cs:10152, 10272', 'a hostile unit fills its tile only if its type has bBlocks; land units need water control (isWaterMovement, Tile.cs:8027) to enter water.'],
  ['Tile.canUnitOccupy / canBothUnitsOccupy', 'Tile.cs:10479, 10382', 'a move may not end on a tile with any hostile unit, blocking or not.'],
  ['Tile.canUnitTypeOccupy', 'Tile.cs:10524', 'ending on water needs a water unit (Game.isWaterUnit, Game.cs:14267: bWater, bAmphibious, or an aeWaterUnit player effect) or bTerritoryWater on own-territory water.'],
  ['ClientRenderer', 'ClientRenderer.cs:1641, 1854, 1880', 'Hold-X overlay calls isHostileZOC with bIgnoreRiver: true; the selected-unit overlay uses isInUnitZOC.'],
  ['PlayerAI', 'PlayerAI.cs:9358-9365, 10679-10686, 10953', `AI_UNIT_ZOC_VALUE ${constants.ai.zocValue}: ignore-ZOC worth ${constants.ai.ignoreZocValue}, each trait-ZOC ${constants.ai.traitZocValue}.`],
  ['XML', 'unit.xml, effectUnit.xml, unitTrait.xml, promotion.xml, trait.xml, diplomacy.xml, hotkeys.xml, color.xml, globalsAI.xml', 'flags, grants, hotkeys, colours and the quoted strings.'],
];
const stats = [
  { label: 'units exert', value: data._meta.exerting },
  { label: 'units ignore', value: data._meta.ignoring },
  { label: 'boards', value: boards.length },
];
---

<Base
  title="Zone of Control"
  active="zone-of-control"
  pageMark="🛑"
  pageStats={stats}
  description="How zone of control works in Old World, covering the single movement rule, who pins whom, and computed hex boards for walls, rivers, cities and water."
>
  {DEV && <meta name="prose-file" content={PROSE_FILE} />}
  {DEV && <meta name="prose-endpoint" content="http://127.0.0.1:4399/save" />}
  {DEV && <script is:inline set:html={editorJs} />}

  <p class="lede" data-prose="lede" set:html={inline('lede')} />

  <div class="legend zc-legend">
    <span class="legend__label">Legend</span>
    <span class="zc-key"><i class="zc-swatch zc-swatch--you"></i> <span data-prose="legend.you" set:html={inline('legend.you')} /></span>
    <span class="zc-key"><i class="zc-swatch zc-swatch--enemy"></i> <span data-prose="legend.enemy" set:html={inline('legend.enemy')} /></span>
    <span class="zc-key"><i class="zc-swatch zc-swatch--zoc" style={`background:${zocColor}`}></i> <span data-prose="legend.zoc" set:html={inline('legend.zoc')} /></span>
    <span class="zc-key"><i class="zc-swatch zc-swatch--ok"></i> <span data-prose="legend.legal" set:html={inline('legend.legal')} /></span>
    <span class="zc-key"><i class="zc-swatch zc-swatch--no">×</i> <span data-prose="legend.refused" set:html={inline('legend.refused')} /></span>
    <span class="zc-key"><i class="zc-swatch zc-swatch--dot"></i> <span data-prose="legend.reach" set:html={inline('legend.reach')} /></span>
    <span class="zc-key"><i class="zc-swatch zc-swatch--adv">⚔</i> <span data-prose="legend.advance" set:html={inline('legend.advance')} /></span>
  </div>

  <section class="zc-section" id="rule">
    <h2 class="zc-h" data-prose="rule.heading" set:html={inline('rule.heading')} />
    <p class="zc-rule" data-prose="rule.headline" set:html={inline('rule.headline')} />
    <div data-prose="rule.body" data-prose-blocks set:html={blocks('rule.body')} />
    <blockquote class="zc-quote">
      <p>{texts.help}</p>
      <footer data-prose="rule.quote.source" set:html={inline('rule.quote.source')} />
    </blockquote>
  </section>

  <section class="zc-section zc-section--wide" id="who">
    <h2 class="zc-h" data-prose="who.heading" set:html={inline('who.heading')} />
    <div class="zc-cards">
      {cards.map(c => (
        <article class={`zc-card zc-card--${c.q}`} id={`q-${c.q}`}>
          <h3 class="zc-card__title">{c.label}</h3>
          <p class="zc-card__hint" data-prose={`who.hint.${c.q}`} set:html={inline(`who.hint.${c.q}`)} />
          <ul class="zc-card__units">
            {c.picks.map(u => (
              <li>
                <img class="zc-uicon" src={`${base}img/icons/unit_glyphs/${u.iconSlug}.png`} alt="" loading="lazy" />
                <Term id={u.id} showIcon={false} label={u.name} />
              </li>
            ))}
            {c.more > 0 && <li class="zc-card__more"><a href="#appendix">+{c.more} more</a></li>}
          </ul>
        </article>
      ))}
    </div>
    {has('who.note') && <p class="zc-note" data-prose="who.note" set:html={inline('who.note')} />}
  </section>

  <section class="zc-section zc-section--wide" id="movement">
    <h2 class="zc-h" data-prose="movement.heading" set:html={inline('movement.heading')} />
    <div class="zc-boards zc-boards--3">
      <HexBoard scenario={sc.zone} zocColor={zocColor} caption={inline('board.zone.caption')} note={inline('board.zone.note')} captionKey="board.zone.caption" noteKey="board.zone.note" />
      <HexBoard scenario={sc.enter} zocColor={zocColor} caption={inline('board.enter.caption')} note={inline('board.enter.note')} captionKey="board.enter.caption" noteKey="board.enter.note" />
      <HexBoard scenario={sc.slip} zocColor={zocColor} caption={inline('board.slip.caption')} note={inline('board.slip.note')} captionKey="board.slip.caption" noteKey="board.slip.note" />
    </div>
  </section>

  <section class="zc-section zc-section--wide" id="walls">
    <h2 class="zc-h" data-prose="walls.heading" set:html={inline('walls.heading')} />
    <div data-prose="walls.intro" data-prose-blocks set:html={blocks('walls.intro')} />
    <div class="zc-boards zc-boards--2">
      <HexBoard scenario={sc.wall2} zocColor={zocColor} caption={inline('board.wall2.caption')} note={inline('board.wall2.note')} captionKey="board.wall2.caption" noteKey="board.wall2.note" />
      <HexBoard scenario={sc.wall3} zocColor={zocColor} caption={inline('board.wall3.caption')} note={inline('board.wall3.note')} captionKey="board.wall3.caption" noteKey="board.wall3.note" />
    </div>
  </section>

  <section class="zc-section zc-section--wide" id="exceptions">
    <h2 class="zc-h" data-prose="exceptions.heading" set:html={inline('exceptions.heading')} />
    <div class="zc-boards zc-boards--3">
      {['cavalry', 'elephant_pinned', 'elephant_pins_nothing', 'river', 'city', 'ships', 'embarked', 'hidden'].map(id => (
        <HexBoard scenario={sc[id]} zocColor={zocColor} caption={inline(`board.${id}.caption`)} note={inline(`board.${id}.note`)} captionKey={`board.${id}.caption`} noteKey={`board.${id}.note`} />
      ))}
    </div>
  </section>

  <section class="zc-section zc-section--wide" id="civilians">
    <h2 class="zc-h" data-prose="civilians.heading" set:html={inline('civilians.heading')} />
    <div class="zc-split">
      <div data-prose="civilians.body" data-prose-blocks set:html={blocks('civilians.body')} />
      <HexBoard scenario={sc.landing} zocColor={zocColor} caption={inline('board.landing.caption')} note={inline('board.landing.note')} captionKey="board.landing.caption" noteKey="board.landing.note" />
    </div>
  </section>

  <section class="zc-section zc-section--wide" id="special">
    <h2 class="zc-h" data-prose="special.heading" set:html={inline('special.heading')} />
    <div class="zc-split">
      <div data-prose="special.body" data-prose-blocks set:html={blocks('special.body')} />
      <HexBoard scenario={sc.rout_gap} zocColor={zocColor} caption={inline('board.rout_gap.caption')} note={inline('board.rout_gap.note')} captionKey="board.rout_gap.caption" noteKey="board.rout_gap.note" />
    </div>
  </section>

  <section class="zc-section" id="not">
    <h2 class="zc-h" data-prose="asked.heading" set:html={inline('asked.heading')} />
    <div data-prose="asked.body" data-prose-blocks set:html={blocks('asked.body')} />
  </section>

  <section class="zc-section" id="overlay">
    <h2 class="zc-h" data-prose="overlay.heading" set:html={inline('overlay.heading')} />
    <div data-prose="overlay.body" data-prose-blocks set:html={blocks('overlay.body')} />
    {has('overlay.callout') && <div class="zc-callout" data-prose="overlay.callout" set:html={inline('overlay.callout')} />}
  </section>

  <section class="zc-section" id="play">
    <h2 class="zc-h" data-prose="play.heading" set:html={inline('play.heading')} />
    <div data-prose="play.body" data-prose-blocks set:html={blocks('play.body')} />
  </section>

  <section class="zc-section zc-section--wide" id="appendix">
    <h2 class="zc-h" data-prose="appendix.heading" set:html={inline('appendix.heading')} />

    <h3 class="zc-h3" data-prose="appendix.units.heading" set:html={inline('appendix.units.heading')} />
    <div class="zc-table">
      <table>
        <thead>
          <tr><th>Unit</th><th>Traits</th><th>Exerts</th><th>Ignores</th><th>Pinned by Polearm</th><th>Medium</th><th>Group</th></tr>
        </thead>
        <tbody>
          {units.map(u => (
            <tr id={`zoc-${u.slug}`}>
              <td class="zc-unitcell">
                <img class="zc-uicon" src={`${base}img/icons/unit_glyphs/${u.iconSlug}.png`} alt="" loading="lazy" />
                <Term id={u.id} showIcon={false} label={u.name} />
              </td>
              <td class="zc-dim">{u.traits.join(', ')}</td>
              <td class={u.exerts ? 'zc-yes' : 'zc-no'}>{u.exerts ? 'yes' : '—'}</td>
              <td class={u.ignores ? 'zc-yes' : 'zc-no'}>{u.ignores ? 'yes' : '—'}</td>
              <td class={u.pinnedByPolearm ? 'zc-yes' : 'zc-no'}>{u.pinnedByPolearm ? 'yes' : '—'}</td>
              <td class="zc-dim">{u.water ? 'water' : 'land'}</td>
              <td class="zc-dim"><a href={`#q-${u.quadrant}`}>{quadrants[u.quadrant]}</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h3 class="zc-h3" data-prose="appendix.grants.heading" set:html={inline('appendix.grants.heading')} />
    <div class="zc-table">
      <table>
        <thead><tr><th>Effect</th><th>Does</th><th>Valid for</th><th>Comes from</th><th>Carried by</th></tr></thead>
        <tbody>
          {grants.map(g => (
            <tr id={`grant-${g.id.toLowerCase()}`}>
              <td>{g.name}{g.dlc && <span class="chip chip--dlc">{g.dlc}</span>}</td>
              <td>
                {[
                  g.grantsZOC && 'exerts a zone',
                  g.grantsIgnoreZOC && 'ignores zones',
                  g.traitZOC.length > 0 && `pins ${g.traitZOC.join(', ')} units even if they ignore zones`,
                  g.fatigueExtra > 0 && `+${g.fatigueExtra} fatigue`,
                ].filter(Boolean).join('; ')}
              </td>
              <td class="zc-dim">{g.validFor.length ? g.validFor.join(', ') : 'any'}</td>
              <td class="zc-dim">
                {g.sources.map((s, i) => (
                  <>{i > 0 && ', '}{s.kind === 'promotion' || s.kind === 'trait' ? <Term id={s.id} showIcon={false} /> : s.name}{s.kind === 'bonus' && ' (unreferenced)'}</>
                ))}
              </td>
              <td class="zc-dim">{g.carriers.length ? g.carriers.join(', ') : '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {has('appendix.grants.note') && <p class="zc-note" data-prose="appendix.grants.note" set:html={inline('appendix.grants.note')} />}

    <h3 class="zc-h3" data-prose="appendix.constants.heading" set:html={inline('appendix.constants.heading')} />
    <div class="zc-table">
      <table>
        <tbody>
          <tr><td>Hostile zone colour</td><td><code>{constants.colors.hostile}</code> (COLOR_HOSTILE_ZOC, used for the wash on this page)</td></tr>
          <tr><td>Neutral zone colour</td><td><code>{constants.colors.neutral}</code> (COLOR_NEUTRAL_ZOC, defined but unused by the source)</td></tr>
          <tr><td>Hotkeys</td><td><kbd>{hk.show.key}</kbd> hold: {hk.show.name}; <kbd>{hk.lock.key}</kbd>: {hk.lock.name}</td></tr>
          <tr><td>Loading hint</td><td>"{texts.hint}"</td></tr>
          <tr><td>Hostile diplomacy states</td><td>{constants.hostileStates.join(', ')}</td></tr>
          <tr><td>AI valuation</td><td>exerting {constants.ai.zocValue}, ignoring {constants.ai.ignoreZocValue}, each trait-ZOC {constants.ai.traitZocValue} (AI_UNIT_ZOC_VALUE)</td></tr>
        </tbody>
      </table>
    </div>

    <h3 class="zc-h3" data-prose="appendix.sources.heading" set:html={inline('appendix.sources.heading')} />
    <ul class="zc-list zc-sources">
      {SOURCES.map(([fn, loc, what]) => (
        <li><code>{fn}</code> <span class="zc-loc">{loc}</span>: {what}</li>
      ))}
      <li><code>scripts/build_zoc.py</code>: the port that computed every board above, with the assertions that fail the build if a rule drifts.</li>
    </ul>
  </section>

  <!-- is:global: the prose is injected with set:html, which gets no scope
       attribute, so scoped selectors like `.zc-section p` would miss it.
       Every selector here is .zc-* namespaced (plus .lede). -->
  <style is:global>
    .lede {
      color: var(--text-dim);
      max-width: 72ch;
      margin: 0 0 1rem;
      font-size: 0.92rem;
      line-height: 1.55;
    }
    .zc-legend { margin: 0 0 1.4rem; row-gap: 0.45rem; }
    .zc-key { display: inline-flex; align-items: center; gap: 0.35rem; }
    .zc-swatch {
      display: inline-flex; align-items: center; justify-content: center;
      width: 0.95em; height: 0.95em; border-radius: 50%;
      font-style: normal; font-size: 0.7em; font-weight: 700;
    }
    .zc-swatch--you { background: rgb(110,160,210); }
    .zc-swatch--enemy { background: rgb(150,60,60); }
    .zc-swatch--zoc { border-radius: 2px; border: 1px solid rgba(255,0,0,.6); background: rgba(255,0,0,.2); }
    .zc-swatch--ok { border-radius: 2px; height: 0.3em; width: 1.4em; background: var(--gold); }
    .zc-swatch--no { border-radius: 2px; height: 0.3em; width: 1.4em; background: #e5484d; color: #e5484d; line-height: 0; }
    .zc-swatch--dot { width: 0.6em; height: 0.6em; background: #fff; }
    .zc-swatch--adv { border-radius: 50%; width: 1.1em; height: 1.1em; border: 1px solid var(--gold); color: var(--gold); background: #1a1508; font-size: 0.65em; }

    .zc-section { margin: 1.6rem 0; max-width: 78ch; }
    .zc-section--wide { max-width: none; }
    .zc-h {
      font-family: var(--font-display);
      font-size: 1.15rem;
      font-weight: 600;
      letter-spacing: 0.03em;
      margin: 0 0 0.6rem;
      border-bottom: 1px solid color-mix(in srgb, var(--accent) 25%, var(--border));
      padding-bottom: 0.35rem;
      color: var(--text);
    }
    .zc-h3 {
      font-family: var(--font-display);
      font-size: 0.95rem;
      font-weight: 600;
      margin: 1.1rem 0 0.4rem;
      color: var(--text);
    }
    .zc-section p {
      color: var(--text);
      font-size: 0.86rem;
      line-height: 1.55;
      margin: 0 0 0.6rem;
      max-width: 78ch;
    }
    .zc-section p em { color: var(--accent); font-style: normal; }
    .zc-rule {
      font-size: 1.02rem !important;
      font-weight: 600;
      line-height: 1.45 !important;
      border-left: 3px solid var(--accent);
      padding: 0.4rem 0.8rem;
      background: var(--bg-elev);
      border-radius: var(--radius);
    }
    .zc-quote {
      margin: 0.6rem 0 0;
      padding: 0.6rem 0.9rem;
      border-left: 3px solid var(--border-strong);
      background: var(--bg-elev);
      border-radius: var(--radius);
    }
    .zc-quote p { font-style: italic; color: var(--text-soft); margin: 0 0 0.3rem; }
    .zc-quote footer { font-size: 0.72rem; color: var(--text-faint); }
    .zc-section code, .zc-section kbd {
      background: var(--bg-elev-2);
      padding: 0.05rem 0.35rem;
      border-radius: 3px;
      border: 1px solid var(--border);
      font-size: 0.85em;
      font-family: var(--font-mono);
    }
    .zc-note { font-size: 0.78rem !important; color: var(--text-dim) !important; margin-top: 0.6rem !important; }
    .zc-list {
      margin: 0.3rem 0 0.8rem 0;
      padding-left: 1.1rem;
      color: var(--text);
      font-size: 0.85rem;
      line-height: 1.55;
    }
    .zc-list li { margin: 0.2rem 0; }
    .zc-list strong { color: var(--text); font-weight: 600; }
    .zc-callout {
      font-size: 0.84rem;
      line-height: 1.5;
      color: var(--text);
      border: 1px solid rgba(229,72,77,.45);
      border-left: 3px solid #e5484d;
      background: rgba(229,72,77,.07);
      border-radius: var(--radius);
      padding: 0.6rem 0.9rem;
      max-width: 78ch;
    }

    .zc-cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 0.8rem;
    }
    .zc-card {
      background: var(--bg-elev);
      border: 1px solid var(--border);
      border-top: 3px solid var(--border-strong);
      border-radius: var(--radius);
      padding: 0.7rem 0.85rem;
