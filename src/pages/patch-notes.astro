---
import Base from '../layouts/Base.astro';
import LinkedText from '../components/LinkedText.astro';
import patchnotes from '../data/patchnotes.json';

const base = import.meta.env.BASE_URL;

const fmtDate = (d: string) =>
  d ? new Date(d + 'T00:00:00Z').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : '';

// Per-section glyph + accent yield class (purely cosmetic grouping).
const SECTION_META: Record<string, { icon: string; yield: string }> = {
  Design:        { icon: '🎯', yield: 'civics' },
  Balance:       { icon: '⚖️', yield: 'training' },
  Programming:   { icon: '⚙️', yield: 'science' },
  AI:            { icon: '🤖', yield: 'science' },
  UI:            { icon: '🖥', yield: 'culture' },
  'Bugs Fixed':  { icon: '🐛', yield: 'growth' },
  Modding:       { icon: '🧩', yield: 'money' },
  Notes:         { icon: '📝', yield: 'misc' },
};
const sectionMeta = (name: string) => SECTION_META[name] || { icon: '•', yield: 'misc' };

// Known DLC names → trailing "(…)" on a note becomes a small chip.
const DLC = new Set([
  'Empires of the Indus', 'Wonders and Dynasties', 'Wrath of Gods',
  'Behind the Throne', 'The Sacred and the Profane', 'Heroes of the Aegean',
  'Pharaohs of the Nile', 'Rise of Carthage',
]);
function splitDlc(text: string): { body: string; dlc: string | null } {
  const m = /^(.*?)\s*\(([^()]+)\)\s*$/.exec(text);
  if (m && DLC.has(m[2])) return { body: m[1], dlc: m[2] };
  return { body: text, dlc: null };
}

const diffTotal = (f: any) => f.added + f.removed + f.changed + f.tracked;
---

<Base
  title="Patch notes"
  active="patch-notes"
  pageMark="🛠"
  description="Old World patch notes — Mohawk's official build notes for each release, mirrored and entity-linked, backed by the data changes our reference site detected in the game's XML."
>
  <div class="page-meta">
    <h1 class="page-title">Patch notes</h1>
    <div class="page-stats">
      <span class="stat"><b>{patchnotes.length}</b> patch{patchnotes.length === 1 ? '' : 'es'}</span>
    </div>
  </div>

  <p class="pn-lede">
    Mohawk's official <a href="https://github.com/MohawkGames/main_buildnotes" target="_blank" rel="noopener">build notes</a>
    for each release — mirrored here and auto-linked to the things they touch — paired with the data changes this
    reference detected in the game's own XML when it re-synced the patch.
  </p>

  {patchnotes.map((p: any) => (
    <article class="pn">
      <header class="pn__head">
        <div class="pn__ver">
          <span class="pn__num">{p.version}</span>
          {p.date && <span class="pn__date">{fmtDate(p.date)}</span>}
        </div>
        <div class="pn__meta">
          {p.buildId && <span class="pn__build">Steam build {p.buildId}</span>}
          <span class="pn__src">Official build notes</span>
        </div>
      </header>

      <div class="pn__sections">
        {p.sections.map((s: any) => {
          const m = sectionMeta(s.name);
          return (
            <section class={`pn-sec yield-${m.yield}`}>
              <h2 class="pn-sec__title"><span class="pn-sec__icon">{m.icon}</span>{s.name}<span class="pn-sec__n">{s.items.length}</span></h2>
              <ul class="pn-list">
                {s.items.map((it: string) => {
                  const { body, dlc } = splitDlc(it);
                  return (
                    <li class="pn-item">
                      <LinkedText text={body} showIcons={false} iconsForYields={true} />
                      {dlc && <span class="pn-dlc">{dlc}</span>}
                    </li>
                  );
                })}
              </ul>
            </section>
          );
        })}
      </div>

      {p.dataDiff && p.dataDiff.length > 0 && (
        <details class="pn-diff">
          <summary>
            Detected in game data
            <span class="pn-diff__hint">{p.dataDiff.length} datasets changed when we re-synced this patch</span>
          </summary>
          <ul class="pn-diff__list">
            {p.dataDiff.map((f: any) => (
              <li class="pn-diff__row">
                <span class="pn-diff__file">{f.file.replace(/\.json$/, '')}</span>
                <span class="pn-diff__counts">
                  {f.added > 0 && <span class="pn-c pn-c--add">+{f.added}</span>}
                  {f.removed > 0 && <span class="pn-c pn-c--rem">−{f.removed}</span>}
                  {f.changed > 0 && <span class="pn-c pn-c--chg">~{f.changed}</span>}
                  {f.tracked > 0 && <span class="pn-c pn-c--new">new</span>}
                </span>
              </li>
            ))}
          </ul>
          <p class="pn-diff__note">
            Counts of entries our generated datasets added / removed / changed since the previous
            snapshot — includes reference-site tooling tweaks, not only game changes.
          </p>
        </details>
      )}
    </article>
  ))}
</Base>

<style>
  .pn-lede {
    color: var(--text-dim);
    font-size: 0.92rem;
    line-height: 1.55;
    max-width: 72ch;
    margin: 0 0 1.6rem;
  }
  .pn-lede a { color: var(--gold-soft); }

  .pn {
    margin: 0 0 2rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-elev);
    overflow: hidden;
  }
  .pn__head {
    display: flex; align-items: baseline; justify-content: space-between;
    flex-wrap: wrap; gap: 0.5rem 1rem;
    padding: 0.8rem 1rem;
    background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(0,0,0,0.18));
    border-bottom: 1px solid var(--border);
  }
  .pn__ver { display: flex; align-items: baseline; gap: 0.7rem; flex-wrap: wrap; }
  .pn__num {
    font-family: var(--font-display); font-weight: 600; font-size: 1.5rem; color: var(--text);
  }
  .pn__date { font-family: var(--font-ui); font-size: 0.82rem; color: var(--gold-soft); }
  .pn__meta { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .pn__build {
    font-family: var(--font-mono); font-size: 0.62rem;
    color: var(--text-dim); border: 1px solid var(--border); border-radius: 3px; padding: 0.1rem 0.4rem;
  }
  .pn__src {
    font-family: var(--font-ui); font-size: 0.6rem; text-transform: uppercase;
    letter-spacing: 0.12em; color: var(--text-faint);
  }

  .pn__sections {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
    gap: 0.9rem 1.3rem;
    padding: 1rem;
  }
  .pn-sec { min-width: 0; }
  .pn-sec__title {
    display: flex; align-items: baseline; gap: 0.45rem;
    font-family: var(--font-ui); font-weight: 600;
    font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--gold-soft);
    border-bottom: 1px solid var(--yield-bg, var(--gold-deep));
    padding-bottom: 0.3rem; margin: 0 0 0.6rem;
  }
  .pn-sec__icon { font-size: 1rem; }
  .pn-sec__n {
    margin-left: auto; font-family: var(--font-mono); font-size: 0.72em;
    color: var(--text-faint); letter-spacing: 0;
  }
  .pn-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.3rem; }
  .pn-item {
    position: relative;
    padding: 0.3rem 0.6rem 0.3rem 0.85rem;
    background: var(--bg);
    border-left: 3px solid var(--yield-bg, var(--border-strong));
    border-radius: 0 4px 4px 0;
    font-size: 0.86rem; line-height: 1.4; color: var(--text-soft);
  }
  .pn-dlc {
    display: inline-block; margin-left: 0.4rem;
    font-family: var(--font-mono); font-size: 0.58rem;
    text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--gold-soft); border: 1px solid var(--gold-deep);
    border-radius: 3px; padding: 0 0.3em; vertical-align: 0.08em;
    white-space: nowrap;
  }

  .pn-diff {
    border-top: 1px solid var(--border);
    background: rgba(0,0,0,0.18);
  }
  .pn-diff > summary {
    cursor: pointer; list-style: revert;
    padding: 0.6rem 1rem;
    font-family: var(--font-ui); font-size: 0.7rem;
    text-transform: uppercase; letter-spacing: 0.14em; color: var(--text-dim);
  }
  .pn-diff > summary:hover { color: var(--text); }
  .pn-diff__hint {
    margin-left: 0.5rem; text-transform: none; letter-spacing: 0;
    font-family: var(--font-mono); font-size: 0.92em; color: var(--text-faint);
  }
  .pn-diff__list {
    list-style: none; margin: 0; padding: 0 1rem 0.4rem;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.15rem 1rem;
  }
  .pn-diff__row { display: flex; align-items: baseline; justify-content: space-between; gap: 0.6rem; font-size: 0.78rem; }
  .pn-diff__file { color: var(--text-dim); font-family: var(--font-mono); }
  .pn-diff__counts { display: inline-flex; gap: 0.3rem; font-family: var(--font-mono); font-size: 0.74rem; }
  .pn-c--add { color: #4caf7d; }
  .pn-c--rem { color: #d46e6e; }
  .pn-c--chg { color: var(--gold-soft); }
  .pn-c--new { color: var(--text-faint); }
  .pn-diff__note { margin: 0.3rem 1rem 0.8rem; font-size: 0.7rem; color: var(--text-faint); font-style: italic; }

  @media (max-width: 700px) {
    .pn__sections { grid-template-columns: 1fr; }
  }
</style>
