---
import Base from '../layouts/Base.astro';
import LinkedText from '../components/LinkedText.astro';
import promotions from '../data/promotions.json';
import { classifyYield } from '../lib/entities';

const base = import.meta.env.BASE_URL;

type Promotion = typeof promotions[number];

// Group by tier (1..3 for chained, "extras" for single-shot promos with tier 1
// but no prereq class siblings — we keep them in tier 1).
const tiers = [1, 2, 3, 4];

const byTier = new Map<number, Promotion[]>();
for (const p of promotions) {
  const t = p.tier || 1;
  if (!byTier.has(t)) byTier.set(t, []);
  byTier.get(t)!.push(p);
}

// For visual chain-grouping inside a tier: sort by class label, then by name.
for (const arr of byTier.values()) {
  arr.sort((a, b) => (a.class || '').localeCompare(b.class || '') || a.name.localeCompare(b.name));
}

const searchBlobs: Record<string, string> = {};
for (const p of promotions) {
  searchBlobs[p.slug] = JSON.stringify(p).toLowerCase();
}

// ── Availability matrix ──────────────────────────────────────────────
// Columns = the unit-trait combinations that actually occur on promotable
// units in unit.xml. A single "Siege" or "Mounted" column would be lossy:
// Strike (invalid: Ranged) reaches Battering Rams but not Onagers, and
// Shrapnel (valid: Ranged) the reverse — so Melee/Ranged are split out.
const unitClasses = [
  { key: 'inf-melee',   label: 'Infantry', sub: 'Melee',  traits: ['Promotable', 'Infantry', 'Melee'],  eg: 'Warrior, Axeman, Spearman, Swordsman' },
  { key: 'inf-ranged',  label: 'Infantry', sub: 'Ranged', traits: ['Promotable', 'Infantry', 'Ranged'], eg: 'Slinger, Archer, Longbowman, Crossbowman' },
  { key: 'mtd-melee',   label: 'Mounted',  sub: 'Melee',  traits: ['Promotable', 'Mounted', 'Melee'],   eg: 'Horseman, Chariot, War Elephant, Cataphract' },
  { key: 'mtd-ranged',  label: 'Mounted',  sub: 'Ranged', traits: ['Promotable', 'Mounted', 'Ranged'],  eg: 'Horse Archer, Light Chariot, Camel Archer' },
  { key: 'siege-melee', label: 'Siege',    sub: 'Melee',  traits: ['Promotable', 'Siege', 'Melee'],     eg: 'Battering Ram, Siege Tower' },
  { key: 'siege-ranged',label: 'Siege',    sub: 'Ranged', traits: ['Promotable', 'Siege', 'Ranged'],    eg: 'Ballista, Polybolos, Onager, Mangonel' },
  { key: 'ship',        label: 'Ship',     sub: '',       traits: ['Promotable', 'Ship'],               eg: 'Bireme, Trireme, Dromon' },
];

// Game.cs canPromote: a unit qualifies if it has at least one valid trait
// (when any are listed) and none of the invalid traits — and it must also
// qualify for the whole prereq chain to ever be offered the promotion.
const promById = new Map(promotions.map(p => [p.id, p]));
function ownEligible(p: Promotion, traits: Set<string>): boolean {
  if (p.validTraits.length > 0 && !p.validTraits.some(t => traits.has(t))) return false;
  if (p.invalidTraits.some(t => traits.has(t))) return false;
  return true;
}
function eligible(p: Promotion, traits: Set<string>): boolean {
  let cur: Promotion | undefined = p;
  while (cur) {
    if (!ownEligible(cur, traits)) return false;
    cur = cur.prereqId ? promById.get(cur.prereqId) : undefined;
  }
  return true;
}
const classTraitSets = unitClasses.map(c => new Set(c.traits));

const prereqSlug = (p: Promotion) => p.prereqId.replace('PROMOTION_', '').toLowerCase();

// Promotions that additionally require the unit to already have a given
// attack type (Game.cs aiAttackPercent gate — e.g. Shrapnel needs Splash).
const condPromos = promotions.filter(p => p.requiresAttack.length > 0);
---

<Base
  title="Promotions"
  active="promotions"
  pageMark="🎖️"
  pageStats={[
    { label: 'promotions', value: promotions.length },
    { label: 'tiers',      value: byTier.size },
  ]}
>
  <section class="grid prom-matrix" aria-labelledby="prom-matrix-title">
    <h2 class="prom-tier__title" id="prom-matrix-title">
      Availability by unit class
      <span class="prom-tier__count">✓ eligible · — not offered</span>
    </h2>
    <p class="grid__searchnote">
      On production and on each upgrade, a unit draws 4 random promotions from those it is eligible for.
    </p>
    <div class="grid__scroll">
      <table class="ntbl prom-matrix__tbl" aria-label="Promotion availability by unit class">
        <colgroup>
          <col class="ntbl__rowlabel-col" />
          <col class="prom-matrix__prereq-col" />
          {unitClasses.map(c => <col class="prom-matrix__class-col" data-class={c.key} />)}
          <col class="prom-matrix__fx-col" />
        </colgroup>
        <thead>
          <tr>
            <th class="rowlabel rowlabel--corner" scope="col">
              <span class="rowlabel__small">Class →</span>
              <span class="rowlabel__big">Promotion ↓</span>
            </th>
            <th class="nhdr pm-hdr" scope="col">
              <span class="pm-hdr__name">Prereq</span>
            </th>
            {unitClasses.map(c => (
              <th class="nhdr pm-hdr pm-hdr--class" scope="col" title={`e.g. ${c.eg}`}>
                <span class="pm-hdr__name">{c.label}</span>
                {c.sub && <span class="pm-hdr__sub">{c.sub}</span>}
              </th>
            ))}
            <th class="nhdr pm-hdr" scope="col">
              <span class="pm-hdr__name">Effect</span>
            </th>
          </tr>
        </thead>
        {tiers.filter(t => byTier.has(t)).map(t => (
          <tbody>
            <tr class="srow">
              <th class="srow__th" colspan={unitClasses.length + 3}>Tier {t}</th>
            </tr>
            {byTier.get(t)!.map(p => (
              <tr data-prom={p.slug}>
                <th class="rowlabel" scope="row">
                  <a href={`#${p.slug}`}>{p.name}</a>
                </th>
                <td class="cell pm-prereq">
                  {p.prereqId
                    ? <a class="chip chip--neutral chip--mini" href={`#${prereqSlug(p)}`}>{p.prereqName}</a>
                    : <span class="cell__dash">—</span>}
                </td>
                {unitClasses.map((c, i) => {
                  const ok = eligible(p, classTraitSets[i]);
                  const cond = ok && p.requiresAttack.length > 0;
                  return ok ? (
                    <td
                      class="cell pm-avail is-avail"
                      title={cond
                        ? `${p.name}: only units that already have a ${p.requiresAttack.join('/')} attack`
                        : `${p.name} — available to ${c.label}${c.sub ? ` (${c.sub})` : ''}`}
                    >{cond ? '✓*' : '✓'}</td>
                  ) : (
                    <td class="cell pm-avail is-empty"><span class="cell__dash">—</span></td>
                  );
                })}
                <td class="cell pm-fx">
                  {p.effects.length > 0
                    ? <LinkedText text={p.effects.join(' · ')} showIcons={false} />
                    : <span class="cell__dash">—</span>}
                </td>
              </tr>
            ))}
          </tbody>
        ))}
      </table>
    </div>
    {condPromos.length > 0 && (
      <p class="grid__searchnote">
        {condPromos.map(p => (
          <span>✓* {p.name} is only offered to units that already have a {p.requiresAttack.join('/')} attack.</span>
        ))}
      </p>
    )}
  </section>

  <div id="prom-grid">
    {tiers.filter(t => byTier.has(t)).map(t => (
      <section class="prom-tier" data-tier={t}>
        <h2 class="prom-tier__title">
          <span class="prom-tier__num">Tier {t}</span>
          <span class="prom-tier__count">{byTier.get(t)!.length} promotions</span>
        </h2>
        <ul class="prom-list">
          {byTier.get(t)!.map(p => (
            <li class="prom" id={p.slug} data-prom={p.slug}>
              <div class="prom__head">
                <div class="prom__title">
                  <span class="prom__name">{p.name}</span>
                  <span class="prom__class">{p.class}</span>
                </div>
                <span class="prom__tier-badge">T{p.tier}</span>
              </div>
              {p.prereqId && (
                <div class="prom__chain">
                  <span class="prom__label">After</span>
                  <a class="chip chip--neutral" href={`#${p.prereqId.replace('PROMOTION_', '').toLowerCase()}`}>
                    {p.prereqName}
                  </a>
                </div>
              )}
              {p.effects.length > 0 && (
                <div class="prom__effects">
                  {p.effects.map(line => {
                    const yieldKey = classifyYield(line)?.toLowerCase() || 'misc';
                    return (
                      <div class={`effect yield-${yieldKey}`}>
                        <LinkedText text={line} showIcons={false} iconsForYields={true} />
                      </div>
                    );
                  })}
                </div>
              )}
              {(p.validTraits.length > 0 || p.invalidTraits.length > 0) && (
                <div class="prom__traits">
                  {p.validTraits.length > 0 && (
                    <span class="prom__traits-row">
                      <span class="prom__label">For</span>
                      {p.validTraits.map(tr => <span class="chip chip--neutral chip--mini">{tr}</span>)}
                    </span>
                  )}
                  {p.invalidTraits.length > 0 && (
                    <span class="prom__traits-row">
                      <span class="prom__label">Not</span>
                      {p.invalidTraits.map(tr => <span class="chip chip--neutral chip--mini chip--neg">{tr}</span>)}
                    </span>
                  )}
                </div>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <script type="application/json" id="prom-search-blobs" set:html={JSON.stringify(searchBlobs)}></script>
  <script is:inline>
    (function () {
      const input = document.getElementById('site-search');
      const grid = document.getElementById('prom-grid');
      const blobNode = document.getElementById('prom-search-blobs');
      if (!input || !grid || !blobNode) return;
      let blobs;
      try { blobs = JSON.parse(blobNode.textContent || '{}'); } catch { return; }
      function apply() {
        const q = (input.value || '').trim().toLowerCase();
        for (const slug of Object.keys(blobs)) {
          const match = !q || blobs[slug].includes(q);
          // Both the tier card (li.prom) and the matrix row (tr) carry data-prom.
          for (const el of document.querySelectorAll('[data-prom="' + slug + '"]')) {
            el.classList.toggle('is-hidden', !match);
          }
        }
        for (const tier of grid.querySelectorAll('.prom-tier')) {
          const visible = tier.querySelectorAll('.prom:not(.is-hidden)').length;
          tier.classList.toggle('is-hidden', visible === 0);
        }
        for (const tb of document.querySelectorAll('.prom-matrix__tbl tbody')) {
          const visible = tb.querySelectorAll('tr[data-prom]:not(.is-hidden)').length;
          tb.classList.toggle('is-hidden', visible === 0);
        }
      }
      input.addEventListener('input', apply);
      apply();
    })();
  </script>
</Base>

<style>
  /* ── Availability matrix ─────────────────────────────── */
  .prom-matrix { margin: 1.4rem 0 2.2rem; }
  .prom-matrix__tbl { min-width: 58rem; }
  .prom-matrix__tbl col.prom-matrix__prereq-col { width: 6.5rem; }
  .prom-matrix__tbl col.prom-matrix__class-col { width: 4.7rem; }
  /* fx col takes the remaining width via table-layout: fixed */

  .prom-matrix__tbl .rowlabel a {
    color: inherit;
    text-decoration: none;
  }
  .prom-matrix__tbl .rowlabel a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 2px;
    text-decoration-thickness: 1px;
  }

  .pm-hdr {
    border-bottom: 1px solid var(--border);
  }
  .pm-hdr__name {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    line-height: 1.1;
  }
  .pm-hdr__sub {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    color: var(--text-faint);
    margin-top: 0.1rem;
  }
  .pm-hdr--class { text-align: center; }
  .pm-hdr--class .pm-hdr__name,
  .pm-hdr--class .pm-hdr__sub { text-align: center; }

  .pm-avail {
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
  .pm-avail.is-avail {
    color: var(--accent);
    background: var(--gold-glow);
  }
  .pm-prereq .chip { font-size: 0.62rem; }
  .pm-fx {
    font-size: 0.74rem;
    color: var(--text-soft);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .prom-matrix .grid__searchnote span { margin-right: 0.8rem; }

  .prom-tier { margin: 1.4rem 0; }
  .prom-tier__title {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0 0 0.6rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 25%, var(--border));
    padding-bottom: 0.35rem;
    color: var(--text);
  }
  .prom-tier__num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--accent);
    background: var(--bg-elev);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, var(--border));
    padding: 0.05rem 0.45rem;
    border-radius: 4px;
    font-weight: 500;
  }
  .prom-tier__count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-faint);
    font-weight: 400;
  }

  .prom-list {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0.5rem;
  }
  .prom {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 0.55rem 0.7rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .prom:target {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 24%, transparent);
  }
  .prom__head {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }
  .prom__title { display: flex; flex-direction: column; flex: 1; gap: 0.05rem; }
  .prom__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.92rem;
    letter-spacing: 0.02em;
    color: var(--text);
  }
  .prom__class {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-faint);
  }
  .prom__tier-badge {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--accent);
    background: var(--bg-elev-2);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, var(--border));
    padding: 0.05rem 0.4rem;
    border-radius: 4px;
    font-weight: 500;
  }
  .prom__chain { display: flex; align-items: center; flex-wrap: wrap; gap: 0.25rem; }
  .prom__chain .chip { font-size: 0.65rem; padding: 0.1rem 0.4rem; }

  .prom__label {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-faint);
    margin-right: 0.25rem;
  }

  .prom__effects {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .prom__effects .effect {
    background: var(--yield-bg, var(--bg-elev-2));
    color: var(--yield-fg, var(--text));
    background-image: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(0,0,0,0.20) 60%, rgba(0,0,0,0.32));
    padding: 0.2rem 0.45rem;
    border-radius: 4px;
    font-size: 0.7rem;
    line-height: 1.25;
    border: 1px solid color-mix(in srgb, var(--yield-bg, var(--border)) 50%, #000 50%);
  }

  .prom__traits {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .prom__traits-row { display: inline-flex; flex-wrap: wrap; gap: 0.2rem; align-items: center; }
  .chip--mini {
    font-size: 0.6rem;
    padding: 0.05rem 0.35rem;
    text-transform: none;
    font-weight: 500;
  }
  .chip--neg { color: var(--text-faint); opacity: 0.75; }
</style>
