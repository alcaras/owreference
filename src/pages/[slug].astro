---
import Base from '../layouts/Base.astro';
import { TABS } from '../data/tabs';

export function getStaticPaths() {
  // Build a page for every tab that isn't already a real .astro page.
  // Astro's static route (e.g. nations.astro) wins over this dynamic one, but
  // we still skip it here so the placeholder doesn't shadow the real impl.
  const built = new Set([
    'nations', 'families', 'wisdom', 'charisma', 'courage', 'discipline',
    'technologies', 'promotions',
    'unit-damage', 'unit-counters', 'combat-damage',
    'rally', 'hold-court', 'steal-research',
  ]);
  return TABS
    .filter(t => !built.has(t.slug))
    .map(t => ({ params: { slug: t.slug }, props: { tab: t } }));
}

const { tab } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<Base
  title={tab.label}
  active={tab.slug}
  pageMark={tab.icon}
  pageStats={[{ label: tab.section.toLowerCase(), value: 'section' }]}
>
  <div class="placeholder">
    <div class="placeholder__badge">Coming soon</div>
    <p class="placeholder__summary">{tab.summary}</p>

    {tab.willContain && tab.willContain.length > 0 && (
      <section>
        <h2>What it will cover</h2>
        <ul>
          {tab.willContain.map(item => <li>{item}</li>)}
        </ul>
      </section>
    )}

    {tab.sourceSheet && (
      <section>
        <h2>From the spreadsheet</h2>
        <p>Tab: {tab.sourceSheet}</p>
      </section>
    )}

    <p style="margin-top: 2rem">
      <a href={base}>← Back to index</a>
    </p>
  </div>
</Base>

<style>
  .placeholder {
    max-width: 720px;
    margin-top: 1rem;
    padding: 1.5rem;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  .placeholder__badge {
    display: inline-block;
    padding: 0.15rem 0.6rem;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: var(--bg-elev-2);
    color: var(--accent);
    border: 1px solid var(--border);
    border-radius: 999px;
    margin-bottom: 1rem;
  }
  .placeholder__summary {
    color: var(--text-dim);
    font-size: 1rem;
    margin-top: 0;
  }
  .placeholder h2 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-dim);
    margin: 1.5rem 0 0.5rem;
  }
  .placeholder ul { margin: 0; padding-left: 1.2rem; }
  .placeholder li { margin: 0.25rem 0; }
</style>
