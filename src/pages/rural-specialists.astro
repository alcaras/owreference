---
import Base from '../layouts/Base.astro';
import LinkedText from '../components/LinkedText.astro';
import specialists from '../data/specialists.json';
import { classifyYield } from '../lib/entities';

const base = import.meta.env.BASE_URL;
const civicsIco = 'img/icons/yields/civics.png';
const foodIco = 'img/icons/yields/food.png';

type Spec = typeof specialists[number];

// Rural specialists are the single-tier (tier 0) classes that work rural
// improvements (Farmer→Farm, Miner→Mine, …). One row per class.
const rural = specialists
  .filter((s: Spec) => s.tier === 0)
  .sort((a: Spec, b: Spec) => a.class.localeCompare(b.class));

const searchBlobs: Record<string, string> = {};
for (const s of rural) searchBlobs[s.classSlug] = JSON.stringify(s).toLowerCase();
---

<Base title="Rural Specialists" active="rural-specialists" pageMark="🌾" pageStats={[
  { label: 'specialists', value: rural.length },
]}>
  <div class="grid" id="rs-grid">
    <div class="grid__scroll">
      <table class="ntbl">
        <thead>
          <tr>
            <th class="nhdr nhdr--col"><div class="nhdr__inner"><span class="nhdr__name">Specialist</span></div></th>
            <th class="nhdr nhdr--col"><div class="nhdr__inner"><span class="nhdr__name">Slots Into</span></div></th>
            <th class="nhdr nhdr--col"><div class="nhdr__inner"><span class="nhdr__name">Effects</span></div></th>
            <th class="nhdr nhdr--col"><div class="nhdr__inner"><span class="nhdr__name">Cost</span></div></th>
          </tr>
        </thead>
        <tbody>
          {rural.map((s: Spec) => {
            const lines = [...(s.yieldsMain || []), ...(s.yieldsExtra || []), ...(s.classModifiers || [])];
            return (
              <tr data-row={s.classSlug}>
                <th class="rowlabel rowlabel--item" scope="row" id={s.classSlug}>
                  <div class="spec-head">
                    <img class="spec-head__icon" src={`${base}${s.icon}`} alt="" loading="lazy" onerror="this.style.display='none'" />
                    <div class="spec-head__text">
                      <div class="item__name">{s.class}</div>
                      <div class="item__sub">rural</div>
                    </div>
                  </div>
                </th>
                <td class="cell yield-misc">
                  {s.slotImprovements && s.slotImprovements.length > 0
                    ? s.slotImprovements.map((si: {class: string; icon: string}) => (
                        <div class="terrain-tag slot-tag">
                          {si.icon && <img class="slot-ico" src={`${base}${si.icon}`} alt="" loading="lazy" onerror="this.style.display='none'" />}
                          <LinkedText text={si.class} />
                        </div>
                      ))
                    : <span class="cell__dash">—</span>}
                </td>
                <td class="cell cell--effects">
                  {lines.length > 0 ? lines.map((line: string) => {
                    const yk = classifyYield(line)?.toLowerCase() || 'misc';
                    return <div class={`effect yield-${yk}`}><LinkedText text={line} iconsForYields={true} /></div>;
                  }) : <span class="cell__dash">—</span>}
                </td>
                <td class="cell yield-misc">
                  <div class="cost-row">
                    <span class="cost-num">{s.civicsCost}</span>
                    <img class="cost-ico" src={`${base}${civicsIco}`} alt="Civics" title="Civics" />
                  </div>
                  <div class="cost-row">
                    <span class="cost-num">{s.foodCost}</span>
                    <img class="cost-ico" src={`${base}${foodIco}`} alt="Food" title="Food" />
                  </div>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </div>

  <script type="application/json" id="rs-search-blobs" set:html={JSON.stringify(searchBlobs)}></script>
  <script is:inline>
    (function () {
      const input = document.getElementById('site-search');
      const blobNode = document.getElementById('rs-search-blobs');
      const grid = document.getElementById('rs-grid');
      if (!input || !blobNode || !grid) return;
      let blobs;
      try { blobs = JSON.parse(blobNode.textContent || '{}'); } catch { return; }
      function apply() {
        const q = (input.value || '').trim().toLowerCase();
        for (const slug of Object.keys(blobs)) {
          const row = grid.querySelector('tr[data-row="' + slug + '"]');
          if (!row) continue;
          row.classList.toggle('is-hidden', !!q && !blobs[slug].includes(q));
        }
      }
      input.addEventListener('input', apply);
      apply();
    })();
  </script>
  <script is:inline>
    (function () {
      const table = document.querySelector('#rs-grid table.ntbl');
      if (!table || !table.tHead) return;
      const ths = Array.from(table.tHead.rows[0].cells);
      ths.forEach((th, ci) => {
        th.classList.add('is-sortable');
        th.addEventListener('click', () => {
          const tb = table.tBodies[0];
          const rows = Array.from(tb.rows).filter(r => !r.classList.contains('srow'));
          const asc = th.getAttribute('aria-sort') !== 'ascending';
          ths.forEach(h => h.removeAttribute('aria-sort'));
          th.setAttribute('aria-sort', asc ? 'ascending' : 'descending');
          const val = r => {
            const c = r.cells[ci];
            const t = (c ? c.textContent : '').trim();
            const n = parseFloat(t.replace(/[^0-9.\-]/g, ''));
            return { t, n: (t && !isNaN(n)) ? n : null };
          };
          rows.sort((a, b) => {
            const ka = val(a), kb = val(b);
            let r;
            if (ka.n !== null && kb.n !== null) r = ka.n - kb.n;
            else if (ka.n !== null) r = -1;
            else if (kb.n !== null) r = 1;
            else r = ka.t.localeCompare(kb.t);
            return asc ? r : -r;
          });
          rows.forEach(r => tb.appendChild(r));
        });
      });
    })();
  </script>
</Base>

<style>
  .nhdr--col {
    background: var(--bg-elev-2);
    color: var(--text);
    background-image: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(0,0,0,0.18));
    text-align: left;
    padding: 0.45rem 0.6rem;
    min-width: 8rem;
  }
  .nhdr--col .nhdr__name {
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }
  .rowlabel--item {
    text-align: left;
    font-family: var(--font-ui);
    font-size: 0.72rem;
    padding: 0.45rem 0.6rem;
    background: var(--bg-elev);
    min-width: 11rem;
    border-right: 1px solid var(--border);
  }
  .spec-head { display: flex; align-items: center; gap: 0.5rem; }
  .spec-head__icon {
    width: 30px; height: 30px; object-fit: contain;
    filter: drop-shadow(0 1px 1px rgba(0,0,0,0.4));
  }
  .item__name {
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: 0.02em;
  }
  .item__sub {
    font-style: italic;
    color: var(--text-faint);
    font-size: 0.66rem;
    margin-top: 0.1rem;
  }
  .terrain-tag {
    display: inline-block;
    padding: 0.05rem 0.4rem;
    margin: 0.1rem 0.2rem 0.1rem 0;
    border: 1px solid var(--border);
    border-radius: 4px;
    font-size: 0.68rem;
    color: var(--text-dim);
    background: var(--bg);
  }
  .cost-row {
    display: flex; align-items: center; gap: 0.25rem;
    font-size: 0.7rem; color: var(--text-dim); padding: 0.05rem 0;
  }
  .cost-ico { width: 13px; height: 13px; object-fit: contain; }
  .cost-num {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--text);
    font-weight: 600;
  }
  .slot-tag { display: inline-flex; align-items: center; gap: 0.25rem; }
  .slot-ico { width: 15px; height: 15px; object-fit: contain; flex: none; }
  .nhdr.is-sortable { cursor: pointer; user-select: none; }
  .nhdr.is-sortable:hover { filter: brightness(1.12); }
  .nhdr.is-sortable .nhdr__name::after { content: '⇅'; opacity: 0.35; font-size: 0.85em; margin-left: 0.3em; }
  .nhdr[aria-sort='ascending'] .nhdr__name::after { content: '↑'; opacity: 0.9; }
  .nhdr[aria-sort='descending'] .nhdr__name::after { content: '↓'; opacity: 0.9; }
</style>
