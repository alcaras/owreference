---
import Base from '../layouts/Base.astro';
import LinkedText from '../components/LinkedText.astro';
import turnOrder from '../data/turn_order.json';

// Generated by scripts/build_turn_order.py from the doTurn-family function
// bodies in reference/Source/Base/Game/GameCore/. Step order mirrors source
// order exactly — do not sort or regroup.

interface Step {
  id: string;
  call: string;
  file: string;
  line: number;
  loop: string | null;
  cond: string | null;
  title: string;
  desc: string;
  group: string;
  children?: Step[];
  childEntry?: string;
  childFn?: string;
  via?: string;
}

const bands = turnOrder.bands as {
  key: string; title: string; fn: string; entry: string; steps: Step[];
}[];

const gameBand = bands.find(b => b.key === 'game')!;
const playerBand = bands.find(b => b.key === 'player')!;

// Find a step (recursively) so the Q&A box can cite real step numbers that
// survive regeneration. The `line` is a PREFERENCE, not a hard match: source
// line numbers shift every patch, so prefer an exact-line hit but fall back to
// the nearest call-name match rather than failing the build. (Only a call that
// vanished entirely returns null — which is a real signal worth failing on.)
function findStep(steps: Step[], call: string, line?: number): Step | null {
  const matches: Step[] = [];
  (function walk(list: Step[]) {
    for (const s of list) {
      if (s.call === call) matches.push(s);
      if (s.children) walk(s.children);
    }
  })(steps);
  if (matches.length === 0) return null;
  if (line === undefined) return matches[0];
  return (
    matches.find(s => s.line === line) ??
    matches.reduce((a, b) =>
      Math.abs((b.line ?? 1e9) - line) < Math.abs((a.line ?? 1e9) - line) ? b : a)
  );
}
function ref(band: 'g' | 'p', call: string, line?: number) {
  const b = band === 'g' ? gameBand : playerBand;
  const s = findStep(b.steps, call, line);
  if (!s) throw new Error(`turn-order: step not found: ${band}:${call}`);
  return { id: s.id, num: s.id.replace(/^[gp]/, band === 'g' ? 'R' : 'P') };
}

// Anchor steps for the Q&A (build fails loudly if extraction drops one).
const rFinishBuild = ref('p', 'finishBuild');
const rProcessYield = ref('p', 'processYield', 16646);
const rDoResearch = ref('p', 'doResearch');
const rUpdateGoals = ref('p', 'updateGoals');
const rRemoveAmbition = ref('p', 'removeAmbition');
const rDoAmbitions = ref('p', 'doAmbitions');
const rDoEventTriggers = ref('p', 'doEventTriggers');
const rUnitTurn = ref('p', 'doTurn', 16712);
const rHealing = ref('p', 'changeDamageText', 5838);
const rCharTurn = ref('p', 'doTurn', 16757);
const rLeaderLast = ref('p', 'doTurn', 16775);
const rMissions = ref('p', 'doMissionTurn');
const rCampRaids = ref('g', 'doTribeTurn', 10974);
const rDistantRaid = ref('p', 'doDistantRaidTurn');
const rPrices = ref('g', 'adjustYieldPrice');
const rDebts = ref('p', 'doDebts');

function countSteps(steps: Step[]): number {
  return steps.length + steps.reduce((a, s) => a + (s.children ? countSteps(s.children) : 0), 0);
}
const totalSteps = countSteps(gameBand.steps) + countSteps(playerBand.steps);
---

<Base
  title="Turn Order"
  active="turn-order"
  pageMark="🔄"
  description="What Old World actually does at turn start, in exact source order: the global turn rollover (occurrences, prices, tiles, tribes, religion) and each player's turn-start processing (cities, research, units, characters, events, ambitions) — extracted from Game.cs and Player.cs."
  pageStats={[
    { label: 'rollover steps', value: countSteps(gameBand.steps) },
    { label: 'player steps', value: countSteps(playerBand.steps) },
    { label: 'total', value: totalSteps },
  ]}
>
  <p class="lede">
    Everything below is the game's own order of operations, extracted from the
    <code>doTurn()</code> functions in the shipped source. When two things seem
    to happen "at the same time" — a build finishing and a tech completing, a
    character dying and an event firing — this page tells you which one the
    engine actually resolves first. Step order is source order; every step
    carries its <code>file:line</code>.
  </p>

  <section class="to-section">
    <h2 class="to-h2">How a round is structured</h2>
    <p>
      The engine advances turns from <code>Game.testTurn()</code>
      (<code>Game.cs:3257</code>): once every currently-active player has ended
      their turn (<code>shouldIncrementTurn</code>, <code>Game.cs:3359</code>),
      <code>nextTeamTurn()</code> (<code>Game.cs:4238</code>) moves play along. A
      full round looks like this:
    </p>
    <ol class="to-cycle">
      <li>
        <b>Players play</b>, team by team (or all at once in simultaneous
        multiplayer). When a player's turn ends, their 0-HP units die and
        stunned units drop to a normal cooldown
        (<code>processEndTurn</code>, <code>Player.cs:16906</code>).
      </li>
      <li>
        <b>The tribe turn.</b> After the last team, tribal and unaffiliated
        characters take their character turns (<code>Game.cs:4381</code>), the
        AI moves tribal units, every tribal unit runs its unit turn, and tribal
        cities act (<code>playCurrentTurn</code>, <code>Game.cs:3269–3314</code>).
      </li>
      <li>
        <b>The turn rollover.</b> When the tribe turn finishes,
        <code>incrementTurn()</code> bumps the turn counter and runs
        <code>Game.doTurn()</code> — the first band below — then checks game
        over (<code>Game.cs:3175–3188</code>, <code>Game.cs:4247–4250</code>).
        So the world updates <i>after the tribes act and before the first
        player's new turn</i>.
      </li>
      <li>
        <b>Each player's turn begins.</b> As a player becomes current,
        <code>Player.doTurn()</code> — the second band below — runs before they
        get control (<code>Game.cs:4316</code>).
      </li>
    </ol>
    <p class="to-fineprint">
      Multiplayer nuances visible in the source: in <b>simultaneous</b> mode all
      players' turn-start processing runs back-to-back in player-index order in
      one pass (<code>Game.cs:4310–4322</code>); in <b>play-by-cloud / server</b>
      games the save uploads and "your turn" notifications go out right after a
      human's turn-start processing (<code>Game.cs:4324–4353</code>); hotseat
      autosaves and switches the active player (<code>Game.cs:4354–4360</code>).
    </p>
  </section>

  <section class="to-section to-qa">
    <h2 class="to-h2">Common ordering questions</h2>
    <dl class="to-qa__list">
      <div class="to-qa__item">
        <dt>Does a build or a tech finish first?</dt>
        <dd>
          City production applies and builds finish at step
          <a href={`#${rFinishBuild.id}`}>{rFinishBuild.num}</a>; Science is
          banked right after at step
          <a href={`#${rProcessYield.id}`}>{rProcessYield.num}</a> — where it
          goes <i>straight into the current tech</i> and can complete it — with
          any remainder flushed at step
          <a href={`#${rDoResearch.id}`}>{rDoResearch.num}</a>. So builds
          finish first, techs immediately after, both before your units and
          characters are processed.
        </dd>
      </div>
      <div class="to-qa__item">
        <dt>When are ambitions checked?</dt>
        <dd>
          At the very end of turn-start processing: progress recomputes at step
          <a href={`#${rUpdateGoals.id}`}>{rUpdateGoals.num}</a>, expired
          ambitions fail at step
          <a href={`#${rRemoveAmbition.id}`}>{rRemoveAmbition.num}</a>, and new
          offers roll at step
          <a href={`#${rDoAmbitions.id}`}>{rDoAmbitions.num}</a> — all after
          that turn's event rolls
          (step <a href={`#${rDoEventTriggers.id}`}>{rDoEventTriggers.num}</a>).
          Whatever you finished last turn is already counted.
        </dd>
      </div>
      <div class="to-qa__item">
        <dt>Do characters die before or after events fire?</dt>
        <dd>
          Death rolls happen inside each character's yearly tick during step
          <a href={`#${rCharTurn.id}`}>{rCharTurn.num}</a> — before the player's
          story-event rolls at step
          <a href={`#${rDoEventTriggers.id}`}>{rDoEventTriggers.num}</a>. The
          leader deliberately goes last (step
          <a href={`#${rLeaderLast.id}`}>{rLeaderLast.num}</a>), and missions
          resolve after all character turns (step
          <a href={`#${rMissions.id}`}>{rMissions.num}</a>) so mid-event state
          changes can't invalidate them.
        </dd>
      </div>
      <div class="to-qa__item">
        <dt>When do my units heal?</dt>
        <dd>
          During your turn-start unit processing (step
          <a href={`#${rUnitTurn.id}`}>{rUnitTurn.num}</a>): healing applies at
          sub-step <a href={`#${rHealing.id}`}>{rHealing.num}</a>, and the idle
          bonus only counts if the unit took no action <i>last</i> turn. Units
          heal before you move anything.
        </dd>
      </div>
      <div class="to-qa__item">
        <dt>When do tribes and raiders act?</dt>
        <dd>
          Tribal units and cities act in their own turn slot after all players
          (see "How a round is structured"). On top of that, camps roll raids
          during the rollover at step
          <a href={`#${rCampRaids.id}`}>{rCampRaids.num}</a>, and each of your
          cities rolls for distant raids at step
          <a href={`#${rDistantRaid.id}`}>{rDistantRaid.num}</a>.
        </dd>
      </div>
      <div class="to-qa__item">
        <dt>When does the market move?</dt>
        <dd>
          Prices drift once per round during the rollover (step
          <a href={`#${rPrices.id}`}>{rPrices.num}</a>), before any player's
          turn. Forced debt sales (step
          <a href={`#${rDebts.id}`}>{rDebts.num}</a>) therefore trade at the
          already-adjusted price.
        </dd>
      </div>
    </dl>
  </section>

  {[gameBand, playerBand].map(band => (
    <section class="to-section">
      <h2 class="to-band">{band.title}</h2>
      <p class="to-band__entry">
        <code>{band.fn}()</code> — <code>{band.entry}</code>
        {band.key === 'player' && (
          <span class="to-band__note">
            Runs once per player as their turn begins; the bulk is inlined from
            <code> processTurn()</code> (<code>Player.cs:16505</code>).
          </span>
        )}
      </p>
      <ol class="tl">
        {band.steps.map((s, i) => (
          <li class="tl__step" id={s.id}>
            <span class="tl__badge">{i + 1}</span>
            <div class="tl__body">
              {(s.loop || s.cond) && (
                <div class="tl__ctx">
                  {s.loop && <span class="tl__loop">{s.loop}</span>}
                  {s.loop && s.cond && <span class="tl__sep">·</span>}
                  {s.cond && <span class="tl__cond">{s.cond}</span>}
                </div>
              )}
              <h3 class="tl__title">
                <a class="tl__anchor" href={`#${s.id}`}>{s.title}</a>
              </h3>
              {s.desc && <p class="tl__desc"><LinkedText text={s.desc} /></p>}
              <span class="tl__src">{s.file}:{s.line}</span>
              {s.children && (
                <details class="tl__sub">
                  <summary>
                    {s.childFn}() sequence — {s.children.length} steps
                    <span class="tl__src tl__src--inline">{s.childEntry}</span>
                  </summary>
                  <ol class="tl tl--nested">
                    {s.children.map((c, j) => (
                      <li class="tl__step" id={c.id}>
                        <span class="tl__badge tl__badge--sub">{i + 1}.{j + 1}</span>
                        <div class="tl__body">
                          {(c.loop || c.cond) && (
                            <div class="tl__ctx">
                              {c.loop && <span class="tl__loop">{c.loop}</span>}
                              {c.loop && c.cond && <span class="tl__sep">·</span>}
                              {c.cond && <span class="tl__cond">{c.cond}</span>}
                            </div>
                          )}
                          <h3 class="tl__title tl__title--sub">
                            <a class="tl__anchor" href={`#${c.id}`}>{c.title}</a>
                          </h3>
                          {c.desc && <p class="tl__desc"><LinkedText text={c.desc} /></p>}
                          <span class="tl__src">{c.file}:{c.line}</span>
                          {c.children && (
                            <details class="tl__sub">
                              <summary>
                                {c.childFn}() sequence — {c.children.length} steps
                                <span class="tl__src tl__src--inline">{c.childEntry}</span>
                              </summary>
                              <ol class="tl tl--nested">
                                {c.children.map((cc, k) => (
                                  <li class="tl__step" id={cc.id}>
                                    <span class="tl__badge tl__badge--sub">{i + 1}.{j + 1}.{k + 1}</span>
                                    <div class="tl__body">
                                      {(cc.loop || cc.cond) && (
                                        <div class="tl__ctx">
                                          {cc.loop && <span class="tl__loop">{cc.loop}</span>}
                                          {cc.loop && cc.cond && <span class="tl__sep">·</span>}
                                          {cc.cond && <span class="tl__cond">{cc.cond}</span>}
                                        </div>
                                      )}
                                      <h3 class="tl__title tl__title--sub">
                                        <a class="tl__anchor" href={`#${cc.id}`}>{cc.title}</a>
                                      </h3>
                                      {cc.desc && <p class="tl__desc"><LinkedText text={cc.desc} /></p>}
                                      <span class="tl__src">{cc.file}:{cc.line}</span>
                                    </div>
                                  </li>
                                ))}
                              </ol>
                            </details>
                          )}
                        </div>
                      </li>
                    ))}
                  </ol>
                </details>
              )}
            </div>
          </li>
        ))}
      </ol>
    </section>
  ))}

  <section class="to-section">
    <h2 class="to-h2">What this page does not pin down</h2>
    <ul class="to-bullets">
      <li>
        <b>Which event fires.</b> The order of the event <i>rolls</i> is exact,
        but event selection inside <code>doEventTrigger</code> is weighted and
        subject-filtered — there is no fixed priority between individual events.
      </li>
      <li>
        <b>AI decision details.</b> <code>AI.doDecisions</code>,
        <code>doAutomatedCityBuilds</code> and the AI diplomacy passes delegate
        into <code>PlayerAI.cs</code>; their internal ordering isn't part of the
        turn skeleton shown here.
      </li>
      <li>
        <b>Relative order between players.</b> Within one rollover, per-player
        loops run in player-index order (host's setup order); in simultaneous
        multiplayer that ordering is internal and not visible in-game.
      </li>
    </ul>
  </section>

  <p class="to-source">
    Source: <code>Game.cs</code> <code>doTurn()</code> / <code>testTurn()</code>
    / <code>nextTeamTurn()</code>, <code>Player.cs</code> <code>doTurn()</code>
    / <code>processTurn()</code>, plus the nested <code>Tile</code>,
    <code>Tribe</code>, <code>City</code>, <code>Unit</code> and
    <code>Character</code> turn functions — extracted by
    <code>scripts/build_turn_order.py</code> into
    <code>src/data/turn_order.json</code>. R = rollover step, P = player step.
  </p>

  <script is:inline>
    // Anchor targets can live inside collapsed <details>; open the chain.
    (function () {
      function openTarget() {
        var id = location.hash.slice(1);
        if (!id) return;
        var el = document.getElementById(id);
        if (!el) return;
        var p = el.parentElement;
        while (p) {
          if (p.tagName === 'DETAILS') p.open = true;
          p = p.parentElement;
        }
        el.scrollIntoView({ block: 'center' });
      }
      window.addEventListener('hashchange', openTarget);
      openTarget();
    })();
  </script>
</Base>

<style>
  .lede {
    color: var(--text-dim);
    font-size: 0.9rem;
    line-height: 1.55;
    max-width: 72ch;
    margin: 0.4rem 0 1.5rem;
  }
  .lede b { color: var(--text); }

  .to-section { margin-top: 2rem; }
  .to-h2 {
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    margin: 0 0 0.5rem;
    color: var(--text);
  }
  .to-section p {
    color: var(--text-dim);
    font-size: 0.85rem;
    line-height: 1.55;
    max-width: 76ch;
    margin: 0.3rem 0;
  }
  .to-section p b, .to-section li b { color: var(--text); }

  .to-cycle {
    list-style: decimal inside;
    color: var(--text-dim);
    font-size: 0.85rem;
    line-height: 1.55;
    max-width: 76ch;
    padding: 0;
    margin: 0.5rem 0;
  }
  .to-cycle li { padding: 0.25rem 0; }

  .to-bullets {
    color: var(--text-dim);
    font-size: 0.85rem;
    line-height: 1.55;
    margin: 0.4rem 0 0.8rem;
    padding-left: 1.2rem;
    max-width: 80ch;
  }
  .to-bullets li { padding: 0.2rem 0; }

  .to-fineprint {
    color: var(--text-faint) !important;
    font-size: 0.78rem !important;
    line-height: 1.5;
    font-style: italic;
    max-width: 76ch;
  }

  /* ── Q&A callout ─────────────────────────────────────────────── */
  .to-qa {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 6px;
    padding: 1rem 1.2rem 1.1rem;
    max-width: 84ch;
  }
  .to-qa__list { margin: 0; }
  .to-qa__item { padding: 0.45rem 0; }
  .to-qa__item + .to-qa__item { border-top: 1px solid var(--border); }
  .to-qa__item dt {
    font-family: var(--font-display);
    font-size: 0.9rem;
    color: var(--accent);
    margin-bottom: 0.2rem;
  }
  .to-qa__item dd {
    margin: 0;
    color: var(--text-dim);
    font-size: 0.83rem;
    line-height: 1.55;
  }
  .to-qa__item dd a {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.92em;
    text-decoration: none;
    border-bottom: 1px dotted var(--accent);
  }
  .to-qa__item dd a:hover { border-bottom-style: solid; }

  /* ── Timeline bands ──────────────────────────────────────────── */
  .to-band {
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: 0.04em;
    color: var(--accent);
    margin: 0 0 0.2rem;
    padding-top: 0.6rem;
    border-top: 2px solid var(--border-strong);
  }
  .to-band__entry {
    font-size: 0.8rem;
    color: var(--text-faint);
    margin: 0 0 1rem !important;
  }
  .to-band__note { display: block; margin-top: 0.2rem; }

  /* ── Timeline ────────────────────────────────────────────────── */
  .tl {
    list-style: none;
    margin: 0.8rem 0 0;
    padding: 0;
    position: relative;
    max-width: 84ch;
  }
  .tl::before {
    content: '';
    position: absolute;
    left: 14px;
    top: 6px;
    bottom: 6px;
    width: 1px;
    background: var(--border-strong);
  }
  .tl__step {
    position: relative;
    display: flex;
    gap: 0.8rem;
    padding: 0.45rem 0 0.55rem;
  }
  .tl__step:target {
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    border-radius: 6px;
  }
  .tl__badge {
    flex: 0 0 auto;
    z-index: 1;
    width: 29px;
    height: 29px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--accent);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
  }
  .tl__badge--sub {
    width: auto;
    min-width: 29px;
    padding: 0 0.35rem;
    border-radius: 14px;
    border-color: var(--border-strong);
    color: var(--text-faint);
    font-size: 0.62rem;
  }
  .tl__body { min-width: 0; flex: 1; }
  .tl__ctx {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--text-faint);
    margin-bottom: 0.1rem;
  }
  .tl__loop { color: var(--text-faint); }
  .tl__cond { color: color-mix(in srgb, var(--accent) 65%, var(--text-faint)); }
  .tl__sep { margin: 0 0.35rem; }
  .tl__title {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    margin: 0;
    color: var(--text);
  }
  .tl__title--sub { font-size: 0.85rem; }
  .tl__anchor { color: inherit; text-decoration: none; }
  .tl__anchor:hover { color: var(--accent); }
  .tl__desc {
    margin: 0.15rem 0 0.1rem !important;
    font-size: 0.81rem !important;
    color: var(--text-dim);
    line-height: 1.5;
    max-width: 72ch;
  }
  .tl__src {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    color: var(--text-faint);
    opacity: 0.8;
  }
  .tl__src--inline { margin-left: 0.5rem; }

  /* nested <details> sub-sequences */
  .tl__sub {
    margin: 0.4rem 0 0.2rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-elev);
  }
  .tl__sub > summary {
    cursor: pointer;
    padding: 0.4rem 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-dim);
    user-select: none;
  }
  .tl__sub > summary:hover { color: var(--accent); }
  .tl__sub[open] > summary { border-bottom: 1px solid var(--border); }
  .tl--nested {
    margin: 0.3rem 0.7rem 0.5rem;
    max-width: none;
  }
  .tl--nested::before { left: 14px; }

  .to-source {
    margin-top: 2.2rem;
    color: var(--text-faint);
    font-size: 0.75rem;
    line-height: 1.5;
    max-width: 84ch;
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.78em;
    background: var(--bg-elev);
    padding: 0 0.25rem;
    border-radius: 3px;
    border: 1px solid var(--border);
  }
</style>
