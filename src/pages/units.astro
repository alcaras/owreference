---
import Base from '../layouts/Base.astro';
import LinkedText from '../components/LinkedText.astro';
import allUnits from '../data/units.json';
import { classifyYield } from '../lib/entities';

const base = import.meta.env.BASE_URL;

// Normal units only — the roster any nation can build. Unique (nation-gated)
// and tribal/barbarian units live on their own pages. Classification comes
// straight from units.json's `category` field (built by build_unit_damage.py).
const units = (allUnits as any[]).filter(u => u.category === 'normal');

const unitArt = (slug: string) => `${base}img/icons/units/${slug}.png`;
const traitIcon = (key: string) => `${base}img/icons/unit_traits/${key}.png`;
const yieldIcon = (key: string) => `${base}img/icons/yields/${key}.png`;

// Display class: combat units take their primary trait; disciples get their
// own bucket (religious unit, not "Infantry"); non-combat are "Civilian".
function unitClass(u: any): { key: string; label: string; icon: string } {
  if (!u.isCombat) return { key: 'civilian', label: 'Civilian', icon: 'worker' };
  if ((u.traitIds as string[]).includes('UNITTRAIT_DISCIPLE'))
    return { key: 'disciple', label: 'Disciple', icon: 'disciple' };
  return {
    key: (u.primaryLabel || 'other').toLowerCase(),
    label: u.primaryLabel || 'Other',
    icon: (u.primaryTrait || '').replace('UNITTRAIT_', '').toLowerCase(),
  };
}

// Counter / attack modifiers, humanized to one short string each.
function fmtCounter(c: any): string {
  const v = (c.value > 0 ? '+' : '') + c.value + '%';
  return c.kind === 'attack' ? `${v} ${c.target}` : `${v} ${c.kind} ${c.target}`;
}

// Secondary trait chips worth surfacing (other units counter these). Drops the
// primary class, generic flags, and the classification traits.
const HIDE_TRAITS = new Set([
  'UNITTRAIT_PROMOTABLE', 'UNITTRAIT_MELEE', 'UNITTRAIT_INFANTRY', 'UNITTRAIT_POLEARM',
  'UNITTRAIT_MOUNTED', 'UNITTRAIT_RANGED', 'UNITTRAIT_SIEGE', 'UNITTRAIT_SHIP',
  'UNITTRAIT_TRIBAL', 'UNITTRAIT_DISCIPLE', 'UNITTRAIT_WORKER',
]);
const secondaryTraits = (u: any) =>
  (u.traitIds as string[])
    .filter(t => t !== u.primaryTrait && !HIDE_TRAITS.has(t))
    .map(t => t.replace('UNITTRAIT_', '').replace(/_/g, ' ').toLowerCase()
      .replace(/\b\w/g, c => c.toUpperCase()));

// Range string for the Range column / sort value (melee = 0).
const rangeText = (u: any) => (u.rangeMax > 0 ? String(u.rangeMax) : '');

// Pre-classified search blob per unit (drives the header search box).
const searchBlobs: Record<string, string> = {};
for (const u of units) searchBlobs[u.slug] = JSON.stringify(u).toLowerCase();

const dlcCount = units.filter(u => u.source !== 'Base game').length;

// ── Faceted-filter option lists (deterministic order, present-only) ──
const CLASS_ORDER = ['Infantry', 'Polearm', 'Mounted', 'Ranged', 'Siege', 'Ship', 'Disciple', 'Civilian'];
const classOf = new Map(units.map(u => [u.slug, unitClass(u).label]));
const presentClasses = CLASS_ORDER.filter(c => [...classOf.values()].includes(c));

const present = <T,>(pref: readonly T[], have: Set<T>) => pref.filter(v => have.has(v));
const SOURCES = present(
  ['Base game', 'Wonders & Dynasties', 'Empires of the Indus', 'Search & Progress', 'Behind the Throne'] as const,
  new Set(units.map(u => u.source)),
);

const cnt = (pred: (u: any) => boolean) => units.filter(pred).length;
type Facet = { key: string; title: string; opts: { val: string; label: string; icon?: string; count: number }[] };
const FACETS: Facet[] = [
  { key: 'class', title: 'Class', opts: presentClasses.map(c => ({
      val: c, label: c, icon: traitIcon(unitClass(units.find(u => classOf.get(u.slug) === c)).icon),
      count: cnt(u => classOf.get(u.slug) === c) })) },
  { key: 'source', title: 'Source', opts: SOURCES.map(s => ({
      val: s, label: s, count: cnt(u => u.source === s) })) },
];
---

<Base
  title="Units"
  active="units"
  pageMark="🛡️"
  description={`The ${units.length} standard units of Old World any nation can build — Infantry, Polearm, Mounted, Ranged, Siege and Ship classes, plus civilian and disciple units. Each row shows Strength, Movement, Range, training cost, material cost, upkeep, tech prerequisite and combat counters, all derived from the game's unit.xml. Nation-unique and tribal units are listed separately.`}
>
  <div class="page-meta">
    <h1 class="page-title">Units</h1>
    <div class="page-stats">
      <button
        type="button"
        class="stat stat--button"
        id="unit-picker-toggle"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="unit-picker"
      >
        <b id="unit-visible-count">{units.length}</b> of <b>{units.length}</b> visible <span class="stat__chev">▾</span>
      </button>
    </div>
  </div>

  <div class="nation-picker nation-picker--facets" id="unit-picker" hidden role="dialog" aria-label="Filter units">
    <div class="nation-picker__actions">
      <button type="button" class="nation-picker__action" data-pick="all">Select all</button>
      <button type="button" class="nation-picker__action" data-pick="none">Clear</button>
      <button type="button" class="nation-picker__action nation-picker__action--close" data-pick="close">Done</button>
    </div>
    {FACETS.map(f => (
      <div class="facet">
        <div class="facet__title">{f.title}</div>
        <ul class="nation-picker__list">
          {f.opts.map(o => (
            <li class="nation-picker__item">
              <label class="nation-picker__row">
                <input type="checkbox" class="nation-picker__cb" data-facet={f.key} value={o.val} checked />
                {o.icon && <img class="nation-picker__crest" src={o.icon} alt="" onerror="this.style.display='none'" />}
                <span class="nation-picker__name">{o.label}</span>
                <span class="nation-picker__count">{o.count}</span>
              </label>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div class="grid__searchnote" id="grid-searchnote" hidden></div>

  <div class="grid" id="units-grid">
    <div class="grid__scroll">
      <table class="ntbl utbl">
        <colgroup>
          <col class="utbl__name-col" />
          <col class="utbl__class-col" />
          <col class="utbl__stat-col" />
          <col class="utbl__stat-col" />
          <col class="utbl__stat-col" />
          <col class="utbl__cost-col" />
          <col class="utbl__mat-col" />
          <col class="utbl__mat-col" />
          <col class="utbl__tech-col" />
          <col class="utbl__abil-col" />
        </colgroup>
        <thead>
          <tr>
            <th class="rowlabel rowlabel--corner"><span class="nhdr__name">Unit</span></th>
            <th class="nhdr nhdr--col"><span class="nhdr__name">Class</span></th>
            <th class="nhdr nhdr--col nhdr--num" title="Strength"><span class="nhdr__name">Str</span></th>
            <th class="nhdr nhdr--col nhdr--num" title="Movement"><span class="nhdr__name">Move</span></th>
            <th class="nhdr nhdr--col nhdr--num" title="Attack range (melee shows —)"><span class="nhdr__name">Range</span></th>
            <th class="nhdr nhdr--col nhdr--num" title="Training cost to build"><span class="nhdr__name">Cost</span></th>
            <th class="nhdr nhdr--col"><span class="nhdr__name">Materials</span></th>
            <th class="nhdr nhdr--col"><span class="nhdr__name">Upkeep</span></th>
            <th class="nhdr nhdr--col"><span class="nhdr__name">Tech</span></th>
            <th class="nhdr nhdr--col"><span class="nhdr__name">Counters & Abilities</span></th>
          </tr>
        </thead>
        <tbody>
          {units.map(u => {
            const cls = unitClass(u);
            const sec = secondaryTraits(u);
            return (
              <tr data-unit={u.slug} data-class={cls.label} data-source={u.source} id={u.slug}>
                <th class="rowlabel rowlabel--unit" scope="row" data-sortval={u.name}>
                  <div class="uname">
                    <img class="uname__art" src={unitArt(u.iconSlug)} alt="" loading="lazy" onerror="this.style.display='none'" />
                    <div class="uname__text">
                      <span class="uname__name">{u.name}</span>
                      {u.source !== 'Base game' && (
                        <div class="uname__meta">
                          <span class="chip chip--dlc" title={`${u.source} DLC`}>DLC</span>
                        </div>
                      )}
                    </div>
                  </div>
                </th>

                {/* Class — trait icon + label, sorts alphabetically */}
                <td class="cell cell--class" data-sortval={cls.label}>
                  <span class="cls-tag" title={cls.label}>
                    <img class="cls-tag__ico" src={traitIcon(cls.icon)} alt="" onerror="this.style.display='none'" />
                    <span class="cls-tag__txt">{cls.label}</span>
                  </span>
                </td>

                {/* Strength (stored 10× — display value) */}
                <td class="cell cell--num" data-sortval={u.strength}>
                  <span class="numval numval--str">{u.strength / 10}</span>
                </td>

                {/* Movement */}
                <td class="cell cell--num" data-sortval={u.movement}>
                  <span class="numval">{u.movement}</span>
                </td>

                {/* Range (melee → dash) */}
                {u.rangeMax > 0 ? (
                  <td class="cell cell--num" data-sortval={u.rangeMax}>
                    <span class="numval">{rangeText(u)}</span>
                  </td>
                ) : (
                  <td class="cell cell--num is-empty" data-sortval={0}><span class="cell__dash">—</span></td>
                )}

                {/* Training cost (production in the unit's ProductionType yield) */}
                {u.production > 0 ? (
                  <td class={`cell cell--num yield-${u.trainingYield || 'misc'}`} data-sortval={u.production}>
                    <span class="numval">
                      {u.trainingYield && (
                        <img class="numval__ico" src={yieldIcon(u.trainingYield)} alt="" onerror="this.style.display='none'" />
                      )}
                      {u.production}
                    </span>
                  </td>
                ) : (
                  <td class="cell cell--num is-empty" data-sortval={0}><span class="cell__dash">—</span></td>
                )}

                {/* Material costs (Iron / Wood / Food …) as yield chips */}
                {u.costs.length === 0 ? (
                  <td class="cell is-empty"><span class="cell__dash">—</span></td>
                ) : (
                  <td class="cell cell--chips">
                    {u.costs.map((c: any) => (
                      <span class={`chip yield-${c.yield}`} title={`${c.value} ${c.yield} to build`}>
                        <img class="chip__icon" src={yieldIcon(c.yield)} alt="" onerror="this.style.display='none'" />
                        {c.value}
                      </span>
                    ))}
                  </td>
                )}

                {/* Per-turn upkeep (consumption) as yield chips */}
                {u.consumption.length === 0 ? (
                  <td class="cell is-empty"><span class="cell__dash">—</span></td>
                ) : (
                  <td class="cell cell--chips">
                    {u.consumption.map((c: any) => (
                      <span class={`chip yield-${c.yield}`} title={`${c.value} ${c.yield} per turn upkeep`}>
                        <img class="chip__icon" src={yieldIcon(c.yield)} alt="" onerror="this.style.display='none'" />
                        {c.value}
                      </span>
                    ))}
                  </td>
                )}

                {/* Tech prerequisite */}
                {u.techLabel ? (
                  <td class="cell cell--tech yield-misc">
                    <div class="cell__body"><LinkedText text={u.techLabel} showIcons={false} /></div>
                  </td>
                ) : (
                  <td class="cell is-empty"><span class="cell__dash">—</span></td>
                )}

                {/* Counters / abilities + secondary trait chips */}
                {u.counters.length === 0 && sec.length === 0 ? (
                  <td class="cell is-empty"><span class="cell__dash">—</span></td>
                ) : (
                  <td class="cell cell--effects">
                    {u.counters.map((c: any) => {
                      const text = fmtCounter(c);
                      const yk = classifyYield(text)?.toLowerCase() || 'misc';
                      return <div class={`effect yield-${yk}`}><LinkedText text={text} showIcons={false} /></div>;
                    })}
                    {sec.length > 0 && (
                      <div class="uname__meta">
                        {sec.map((t: string) => <span class="chip chip--neutral" title="Unit trait">{t}</span>)}
                      </div>
                    )}
                  </td>
                )}
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </div>

  <script type="application/json" id="unit-search-blobs" set:html={JSON.stringify(searchBlobs)}></script>
  <script is:inline define:vars={{ FACET_ATTR_JSON: JSON.stringify({ class: 'data-class', source: 'data-source' }) }}>
    // Faceted picker + header search on the flat (sortable) table. OR within a
    // facet, AND across facets, composed with search. Mirrors wonders.astro.
    (function () {
      const input = document.getElementById('site-search');
      const blobNode = document.getElementById('unit-search-blobs');
      const grid = document.getElementById('units-grid');
      const note = document.getElementById('grid-searchnote');
      const toggle = document.getElementById('unit-picker-toggle');
      const picker = document.getElementById('unit-picker');
      const visibleCount = document.getElementById('unit-visible-count');
      if (!blobNode || !grid || !picker) return;
      let blobs;
      try { blobs = JSON.parse(blobNode.textContent || '{}'); } catch { return; }

      const FACET_ATTR = JSON.parse(FACET_ATTR_JSON);
      const rows = Array.from(grid.querySelectorAll('tr[data-unit]'));
      const cbs = Array.from(picker.querySelectorAll('.nation-picker__cb'));
      const picked = {};
      function syncPicked() {
        for (const k of Object.keys(FACET_ATTR)) picked[k] = new Set();
        cbs.forEach((cb) => { if (cb.checked) picked[cb.getAttribute('data-facet')].add(cb.value); });
      }
      function rowPasses(row) {
        for (const facet of Object.keys(FACET_ATTR)) {
          const pset = picked[facet];
          if (!pset.has(row.getAttribute(FACET_ATTR[facet]) || '')) return false;
        }
        return true;
      }
      function applyFilters() {
        syncPicked();
        const q = ((input && input.value) || '').trim().toLowerCase();
        let visibleN = 0, hiddenBySearch = 0;
        for (const row of rows) {
          const slug = row.getAttribute('data-unit');
          const matchesSearch = !q || (blobs[slug] || '').includes(q);
          const visible = matchesSearch && rowPasses(row);
          if (visible) visibleN++;
          if (!matchesSearch) hiddenBySearch++;
          row.classList.toggle('is-hidden', !visible);
        }
        if (visibleCount) visibleCount.textContent = String(visibleN);
        if (note) {
          if (q && hiddenBySearch > 0) {
            note.hidden = false;
            note.textContent = 'Showing ' + (rows.length - hiddenBySearch) + ' of ' + rows.length +
              ' units matching "' + (input ? input.value : '') + '"';
          } else { note.hidden = true; note.textContent = ''; }
        }
      }

      if (input) input.addEventListener('input', applyFilters);
      if (toggle) {
        toggle.addEventListener('click', () => {
          const open = !picker.hidden;
          picker.hidden = open;
          toggle.setAttribute('aria-expanded', String(!open));
        });
        document.addEventListener('click', (e) => {
          if (picker.hidden) return;
          if (picker.contains(e.target) || toggle.contains(e.target)) return;
          picker.hidden = true; toggle.setAttribute('aria-expanded', 'false');
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !picker.hidden) {
            picker.hidden = true; toggle.setAttribute('aria-expanded', 'false'); toggle.focus();
          }
        });
      }
      cbs.forEach((cb) => cb.addEventListener('change', applyFilters));
      picker.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-pick]');
        if (!btn) return;
        const action = btn.getAttribute('data-pick');
        if (action === 'all') { cbs.forEach((cb) => (cb.checked = true)); applyFilters(); }
        else if (action === 'none') { cbs.forEach((cb) => (cb.checked = false)); applyFilters(); }
        else if (action === 'close') {
          picker.hidden = true;
          if (toggle) toggle.setAttribute('aria-expanded', 'false');
        }
      });
      applyFilters();
    })();
  </script>
  <script is:inline>
    // Click-to-sort columns (honors data-sortval). Same engine as wonders.astro.
    (function () {
      const table = document.querySelector('#units-grid table.ntbl');
      if (!table || !table.tHead) return;
      const ths = Array.from(table.tHead.rows[0].cells);
      ths.forEach((th, ci) => {
        th.classList.add('is-sortable');
        th.addEventListener('click', () => {
          const tb = table.tBodies[0];
          const rows = Array.from(tb.rows);
          const asc = th.getAttribute('aria-sort') !== 'ascending';
          ths.forEach(h => h.removeAttribute('aria-sort'));
          th.setAttribute('aria-sort', asc ? 'ascending' : 'descending');
          const val = r => {
            const c = r.cells[ci];
            const sv = c && c.getAttribute && c.getAttribute('data-sortval');
            const t = (sv != null ? sv : (c ? c.textContent : '')).trim();
            const n = parseFloat(t.replace(/[^0-9.\-]/g, ''));
            return { t, n: (t && !isNaN(n)) ? n : null };
          };
          rows.sort((a, b) => {
            const ka = val(a), kb = val(b);
            let r;
            if (ka.n !== null && kb.n !== null) r = ka.n - kb.n;
            else if (ka.n !== null) r = -1;
            else if (kb.n !== null) r = 1;
            else r = ka.t.localeCompare(kb.t);
            return asc ? r : -r;
          });
          rows.forEach(r => tb.appendChild(r));
        });
      });
    })();
  </script>
</Base>

<style>
  /* Column widths */
  .utbl__name-col  { width: 15rem; }
  .utbl__class-col { width: 7.5rem; }
  .utbl__stat-col  { width: 4rem; }
  .utbl__cost-col  { width: 5rem; }
  .utbl__mat-col   { width: 6rem; }
  .utbl__tech-col  { width: 9rem; }
  .utbl__abil-col  { width: auto; }

  /* Sortable header affordance (shared look with wonders / improvements) */
  .nhdr--col {
    background: var(--bg-elev-2);
    color: var(--text);
    background-image: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(0,0,0,0.18));
    border-bottom: 2px solid var(--border-strong);
    text-align: left;
    padding: 0.45rem 0.55rem;
  }
  .nhdr__name { font-family: var(--font-display); font-size: 0.78rem; letter-spacing: 0.03em; display: inline-flex; align-items: center; gap: 0.3rem; }
  .nhdr.is-sortable, .rowlabel--corner.is-sortable { cursor: pointer; user-select: none; }
  .nhdr.is-sortable:hover, .rowlabel--corner.is-sortable:hover { filter: brightness(1.12); }
  .nhdr.is-sortable .nhdr__name::after,
  .rowlabel--corner.is-sortable .nhdr__name::after { content: '↕'; opacity: 0.35; margin-left: 0.25rem; font-size: 0.85em; }
  .nhdr[aria-sort='ascending'] .nhdr__name::after,
  .rowlabel--corner[aria-sort='ascending'] .nhdr__name::after { content: '↑'; opacity: 0.9; }
  .nhdr[aria-sort='descending'] .nhdr__name::after,
  .rowlabel--corner[aria-sort='descending'] .nhdr__name::after { content: '↓'; opacity: 0.9; }
  .nhdr--num { text-align: right; }
  .nhdr--num .nhdr__name { justify-content: flex-end; }

  /* Unit name cell: art + name + chips */
  .rowlabel--unit { padding: 0.4rem 0.6rem; text-align: left; background: var(--bg-elev); }
  .uname { display: flex; gap: 0.5rem; align-items: center; }
  .uname__art {
    width: 44px; height: 44px; object-fit: contain; flex-shrink: 0;
    border-radius: 6px; background: rgba(0,0,0,0.25);
  }
  .uname__text { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }
  .uname__name { font-family: var(--font-display); font-weight: 600; font-size: 0.9rem; color: var(--text); letter-spacing: 0.02em; }
  .uname__meta { display: flex; gap: 0.25rem; flex-wrap: wrap; align-items: center; margin-top: 0.15rem; }

  /* Class tag */
  .cell--class { background: var(--bg-elev); background-image: none; }
  .cls-tag { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.8rem; color: var(--text-dim); }
  .cls-tag__ico { width: 18px; height: 18px; object-fit: contain; }

  /* Numeric columns: right-aligned mono */
  .cell--num { text-align: right; padding: 0.3rem 0.55rem; background-image: none; }
  .cell--num.is-empty { background: var(--bg-elev); }
  .numval { display: inline-flex; align-items: center; gap: 0.3rem; font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-weight: 600; font-size: 0.84rem; justify-content: flex-end; }
  .numval--str { color: var(--accent); }
  .numval__ico { width: 14px; height: 14px; object-fit: contain; flex-shrink: 0; }

  /* Chip clusters (materials / upkeep / traits) */
  .cell--chips { padding: 0.3rem 0.45rem; }
  .cell--chips .chip { margin: 0.1rem 0.15rem 0.1rem 0; }
  .chip__icon { width: 13px; height: 13px; object-fit: contain; vertical-align: -2px; margin-right: 2px; }
  .chip--dlc { background: var(--bg-elev-2); color: var(--text-dim); border: 1px solid var(--border); padding: 0.05rem 0.4rem; font-size: 0.64rem; letter-spacing: 0.06em; font-family: var(--font-mono); text-transform: uppercase; }
  .chip--neutral { background: var(--bg-elev-2); color: var(--text-dim); border: 1px solid var(--border); padding: 0.05rem 0.4rem; font-size: 0.68rem; }

  .cell--tech { font-size: 0.8rem; }

  /* Faceted picker popover (shared with wonders) */
  .nation-picker--facets { max-height: 70vh; overflow-y: auto; min-width: 15rem; }
  .facet + .facet { margin-top: 0.5rem; border-top: 1px solid var(--border); padding-top: 0.5rem; }
  .facet__title { font-family: var(--font-display); font-size: 0.72rem; letter-spacing: 0.06em; color: var(--text-faint); margin: 0 0 0.2rem; padding-left: 0.6rem; }
  .nation-picker__count { margin-left: auto; font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: 0.72rem; color: var(--text-faint); }

  tr.is-hidden { display: none; }
</style>
