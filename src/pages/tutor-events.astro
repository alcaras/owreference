---
import Base from '../layouts/Base.astro';
import LinkedText from '../components/LinkedText.astro';
import events from '../data/study_events.json';
import { classifyYield } from '../lib/entities';

type Event = typeof events[number];

// A royal child's tutor picks a course of study; each study event is gated to
// one course (or fires under "Any"). Group the events by that course — the
// view the legacy "Study Events" sheet laid out by hand, here from XML
// (the SUBJECT_STUDY_* subject-extra on each EVENTCLASS_STUDY entry).
const COURSES: { key: string; label: string; glyph: string; blurb: string }[] = [
  { key: 'Philosophy', label: 'Philosophy', glyph: '📜', blurb: 'Wisdom-leaning lessons — reason, faith, and the life of the mind.' },
  { key: 'Politics',   label: 'Politics',   glyph: '🏛️', blurb: 'Rhetoric and statecraft — oration, law, and swaying the court.' },
  { key: 'Tactics',    label: 'Tactics',    glyph: '⚔️', blurb: 'The martial education — combat training, command, and the field.' },
  { key: 'Commerce',   label: 'Commerce',   glyph: '⚖️', blurb: 'Money management — trade, numbers, and the marketplace.' },
  { key: 'Any',        label: 'Any Course', glyph: '🎓', blurb: 'Fires whatever the tutor teaches — not tied to one course.' },
  { key: '',           label: 'No Course Set', glyph: '✶', blurb: 'Education events with no course-of-study requirement at all.' },
];

const byCourse = (key: string) =>
  events
    .filter(e => (e.study || '') === key)
    // nation-locked events sink to the bottom of each course, then by title
    .sort((a, b) => (a.nation ? 1 : 0) - (b.nation ? 1 : 0) || a.title.localeCompare(b.title));

const sections = COURSES.map(c => ({ ...c, rows: byCourse(c.key) })).filter(s => s.rows.length);

const searchBlobs: Record<string, string> = {};
for (const e of events) searchBlobs[e.slug] = JSON.stringify(e).toLowerCase();

const courseCount = sections.filter(s => s.key && s.key !== 'Any').length;
---

<Base pageFilter title="Tutor Events" active="tutor-events" pageMark="🎓" pageStats={[
  { label: 'events', value: events.length },
  { label: 'courses', value: courseCount },
]}>
  <p class="te-intro">
    Every <code>EVENTCLASS_STUDY</code> event, grouped by the <strong>course of
    study</strong> a child's tutor sets. Each event is gated to one course —
    or fires under <em>Any</em> — via its <code>SUBJECT_STUDY_*</code> subject
    requirement. Rows show the prerequisites (age, nation, relationship), the
    bonuses each option grants, and the weight × chance the event rolls. Pulled
    from <code>eventStory.xml</code> and the BTT / SAP / WD / WoG packs.
  </p>

  <div id="te-grid">
    {sections.map(s => (
      <section class="te-course">
        <h2 class="te-course__h" id={`course-${s.key || 'none'}`}>
          <span class="te-course__glyph">{s.glyph}</span>
          <span class="te-course__name">{s.label}</span>
          <span class="te-course__count">{s.rows.length}</span>
        </h2>
        <p class="te-course__blurb">{s.blurb}</p>

        <div class="grid__scroll">
          <table class="ntbl">
            <thead>
              <tr>
                <th class="rowlabel rowlabel--corner">
                  <span class="rowlabel__small">Event →</span>
                  <span class="rowlabel__big">Field ↓</span>
                </th>
                <th class="nhdr nhdr--family">Event</th>
                <th class="nhdr nhdr--family">Prerequisites</th>
                <th class="nhdr nhdr--family">Options & Outcomes</th>
                <th class="nhdr nhdr--family">Weight × Prob</th>
                <th class="nhdr nhdr--family">Repeat</th>
              </tr>
            </thead>
            <tbody>
              {s.rows.map((e: Event) => (
                <tr data-event={e.slug}>
                  <th class="rowlabel" scope="row" id={`${s.key || 'none'}-${e.slug}`}>{e.title}</th>
                  <td class="cell yield-misc">
                    <span class="se__title">{e.title}</span>
                    <span class="se__markers">
                      <span
                        class={`chip--cm ${(e as any).cmEligible !== false ? 'chip--cm-yes' : 'chip--cm-no'}`}
                        title={(e as any).cmEligible !== false
                          ? 'Eligible in Competitive Mode'
                          : 'Excluded when Competitive Events is on (Competitive Mode tournaments)'}
                      >CM {(e as any).cmEligible !== false ? '✓' : '✗'}</span>
                      {(e as any).minTurns && <span class="chip--turn" title="Earliest turn this event can fire">Turn {(e as any).minTurns}+</span>}
                    </span>
                    {e.nation && <span class="te__nation">{e.nation} only</span>}
                    {e.author && <span class="se__author">by {e.author}</span>}
                  </td>
                  <td class={`cell ${e.prereqs.length ? 'yield-misc' : 'is-empty'}`}>
                    {e.prereqs.length ? (
                      <div class="chiplist">
                        {e.prereqs.map(p => <span class="chip chip--neutral">{p}</span>)}
                      </div>
                    ) : <span class="cell__dash">—</span>}
                  </td>
                  <td class={`cell ${e.options.length ? 'se__opts' : 'is-empty'}`}>
                    {e.options.length ? e.options.map((opt, i) => (
                      <div class="se-opt">
                        <div class="se-opt__text">
                          <span class="se-opt__num">{i + 1}.</span>
                          <span class="se-opt__t"><LinkedText text={opt.text} showIcons={false} /></span>
                        </div>
                        {opt.outcomes.length > 0 && (
                          <div class="se-opt__outs">
                            {opt.outcomes.map(o => {
                              const yieldKey = classifyYield(o)?.toLowerCase() || 'misc';
                              return (
                                <span class={`effect-pill yield-${yieldKey}`}>
                                  <LinkedText text={o} showIcons={false} iconsForYields={true} />
                                </span>
                              );
                            })}
                          </div>
                        )}
                      </div>
                    )) : <span class="cell__dash">—</span>}
                  </td>
                  <td class="cell yield-misc">
                    <span class="se__num">w{e.weight}</span>
                    <span class="se__num se__num--dim">{e.prob}%</span>
                  </td>
                  <td class="cell yield-misc">
                    {e.repeat === '-1' ? <span class="se__once">Once</span> :
                     e.repeat ? <span class="se__num">{e.repeat}t</span> :
                     <span class="cell__dash">—</span>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))}
  </div>

  <script type="application/json" id="te-search-blobs" set:html={JSON.stringify(searchBlobs)}></script>
  <script is:inline>
    (function () {
      const input = document.getElementById('page-filter');
      const blobNode = document.getElementById('te-search-blobs');
      const grid = document.getElementById('te-grid');
      if (!input || !blobNode || !grid) return;
      let blobs;
      try { blobs = JSON.parse(blobNode.textContent || '{}'); } catch { return; }
      function apply() {
        const q = (input.value || '').trim().toLowerCase();
        // Toggle rows, then hide any course section left with no visible rows.
        for (const slug of Object.keys(blobs)) {
          const match = !q || blobs[slug].includes(q);
          for (const el of grid.querySelectorAll('[data-event="' + slug + '"]')) {
            el.classList.toggle('is-hidden', !match);
          }
        }
        for (const sec of grid.querySelectorAll('.te-course')) {
          const anyVisible = sec.querySelector('tbody [data-event]:not(.is-hidden)');
          sec.classList.toggle('is-hidden', !anyVisible);
        }
      }
      input.addEventListener('input', apply);
      apply();
    })();
  </script>
</Base>

<style>
  .te-intro {
    max-width: 820px;
    color: var(--text-dim);
    font-size: 0.86rem;
    margin: 0 0 1.4rem;
    line-height: 1.55;
  }
  .te-intro code, .te-intro strong { color: var(--text); }
  .te-intro code {
    background: var(--bg-elev);
    padding: 0.05rem 0.4rem;
    border-radius: 3px;
    border: 1px solid var(--border);
  }

  .te-course { margin: 0 0 2.4rem; }
  .te-course.is-hidden { display: none; }

  .te-course__h {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 0.2rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--border);
  }
  .te-course__glyph { font-size: 1rem; }
  .te-course__name { flex: 0 0 auto; }
  .te-course__count {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--text-dim);
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.05rem 0.5rem;
  }
  .te-course__blurb {
    color: var(--text-dim);
    font-size: 0.78rem;
    margin: 0 0 0.7rem;
    font-style: italic;
  }

  .te__nation {
    display: inline-block;
    margin-top: 0.12rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    border-radius: 3px;
    padding: 0.02rem 0.3rem;
  }

  /* Shared with study-events.astro */
  .se__title {
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text);
    display: block;
  }
  .se__markers { display: flex; gap: 0.3rem; flex-wrap: wrap; margin: 0.2rem 0; }
  /* Competitive-Mode eligibility (green/red) + earliest-fire turn markers */
  .chip--cm { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.02em; padding: 0.05rem 0.4rem; border-radius: 5px; border: 1px solid transparent; }
  .chip--cm-yes { color: #6ba368; background: color-mix(in srgb, #6ba368 14%, var(--bg-elev)); border-color: color-mix(in srgb, #6ba368 40%, transparent); }
  .chip--cm-no  { color: #c25555; background: color-mix(in srgb, #c25555 14%, var(--bg-elev)); border-color: color-mix(in srgb, #c25555 40%, transparent); }
  .chip--turn { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.02em; padding: 0.05rem 0.4rem; border-radius: 5px; color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, var(--bg-elev)); border: 1px solid color-mix(in srgb, var(--accent) 38%, transparent); }
  .se__author {
    display: block;
    margin-top: 0.1rem;
    font-size: 0.62rem;
    font-style: italic;
    color: var(--text-faint);
  }
  .chiplist { display: flex; flex-wrap: wrap; gap: 0.2rem; }
  .chiplist .chip { padding: 0.08rem 0.4rem; font-size: 0.66rem; }
  .se__opts {
    background: var(--bg-elev);
    background-image: none;
    padding: 0.3rem 0.4rem;
  }
  .se-opt { padding: 0.3rem 0; border-bottom: 1px dashed var(--border); }
  .se-opt:first-child { padding-top: 0; }
  .se-opt:last-child { padding-bottom: 0; border-bottom: 0; }
  .se-opt__text { display: flex; gap: 0.3rem; font-size: 0.72rem; line-height: 1.4; }
  .se-opt__num { color: var(--accent); font-family: var(--font-mono); font-weight: 600; flex-shrink: 0; }
  .se-opt__t { color: var(--text); }
  .se-opt__outs { display: flex; flex-wrap: wrap; gap: 0.2rem; margin-top: 0.2rem; }
  .effect-pill {
    display: inline-block;
    padding: 0.05rem 0.45rem;
    border-radius: 999px;
    font-size: 0.66rem;
    background: var(--yield-bg, var(--bg-elev));
    color: var(--yield-fg, var(--text));
    border: 1px solid color-mix(in srgb, var(--yield-bg, var(--border)) 60%, #000 40%);
  }
  .se__num {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 0.72rem;
    color: var(--text);
    display: block;
  }
  .se__num--dim { color: var(--text-dim); margin-top: 0.1rem; }
  .se__once {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  .ntbl .nhdr:nth-child(2) { min-width: 10rem; }
  .ntbl .nhdr:nth-child(3) { min-width: 9rem; }
  .ntbl .nhdr:nth-child(4) { min-width: 20rem; }
</style>
