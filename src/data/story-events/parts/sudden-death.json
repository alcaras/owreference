"As leader: -10% Orders"],"tipTitle":"Mourning — trait"},{"text":"Gain trait: Inspiring","tip":["As leader: +1 Culture/Culture Level","As governor: +2 Culture/Culture Level","+1 Charisma","+20 opinion with same-trait characters"],"tipTitle":"Inspiring — trait"}]}],"raw":{"bonuses":[{"fields":["aeAddTraits: TRAIT_MOURNING, TRAIT_INSPIRING"],"id":"BONUS_EVENTOPTION_CHILD_NO_SIGNS_OF_LIFE_OPTION_0_CHARACTER","pct":null,"weight":null}],"gates":[]},"requirements":[],"text":"We summon our strength and move on."},{"outcomes":[{"rewards":[{"text":"Gain trait: Mourning","tip":["As leader: -10% Orders"],"tipTitle":"Mourning — trait"},{"text":"Gain trait: Compassionate","tip":["+1 Charisma","+20 opinion with same-trait characters"],"tipTitle":"Compassionate — trait"}]}],"raw":{"bonuses":[{"fields":["aeAddTraits: TRAIT_MOURNING, TRAIT_COMPASSIONATE"],"id":"BONUS_EVENTOPTION_CHILD_NO_SIGNS_OF_LIFE_OPTION_1_CHARACTER","pct":null,"weight":null}],"gates":[]},"requirements":[],"text":"It is right to pause and reflect on our losses."}],"subjects":["Leader Us","Child Of Leader Us","Spouse Of Leader Us"],"text":"In a tragic turn of events, your newborn, [character], begins to languish. Within hours, he no longer shows signs of life. Servants are able to attend to your needs, but the child's time has passed. The nation mourns your loss.","timing":{"minLeader":2,"repeat":"Once per game"},"weight":2},{"author":"Andy Auseon","conditions":["Child","Not Blessed"],"guaranteed":[{"text":"Gain trait: Mourning","tip":["As leader: -10% Orders"],"tipTitle":"Mourning — trait"}],"id":"EVENTSTORY_DEATH_STRICKEN_DOWN","name":"Stricken Down","options":[{"outcomes":[{"rewards":[{"base":20,"per":5,"text":"+20 Science (+5/city)","yield":"science"}]}],"raw":{"bonuses":[{"fields":["aiGlobalYieldsBase: YIELD_SCIENCE=20","aiGlobalYieldsPer: YIELD_SCIENCE=5"],"id":"BONUS_SCIENCE_GAIN_SMALL","pct":null,"weight":null}],"gates":[]},"requirements":[],"text":"Scientists will work for a cure so no others must die."}