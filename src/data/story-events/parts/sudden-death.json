{"category":{"count":15,"kind":"class","label":"Sudden Death","parts":[{"count":15,"first":"A Long Fall","last":"Where Lightning Strikes","slug":"sudden-death"}],"schedule":{"levelProb":3,"minRepeat":60,"minTurns":20},"slug":"sudden-death","token":"EVENTCLASS_SUDDEN_DEATH"},"events":[{"author":"Andy Auseon","conditions":["Child","Not Blessed"],"guaranteed":[{"text":"Gain trait: Mourning","tip":["As leader: -10% Orders"],"tipTitle":"Mourning — trait"}],"id":"EVENTSTORY_DEATH_A_LONG_FALL","name":"A Long Fall","options":[{"outcomes":[{"rewards":[{"base":60,"per":15,"text":"+60 Civics (+15/city)","yield":"civics"}]}],"raw":{"bonuses":[{"fields":["aiGlobalYieldsBase: YIELD_CIVICS=60","aiGlobalYieldsPer: YIELD_CIVICS=15"],"id":"BONUS_CIVICS_GAIN_AVERAGE","pct":null,"weight":null}],"gates":[]},"requirements":[],"text":"A statue in the palace garden."},{"outcomes":[{"rewards":[{"eachCity":80,"text":"+80 Happiness (each city)","yield":"happiness"}]}],"raw":{"bonuses":[{"fields":["aiCityYields: YIELD_HAPPINESS=80"],"id":"BONUS_HAPPINESS_GAIN_AVERAGE","pct":null,"weight":null}],"gates":[]},"requirements":[],"text":"A public funeral procession."}],"subjects":["Leader Us","Child Of Leader Us"],"text":"Palace servants bring terrible news! Your son [character] was climbing the fruit trees along the high wall when he lost his balance and fell. He was killed instantly. How will you celebrate the life of precious [character]?","timing":{"repeat":"Once per game"},"weight":1},{"author":"Andy Auseon","conditions":["Teenager","Not Blessed"],"id":"EVENTSTORY_DEATH_ACT_OF_MALICE","name":"Act of Malice","options":[{"outcomes":[{"rewards":[{"text":"Gain trait: Mourning","tip":["As leader: -10% Orders"],"tipTitle":"Mourning — trait"},{"text":"+1 Discipline"}]}],"raw":{"bonuses":[{"fields":["aeAddTraits: TRAIT_MOURNING","aeBonuses: BONUS_GAIN_DISCIPLINE_1"],"id":"BONUS_EVENTOPTION_DEATH_ACT_OF_MALICE_OPTION_0_CHARACTER","pct":null,"weight":null}],"gates":[]},"requirements":[],"text":"We should