{"category":{"count":10,"kind":"trigger","label":"Occurrence Ready","parts":[{"count":10,"first":"A Feeling On the Wind","last":"Tinderbox","slug":"on-occurrence-ready"}],"slug":"on-occurrence-ready","token":"EVENTTRIGGER_OCCURRENCE_READY"},"events":[{"author":"Jeri Roys","conditions":["Sandstorm"],"id":"EVENTSTORY_CALAMITIES_A_FEELING_ON_THE_WIND","name":"A Feeling On the Wind","options":[{"outcomes":[{"rewards":[{"base":-30,"per":-10,"text":"-30 Food (-10/city)","yield":"food"},{"base":-20,"per":-5,"text":"-20 Wood (-5/city)","yield":"wood"}]}],"raw":{"bonuses":[{"fields":["aiGlobalYieldsBase: YIELD_FOOD=-30","aiGlobalYieldsPer: YIELD_FOOD=-10"],"id":"BONUS_FOOD_LOSS_SMALL","pct":null,"weight":null},{"fields":["aiGlobalYieldsBase: YIELD_WOOD=-20","aiGlobalYieldsPer: YIELD_WOOD=-5"],"id":"BONUS_WOOD_LOSS_TINY","pct":null,"weight":null}],"gates":[]},"requirements":[],"text":"If the weather turns harsher still, we shall have stockpiles and shelters prepared."},{"outcomes":[{"rewards":[{"text":"+40 XP to the character"}]}],"raw":{"bonuses":[{"fields":["iOccurrenceTargetSubject 0","bOccurrenceSetPending 1"],"id":"BONUS_OCCURRENCE_SET_PENDING_S0","pct":null,"weight":null},{"fields":["iXPCharacter 40"],"id":"BONUS_XP_CHARACTER_AVERAGE","pct":null,"weight":null}],"gates":[]},"requirements":[],"text":"Reaction is demanded by crises, not by inauspicious gusts."}],"pack":"Wrath of Gods","prob":60,"subjects":["Tile Claimed Us","Occurrence","City Us","Player Us","Leader Us"],"text":"The dry season in [city] is harsh this year, and winds tear at the desiccated fields. Locals are uneasy that this portends worse yet to come.","timing":{"repeat":"Every 40 turns"},"trigger":"Occurrence Ready","weight":1},{"author":"Jeri Roys","conditions":["Flood"],"id":"EVENTSTORY_CALAMITIES_HIGH_WATER","name":"High Water","options":[{"outcomes":[{"rewards":[{"base":-120,"per":-30,"text":"-120 Money (-30/city)","yield":"money"},{"base":-30,"per":-10,"text":"-30 Stone (-10/city)","yield":"stone"}]}