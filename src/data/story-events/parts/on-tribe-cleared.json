ION"],"id":"BONUS_EVENTOPTION_PRISONERS_OF_WAR_EXECUTE_BARBARIAN","pct":null,"weight":null},{"fields":["aeAddTraits: TRAIT_VIGILANT"],"id":"BONUS_GIVE_TRAIT_VIGILANT","pct":null,"weight":null}],"gates":[]},"requirements":[],"text":"We must be prudent. Execute the prisoners."},{"outcomes":[{"rewards":[{"eachCity":20,"text":"+20 Discontent (each city)","yield":"discontent"}]}],"raw":{"bonuses":[{"fields":["aeBonuses: BONUS_ADD_CITIZEN_1, BONUS_DISCONTENT_GAIN_MINIMAL"],"id":"BONUS_EVENTOPTION_PRISONERS_OF_WAR_OPTION_1","pct":null,"weight":null}],"gates":[]},"requirements":[],"text":"If they are laborers, they will labor for us."}],"subjects":["Tribe","Leader Us","Tile","City Us"],"text":"As they loot the [tribe] camp, our soldiers free a group of terrified prisoners. These ragged men claim to be skilled laborers from a rival tribe, but our units suspect that they are enemies posing as captives. What shall we do?","timing":{"repeat":"Every 40 turns"},"trigger":"Tribe Cleared","weight":1},{"author":"Andy Auseon","conditions":["Male"],"id":"EVENTSTORY_TRIBE_REBEL_GLADIATORS","name":"Rebel Gladiators","options":[{"outcomes":[{"rewards":[{"text":"+1 Charisma"},{"text":"+1 Heavy Infantry unit"}]}],"raw":{"bonuses":[{"fields":["aiRatings: RATING_CHARISMA=1"],"id":"BONUS_GAIN_CHARISMA_1","pct":null,"weight":null},{"fields":["aiBonusUnits: BONUSUNITCLASS_HEAVY_INFANTRY=1"],"id":"BONUS_UNITCLASS_HEAVY_INFANTRY","pct":null,"weight":null}],"gates":[]},"requirements":[],"text":"Very well. Your swords are ours."},{"outcomes":[{"rewards":[{"text":"+2 Legitimacy"}]}],"raw":{"bonuses":[{"fields":["iCitizens 2","iBorderGrowth 4","iLegitimacy 2"],"id":"BONUS_EVENTOPTION_TRIBE_REBEL_GLADIATORS_OPTION_1","pct":null,"weight":null}],"gates":[]},"requirements":[],"text":"You are more valuable to us as labor."},{"outcomes":[{"rewards":[{"text":"+1 Wisdom"},{"text":"Gain a Court Soldier"}]}],"raw":{"bonuses":[{"fields":["aiRatings: RATING_WISDOM=1"],"id":"BONUS_GAIN_WISDOM_1","pct":null,"weight":null},{"fields":["MakeCourtier COURTIER_SOLDIER"],"id":"BONUS_MAKE_GREAT_SOLDIER","pct":null,"weight":null}],"gates":[]},"requirements":[],"text":"Such leadership should not be wasted."}],"subjects":["Tribe","Leader Us","Tribal Courtier","Tile","City Us"],"text":"The core of the defeated [tribe] forces is made up of escaped gladiators, highly trained slaves and former soldiers. [character] is the gladiators' leader, and while vulgar, he knows power when he sees it. He bows to the throne. \"Let us fight for you.\"","timing":{"repeat":"Once per game"},"trigger":"Tribe Cleared","weight":4},{"author":"Andy Auseon","conditions":["Max 2 Strengths"],"id":"EVENTSTORY_SAVAGE_PLAGUE","name":"Savage Plague","options":[{"outcomes":[{"rewards":[{"base":160,"per":40,"text":"+160 Money (+40/city)","yield":"money"},{"base":20,"per":5,"text":"+20 Wood (+5/city)","yield":"wood"},{"base":30,"per":10,"text":"+30 Food (+10/city)","yield":"food"}]}],"raw":{"bonuses":[{"fields":["aeBonuses: BONUS_MONEY_GAIN_AVERAGE, BONUS_WOOD_GAIN_TINY, BONUS_FOOD_GAIN_SMALL"],"id":"BONUS_EVENTOPTION_SAVAGE_PLAGUE_OPTION_0","pct":null,"weight":null},{"fields":["aiTraitProbDelay: TRAIT_ILL=50"],"id":"BONUS_EVENTOPTION_SAVAGE_PLAGUE_OPTION_0_CHARACTER_2","pct":null,"weight":null}],"gates":[]},"requirements":[],"text":"They must do their duty and seize the treasures."},{"outcomes":[{"rewards":[{"text":"Leader relationship: Influenced By"},{"text":"Gain trait: Compassionate","tip":["+1 Charisma","+20 opinion with same-trait characters"],"tipTitle":"Compassionate — trait"}]}],"raw":{"bonuses":[{"fields":["AddLeaderRelationship RELATIONSHIP_INFLUENCED_BY"],"id":"BONUS_LEADER_INFLUENCED_BY","pct":null,"weight":null},{"fields":["aeAddTraits: TRAIT_COMPASSIONATE"],"id":"BONUS_GIVE_TRAIT_COMPASSIONATE","pct":null,"weight":null}],"gates":[]},"requirements":[],"text":"The health of our soldiers is top priority."}],"subjects":["Tribe","Unit Us","Us","Leader Us","Tile"],"text":"Within days of your victory at the [tribe] encampment, your units begin succumbing to a mysterious ailment. The general, [character], wishes to abandon the battlefield and return to the capital as quickly as possible, abandoning the spoils.","timing":{"minTurns":30,"repeat":"Once per game"},"trigger":"Tribe Cleared","weight":2},{"author":"Andy Auseon","id":"EVENTSTORY_TRIBE_SECRET_ALLIANCES","name":"Secret Alliances","options":[{"outcomes":[{"rewards":[{"text":"Gain trait: Vigilant","tip":["+1 Discipline","+20 opinion with same-trait characters"],"tipTitle":"Vigilant — trait"},{"text":"Opinion memory (leader of you)"}]}],"raw":{"bonuses":[{"fields":["aeAddTraits: TRAIT_VIGILANT"],"id":"BONUS_GIVE_TRAIT_VIGILANT","pct":null,"weight":null},{"fields":["MemoryLeader MEMORYCHARACTER_WARNED_TO_STOP"],"id":"BONUS_EVENTOPTION_TRIBE_SECRET_ALLIANCES_OPTION_0_PLAYER","pct":null,"weight":null}],"gates":[]},"requirements":[],"text":"Warn [rival] to be careful with whom they ally."},{"outcomes":[{"rewards":[{"text":"+6 Legitimacy"},{"text":"Opinion memory"},{"text":"Opinion memory"}]}],"raw":{"bonuses":[{"fields":["iLegitimacy 6"],"id":"BONUS_EVENTOPTION_TRIBE_SECRET_ALLIANCES_OPTION_1","pct":null,"weight":null},{"fields":["Memory MEMORYPLAYER_DECLARED_WAR","DiplomacyPlayerFrom DIPLOMACY_WAR","aeBonuses: BONUS_PLAYER_OFFER"],"id":"BONUS_DECLARE_WAR_PLAYER","pct":null,"weight":null}],"gates":[]},"requirements":[],"text":"Declare war on [rival] for its expansionism."},{"outcomes":[{"rewards":[{"text":"Opinion memory (leader of you)"}]}],"raw":{"bonuses":[{"fields":["MemoryLeader MEMORYCHARACTER_AVOIDED_WAR"],"id":"BONUS_EVENTOPTION_TRIBE_SECRET_ALLIANCES_OPTION_2","pct":null,"weight":null}],"gates":[]},"requirements":[],"text":"Ignore the connection. It means nothing."}],"subjects":["Tile","Tribe War","Leader Us","Player Them"],"text":"There is evidence in the barbarian camp of an ongoing relationship between the [tribe] and the more civilized [rival]. Our advisors fear the worst. One must tread carefully...","timing