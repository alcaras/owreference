":[{"fields":["aiRatings: RATING_DISCIPLINE=1"],"id":"BONUS_GAIN_DISCIPLINE_1","pct":null,"weight":null}],"gates":[]},"requirements":[],"text":"Put the miserable creature out of its misery."}],"subjects":["Tribe Dead","Leader Us","Player Us"],"text":"You visit the site of the [tribe]’ last stand. As you walk among the ruins and the bodies of the fallen, you notice a ragged hound, head down and tail between its legs, slinking after you from a distance, stopping when you stop, starting when you start. The dog appears hungry but otherwise healthy. How shall we deal with the stray?","timing":{"repeat":"Once per game"},"trigger":"Tribe Eliminated","weight":1},{"author":"Brodie Frehlich","conditions":["Family Statesmen","Max Upset","City Family Seat"],"guaranteed":[{"text":"+6 Legitimacy"}],"id":"EVENTSTORY_TRIBE_ELIMINATED_POST_WAR","name":"Post War","options":[{"outcomes":[{"rewards":[{"text":"-1 Charisma"},{"text":"+1 Courage"}]}],"raw":{"bonuses":[{"fields":["aiRatings: RATING_CHARISMA=-1, RATING_COURAGE=1"],"id":"BONUS_EVENTOPTION_TRIBE_ELIMINATED_POST_WAR_OPTION_THREATEN_LEADER","pct":null,"weight":null}],"gates":[]},"requirements":[],"text":"Threaten [character] with retaliatory indictments."},{"outcomes":[{"rewards":[{"text":"Opinion memory (all families)"}]}],"raw":{"bonuses":[{"fields":["MemoryAllFamilies MEMORYFAMILY_BLAMED_FOR_LAWS","StartLaw LAW_TYRANNY"],"id":"BONUS_EVENTOPTION_TRIBE_ELIMINATED_POST_WAR_OPTION_TYRANNY_LEADER","pct":null,"weight":null}],"gates":[]},"requirements":[],"text":"I have no time for this. My word shall become law."},{"outcomes":[{"rewards":[{"text":"Opinion memory"},{"text":"Gain trait: Imprisoned","tip":["-100 base opinion of this character","Cannot hold a job"],"tipTitle":"Imprisoned — trait"},{"text":"-1 Discipline"}]}],"raw":{"bonuses":[{"fields":["Memory MEMORYFAMILY_IMPRISONED_MEMBER"],"id":"BONUS_EVENTOPTION_TRIBE_ELIMINATED_POST_WAR_OPTION_IMPRISON_FAMILY","pct":null,"weight":null},{"fields":["aeAddTraits: TRAIT_IMPRISONED"]