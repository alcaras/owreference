            "outcomes": [
              "+1 Charisma",
              "-3 Orders (scales)",
              "+1 Discipline"
            ],
            "removes": false,
            "text": "I will work with my friend {CHARACTER-SHORT-1} to find the funds elsewhere in {CITY-2}’s budget."
