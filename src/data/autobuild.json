        "options": [
          {
            "eventLink": "",
            "grants": true,
            "outcomes": [
              "family remembers it",
              "grants Autonomous Rule"
            ],
            "removes": false,
            "text": "The crown relinquishes our control of the city."
          },
          {
            "eventLink": "",
            "grants": false,
            "outcomes": [
              "+80 Discontent in the city",
              "+1 Discipline"
            ],
            "removes": false,
            "text": "We cannot risk the {FAMILY-0,1} gaining more power."
          }
        ],
        "prob": 0,
        "repeatTurns": -1,
        "requires": [
          "SUBJECT_FAMILY_MAX_FURIOUS"
        ],
        "role": "grant",
        "text": "Followers of the {FAMILY-0} Family have taken to the streets of {CITY-1} in the hundreds, protesting against collapsing roads and poor supplies in the city. Your advisers suspect that this is the result of a concentrated propaganda effort by the {FAMILY-0,1} to weaken your hold in the city.\n\nIt would be a bold move, but they suggest that giving the family completely autonomous rule of the city could go a long way to repairing relations with them.\n\nShall the {FAMILY-0,1} rule {CITY-1} alone?",
        "title": "Demand for Autonomy",
        "trigger": "",
        "url": ""
      },
      {
        "author": "Josh Unsworth",
        "dlc": "",
        "eventLinkPrereq": "",
        "eventLinkTurns": 0,
        "excludes": [
          "SUBJECT_CAPITAL_US",
          "SUBJECT_CITY_FAMILY_SEAT"
