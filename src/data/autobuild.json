        "id": "EVENTSTORY_CITY_AUTONOMY",
        "options": [
          {
            "eventLink": "EVENTLINK_CITY_ZENOBIA_AUTONOMY",
            "grants": true,
            "outcomes": [
              "grants Autonomous Rule",
              "becomes the city's Governor"
            ],
            "removes": false,
            "text": "Let them rule over themselves as long as they pay their taxes."
          },
          {
            "eventLink": "",
            "grants": false,
            "outcomes": [
              "-1 Happiness level"
            ],
            "removes": false,
            "text": "Never! Find a noble, {PLAYER-2,1} husband for {CHARACTER-SHORT-1}."
          }
        ],
        "prob": 0,
        "repeatTurns": -1,
        "requires": [],
        "role": "grant",
        "text": "The city of {CITY-0} would like to establish autonomy and rule itself independently from {PLAYER-2}. A prominent figure, named {CHARACTER-SHORT-1}, would like to reign over the city as its Governor.",
        "title": "Autonomy in {CITY-0}",
        "trigger": "",
        "url": "https://en.wikipedia.org/wiki/Zenobia"
      },
      {
