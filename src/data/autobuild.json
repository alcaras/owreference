          {
            "eventLink": "",
            "grants": false,
            "outcomes": [
              "3 rebel units spawn"
            ],
            "removes": false,
            "text": "Refuse to indulge the rabble."
          },
          {
            "eventLink": "",
            "grants": true,
            "outcomes": [
              "grants Autonomous Rule",
              "+1 Happiness level"
            ],
            "removes": false,
            "text": "Very well, let them rule themselves."
          },
          {
            "eventLink": "",
            "grants": false,
            "outcomes": [
              "+1 Happiness level"
            ],
            "removes": false,
            "text": "The people know my reign is ordained by the heavens, no usurpers will sway them."
          }
        ],
        "prob": 0,
        "repeatTurns": -1,
        "requires": [
          "SUBJECT_CITY_DISCONTENT_MODERATE"
        ],
        "role": "grant",
        "text": "Amidst growing discontent, the people of {CITY-0} have been becoming increasingly organized in their resistance to your rule. Headed by an elected council of elders, they have trained an independent militia and live by their own laws.\n\nA message has arrived from this council, asking that you recognize the city's independence. They promise to continue to swear fealty and to pay taxes, but beyond that the city will be out of your hands.",
        "title": "Independent City",
        "trigger": "",
        "url": ""
      },
