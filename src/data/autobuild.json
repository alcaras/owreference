        ],
        "role": "grant",
        "text": "Your vassals are happy under your rule, the {FAMILY-0} Family especially adapting to their role. Feeling favored above all others, they are loyal and eager to serve.\n\nHowever, this is tested when {CHARACTER-1} comes to you and asks for autonomous rule of {CITY-2}, citing an unexpected loophole in the laws that leaves the city under their command rather than the crown's.\n\nShould such independence be allowed?",
        "title": "Autonomous Vassal",
        "trigger": "",
        "url": ""
      },
      {
        "author": "Leyla Johnson",
        "dlc": "",
        "eventLinkPrereq": "",
        "eventLinkTurns": 0,
        "excludes": [
          "SUBJECT_CAPITAL_US",
          "SUBJECT_CITY_FAMILY_SEAT"
