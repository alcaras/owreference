---
import '../styles/theme.css';
import '../styles/nation-tokens.css';
import patch from '../../data/patch.json';

interface Props {
  title: string;
  active?: string;
  pageStats?: { label: string; value: string | number }[];
  pageMark?: string;
}
const { title, active, pageStats, pageMark } = Astro.props;
const base = import.meta.env.BASE_URL;

const nav = [
  { href: '',           label: 'Index' },
  { href: 'nations',    label: 'Nations' },
  { href: 'families',   label: 'Families' },
  { href: 'technologies', label: 'Techs' },
  { href: 'unit-damage', label: 'Units' },
  { href: 'laws',       label: 'Laws' },
  { href: 'yields/orders', label: 'Yields' },
  { href: 'shrines',    label: 'Shrines' },
];

const syncedDate = new Date(patch.syncedAt);
const syncedLabel = syncedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Old World Reference</title>
    <meta name="description" content="Dark-mode reference for Old World — auto-updated each patch from the game's own files." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="hdr">
      <div class="hdr__inner">
        <a class="hdr__brand" href={base}>
          <span class="hdr__mark">⚜</span>
          <span class="hdr__title">Old World</span>
          <span class="hdr__sub">Reference</span>
        </a>
        <nav class="hdr__nav">
          {nav.map(n => (
            <a
              href={`${base}${n.href}`}
              class={`hdr__navlink ${active === n.label.toLowerCase() ? 'is-active' : ''}`}
            >{n.label}</a>
          ))}
        </nav>
        <label class="hdr__search">
          <span class="hdr__search-ico">⌕</span>
          <input
            id="site-search"
            type="search"
            placeholder="Search nations, yields, techs…"
            autocomplete="off"
            spellcheck={false}
          />
          <kbd>⌘K</kbd>
        </label>
      </div>
    </header>

    <main class="main">
      {pageStats && (
        <div class="page-meta">
          <h1 class="page-title">
            {pageMark && <span class="page-title__mark">{pageMark}</span>}
            {title}
          </h1>
          <div class="page-stats">
            {pageStats.map(s => (
              <span class="stat"><b>{s.value}</b> {s.label}</span>
            ))}
          </div>
        </div>
      )}

      <slot />

      <footer class="foot">
        <div class="foot__col">
          <span class="foot__label">Patch</span>
          <span class="foot__val">{patch.version}</span>
          <span class="foot__dot">·</span>
          <span class="foot__val foot__val--dim">synced {syncedLabel}</span>
          <span class="foot__dot">·</span>
          <span class="foot__val foot__val--dim">auto-built from game files</span>
        </div>
        <div class="foot__col foot__col--right">
          <a href={`${base}CHANGELOG.md`}>Changelog</a>
          <span class="foot__dot">·</span>
          <a href="https://github.com/alcaras/owreference">Source</a>
          <span class="foot__dot">·</span>
          <a href="https://mohawkgames.com/oldworld/" rel="noopener" target="_blank">Old World</a>
        </div>
      </footer>
    </main>

    <script is:inline>
      // ⌘K / Ctrl+K focuses the global search.
      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          const input = document.getElementById('site-search');
          if (input) {
            e.preventDefault();
            input.focus();
            input.select();
          }
        }
      });
    </script>
  </body>
</html>
