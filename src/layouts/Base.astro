---
import '../styles/theme.css';
import '../styles/nation-tokens.css';
import patch from '../../data/patch.json';
import { TABS, SECTIONS } from '../data/tabs';
import FloatingHeader from '../components/FloatingHeader.astro';

interface Props {
  title: string;
  active?: string;
  pageStats?: { label: string; value: string | number }[];
  // Opt in to a per-page row filter. The header box is global search only
  // (b31cb35 retired the header-driven row filter on purpose), so pages that
  // want to narrow their own tables get their own input, with a stable
  // #page-filter id for the page's handler to hook. Pass a string to override
  // the placeholder.
  pageFilter?: boolean | string;
  pageMark?: string;
  // Editorial eyebrow line above the page title (small caps, gold).
  eyebrow?: string;
  description?: string;
  ogImage?: string;
}
const { title, active, pageStats, pageMark, eyebrow, description, ogImage, pageFilter } = Astro.props;
const filterPlaceholder = typeof pageFilter === 'string' ? pageFilter : 'Filter this page…';
const base = import.meta.env.BASE_URL;

const SITE_NAME = "Old World Reference";
const SITE_TAGLINE = "the alcaras spreadsheet, in your browser";
const DEFAULT_DESC =
  "Complete reference for Mohawk Games' Old World — every nation, family, shrine, wonder, tech, law, unit, promotion, and game mechanic, pulled directly from the game's XML and source code and updated each patch.";

const pageDesc = description || DEFAULT_DESC;
const fullTitle = `${title} · ${SITE_NAME}`;

// Build canonical URL from Astro.url + base. Falls back gracefully in dev.
const siteOrigin = Astro.site?.origin || 'https://alcaras.github.io';
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href;
const ogImageUrl = ogImage
  ? new URL(base + ogImage, siteOrigin).href
  : new URL(base + 'img/crests/rome.png', siteOrigin).href;  // sensible fallback crest

// Header nav and the home-page catalog share ONE source of truth: every
// tabs.ts entry with status 'built', grouped by section. The header renders
// sections as dropdowns so all pages stay reachable without a link soup.
const navSections = SECTIONS
  .map(section => ({
    section,
    items: TABS.filter(t => t.section === section && t.status === 'built'),
  }))
  .filter(s => s.items.length > 0);
const activeSection = navSections.find(s => s.items.some(t => t.slug === active))?.section;

const syncedDate = new Date(patch.syncedAt);
const syncedLabel = syncedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
const buildLabel = (patch as any).buildId || patch.version;
const updatedAt = (patch as any).updatedAt;
const updatedLabel = updatedAt
  ? new Date(updatedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
  : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicon: the Old World royal crown (the Legitimacy mark, our logo) -->
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16x16.png`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <meta name="theme-color" content="#0e0f12" />

    <!-- Open Graph (Discord, Slack, Facebook, LinkedIn unfurls) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="keywords" content="Old World, Mohawk Games, 4X strategy, game reference, nations, families, technologies, wonders, laws, units, promotions, shrines, Old World wiki" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="hdr">
      <div class="hdr__inner">
        <a class="hdr__brand" href={base}>
          <span class="hdr__mark" aria-hidden="true">
            <img src={`${base}img/icons/yields/legitimacy.png`} alt="" />
          </span>
          <span class="hdr__title-wrap">
            <span class="hdr__sub">Old World</span>
            <span class="hdr__title">Reference</span>
          </span>
        </a>
        <nav class="hdr__nav" aria-label="Site sections">
          {navSections.map(({ section, items }) => (
            items.length === 1 ? (
              <a
                href={`${base}${items[0].slug}`}
                class={`hdr__navlink ${active === items[0].slug ? 'is-active' : ''}`}
              >{items[0].label}</a>
            ) : (
            <details class="hdr__menu" data-section={section}>
              <summary class={`hdr__navlink ${activeSection === section ? 'is-active' : ''}`}>
                {section}<span class="hdr__caret" aria-hidden="true">▾</span>
              </summary>
              <div class="hdr__panel">
                {items.map(t => (
                  <a
                    href={`${base}${t.slug}`}
                    class={`hdr__panellink ${active === t.slug ? 'is-active' : ''}`}
                  >
                    <span class="hdr__panelicon" aria-hidden="true">{t.icon}</span>
                    {t.label}
                  </a>
                ))}
              </div>
            </details>
            )
          ))}
        </nav>
        <script is:inline>
          // Only one header menu open at a time; close on outside click / Esc.
          document.addEventListener('click', (e) => {
            const open = document.querySelectorAll('details.hdr__menu[open]');
            for (const d of open) {
              if (!d.contains(e.target)) d.removeAttribute('open');
            }
            const hit = e.target.closest?.('details.hdr__menu');
            if (hit) {
              for (const d of open) if (d !== hit) d.removeAttribute('open');
            }
          });
          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
              document.querySelectorAll('details.hdr__menu[open]')
                .forEach(d => d.removeAttribute('open'));
            }
          });
          // Panels are left-anchored; flip the ones near the right edge so they
          // don't spill off-screen. `toggle` doesn't bubble — listen in capture.
          document.addEventListener('toggle', (e) => {
            const d = e.target;
            if (!d.classList?.contains('hdr__menu') || !d.open) return;
            const panel = d.querySelector('.hdr__panel');
            if (!panel) return;
            panel.classList.remove('is-right');
            if (panel.getBoundingClientRect().right > window.innerWidth - 8) {
              panel.classList.add('is-right');
            }
          }, true);
        </script>
        <details class="hdr__mobilemenu">
          <summary class="hdr__navlink">Menu<span class="hdr__caret" aria-hidden="true">▾</span></summary>
          <nav class="hdr__mobilepanel" aria-label="All pages">
            {navSections.map(({ section, items }) => (
              <div class="hdr__mgroup">
                {/* Single-page sections (Wonders, Laws, Ambitions) are their own
                    label — don't repeat it above the one link. */}
                {items.length > 1 && <div class="hdr__mgroup-label">{section}</div>}
                {items.map(t => (
                  <a
                    href={`${base}${t.slug}`}
                    class={`hdr__panellink ${active === t.slug ? 'is-active' : ''}`}
                  >
                    <span class="hdr__panelicon" aria-hidden="true">{t.icon}</span>
                    {t.label}
                  </a>
                ))}
              </div>
            ))}
          </nav>
        </details>
        <span class="hdr__spacer" aria-hidden="true"></span>
        <label class="hdr__search">
          <span class="hdr__search-ico" aria-hidden="true">⌕</span>
          <input
            id="global-search"
            type="search"
            placeholder="Search…"
            aria-label="Search the whole site"
            autocomplete="off"
          />
          <kbd>/</kbd>
          <div id="site-search-results" class="hdr__sresults" hidden></div>
        </label>
        <script is:inline define:vars={{ base }}>
          // "/" focuses the search (unless already typing somewhere)
          document.addEventListener('keydown', (e) => {
            if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
            const t = e.target;
            if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
            const s = document.getElementById('global-search');
            if (s) { e.preventDefault(); s.focus(); }
          });

          // Site-wide search (same approach as the streamer panel's): a light
          // index of pages + entities + events, lazy-fetched on first focus.
          // Search only — the old per-page row filtering is retired (the id
          // rename orphans those pages' null-guarded hooks); Ctrl-F covers
          // in-page text hunting.
          (() => {
            const input = document.getElementById('global-search');
            const panel = document.getElementById('site-search-results');
            if (!input || !panel) return;
            let idx = null, sel = -1, rows = [];

            function load() {
              if (idx) return;
              idx = [];
              fetch(`${base}data/search-index.json`)
                .then((r) => r.json())
                .then((d) => { idx = d; update(); })
                .catch(() => {});
            }

            const escapeHtml = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');

            function update() {
              const q = input.value.trim().toLowerCase();
              sel = -1;
              if (!q || !idx || !idx.length) { panel.hidden = true; return; }
              const starts = [], words = [], contains = [];
              for (const e of idx) {
                const n = e.n.toLowerCase();
                if (n.startsWith(q)) starts.push(e);
                else if (n.includes(q)) (n.includes(' ' + q) ? words : contains).push(e);
                else if (e.a && e.a.includes(q)) contains.push(e);
                if (starts.length > 40) break;
              }
              // shortest name first within each tier — "Hoplite" beats
              // "Hoplite Bonus" for the query "hopl"
              const byLen = (a, b) => a.n.length - b.n.length;
              rows = starts.sort(byLen).concat(words.sort(byLen), contains.sort(byLen)).slice(0, 10);
              if (!rows.length) { panel.hidden = true; return; }
              panel.innerHTML = rows.map((e, i) => `
                <a class="hdr__sres${i === sel ? ' is-sel' : ''}" href="${base}${e.u}">
                  ${e.c ? `<img src="${base}${e.c}" alt="" loading="lazy" />` : '<span class="hdr__sres-blank"></span>'}
                  <span class="hdr__sres-txt"><b>${escapeHtml(e.n)}</b><i>${escapeHtml(e.g ? `${e.t} · ${e.g}` : e.t)}</i></span>
                </a>`).join('');
              panel.hidden = false;
            }

            input.addEventListener('focus', load);
            input.addEventListener('input', update);
            input.addEventListener('keydown', (e) => {
              if (panel.hidden) return;
              if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
                e.preventDefault();
                sel = (sel + (e.key === 'ArrowDown' ? 1 : -1) + rows.length) % rows.length;
                panel.querySelectorAll('.hdr__sres').forEach((el, i) =>
                  el.classList.toggle('is-sel', i === sel));
              } else if (e.key === 'Enter' && rows.length) {
                e.preventDefault();
                location.href = `${base}${rows[sel >= 0 ? sel : 0].u}`;
              } else if (e.key === 'Escape') {
                panel.hidden = true;
              }
            });
            document.addEventListener('click', (e) => {
              if (!panel.contains(e.target) && e.target !== input) panel.hidden = true;
            });
          })();
        </script>
      </div>
    </header>

    <main class="main">
      {(pageStats || pageFilter) && (
        <div class="page-meta">
          <div>
            {eyebrow && <div class="page-eyebrow">{eyebrow}</div>}
            <h1 class="page-title">
              {pageMark && <span class="page-title__mark">{pageMark}</span>}
              {title}
            </h1>
          </div>
          <div class="page-meta__right">
            {pageFilter && (
              <label class="page-filter">
                <span class="page-filter__ico" aria-hidden="true">⌕</span>
                <input id="page-filter" type="search" autocomplete="off" spellcheck="false"
                  placeholder={filterPlaceholder} aria-label={filterPlaceholder} />
              </label>
            )}
            {pageStats && (
              <div class="page-stats">
                {pageStats.map(s => (
                  <span class="stat"><b>{s.value}</b> {s.label}</span>
                ))}
              </div>
            )}
          </div>
        </div>
      )}

      <slot />

      <FloatingHeader />

      <footer class="foot">
        <div class="foot__col">
          <span class="foot__label">Build</span>
          <span class="foot__val">{buildLabel}</span>
          {updatedLabel && (
            <>
              <span class="foot__dot">·</span>
              <span class="foot__val foot__val--dim">game updated {updatedLabel}</span>
            </>
          )}
          <span class="foot__dot">·</span>
          <span class="foot__val foot__val--dim">synced {syncedLabel}</span>
        </div>
        <div class="foot__col foot__col--right">
          <a href="https://github.com/alcaras/owreference/blob/main/CHANGELOG.md">Changelog</a>
          <span class="foot__dot">·</span>
          <a href="https://github.com/alcaras/owreference">Source</a>
          <span class="foot__dot">·</span>
          <a href="https://mohawkgames.com/oldworld/" rel="noopener" target="_blank">Old World</a>
        </div>
      </footer>
    </main>

  </body>
</html>
