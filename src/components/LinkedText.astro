---
// Auto-links every known entity alias inside a free-text string.
import { linkify } from '../lib/entities';
import Term from './Term.astro';

interface Props {
  text: string;
  showIcons?: boolean;
  // If true, replace yield/concept aliases ("Sci", "Cult", "Civ", "Orders"…)
  // with just their icon (label tooltip preserved). Mirrors the game's UI
  // which shows the yield glyph rather than spelling out the yield name.
  // Other entity types (nations, units, techs…) still render as text+icon
  // since their names are not directly representable by a single glyph.
  iconsForYields?: boolean;
}

const { text, showIcons = true, iconsForYields = false } = Astro.props;
const segments = linkify(text || '');

function shouldIconize(seg: typeof segments[number]): boolean {
  if (!iconsForYields) return false;
  if (!seg.entity) return false;
  if (!seg.entity.icon) return false;
  return ['yield', 'concept', 'improvement'].includes(seg.entity.type);
}

// Tighten the rendering to match in-game style: the game writes "2🌾" not
// "+2 Food". When iconsForYields is on, we apply two text passes between
// segments:
//   1. Strip a leading "+" immediately before an iconized yield/improvement.
//      "+2 " before a yield-icon → "2 " (negatives keep their sign).
//   2. Drop the comma between two iconized values that the spreadsheet
//      separates: "+2 Civics, +1 Order/Wonder" already reduces to
//      "2 [civ] 1 [order]/[wonder]" — leave the slash alone, drop the
//      ", " between adjacent iconized chunks.
function processedSegments() {
  if (!iconsForYields) return segments;
  const out: typeof segments = [];
  for (let i = 0; i < segments.length; i++) {
    let s = segments[i];
    const nextIconized = shouldIconize(segments[i + 1] || { text: '', entity: undefined } as any);
    if (nextIconized && !s.entity) {
      // Drop a leading "+" only when it directly precedes an iconized yield;
      // also collapse a ", " separator into a single space.
      let t = s.text;
      // ", " before an iconized yield → " "
      t = t.replace(/,\s+\+?(?=$)/, ' ');
      // "+" at the start of a trailing number-then-space → number-then-space
      t = t.replace(/(^|\s)\+(?=\d)/g, '$1');
      s = { ...s, text: t };
    }
    out.push(s);
  }
  return out;
}
const renderSegs = processedSegments();
---

{renderSegs.map(s => (
  s.entity
    ? <Term entity={s.entity} label={s.text} showIcon={showIcons} iconOnly={shouldIconize(s)} />
    : <Fragment>{s.text}</Fragment>
))}
