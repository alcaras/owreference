---
// Renders a single linked entity reference: optional icon + name → link to its page.
// Use directly for known IDs, or via <LinkedText> for free-text auto-linking.
import type { Entity } from '../lib/entities';
import { getEntity } from '../lib/entities';

interface Props {
  id?: string;
  entity?: Entity;
  label?: string;          // override display label
  showIcon?: boolean;
  iconOnly?: boolean;
}

const { id, entity: passed, label, showIcon = true, iconOnly = false } = Astro.props;
const e: Entity | undefined = passed ?? (id ? getEntity(id) : undefined);
const base = import.meta.env.BASE_URL;

if (!e) {
  // Unknown — render the label or id as plain text
}
---

{e ? (
  <a class={`term term--${e.type}`} href={`${base}${e.page}#${e.slug}`} title={e.name} data-entity-id={e.id}>
    {/* Render the icon when explicitly enabled OR when this is an icon-only
        link (otherwise the link would be empty). */}
    {(showIcon || iconOnly) && e.icon && (
      <img class="term__icon" src={`${base}${e.icon}`} alt={e.name} />
    )}
    {!iconOnly && <span class="term__name">{label ?? e.name}</span>}
  </a>
) : (
  <span class="term term--unknown">{label ?? id ?? ''}</span>
)}

<style>
  .term {
    display: inline-flex;
    align-items: center;
    gap: 0.2em;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px dotted currentColor;
    opacity: 0.95;
  }
  .term:hover {
    opacity: 1;
    border-bottom-style: solid;
  }
  .term__icon {
    width: 1em;
    height: 1em;
    object-fit: contain;
    vertical-align: -0.1em;
    flex-shrink: 0;
  }
  /* Icon-only terms (used for yield mentions inside effect text — "Sci",
     "Cult", etc. → just the yield icon) shouldn't carry the dotted-link
     underline; the icon itself reads as a glyph. */
  .term:has(> .term__icon:only-child) {
    border-bottom: none;
  }
  .term:has(> .term__icon:only-child) .term__icon {
    width: 1.05em;
    height: 1.05em;
    vertical-align: -0.18em;
  }
  .term--nation { font-weight: 600; }
  .term--unknown { border-bottom: none; opacity: 0.7; }
</style>
