---
// Renders a single linked entity reference: optional icon + name → link to its page.
// Use directly for known IDs, or via <LinkedText> for free-text auto-linking.
// While scope is narrowed to the Nations tab, only entity types with a
// real destination page get rendered as <a>; the rest render as <span>
// (icon + tooltip), so clicks don't dead-end on unbuilt pages.
import type { Entity } from '../lib/entities';
import { getEntity } from '../lib/entities';

interface Props {
  id?: string;
  entity?: Entity;
  label?: string;
  showIcon?: boolean;
  iconOnly?: boolean;
}

const { id, entity: passed, label, showIcon = true, iconOnly = false } = Astro.props;
const e: Entity | undefined = passed ?? (id ? getEntity(id) : undefined);
const base = import.meta.env.BASE_URL;

// Every registered entity type now has a built destination page, so all of
// them link (wiki-style). `page` is the section/detail route; Term appends
// `#slug` for deep-linking where the page has per-item anchors (and falls back
// to the page top otherwise). Add new types here as the registry grows.
const NAV_TYPES = new Set([
  'nation', 'family', 'yield', 'tech', 'unit', 'law',
  'resource', 'improvement', 'project', 'promotion',
  'shrine', 'wonder', 'theology', 'tribe', 'archetype', 'trait', 'specialist',
]);
const isLinkable = e && NAV_TYPES.has(e.type) && !!e.page;
// Append the #slug deep-link anchor unless the page IS the item's detail route
// (e.g. nations/aksum) — then the slug is already the page, so no anchor.
const href = e ? `${base}${e.page}${e.page.endsWith('/' + e.slug) ? '' : `#${e.slug}`}` : '';
---

{e ? (
  isLinkable ? (
    <a class={`term term--${e.type}`} href={href} title={e.name} data-entity-id={e.id}>
      {(showIcon || iconOnly) && e.icon && (
        <img class="term__icon" src={`${base}${e.icon}`} alt={e.name} />
      )}
      {!iconOnly && <span class="term__name">{label ?? e.name}</span>}
    </a>
  ) : (
    <span class={`term term--${e.type} term--noref`} title={e.name} data-entity-id={e.id}>
      {(showIcon || iconOnly) && e.icon && (
        <img class="term__icon" src={`${base}${e.icon}`} alt={e.name} />
      )}
      {!iconOnly && <span class="term__name">{label ?? e.name}</span>}
    </span>
  )
) : (
  <span class="term term--unknown">{label ?? id ?? ''}</span>
)}

<style>
  .term {
    display: inline-flex;
    align-items: center;
    gap: 0.2em;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px dotted currentColor;
    opacity: 0.95;
  }
  .term:hover {
    opacity: 1;
    border-bottom-style: solid;
  }
  .term__icon {
    width: 1em;
    height: 1em;
    object-fit: contain;
    vertical-align: -0.1em;
    flex-shrink: 0;
  }
  /* Icon-only terms (used for yield mentions inside effect text — "Sci",
     "Cult", etc. → just the yield icon) shouldn't carry the dotted-link
     underline; the icon itself reads as a glyph. */
  .term:has(> .term__icon:only-child) {
    border-bottom: none;
  }
  .term:has(> .term__icon:only-child) .term__icon {
    width: 1.05em;
    height: 1.05em;
    vertical-align: -0.18em;
  }
  .term--nation { font-weight: 600; }
  .term--unknown { border-bottom: none; opacity: 0.7; }
  /* Non-link terms (improvements, yields, etc. with no destination right
     now) — drop the dotted link cue so they don't look interactive. */
  .term--noref { border-bottom: none; cursor: help; }
</style>
