---
import Base from '../layouts/Base.astro';
import LinkedText from '../components/LinkedText.astro';
import { classifyYield } from '../lib/entities';
import missions from '../data/missions.json';

interface Props {
  slug: string;
  pageMark: string;
}
const { slug, pageMark } = Astro.props;
const base = import.meta.env.BASE_URL;

const mission = missions.find(m => m.slug === slug)!;

function pct(p: number): string {
  return (p * 100).toFixed(0) + '%';
}
---

<Base title={mission.name} active={slug} pageMark={pageMark} pageStats={[
  { label: 'turns', value: mission.turns },
  { label: 'outcomes', value: mission.outcomes.length },
]}>
  <section class="mission-overview">
    <p class="mission-desc"><LinkedText text={mission.description} /></p>

    <div class="mission-chips">
      {mission.subject && (
        <span class="chip chip--neutral">
          <span class="chip__label">Run by</span>
          <strong>{mission.subject}</strong>
        </span>
      )}
      {mission.techPrereq && (
        <a class="chip chip--neutral" href={`${base}technologies#${mission.techPrereq.slug}`}>
          <span class="chip__label">Requires tech</span>
          <strong>{mission.techPrereq.label}</strong>
        </a>
      )}
      <span class="chip chip--neutral">
        <span class="chip__label">Duration</span>
        <strong>{mission.turns} turn{mission.turns === 1 ? '' : 's'}</strong>
      </span>
      {mission.cost.map(c => (
        <span class={`chip yield-${c.yield}`}>
          <span class="chip__label">Cost</span>
          <strong>{c.value} {c.label}</strong>
        </span>
      ))}
    </div>
  </section>

  <section class="outcomes">
    <h2 class="outcomes__title">Outcomes</h2>
    <p class="outcomes__sub">
      A {mission.totalDiceWeight}-sided die rolls when the mission completes; results are weighted as shown.
      Subject character ratings (e.g., Wisdom on Steal Research) shift the roll.
    </p>

    <div class="outcome-grid">
      {mission.outcomes.map(o => {
        // Color the outcome card by its primary reward yield (or fall back to misc)
        const firstReward = o.rewards.find(r => r.value != null);
        const yieldKey = firstReward
          ? firstReward.yield
          : (o.name.toLowerCase().includes('event') ? 'misc' : (classifyYield(o.name)?.toLowerCase() || 'misc'));
        const isEvent = o.id.endsWith('_EVENT');
        const isExposed = o.id.includes('EXPOSED');
        return (
          <div class={`outcome-card yield-${yieldKey} ${isEvent ? 'outcome-card--event' : ''} ${isExposed ? 'outcome-card--exposed' : ''}`}>
            <div class="outcome-card__head">
              <span class="outcome-card__name">{o.name}</span>
              <span class="outcome-card__prob">
                <span class="outcome-card__weight">{o.weight} / {mission.totalDiceWeight}</span>
                <span class="outcome-card__pct">{pct(o.probability)}</span>
              </span>
            </div>
            {o.description && (
              <p class="outcome-card__desc"><LinkedText text={o.description} /></p>
            )}
            {o.ratingModifier.length > 0 && (
              <div class="outcome-card__ratings">
                <span class="outcome-card__ratings-label">Rating influence</span>
                {o.ratingModifier.map(r => (
                  <span class={`chip yield-${r.rating}`}>
                    {r.value > 0 ? '+' : ''}{r.value} × <strong>{r.label}</strong>
                  </span>
                ))}
              </div>
            )}
            {o.rewards.length > 0 && (
              <ul class="outcome-card__rewards">
                {o.rewards.map(r => (
                  <li>
                    {r.value == null ? (
                      <span>{r.label}</span>
                    ) : (
                      <>
                        <span class="reward-val">{r.scope.endsWith('Per') ? `+${r.value / 10} per City` : `+${r.value / 10}`}</span>
                        <span class="reward-yield">{r.label}</span>
                      </>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </div>
        );
      })}
    </div>

    <p class="outcomes__legend">
      <strong>Base</strong> is the flat reward; <strong>per City</strong> values stack with the size of your empire
      (see Reward scaling below). The subject's character rating shifts the dice — e.g. Wisdom raises the
      Steal Research success chance — but does not change the yield amounts.
    </p>
  </section>

  {mission.scaling && (
    <section class="scaling">
      <h2 class="outcomes__title">Reward scaling</h2>
      <p class="outcomes__sub">
        The base reward is <strong>{mission.scaling.base} {mission.scaling.label}</strong>
        {mission.scaling.per ? <> plus <strong>{mission.scaling.per} {mission.scaling.label} per City</strong></> : null},
        so it grows with your empire. The game then scales it up further as the match goes on
        (a turn/price multiplier that depends on game state). <strong>Competitive Mode does not change mission rewards.</strong>
      </p>
      <table class={`ntbl scale-tbl yield-${mission.scaling.yield}`}>
        <thead>
          <tr>
            <th class="rowlabel rowlabel--corner"><span class="nhdr__name">Cities</span></th>
            {mission.scaling.byCities.map(c => <th class="nhdr nhdr--col nhdr--num"><span class="nhdr__name">{c.cities}</span></th>)}
          </tr>
        </thead>
        <tbody>
          <tr>
            <th class="rowlabel" scope="row">
              <span class="scale-tbl__yield">
                <img class="scale-tbl__ico" src={`${base}img/icons/yields/${mission.scaling.yield}.png`} alt="" onerror="this.style.display='none'" />
                {mission.scaling.label} reward
              </span>
            </th>
            {mission.scaling.byCities.map(c => (
              <td class={`cell cell--num yield-${mission.scaling.yield}`}>
                <span class="numval">+{c.value}</span>
              </td>
            ))}
          </tr>
        </tbody>
      </table>
      <p class="outcomes__legend">Reward at base game-yield rate (early game). Later turns multiply these up.</p>
    </section>
  )}

  {mission.events && mission.events.length > 0 && mission.eventChance && (
    <section class="events">
      <h2 class="outcomes__title">Events</h2>
      <p class="outcomes__sub">
        <strong>{pct(mission.eventChance.probability)}</strong> of the time (a {mission.eventChance.weight}/{mission.eventChance.total} dice
        result) the mission fires an <strong>event</strong> instead of its normal reward. One of the
        {' '}{mission.events.length} stories below is drawn by weight, among those whose character/empire
        conditions are met — then you pick a response. Percentages are each story's share of the weighted pool.
      </p>

      <div class="evt-list">
        {mission.events.map(ev => {
          const evYield = classifyYield(ev.guaranteed.join(' '))?.toLowerCase()
            || ev.options.flatMap((o: any) => o.outcomes.flatMap((oc: any) => oc.rewards)).map((r: string) => classifyYield(r)).find(Boolean)?.toLowerCase()
            || 'misc';
          return (
            <details class={`evt yield-${evYield}`}>
              <summary class="evt__summary">
                <span class="evt__name">{ev.name}</span>
                <span class="evt__meta">
                  <span class="evt__share" title="Share of the weighted event pool (among eligible stories)">~{pct(ev.share)}</span>
                  {ev.conditions.map((c: string) => <span class="chip chip--cond">{c}</span>)}
                </span>
              </summary>
              <div class="evt__body">
                {ev.text && <p class="evt__flavor"><LinkedText text={ev.text} /></p>}
                {ev.guaranteed.length > 0 && (
                  <div class="evt__guaranteed">
                    <span class="evt__label">Always</span>
                    {ev.guaranteed.map((g: string) => (
                      <span class={`chip yield-${classifyYield(g)?.toLowerCase() || 'misc'}`}><LinkedText text={g} showIcons={false} /></span>
                    ))}
                  </div>
                )}
                <ul class="evt__opts">
                  {ev.options.map((o: any) => (
                    <li class="opt">
                      <div class="opt__text">
                        <span class="opt__bullet">▸</span>
                        <LinkedText text={o.text || 'Resolve'} />
                        {o.requirements.map((r: string) => <span class="chip chip--req" title="Requires">{r}</span>)}
                      </div>
                      <div class="opt__outcomes">
                        {o.outcomes.map((oc: any) => (
                          <div class="oc">
                            {oc.probability < 1 && <span class="oc__prob">{pct(oc.probability)}</span>}
                            <div class="oc__rewards">
                              {oc.rewards.filter(Boolean).map((r: string) => (
                                <span class={`chip yield-${classifyYield(r)?.toLowerCase() || 'misc'}`}><LinkedText text={r} showIcons={false} /></span>
                              ))}
                            </div>
                          </div>
                        ))}
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            </details>
          );
        })}
      </div>
    </section>
  )}
</Base>

<style>
  .mission-overview { margin-bottom: 1.5rem; }
  .mission-desc {
    color: var(--text-dim);
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0 0 1rem;
    max-width: 70ch;
  }
  .mission-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; }
  .mission-chips .chip { gap: 0.5rem; padding: 0.3rem 0.7rem; font-size: 0.78rem; }
  .chip__label {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 500;
  }

  .outcomes { margin-top: 2rem; }
  .outcomes__title {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-dim);
    margin-bottom: 0.5rem;
  }
  .outcomes__sub {
    color: var(--text-dim);
    font-size: 0.82rem;
    margin: 0 0 1rem;
    max-width: 70ch;
  }
  .outcomes__legend {
    margin-top: 1rem;
    color: var(--text-faint);
    font-size: 0.75rem;
    max-width: 70ch;
  }
  .outcomes__legend strong { color: var(--text-dim); }

  .outcome-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 0.6rem;
  }
  .outcome-card {
    background: var(--yield-bg, var(--bg-elev));
    color: var(--yield-fg, var(--text));
    background-image: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(0,0,0,0.20) 60%, rgba(0,0,0,0.36));
    border: 1px solid color-mix(in srgb, var(--yield-bg, var(--border-strong)) 50%, #000 50%);
    border-radius: var(--radius-lg);
    padding: 0.7rem 0.9rem 0.8rem;
  }
  .outcome-card--event { background-image: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(0,0,0,0.30) 60%, rgba(0,0,0,0.50)); }
  .outcome-card--exposed { box-shadow: inset 0 0 0 1px rgba(255,255,255,0.06), inset 0 -2px 0 #d46e6e; }

  .outcome-card__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 0.4rem;
  }
  .outcome-card__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
  }
  .outcome-card__prob {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.1rem;
  }
  .outcome-card__pct {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .outcome-card__weight {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    opacity: 0.7;
    letter-spacing: 0.04em;
  }
  .outcome-card__desc {
    margin: 0 0 0.5rem;
    font-size: 0.78rem;
    line-height: 1.4;
    opacity: 0.92;
  }
  .outcome-card__ratings {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-bottom: 0.5rem;
    align-items: center;
  }
  .outcome-card__ratings-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.55);
    margin-right: 0.15rem;
  }
  .outcome-card__ratings .chip {
    font-size: 0.7rem;
    padding: 0.1rem 0.45rem;
  }
  .outcome-card__rewards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .outcome-card__rewards li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 0.78rem;
    gap: 0.6rem;
    padding: 0.15rem 0;
    border-top: 1px dashed rgba(255,255,255,0.12);
  }
  .outcome-card__rewards li:first-child { border-top: 0; }
  .reward-val {
    font-family: var(--font-mono);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .reward-yield { opacity: 0.78; }

  /* ── Reward scaling table ── */
  .scaling { margin-top: 2rem; }
  .scale-tbl { width: auto; margin-top: 0.6rem; }
  .scale-tbl .nhdr--col { background: var(--bg-elev-2); text-align: right; padding: 0.4rem 0.7rem; }
  .scale-tbl .nhdr--num .nhdr__name { font-family: var(--font-mono); font-size: 0.82rem; }
  .scale-tbl__yield { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.82rem; color: var(--text-dim); white-space: nowrap; }
  .scale-tbl__ico { width: 15px; height: 15px; object-fit: contain; }
  .scale-tbl .cell--num { text-align: right; padding: 0.35rem 0.7rem; }
  .scale-tbl .numval { font-family: var(--font-mono); font-weight: 600; font-variant-numeric: tabular-nums; font-size: 0.86rem; }

  /* ── Events ── */
  .events { margin-top: 2rem; }
  .evt-list { display: flex; flex-direction: column; gap: 0.4rem; margin-top: 0.8rem; }
  .evt {
    border: 1px solid var(--border);
    border-left: 3px solid color-mix(in srgb, var(--yield-bg, var(--accent)) 70%, transparent);
    border-radius: var(--radius-lg); background: var(--bg-elev); overflow: hidden;
  }
  .evt[open] { background: var(--bg-elev-2); }
  .evt__summary {
    display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;
    padding: 0.5rem 0.8rem; cursor: pointer; list-style: none; user-select: none;
  }
  .evt__summary::-webkit-details-marker { display: none; }
  .evt__summary::before {
    content: '▸'; color: var(--text-faint); font-size: 0.8rem; transition: transform 0.12s; flex-shrink: 0;
  }
  .evt[open] .evt__summary::before { transform: rotate(90deg); }
  .evt__summary:hover { background: color-mix(in srgb, var(--accent) 6%, transparent); }
  .evt__name { font-family: var(--font-display); font-weight: 600; font-size: 0.92rem; color: var(--text); }
  .evt__meta { display: flex; align-items: center; gap: 0.35rem; flex-wrap: wrap; margin-left: auto; }
  .evt__share {
    font-family: var(--font-mono); font-size: 0.74rem; font-weight: 600;
    color: var(--accent); background: color-mix(in srgb, var(--accent) 14%, var(--bg-elev));
    padding: 0.08rem 0.4rem; border-radius: 5px;
  }
  .chip--cond { background: var(--bg-elev); color: var(--text-dim); border: 1px solid var(--border); padding: 0.06rem 0.42rem; font-size: 0.68rem; }
  .chip--req { background: color-mix(in srgb, #6b5ea6 24%, var(--bg-elev)); color: var(--text); border: 1px solid color-mix(in srgb, #6b5ea6 45%, transparent); padding: 0.04rem 0.4rem; font-size: 0.66rem; margin-left: 0.4rem; }

  .evt__body { padding: 0 0.9rem 0.7rem 1.6rem; }
  .evt__flavor { color: var(--text-dim); font-size: 0.82rem; line-height: 1.45; margin: 0 0 0.6rem; font-style: italic; max-width: 75ch; }
  .evt__guaranteed { display: flex; align-items: center; gap: 0.3rem; flex-wrap: wrap; margin-bottom: 0.6rem; }
  .evt__label, .oc__prob { font-family: var(--font-mono); font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-faint); }

  .evt__opts { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.45rem; }
  .opt { border-top: 1px dashed var(--border); padding-top: 0.45rem; }
  .opt:first-child { border-top: 0; padding-top: 0; }
  .opt__text { font-size: 0.85rem; color: var(--text); margin-bottom: 0.3rem; display: flex; align-items: baseline; gap: 0.35rem; flex-wrap: wrap; }
  .opt__bullet { color: var(--accent); font-size: 0.7rem; }
  .opt__outcomes { display: flex; flex-direction: column; gap: 0.25rem; padding-left: 1rem; }
  .oc { display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; }
  .oc__prob {
    font-family: var(--font-mono); font-size: 0.7rem; font-weight: 600; color: var(--text-dim);
    min-width: 2.4rem; text-align: right;
  }
  .oc__rewards { display: flex; gap: 0.25rem; flex-wrap: wrap; }
  .oc__rewards .chip, .evt__guaranteed .chip { font-size: 0.72rem; padding: 0.08rem 0.45rem; }
</style>
